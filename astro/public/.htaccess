# Canonical host + scheme: force https://newgoldenoffice.com (no www, no http)
# Checks X-Forwarded-Proto because Cloudflare terminates TLS and can forward
# to the origin over plain HTTP even when the visitor used https:// —
# relying on %{HTTPS} alone here would risk a redirect loop.
RewriteEngine On

# Astro builds every route as <page>/index.html (directory format), so
# Apache's own mod_dir would otherwise 301 extensionless requests like
# /copiers/buy to /copiers/buy/ — but every internal link, canonical tag,
# and sitemap entry in this codebase points at the no-slash form. Turn off
# the automatic redirect and serve the directory's index.html straight from
# the extensionless URL instead, so it's a real 200, not a redirect.
DirectorySlash Off

# BEGIN MANAGED REDIRECTS -- generated from admin/data/redirects.json, do not hand-edit
RewriteRule ^printing/alexandria/?$ /alexandria/printing [R=301,L]
RewriteRule ^printing/cairo/?$ /cairo/printing [R=301,L]
RewriteRule ^copiers/alexandria/?$ /alexandria/copiers [R=301,L]
RewriteRule ^copiers/cairo/?$ /cairo/copiers [R=301,L]
RewriteRule ^cameras/alexandria/?$ /alexandria/cameras [R=301,L]
RewriteRule ^cameras/cairo/?$ /cairo/cameras [R=301,L]
RewriteRule ^ac/alexandria/?$ /alexandria/ac [R=301,L]
RewriteRule ^ac/cairo/?$ /cairo/ac [R=301,L]
RewriteRule ^cash-machines/alexandria/?$ /alexandria/cash-machines [R=301,L]
RewriteRule ^cash-machines/cairo/?$ /cairo/cash-machines [R=301,L]
RewriteRule ^office-supplies/alexandria/?$ /alexandria/office-supplies [R=301,L]
RewriteRule ^office-supplies/cairo/?$ /cairo/office-supplies [R=301,L]
# END MANAGED REDIRECTS

RewriteCond %{HTTP_HOST} ^www\.newgoldenoffice\.com$ [NC]
RewriteRule ^(.*)$ https://newgoldenoffice.com/$1 [R=301,L]

RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^(.*)$ https://newgoldenoffice.com/$1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*[^/])$ $1/index.html [L]

# /page/ -> /page. DirectorySlash Off (above) already serves the trailing-slash
# form as a real 200 with a self-canonical tag pointing at the no-slash URL, so
# this was never a broken page — but leaving it as a live 200 means crawlers
# keep spending budget on a duplicate instead of just following a redirect.
# THE_REQUEST-based so it can't loop against the internal directory rule above.
RewriteCond %{THE_REQUEST} \s/+(.+)/[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Clean URLs: /ac/buy instead of /ac/buy.html. THE_REQUEST reflects the
# original client request line (never the internally-rewritten one below),
# so these two conditions can't loop against each other.
# /dir/index.html -> /dir/ for anyone requesting the literal filename
# (the DirectorySlash-off rule above already makes /dir the real canonical
# URL — this just catches stray links to the index.html itself).
RewriteCond %{THE_REQUEST} \s/+(.*)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /anything.html -> /anything, except search-engine ownership-verification
# files (e.g. yandex_*.html, google*.html) which must be served at their
# exact .html URL with a direct 200 — verification crawlers don't follow
# redirects.
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteCond %1 !^(yandex_|google)[a-z0-9]*$ [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve the .html file internally for the clean extension-less URL, without
# changing what the visitor sees in the address bar.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"
</IfModule>
