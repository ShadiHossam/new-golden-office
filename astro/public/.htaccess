# Canonical URL enforcement: everything resolves to
# https://newgoldenoffice.com/<path> — no www, no http, no trailing slash,
# no .html, no index.html.
RewriteEngine On

# Astro builds every route as <page>/index.html (directory format), so
# Apache's own mod_dir would otherwise 301 extensionless requests like
# /copiers/buy to /copiers/buy/ — but every internal link, canonical tag,
# and sitemap entry in this codebase points at the no-slash form. Turn off
# the automatic redirect and serve the directory's index.html straight from
# the extensionless URL instead, so it's a real 200, not a redirect.
DirectorySlash Off

# BEGIN MANAGED REDIRECTS -- generated from admin/data/redirects.json, do not hand-edit
RewriteRule ^printing/alexandria/?$ https://newgoldenoffice.com/alexandria/printing [R=301,L]
RewriteRule ^printing/cairo/?$ https://newgoldenoffice.com/cairo/printing [R=301,L]
RewriteRule ^copiers/alexandria/?$ https://newgoldenoffice.com/alexandria/copiers [R=301,L]
RewriteRule ^copiers/cairo/?$ https://newgoldenoffice.com/cairo/copiers [R=301,L]
RewriteRule ^cameras/alexandria/?$ https://newgoldenoffice.com/alexandria/cameras [R=301,L]
RewriteRule ^cameras/cairo/?$ https://newgoldenoffice.com/cairo/cameras [R=301,L]
RewriteRule ^ac/alexandria/?$ https://newgoldenoffice.com/alexandria/ac [R=301,L]
RewriteRule ^ac/cairo/?$ https://newgoldenoffice.com/cairo/ac [R=301,L]
RewriteRule ^cash-machines/alexandria/?$ https://newgoldenoffice.com/alexandria/cash-machines [R=301,L]
RewriteRule ^cash-machines/cairo/?$ https://newgoldenoffice.com/cairo/cash-machines [R=301,L]
RewriteRule ^office-supplies/alexandria/?$ https://newgoldenoffice.com/alexandria/office-supplies [R=301,L]
RewriteRule ^office-supplies/cairo/?$ https://newgoldenoffice.com/cairo/office-supplies [R=301,L]
RewriteRule ^portfolio/?$ https://newgoldenoffice.com/about [R=301,L]
RewriteRule ^blog/adawat-tanzim-al-maktab/?$ https://newgoldenoffice.com/blog/office-organization-tools-guide [R=301,L]
RewriteRule ^blog/egypt-photocopier-prices-2025/?$ https://newgoldenoffice.com/blog/egypt-photocopier-prices [R=301,L]
# END MANAGED REDIRECTS

# URL-form canonicalization. Every target below is absolute
# (https://newgoldenoffice.com/...) so a request that's wrong in BOTH host/scheme
# AND path form — e.g. http://www.newgoldenoffice.com/ac/buy.html — is corrected
# in a SINGLE 301, instead of bouncing off the host rules below for a second hop.
# All three match on THE_REQUEST, the original client request line, which the
# internal rewrites at the bottom never modify — that is what keeps them from
# looping against those. Their targets are already fully canonical, so a
# follow-up request on the target can't re-match any of them either.

# /dir/index.html -> /dir. The optional /? swallows the trailing slash in the
# same pass, so this can't hand off to the trailing-slash rule for a second hop.
RewriteCond %{THE_REQUEST} \s/+(.*?)/?index\.html[\s?] [NC]
RewriteRule ^ https://newgoldenoffice.com/%1 [R=301,L]

# /anything.html -> /anything, except search-engine ownership-verification
# files (e.g. yandex_*.html, google*.html) which must be served at their
# exact .html URL with a direct 200 — verification crawlers don't follow
# redirects. Must stay below the index.html rule above, or /dir/index.html
# would land on /dir/index here.
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteCond %1 !^(yandex_|google)[a-z0-9]*$ [NC]
RewriteRule ^ https://newgoldenoffice.com/%1 [R=301,L]

# /page/ -> /page. DirectorySlash Off (above) already serves the trailing-slash
# form as a real 200 with a self-canonical tag pointing at the no-slash URL, so
# this was never a broken page — but leaving it as a live 200 means crawlers
# keep spending budget on a duplicate instead of just following a redirect.
RewriteCond %{THE_REQUEST} \s/+(.+)/[\s?] [NC]
RewriteRule ^ https://newgoldenoffice.com/%1 [R=301,L]

# Host/scheme fallback, for requests the rules above didn't already send to the
# canonical origin (e.g. https://www.newgoldenoffice.com/ itself).
# X-Forwarded-Proto is checked because Cloudflare terminates TLS and can forward
# to the origin over plain HTTP even when the visitor used https:// — relying on
# %{HTTPS} alone here would risk a redirect loop.
RewriteCond %{HTTP_HOST} ^www\.newgoldenoffice\.com$ [NC]
RewriteRule ^(.*)$ https://newgoldenoffice.com/$1 [R=301,L]

RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^(.*)$ https://newgoldenoffice.com/$1 [R=301,L]

# Internal rewrites below — these change what gets served, never what the
# visitor sees in the address bar.

RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*[^/])$ $1/index.html [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Compression. Text formats compress 70-80%; images, woff2 and video are
# already compressed and are deliberately left out.
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/xsl
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/ld+json
    AddOutputFilterByType DEFLATE application/xml application/rss+xml application/atom+xml
    AddOutputFilterByType DEFLATE image/svg+xml
  </IfModule>
</IfModule>

# Brotli where the host offers it — a better ratio than gzip on text. Both
# blocks can be active at once; Apache picks by the client's Accept-Encoding.
<IfModule mod_brotli.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml text/xsl
    AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/json application/ld+json
    AddOutputFilterByType BROTLI_COMPRESS application/xml application/rss+xml application/atom+xml
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
  </IfModule>
</IfModule>

# ---------------------------------------------------------------------------
# Cache policy.
#   HTML            revalidate every time, so a redeploy is live immediately.
#   /_astro/        filenames carry a build hash.
#   /images/v/      variant filenames carry their width and are never rewritten.
#   /fonts/         icon subsets carry a content hash (build-icon-subset.mjs);
#                   the Cairo/Tajawal faces are stable.
#   other images    30 days — the base files keep stable names and could be
#                   re-encoded by scripts/optimize-images.mjs.
#   sitemaps        1 hour, so search engines pick up changes quickly.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xsl "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"

  # Content-addressed paths: safe to freeze for a year. Defined before the
  # general static-asset rule below, but that ordering doesn't actually decide
  # precedence — Apache applies <FilesMatch> sections after plain directives
  # regardless of where they sit in the file, so a plain Header here and a
  # <FilesMatch>-wrapped Header below both matching the same .webp request
  # would have the FilesMatch one win no matter which is written first or last.
  # Making the two conditions mutually exclusive (env= / env=!) is what
  # actually guarantees correctness, not the order below.
  SetEnvIf Request_URI "^/_astro/"   IMMUTABLE_ASSET=1
  SetEnvIf Request_URI "^/images/v/" IMMUTABLE_ASSET=1
  SetEnvIf Request_URI "^/fonts/"    IMMUTABLE_ASSET=1
  Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE_ASSET

  # Static assets, conservative default — everything NOT already caught by the
  # immutable rule above (env=!IMMUTABLE_ASSET is what makes this safe to
  # coexist with it; see note above).
  <FilesMatch "\.(css|js|mjs|woff2|woff|ttf|webp|jpe?g|png|gif|svg|ico|avif)$">
    Header set Cache-Control "public, max-age=2592000" env=!IMMUTABLE_ASSET
  </FilesMatch>

  # HTML must always revalidate.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Crawl-facing files stay fresh.
  <FilesMatch "^(.*sitemap.*\.xml|robots\.txt|llms\.txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
