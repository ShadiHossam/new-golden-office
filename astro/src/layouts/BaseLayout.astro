---
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { join } from 'node:path';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { PAGE_NAMES } from '../lib/pageNames';

// Cache-busting query param so CDN/browser caches never serve a stale
// global.css after a deploy — content hash changes only when the file does.
// import.meta.url can't be used here: Astro bundles this component into
// dist/.prerender/chunks/ during build, which breaks any URL relative to
// the source file's original location. process.cwd() is stable because
// `astro build` always runs from the project root.
const globalCssPath = join(process.cwd(), 'public/styles/global.css');
const globalCssVersion = createHash('md5').update(readFileSync(globalCssPath)).digest('hex').slice(0, 10);

// Self-hosted icon subset, generated by scripts/build-icon-subset.mjs. Replaces
// the render-blocking Font Awesome bundle that used to load from cdnjs on every
// page — same glyphs, one same-origin request, no third-party handshake.
const iconsCssPath = join(process.cwd(), 'public/styles/icons.css');
const iconsCssVersion = createHash('md5').update(readFileSync(iconsCssPath)).digest('hex').slice(0, 10);

interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: string;
  publishedTime?: string;
  modifiedTime?: string;
  schemaJson?: string;
  /** Extra JSON-LD blocks, e.g. FAQ schema carried inside a post's stored HTML. */
  extraSchemas?: string[];
  preloadImage?: string;
  robots?: string;
  breadcrumbLabel?: string;
}

const {
  title,
  description,
  keywords,
  ogTitle,
  ogDescription,
  ogImage,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  schemaJson,
  extraSchemas = [],
  preloadImage,
  robots,
  breadcrumbLabel,
} = Astro.props;

const SITE = 'https://newgoldenoffice.com';
const pathname = Astro.url.pathname;
const canonical = SITE + (pathname.endsWith('/') && pathname !== '/' ? pathname.slice(0, -1) : pathname);
const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDescription = ogDescription ?? description;
const resolvedOgImage = ogImage
  ? (ogImage.startsWith('http') ? ogImage : `${SITE}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`)
  : `${SITE}/images/og-image.jpg`;

// Build BreadcrumbList schema from pathname
const segments = pathname.split('/').filter(s => s && s !== 'index.html' && !s.endsWith('.html'));
const breadcrumbItems = [{ name: 'الرئيسية', url: SITE + '/' }];
let builtUrl = SITE;
const relSegments: string[] = [];
segments.forEach((seg, i) => {
  builtUrl += '/' + seg;
  relSegments.push(seg);
  const relPath = relSegments.join('/');
  const isLast = i === segments.length - 1;
  const mapped = PAGE_NAMES[relPath] ?? PAGE_NAMES[seg];
  const name = (isLast && breadcrumbLabel) || mapped || seg;
  // A PAGE_NAMES entry of '' marks a routing-only segment (e.g. the "page" in
  // /blog/page/2) that shouldn't appear as its own crumb.
  if (!isLast && mapped === '') return;
  // No trailing slash: .htaccess 301s /path/ -> /path, and the canonical tag
  // and sitemap both use the slash-less form. Emitting it here would point
  // every breadcrumb node at a URL that redirects.
  breadcrumbItems.push({ name, url: builtUrl });
});
const breadcrumbSchema = breadcrumbItems.length > 1 ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    item: item.url,
  })),
}) : null;

const localBusinessSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://newgoldenoffice.com/#organization',
  name: 'نيو جولدن أوفيس',
  alternateName: 'New Golden Office',
  description: 'بيع وصيانة ماكينات التصوير والطابعات، خدمات الطباعة، كاميرات المراقبة، التكييفات، ماكينات عد النقود، والمستلزمات المكتبية في مصر',
  url: 'https://newgoldenoffice.com',
  telephone: '+201227392074',
  image: `${SITE}/images/about-team.webp`,
  logo: `${SITE}/images/logo.png`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '26 عبد المنعم سند',
    addressLocality: 'الإبراهيمية، باب شرق',
    addressRegion: 'الإسكندرية',
    // 21524 — Ibrahimeya, Alexandria's real 5-digit code (Egyptian National
    // Postal Organization / egyxa.com, cross-checked 2026-09-06). The old
    // value (5423031) was 7 digits and not a valid Egyptian postcode at all.
    postalCode: '21524',
    addressCountry: 'EG',
  },
  // The business serves all of Egypt from an Alexandria HQ; areaServed is what
  // states that in schema without claiming branch addresses that don't exist.
  areaServed: {
    '@type': 'Country',
    name: 'Egypt',
  },
  // Multi-category (printing, copiers, AC, CCTV, cash machines, supplies) with
  // both retail items and installation/maintenance contracts — "$$" reflects
  // a mid-range mix rather than a single number that would misrepresent most
  // of the catalog.
  priceRange: '$$',
  foundingDate: '1999',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday','Sunday','Monday','Tuesday','Wednesday','Thursday'],
      opens: '09:00',
      closes: '18:00',
    },
  ],
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 31.2078,
    longitude: 29.9133,
  },
  // Canonical Google Maps URL for the business, resolved from the share link:
  // feature id 0x14f5c5290d565f6d:0x697251e830257eb7 -> CID 7598225579009474231.
  // The ?cid= form is stable and resolves directly to the listing, unlike a
  // share.google shortlink, which is a redirect and a weaker entity signal.
  hasMap: 'https://maps.google.com/?cid=7598225579009474231',
  sameAs: ['https://maps.google.com/?cid=7598225579009474231'],
});
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <!-- Google Tag Manager -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-NMLZVZR3');</script>
  <!-- End Google Tag Manager -->

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-SEPETFLC25"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-SEPETFLC25');

    gtag('config', 'AW-18320973253');
  </script>

  <!-- Microsoft Clarity -->
  <script type="text/javascript">
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "xlc66h8b4c");
  </script>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/images/logo.png" type="image/png">
  <link rel="apple-touch-icon" href="/images/logo.png">
  <title>{title}</title>
  <meta name="description" content={description}>
  {keywords && <meta name="keywords" content={keywords}>}
  {robots && <meta name="robots" content={robots}>}
  <meta property="og:title" content={resolvedOgTitle}>
  <meta property="og:description" content={resolvedOgDescription}>
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={resolvedOgImage}>
  <meta property="og:site_name" content="نيو جولدن أوفيس">
  <meta property="og:locale" content="ar_EG">
  {publishedTime && <meta property="article:published_time" content={publishedTime}>}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime}>}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content={resolvedOgImage}>
  <link rel="canonical" href={canonical}>
  <link rel="dns-prefetch" href="https://wa.me">
  {preloadImage && <link rel="preload" href={preloadImage} as="image">}
  <link rel="stylesheet" href={`/styles/icons.css?v=${iconsCssVersion}`}>
  <link rel="stylesheet" href={`/styles/global.css?v=${globalCssVersion}`}>
  <script type="application/ld+json" set:html={localBusinessSchema} />
  {breadcrumbSchema && <script type="application/ld+json" set:html={breadcrumbSchema} />}
  {schemaJson && <script type="application/ld+json" set:html={schemaJson} />}
  {extraSchemas.map((json) => <script type="application/ld+json" set:html={json} />)}
</head>
<body>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NMLZVZR3"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

<Navbar currentPath={pathname} />
<slot />
<Footer />
<WhatsAppFloat />
<div class="nav-overlay"></div>
<script src="/js/main.js" defer></script>

</body>
</html>
