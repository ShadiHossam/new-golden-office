---
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { join } from 'node:path';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { PAGE_NAMES } from '../lib/pageNames';

// Cache-busting query param so CDN/browser caches never serve a stale
// global.css after a deploy — content hash changes only when the file does.
// import.meta.url can't be used here: Astro bundles this component into
// dist/.prerender/chunks/ during build, which breaks any URL relative to
// the source file's original location. process.cwd() is stable because
// `astro build` always runs from the project root.
const globalCssPath = join(process.cwd(), 'public/styles/global.css');
const globalCssVersion = createHash('md5').update(readFileSync(globalCssPath)).digest('hex').slice(0, 10);

interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  schemaJson?: string;
  preloadImage?: string;
  robots?: string;
}

const {
  title,
  description,
  keywords,
  ogTitle,
  ogDescription,
  ogImage,
  schemaJson,
  preloadImage,
  robots,
} = Astro.props;

const SITE = 'https://newgoldenoffice.com';
const pathname = Astro.url.pathname;
const canonical = SITE + (pathname.endsWith('/') && pathname !== '/' ? pathname.slice(0, -1) : pathname);
const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDescription = ogDescription ?? description;
const resolvedOgImage = ogImage
  ? (ogImage.startsWith('http') ? ogImage : `${SITE}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`)
  : `${SITE}/images/og-image.jpg`;

// Build BreadcrumbList schema from pathname
const segments = pathname.split('/').filter(s => s && s !== 'index.html' && !s.endsWith('.html'));
const breadcrumbItems = [{ name: 'الرئيسية', url: SITE + '/' }];
let builtUrl = SITE;
const relSegments: string[] = [];
segments.forEach(seg => {
  builtUrl += '/' + seg;
  relSegments.push(seg);
  const relPath = relSegments.join('/');
  const name = PAGE_NAMES[relPath] ?? PAGE_NAMES[seg] ?? seg;
  breadcrumbItems.push({ name, url: builtUrl + '/' });
});
const breadcrumbSchema = breadcrumbItems.length > 1 ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    item: item.url,
  })),
}) : null;

const localBusinessSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'نيو جولدن أوفيس',
  alternateName: 'New Golden Office',
  description: 'بيع وصيانة ماكينات التصوير والطابعات، خدمات الطباعة، كاميرات المراقبة، التكييفات، ماكينات عد النقود، والمستلزمات المكتبية في مصر',
  url: 'https://newgoldenoffice.com',
  telephone: '+201227392074',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '26 عبد المنعم سند',
    addressLocality: 'الإبراهيمية، باب شرق',
    addressRegion: 'الإسكندرية',
    postalCode: '5423031',
    addressCountry: 'EG',
  },
  foundingDate: '1999',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday','Sunday','Monday','Tuesday','Wednesday','Thursday'],
      opens: '09:00',
      closes: '18:00',
    },
  ],
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 31.2078,
    longitude: 29.9133,
  },
  hasMap: 'https://share.google/DBHA1FMpRmsO9xqwU',
});
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/images/logo.png" type="image/png">
  <link rel="apple-touch-icon" href="/images/logo.png">
  <title>{title}</title>
  <meta name="description" content={description}>
  {keywords && <meta name="keywords" content={keywords}>}
  {robots && <meta name="robots" content={robots}>}
  <meta property="og:title" content={resolvedOgTitle}>
  <meta property="og:description" content={resolvedOgDescription}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={resolvedOgImage}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content={resolvedOgImage}>
  <link rel="canonical" href={canonical}>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com">
  <link rel="dns-prefetch" href="https://wa.me">
  {preloadImage && <link rel="preload" href={preloadImage} as="image">}
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href={`/styles/global.css?v=${globalCssVersion}`}>
  <script type="application/ld+json" set:html={localBusinessSchema} />
  {breadcrumbSchema && <script type="application/ld+json" set:html={breadcrumbSchema} />}
  {schemaJson && <script type="application/ld+json" set:html={schemaJson} />}
</head>
<body>

<Navbar currentPath={pathname} />
<slot />
<Footer />
<WhatsAppFloat />
<div class="nav-overlay"></div>
<script src="/js/main.js" defer></script>

</body>
</html>
