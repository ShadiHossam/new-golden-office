---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">

      <!-- Brand -->
      <div class="footer-brand">
        <a href="/" class="footer-logo-wrap">
          <img src="/images/logo.png" alt="نيو جولدن أوفيس" class="footer-logo-img" onerror="this.style.display='none'">
          <div>
            <div class="footer-logo-name">نيو جولدن أوفيس</div>
            <div class="footer-logo-en">NEW GOLDEN OFFICE</div>
          </div>
        </a>
        <p class="footer-desc">شريكك الموثوق في الإسكندرية ومصر منذ 1999. مستلزمات مكتبية، طباعة، ماكينات تصوير، كاميرات مراقبة، تكييفات، وماكينات عد الأموال.</p>
        <div class="footer-social">
          <a href="https://wa.me/201227392074" class="social-link" aria-label="واتساب" target="_blank"><i class="fab fa-whatsapp"></i></a>
          <a href="tel:+201227392074" class="social-link" aria-label="اتصل بنا"><i class="fas fa-phone"></i></a>
        </div>
      </div>

      <!-- Services -->
      <div class="footer-col">
        <h5>خدماتنا</h5>
        <ul class="footer-links">
          <li><a href="/office-supplies">مستلزمات مكتبية</a></li>
          <li><a href="/printing">خدمات الطباعة</a></li>
          <li><a href="/copiers">ماكينات التصوير</a></li>
          <li><a href="/cameras">كاميرات المراقبة</a></li>
          <li><a href="/ac">التكييفات</a></li>
          <li><a href="/cash-machines">ماكينات الفارم والعد</a></li>
        </ul>
      </div>

      <!-- Quick Links -->
      <div class="footer-col">
        <h5>روابط سريعة</h5>
        <ul class="footer-links">
          <li><a href="/">الرئيسية</a></li>
          <li><a href="/about">عن الشركة</a></li>
          <li><a href="/portfolio">معرض أعمالنا</a></li>
          <li><a href="/blog">المدونة</a></li>
          <li><a href="/contact">تواصل معنا</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="footer-col">
        <h5>تواصل معنا</h5>
        <div class="footer-contact-items">
          <div class="footer-contact-item">
            <i class="fas fa-map-marker-alt"></i>
            <span>26 عبد المنعم سند، الإبراهيمية، باب شرق، الإسكندرية</span>
          </div>
          <div class="footer-contact-item">
            <i class="fas fa-phone-alt"></i>
            <a href="tel:+201227392074">01227392074</a>
          </div>
          <div class="footer-contact-item">
            <i class="fab fa-whatsapp"></i>
            <a href="https://wa.me/201227392074" target="_blank">واتساب مباشر</a>
          </div>
          <div class="footer-contact-item">
            <i class="fas fa-clock"></i>
            <span>السبت – الخميس: 9ص – 6م</span>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom-bar">
    <div class="container">
      <p>جميع الحقوق محفوظة &copy; {year} — نيو جولدن أوفيس</p>
      <div class="footer-bottom-links">
        <a href="/privacy">سياسة الخصوصية</a>
        <a href="/terms">الشروط والأحكام</a>
        <a href="/contact">تواصل معنا</a>
      </div>
    </div>
  </div>
</footer>

<style is:global>
.footer {
  background: var(--green-dark);
  color: rgba(255,255,255,0.88);
  padding: 64px 0 0;
}

.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1.4fr;
  gap: 48px;
  padding-bottom: 52px;
  border-bottom: 1px solid rgba(255,255,255,0.1);
}

/* Brand col */
.footer-logo-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
  text-decoration: none;
}
.footer-logo-img {
  width: 46px;
  height: 46px;
  border-radius: 10px;
  object-fit: contain;
  border: 2px solid rgba(255,255,255,0.2);
  background: rgba(255,255,255,0.06);
  padding: 3px;
  flex-shrink: 0;
}
.footer-logo-name {
  font-family: var(--font-heading);
  font-weight: 900;
  font-size: 1.1rem;
  color: #fff;
  line-height: 1.2;
}
.footer-logo-en {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  color: var(--green-light);
  margin-top: 2px;
}
.footer-desc {
  font-size: 0.88rem;
  color: rgba(255,255,255,0.65);
  line-height: 1.85;
  margin-bottom: 22px;
  max-width: 320px;
}
.footer-social {
  display: flex;
  gap: 10px;
}
.footer-social .social-link {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,0.8);
  font-size: 0.95rem;
  transition: var(--transition);
}
.footer-social .social-link:hover {
  background: var(--green-light);
  border-color: var(--green-light);
  color: #fff;
  transform: translateY(-2px);
}

/* Columns */
.footer-col h5 {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.95rem;
  color: #fff;
  margin-bottom: 20px;
  padding-bottom: 10px;
  border-bottom: 2px solid var(--green-light);
  display: inline-block;
}
.footer-links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.footer-links a {
  color: rgba(255,255,255,0.70);
  font-size: 0.88rem;
  display: flex;
  align-items: center;
  gap: 7px;
  transition: var(--transition);
  text-decoration: none;
}
.footer-links a::before {
  content: '›';
  color: var(--green-light);
  font-size: 1rem;
  line-height: 1;
}
.footer-links a:hover {
  color: var(--green-light);
  padding-right: 4px;
}

/* Contact items */
.footer-contact-items {
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.footer-contact-item {
  display: flex;
  align-items: flex-start;
  gap: 11px;
  font-size: 0.87rem;
  color: rgba(255,255,255,0.70);
  line-height: 1.5;
}
.footer-contact-item i {
  color: var(--green-light);
  width: 16px;
  flex-shrink: 0;
  margin-top: 2px;
}
.footer-contact-item a {
  color: rgba(255,255,255,0.80);
  text-decoration: none;
  transition: var(--transition);
}
.footer-contact-item a:hover {
  color: var(--green-light);
}

/* Bottom bar */
.footer-bottom-bar {
  padding: 20px 0;
}
.footer-bottom-bar .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
}
.footer-bottom-bar p {
  font-size: 0.82rem;
  color: rgba(255,255,255,0.45);
  margin: 0;
}
.footer-bottom-links {
  display: flex;
  gap: 20px;
}
.footer-bottom-links a {
  font-size: 0.82rem;
  color: rgba(255,255,255,0.50);
  text-decoration: none;
  transition: var(--transition);
}
.footer-bottom-links a:hover {
  color: var(--green-light);
}

/* Responsive */
@media (max-width: 1024px) {
  .footer-grid {
    grid-template-columns: 1fr 1fr;
    gap: 36px;
  }
  .footer-brand {
    grid-column: span 2;
  }
}
@media (max-width: 640px) {
  .footer-grid {
    grid-template-columns: 1fr;
    gap: 28px;
  }
  .footer-brand {
    grid-column: span 1;
  }
  .footer-bottom-bar .container {
    flex-direction: column;
    text-align: center;
  }
}
</style>
