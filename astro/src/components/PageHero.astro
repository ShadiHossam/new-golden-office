---
interface Breadcrumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  subtitle?: string;
  breadcrumbs: Breadcrumb[];
  heroImage: string;
  heroIcon: string;
  showCta?: boolean;
}

const { title, subtitle, breadcrumbs, heroImage, heroIcon, showCta = true } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    <div class="page-hero-inner">
      <div class="page-hero-content">
        <nav class="breadcrumb" aria-label="breadcrumb">
          {breadcrumbs.map((crumb, i) => (
            <>
              {i > 0 && <i class="fa-solid fa-chevron-left"></i>}
              {crumb.href
                ? <a href={crumb.href}>{crumb.label}</a>
                : <span class="current">{crumb.label}</span>
              }
            </>
          ))}
        </nav>
        <h1>{title}</h1>
        {subtitle && <p class="lead">{subtitle}</p>}
        {showCta && (
          <div class="hero-cta">
            <a href="https://wa.me/201227392074?text=مرحباً،%20أريد%20الاستفسار%20عن%20خدماتكم" class="btn btn-whatsapp" target="_blank">
              <i class="fab fa-whatsapp"></i> تواصل عبر واتساب
            </a>
            <a href="tel:+201227392074" class="btn btn-outline">
              <i class="fas fa-phone"></i> اتصل الآن
            </a>
          </div>
        )}
      </div>
      <div class="page-hero-image">
        <img src={heroImage} alt="" loading="lazy" onerror="this.style.display='none'">
        <div class="page-hero-icon"><i class={`fas ${heroIcon}`}></i></div>
      </div>
    </div>
  </div>
</section>
