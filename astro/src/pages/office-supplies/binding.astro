---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';
import ContentIntro from '../../components/ContentIntro.astro';
import IconCardGrid from '../../components/IconCardGrid.astro';
import ComparisonGrid from '../../components/ComparisonGrid.astro';
import { getSeoFor } from '../../lib/siteSeo';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "أدوات ربط ودباسة ولاصق",
  "description": "دباسات وأدوات ربط وورق لاصق وغراء للمكاتب في مصر — جميع الماركات بأسعار الجملة.",
  "serviceType": "أدوات مكتبية",
  "provider": {
    "@type": "LocalBusiness",
    "name": "نيو جولدن أوفيس",
    "url": "https://newgoldenoffice.com",
    "telephone": "+201227392074",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "26 عبد المنعم سند",
      "addressLocality": "الإبراهيمية، باب شرق",
      "addressRegion": "الإسكندرية",
      "addressCountry": "EG"
    }
  },
  "areaServed": { "@type": "Country", "name": "Egypt" }
});
---
<BaseLayout
  {...getSeoFor('/office-supplies/binding')}
  schemaJson={schemaJson}
  preloadImage="/images/office-supplies-hub.webp"
>
  <PageHero
    title="أدوات ربط ودباسة ولاصق في مصر"
    subtitle="نيو جولدن أوفيس — دباسات ومشابك وأشرطة لاصقة وغراء ومقص وأدوات ربط مكتبية في مصر. جميع الماركات بأسعار الجملة"
    heroImage="/images/office-supplies-hub.webp"
    heroIcon="fa-paperclip"
    breadcrumbs={[
      { label: 'الرئيسية', href: '/' },
      { label: 'مستلزمات مكتبية', href: '/office-supplies' },
      { label: 'أدوات ربط ودباسة' }
    ]}
  />

  <section class="section">
    <div class="container">
      <div class="service-detail-grid">

        <div class="service-content">
          <ContentIntro
            heading="شريط لاصق مكتبي مصر وأدوات الربط والتثبيت"
            text="الأدوات الصغيرة هي التي تُبقي المكتب منظماً وعمل الفريق سلساً. في نيو جولدن أوفيس، نوفر مجموعة متكاملة من أدوات الربط والتثبيت والقص التي لا يمكن لأي مكتب الاستغناء عنها — من الدباسة البسيطة إلى الدباسة الثقيلة المتطورة، ومن الشريط اللاصق الشفاف إلى أشرطة التغليف المتينة."
          />
          <p>
            نحرص على توفير منتجات من أفضل الماركات العالمية والمحلية كـ Bostitch وARCOS وScotch وPrimo بأسعار تنافسية تناسب شراء الجملة للمكاتب والشركات.
          </p>
          <p>
            نساعدك أيضًا في اختيار نوع التجليد المناسب لطبيعة مستنداتك، سواء كانت تقارير تحتاج فتحًا مسطحًا كاملاً أو عقودًا رسمية تحتاج مظهرًا أكثر ثباتًا واحترافية يليق بأهمية المستند.
          </p>
          <p>
            نوفر أيضًا خدمة التجليد الفوري داخل متجرنا لمن يحتاج تنفيذ عدد محدود من النسخ بسرعة، بدل الانتظار حتى موعد لاحق لإنجاز المستند.
          </p>
          <p>
            للشركات التي تحتاج تجليد كميات كبيرة بانتظام، نوفر أسعار جملة وجدول تسليم ثابت يوفر عليك متابعة كل طلب على حدة.
          </p>
          <p>
            نساعدك أيضًا في اختيار الأداة المناسبة للاستخدام المكتبي اليومي البسيط، من الدباسة الصغيرة إلى دباسة السلك الطويل للتقارير الأكثر سمكًا.
          </p>

          <h3>الدباسات (Staplers)</h3>
          <IconCardGrid columns={3} items={[
            { icon: 'fa-toolbox', title: 'دباسة مكتبية قياسية', text: 'للاستخدام اليومي العادي، تستخدم دبابيس مقاس 26/6 أو 24/6، مثالية لربط ما يصل إلى 20-30 ورقة' },
            { icon: 'fa-compress', title: 'دباسة يد صغيرة (Mini)', text: 'مدمجة وخفيفة الوزن للحمل في الحقيبة والاستخدام المتنقل' },
            { icon: 'fa-weight-hanging', title: 'دباسة ثقيلة (Heavy Duty)', text: 'لربط كميات ورق كبيرة تصل إلى 100 ورقة أو أكثر، مثالية لمراكز الطباعة والأرشفة' },
            { icon: 'fa-arrows-alt-h', title: 'دباسة طويلة الذراع', text: 'تصل إلى منتصف الصفحة لصنع الكتيبات والمطبوعات المجلدة' },
            { icon: 'fa-box', title: 'دباسة لإغلاق الكراتين', text: 'للتثبيت في بيئات المستودعات والشحن' },
            { icon: 'fa-eraser', title: 'محرمة الدباسة (Remover)', text: 'أداة مخصصة لإزالة الدبابيس بأمان دون تمزيق الأوراق' },
          ]} />

          <h3>مشابك الورق (Paper Clips)</h3>
          <IconCardGrid columns={3} items={[
            { icon: 'fa-paperclip', title: 'مشابك معدنية قياسية', text: 'متوفرة بأحجام صغيرة ومتوسطة وكبيرة وكبيرة جداً في أكياس بالجملة' },
            { icon: 'fa-palette', title: 'مشابك بلاستيكية ملونة', text: 'بألوان متعددة للتمييز والتصنيف اللوني للمستندات' },
            { icon: 'fa-grip-lines', title: 'كبسات (Binder Clips)', text: 'بأحجام متعددة لربط المستندات الثقيلة والملفات الكبيرة دون تمزيق' },
            { icon: 'fa-thumbtack', title: 'دبابيس رأس مستديرة (Push Pins)', text: 'للوحة الإعلانات والفلين بورد بألوان متنوعة' },
            { icon: 'fa-link', title: 'مشابك تعليق', text: 'للتثبيت على الحوائط والأسطح المختلفة' },
          ]} />

          <h3>أشرطة لاصقة وسكوتش</h3>
          <IconCardGrid columns={3} items={[
            { icon: 'fa-tape', title: 'شريط سكوتش شفاف (Scotch Tape)', text: 'الأكثر استخداماً في المكاتب، متوفر بعروض وأطوال متعددة مع حامل ومن دونه' },
            { icon: 'fa-pen', title: 'شريط قناع (Masking Tape)', text: 'شريط ورقي قابل للكتابة عليه وسهل التقشير، يُستخدم للتعليم والتصنيف المؤقت' },
            { icon: 'fa-clone', title: 'شريط لاصق مزدوج الوجه (Double-sided)', text: 'يثبت الأشياء من الجانبين دون أن يُرى، مثالي للعروض والديكور' },
            { icon: 'fa-box-open', title: 'شريط تغليف بني (Packaging Tape)', text: 'شريط بولي بروبيلين متين لإغلاق الكراتين ومستلزمات الشحن' },
            { icon: 'fa-image', title: 'شريط فوم لاصق', text: 'لتثبيت الإطارات والصور على الجدران بثبات محكم' },
          ]} />

          <h3>غراء ومقص</h3>
          <IconCardGrid columns={3} items={[
            { icon: 'fa-vial', title: 'صمغ ورق (Glue Stick)', text: 'سريع الجفاف ونظيف الاستخدام، مثالي للطلاب والأعمال الفنية واليدوية' },
            { icon: 'fa-tint', title: 'غراء سائل (Liquid Glue)', text: 'لاصق قوي للورق والكرتون والمواد المتنوعة' },
            { icon: 'fa-bolt', title: 'سوبر غراء (Super Glue)', text: 'لاصق سيانواكريلات فائق القوة للإصلاح السريع' },
            { icon: 'fa-cut', title: 'مقص مكتبي ستانلس', text: 'بشفرات ستانلس ستيل حادة ومقبض مريح للاستخدام اليومي المكثف' },
            { icon: 'fa-scissors', title: 'قاطع ورق (Cutter / Box Cutter)', text: 'بأنواع اليد والمكتبي لقطع الورق والكرتون بدقة' },
          ]} />

          <MidPageCTA formId="offBindingMidCta" />

          <h3>دباسة مكتبية</h3>
          <p>دباسات يدوية وكهربائية للمكاتب، متوفرة بمقاسات 24/6 و26/6.</p>

          <h3>مشابك ورق (الكليب)</h3>
          <p>مشابك معدنية بأحجام 19 / 25 / 32 / 41 مم لتجميع الأوراق.</p>

          <h3>شريط لاصق</h3>
          <p>شريط 3M وSelotape بعروض وطول متنوع، شفاف وملون وقوي التثبيت.</p>

          <h3>ماكينة تجليد</h3>
          <p>ماكينات تجليد بالسلك أو البلاستيك للتقارير والكتيبات والمستندات الرسمية.</p>

          <h3 style="color:var(--primary)">دليل اختيار الدباسة المناسبة لحجم عملك</h3>
          <p>اختيار الدباسة المناسبة يوفر عليك الإحباط اليومي من الانحشار أو عدم القدرة على ربط عدد الأوراق المطلوب. إليك دليلنا السريع:</p>
          <ComparisonGrid items={[
            { title: 'حتى 20 ورقة', text: 'دباسة مكتبية قياسية بمقاس دبابيس 26/6، مناسبة لـ 90% من الاستخدام اليومي في أي مكتب.' },
            { title: '20-50 ورقة', text: 'دباسة متوسطة الحجم بآلية ضغط معززة (غالباً تحمل علامة "Heavy Duty Light") تستخدم دبابيس 24/6 لتوفير قوة ربط أكبر دون الحاجة لدباسة ثقيلة كاملة.' },
            { title: '50-100 ورقة أو أكثر', text: 'دباسة ثقيلة احترافية (Heavy Duty) بمقاسات دبابيس أكبر مثل 23/8 أو 23/13، ضرورية في مراكز الطباعة وأقسام الأرشفة التي تربط تقارير وملفات ضخمة يومياً.' },
            { title: 'الكتيبات والمطبوعات المجلدة', text: 'دباسة طويلة الذراع (Long Reach / Saddle Stitch) تصل ذراعها إلى منتصف الصفحة لتثبيت الدبوس في منتصف الكتيب المطوي، وهي أداة أساسية لأي مطبعة أو قسم تسويق يُصدر كتيبات ونشرات دورية.' },
          ]} />

          <h3 style="color:var(--primary)">أدوات الربط حسب طبيعة نشاطك</h3>
          <IconCardGrid columns={2} items={[
            { icon: 'fa-balance-scale', title: 'المكاتب القانونية ومكاتب المحاماة', text: 'تحتاج إلى كبسات (Binder Clips) بأحجام كبيرة لربط الملفات القضائية الضخمة دون تمزيقها، بالإضافة إلى دباسات ثقيلة لتجميع المستندات متعددة الصفحات قبل الأرشفة.' },
            { icon: 'fa-school', title: 'المدارس ومراكز التصوير', text: 'الصمغ وأدوات القص المتكررة تحتاج لتجديد مستمر بسبب معدل الاستخدام اليومي المرتفع من الطلاب والمدرسين، ونوفر عبوات اقتصادية بالجملة لتغطية هذا الاستهلاك.' },
            { icon: 'fa-print', title: 'المطابع ودور النشر', text: 'ماكينات التجليد بالسلك أو الحلزوني ضرورة يومية لإنتاج التقارير والكتيبات النهائية، مع حاجة مستمرة لأسلاك التجليد وأغلفة بلاستيكية شفافة بمقاسات متعددة.' },
            { icon: 'fa-warehouse', title: 'المستودعات ومراكز الشحن', text: 'شريط التغليف البني بالجملة هو الأداة الأساسية اليومية، إلى جانب دباسات إغلاق الكراتين للتعبئة السريعة والآمنة قبل الشحن.' },
          ]} />

          <h3 style="color:var(--primary)">نصائح للعناية بأدوات الربط وإطالة عمرها</h3>
          <IconCardGrid columns={3} items={[
            { icon: 'fa-tools', text: 'نظّف الدباسة دورياً من بقايا الدبابيس المكسورة داخل الفتحة، فتراكمها هو السبب الأكثر شيوعاً لانحشار الدبابيس الجديدة.' },
            { icon: 'fa-tools', text: 'استخدم دائماً مقاس الدبابيس الموصى به لدباستك — استخدام مقاس أكبر من اللازم يُجهد آلية الضغط الداخلية ويقصر عمرها.' },
            { icon: 'fa-tools', text: 'أغلق غطاء صمغ الورق (Glue Stick) بإحكام بعد كل استخدام لمنع جفافه قبل الأوان، واحفظه بعيداً عن الحرارة المباشرة.' },
            { icon: 'fa-tools', text: 'نظّف شفرات المقص من بقايا الغراء أو الشريط اللاصق بقطعة قماش مبللة بالكحول للحفاظ على حدتها لفترة أطول.' },
            { icon: 'fa-tools', text: 'خزّن بكرات الشريط اللاصق في مكان بارد بعيد عن أشعة الشمس المباشرة، فالحرارة تُضعف قوة اللصق وتجعل الشريط يتمزق بسهولة عند الاستخدام.' },
          ]} />

        </div>

        <div class="service-sidebar">
          <div class="sidebar-card">
            <h4>المستلزمات المكتبية</h4>
            <div class="sidebar-services">
              <a href="/office-supplies/a4-paper" class="sidebar-service-link"><span>ورق A4 وطباعة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/thermal" class="sidebar-service-link"><span>ورق حراري وكاشير</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/pens" class="sidebar-service-link"><span>أقلام وأدوات كتابة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/notebooks" class="sidebar-service-link"><span>دفاتر ومفكرات</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/files" class="sidebar-service-link"><span>ملفات وأرشفة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/stamps" class="sidebar-service-link"><span>أختام ومستلزمات</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/envelopes" class="sidebar-service-link"><span>أظرف وتغليف</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/whiteboards" class="sidebar-service-link"><span>وايت بورد وفلين بورد</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/binding" class="sidebar-service-link active"><span>أدوات ربط ودباسة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/sticky-notes" class="sidebar-service-link"><span>بوست إت وورق لاصق</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/batteries-usb" class="sidebar-service-link"><span>بطاريات وUSB</span><i class="fas fa-angle-left"></i></a>
            </div>
          </div>
          <div class="sidebar-card">
            <h4>تواصل معنا</h4>
            <div class="contact-info">
              <div class="contact-info-item"><i class="fas fa-phone"></i><span>01227392074</span></div>
              <div class="contact-info-item"><i class="fas fa-clock"></i><span>السبت - الخميس: 9ص - 6م</span></div>
            </div>
            <a href="/contact" class="btn btn-primary btn-sm" style="width:100%;text-align:center;margin-top:16px">اتصل بنا</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="section section-bg">
    <div class="container">
      <div class="section-header">
        <h2>احصل على أدواتك المكتبية في 3 خطوات</h2>
        <div class="divider"></div>
      </div>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">1</div>
          <h4>اختر ما تحتاجه</h4>
          <p>تصفح قائمتنا الشاملة من أدوات الدباسة والمشابك والأشرطة اللاصقة والغراء والمقص، واختر الماركات والأنواع المناسبة لاحتياجات مكتبك.</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <h4>أخبرنا بالكمية</h4>
          <p>حدد الكمية المطلوبة من كل منتج وسنرسل لك عرض سعر مفصل بأسعار الجملة. كلما زادت الكمية كلما انخفض سعر الوحدة.</p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <h4>استلم طلبك</h4>
          <p>نجهز طلبك ونوصله إليك بسرعة. يمكنك أيضاً الاستلام من متجرنا في الإسكندرية أو الاستفادة من خدمة التوصيل لجميع أنحاء مصر.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section" style="padding:60px 0;background:#f8f9fa">
    <div class="container">
      <h2 style="font-size:1.8rem;font-weight:700;color:#1a1a2e;margin-bottom:24px">أشهر الماركات المتوفرة</h2>
      <p style="font-size:1.05rem;line-height:1.9;color:#444;margin-bottom:20px">نوفر أدوات الربط المكتبية من أفضل الماركات العالمية والمحلية:</p>
      <ComparisonGrid items={[
        { title: 'Scotch / 3M', text: 'أشرطة لاصقة شفافة وسكوتش — الأعلى جودة عالمياً' },
        { title: 'Bostitch', text: 'دباسات من الدرجة الأولى للاستخدام المكثف' },
        { title: 'Primo / Deli', text: 'أدوات مكتبية متكاملة بسعر اقتصادي وجودة مقبولة' },
      ]} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>أسئلة شائعة عن أدوات الربط المكتبية</h2>
        <div class="divider"></div>
      </div>
      <div class="faq-list">

        <div class="faq-item">
          <div class="faq-question">ما أنواع الدبابيس المتوافقة مع دباستي؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">أكثر الدباسات المكتبية تستخدم دبابيس مقاس 26/6 (الأكثر شيوعاً) أو 24/6. الدباسات الثقيلة تستخدم مقاسات أكبر مثل 23/8 أو 23/13. تحقق من مواصفات دباستك أو انظر إلى علبة الدبابيس القديمة. في حال الشك، اتصل بنا وأخبرنا بماركة وموديل دباستك وسنوجهك للمقاس الصحيح.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">ما الفرق بين مشابك الورق العادية والكبسات (Binder Clips)؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">مشابك الورق المعدنية العادية: خفيفة ومناسبة لربط عدد صغير من الأوراق (حتى 15 ورقة)، لا تترك أثراً على الورق تقريباً. الكبسات (Binder Clips): أقوى وأكثر قدرة لربط كميات أوراق أكبر (حتى 100 ورقة حسب الحجم)، تترك أثراً بسيطاً عند الإزالة. للملفات الثقيلة والتقارير الكبيرة — الكبسات هي الاختيار الأفضل.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">أي نوع شريط لاصق أنسب للاستخدام المكتبي؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">للاستخدام اليومي العام في المكاتب: شريط سكوتش شفاف (Scotch Tape) — يمكن الكتابة عليه وهو غير مرئي تقريباً على الورق. للتعليق المؤقت والتصنيف: شريط القناع (Masking Tape) — يُقشر بسهولة دون أثر. لتثبيت الأشياء بشكل دائم: الشريط اللاصق مزدوج الوجه. لإغلاق الكراتين والشحن: شريط التغليف البني.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">هل تتوفر أدوات الربط بالجملة للشركات؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">نعم، نوفر جميع أدوات الربط المكتبية بكميات الجملة للشركات والمؤسسات بأسعار مخفضة. يمكن الطلب بأي كمية وسنقدم لك عرض سعر خاص بالجملة. نوفر أيضاً خدمة التوريد الدوري المنتظم للشركات التي تحتاج إلى إعادة تخزين المستلزمات المكتبية بشكل متكرر.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">ما المقص المناسب للاستخدام المكتبي المكثف؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">للاستخدام المكتبي العادي: مقص ستانلس ستيل بطول 21-25 سم مع مقبض مريح من البلاستيك أو المطاط. للاستخدام المكثف وقطع كميات كبيرة: مقص عالي الجودة بنصل تيتانيوم أو مطلي بالتيفلون لمنع تراكم الغراء. للعمل اليدوي الدقيق: مقص صغير بنصل حاد. تواصل معنا وسنرشدك للخيار المناسب لاحتياجك.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">لماذا تنحشر الدبابيس داخل الدباسة بشكل متكرر؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">أشهر أسباب الانحشار: تراكم بقايا دبابيس مكسورة داخل مسار الدباسة، استخدام مقاس دبابيس غير مطابق للموديل، أو محاولة ربط عدد أوراق يفوق قدرة الدباسة. الحل: افتح الدباسة ونظّف المسار الداخلي جيداً، تأكد من استخدام المقاس الصحيح المدوّن على الدباسة نفسها، وإذا كنت تربط كميات كبيرة بانتظام فكّر في الترقية لدباسة متوسطة أو ثقيلة بدلاً من إجهاد الدباسة القياسية.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">هل توفرون ماكينات تجليد للمكاتب والمطابع الصغيرة؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">نعم، نوفر ماكينات تجليد بالسلك الحلزوني والتجليد البلاستيكي (Comb Binding) المناسبة للمكاتب ومراكز التصوير والمطابع الصغيرة والمتوسطة، بالإضافة إلى مستلزماتها المستهلكة من أسلاك تجليد وأغلفة أمامية شفافة وأغلفة خلفية ملونة بمقاسات متعددة. اتصل بنا لمعرفة الموديلات المتاحة والأسعار.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">كيف أختار حجم شريط التغليف المناسب لصندوق الشحن؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">للكراتين الصغيرة والمتوسطة: شريط بعرض 4.8 سم يكفي لإغلاق آمن. للكراتين الكبيرة أو الثقيلة التي تُشحن لمسافات طويلة: يُفضل شريط أعرض (5-7.5 سم) أو تطبيق طبقتين متقاطعتين لضمان عدم انفتاح الصندوق أثناء النقل. نوفر شريط التغليف بالجملة بعرضات وأطوال متعددة تناسب مراكز الشحن والمستودعات.</div>
          </div>
        </div>

      </div>
    </div>
  </section>

