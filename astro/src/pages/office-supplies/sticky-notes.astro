---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';
import ContentIntro from '../../components/ContentIntro.astro';
import IconCardGrid from '../../components/IconCardGrid.astro';
import { getSeoFor } from '../../lib/siteSeo';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "بوست إت وورق لاصق وتسميات",
  "description": "بوست إت وأوراق لاصقة وتسميات للمكاتب في مصر — ألوان متعددة وأحجام مختلفة بالجملة.",
  "serviceType": "أدوات مكتبية",
  "provider": {
    "@type": "LocalBusiness",
    "name": "نيو جولدن أوفيس",
    "url": "https://newgoldenoffice.com",
    "telephone": "+201227392074",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "26 عبد المنعم سند",
      "addressLocality": "الإبراهيمية، باب شرق",
      "addressRegion": "الإسكندرية",
      "addressCountry": "EG"
    }
  },
  "areaServed": { "@type": "Country", "name": "Egypt" }
});
---
<BaseLayout
  {...getSeoFor('/office-supplies/sticky-notes')}
  schemaJson={schemaJson}
  preloadImage="/images/office-supplies-hub.webp"
>
  <PageHero
    title="بوست إت وورق لاصق وتسميات"
    subtitle="نيو جولدن أوفيس — بوست إت وأوراق لاصقة وتسميات وملصقات في مصر. أحجام وألوان متعددة بالجملة للمكاتب والشركات"
    heroImage="/images/office-supplies-hub.webp"
    heroIcon="fa-sticky-note"
    breadcrumbs={[
      { label: 'الرئيسية', href: '/' },
      { label: 'مستلزمات مكتبية', href: '/office-supplies' },
      { label: 'بوست إت وورق لاصق' }
    ]}
  />

  <section class="section">
    <div class="container">
      <div class="service-detail-grid">

        <div class="service-content">
          <ContentIntro
            heading="بوست إت وورق لاصق مصر للتنظيم المكتبي"
            text="من أكثر المستلزمات المكتبية عملية وانتشاراً، تقدم نيو جولدن أوفيس تشكيلة واسعة من أوراق الملاحظات اللاصقة (Post-it / Sticky Notes) والتسميات اللاصقة والملصقات المتنوعة التي تجعل التنظيم المكتبي أسهل وأجمل. نوفر جميع الأحجام والألوان بأسعار الجملة للأفراد والشركات."
          />
          <p>
            سواء كنت موظفًا فرديًا يحتاج علبة واحدة لمكتبه، أو مسؤول مشتريات في شركة كبرى يطلب مئات العلب لكل الأقسام، نتعامل مع طلبك بنفس مستوى الجودة والاهتمام بالتفاصيل، مع أسعار جملة تتحسن كلما زادت الكمية المطلوبة في الطلب الواحد.
          </p>
          <p>
            نوفر أيضًا خدمة التوريد المنتظم للشركات التي تستهلك كميات كبيرة شهريًا، بجدول تسليم ثابت يضمن عدم نفاد المخزون في أي قسم من أقسام شركتك.
          </p>
          <p>
            نساعد أيضًا فرق العمل الجديدة في تبني نظام تنظيم بسيط باستخدام الألوان المختلفة، ونرشح لهم توليفة الألوان الأنسب حسب طبيعة عملهم اليومي.
          </p>
          <p>
            نوفر أيضًا عروضًا خاصة على الكميات الكبيرة الموسمية، مثل بداية العام الدراسي أو الحملات التسويقية التي تحتاج كميات إضافية من الملصقات والتسميات.
          </p>
          <p>
            نضمن دائمًا وضوح السعر منذ أول استفسار، فلا تفاجأ بأي تكلفة إضافية غير متوقعة عند استلام طلبك النهائي.
          </p>
          <p>
            نحرص أيضًا على توفير بدائل صديقة للبيئة لمن يهتم بمعايير الاستدامة في مكتبه، وأوراق ذات جودة لصق أعلى للاستخدامات الحساسة كتعليق الملاحظات على شاشات العرض أو الأجهزة الإلكترونية دون ترك أي أثر لاصق دائم.
          </p>
          <p>
            سواء كنت تحتاج علبة واحدة لمكتبك الشخصي أو مئات العلب لتوزيعها على كل أقسام شركتك، نتعامل مع الطلب بنفس الاهتمام بالتفاصيل ونفس سرعة التسليم المعتادة.
          </p>
          <p>
            أوراق الملاحظات اللاصقة ليست مجرد أداة للتذكير — إنها نظام تنظيم متكامل حين تُستخدم بشكل صحيح. تعتمد عليها المكاتب الاحترافية في إدارة المهام ومتابعة المشاريع والتواصل السريع بين أعضاء الفريق.
          </p>
          <p>
            منذ عام 1999 ونحن نورد هذه المنتجات لمئات المكاتب والشركات في الإسكندرية ومصر، ولاحظنا أن الطلب عليها يزداد باستمرار مع انتشار ثقافة إدارة المهام البصرية في بيئات العمل الحديثة، حيث أصبحت لوحات المتابعة المغطاة بالبوست إت الملون منظرًا مألوفًا في أغلب المكاتب الإدارية وفرق التطوير.
          </p>

          <h3>أنواع البوست إت والأوراق اللاصقة</h3>
          <IconCardGrid columns={4} items={[
            { icon: 'fa-sticky-note', title: 'بوست إت قياسي 76×76 مم', text: 'الحجم الأكثر استخداماً، متوفر بحزم ألوان متعددة (أصفر، أخضر، وردي، أزرق، بنفسجي) وبحزم أحادية اللون' },
            { icon: 'fa-compress', title: 'بوست إت صغير 38×51 مم', text: 'مناسب للملاحظات القصيرة وتعليق التنبيهات على الملفات والمستندات' },
            { icon: 'fa-expand', title: 'بوست إت كبير 102×152 مم', text: 'لكتابة ملاحظات مطولة وقوائم المهام والتعليمات المفصلة' },
            { icon: 'fa-align-left', title: 'بوست إت خطوط مفهرسة (Lined)', text: 'أوراق لاصقة بخطوط لضمان انتظام الكتابة وتسهيل القراءة' },
            { icon: 'fa-desktop', title: 'بوست إت لعروض الشاشة', text: 'مصمم خصيصاً للصق على شاشات الكمبيوتر والشاشات الكبيرة في غرف الاجتماعات' },
            { icon: 'fa-box', title: 'بلوك بوست إت للمكاتب الكبيرة', text: 'مع حامل مكتبي أنيق لتوفير الورق دائماً في مكانه' },
            { icon: 'fa-palette', title: 'بوست إت ملون متدرج (Gradient)', text: 'للتمييز السهل بين المهام والأولويات' },
          ]} />

          <h3>فلاجات وعلامات التبويب (Index Flags)</h3>
          <IconCardGrid columns={4} items={[
            { icon: 'fa-bookmark', title: 'علامات تبويب شفافة', text: 'علامات صغيرة شبه شفافة للإشارة إلى صفحات محددة في الكتب والملفات دون إخفاء النص' },
            { icon: 'fa-flag', title: 'فلاجات ورقية ملونة', text: 'علامات ورقية بألوان زاهية للإشارة إلى أقسام مختلفة في وثيقة واحدة' },
            { icon: 'fa-tag', title: 'تابات كتب قابلة للكتابة', text: 'علامات تبويب يمكن الكتابة عليها لتحديد محتوى الصفحة أو القسم' },
            { icon: 'fa-hashtag', title: 'تابات فهرس هاشمي', text: 'للملفات والكتالوجات الكبيرة لتقسيمها وتنظيمها بشكل احترافي' },
            { icon: 'fa-signature', title: 'علامات "للتوقيع هنا"', text: 'علامات مطبوع عليها "وقّع هنا" بالأحمر لتسريع عملية الحصول على التوقيعات على العقود والوثائق' },
            { icon: 'fa-tags', title: 'تاجات أسعار', text: 'للمحلات التجارية والسوبرماركت ومحلات الملابس' },
            { icon: 'fa-clone', title: 'ملصقات شفافة', text: 'للأسطح الزجاجية ومواد العرض' },
          ]} />

          <h3>تسميات لاصقة (Labels)</h3>
          <IconCardGrid columns={3} items={[
            { icon: 'fa-print', title: 'ورق تسميات A4', text: 'صفحات A4 مقسمة إلى خلايا تسمية متعددة، تطبع مباشرة من الطابعة الليزرية أو الإنكجت لتسمية الملفات والمنتجات' },
            { icon: 'fa-circle', title: 'ملصقات دائرية ومربعة ملونة', text: 'للتصنيف اللوني السريع والإشارة إلى حالة المستند وتمييز المنتجات' },
            { icon: 'fa-book', title: 'تسميات رقبة الملف', text: 'شرائط تسمية خاصة لظهر ملفات الحلقات لتعريف محتوى كل ملف' },
            { icon: 'fa-barcode', title: 'ملصقات باركود وقيمة', text: 'لأصحاب المحلات والمخازن لتسعير المنتجات وإضافة الباركود' },
            { icon: 'fa-shipping-fast', title: 'ملصقات عناوين بريدية', text: 'للشحن والتوصيل والمراسلات الرسمية' },
            { icon: 'fa-compact-disc', title: 'ملصقات CD/DVD', text: 'لتصنيف الأقراص والأرشيف الرقمي' },
          ]} />

          <MidPageCTA formId="offStickyNotesMidCta" />

          <h3>ماكينات التسمية</h3>
          <p>
            لمن يحتاج إلى تسمية احترافية سريعة ومرتبة، نوفر ماكينات التسمية (Label Makers) من ماركة Brother وDymo وغيرها. هذه الأجهزة الصغيرة تطبع ملصقات نصية أو تحتوي على صور ورموز مباشرة من الجهاز بجودة عالية ووضوح ممتاز. مثالية لتسمية أسلاك الكمبيوتر والملفات والأرفف وأدراج المكتب.
          </p>
          <p>
            في المخازن والمصانع، تُستخدم ماكينات التسمية لتمييز الرفوف والصناديق بأكواد وأسماء واضحة تسرّع عملية الجرد والبحث عن المنتجات، بدلًا من الاعتماد على الذاكرة أو الكتابة اليدوية غير المنظمة. في المكاتب الإدارية، تساعد على تنظيم الأرشيف الورقي والملفات الإلكترونية المطبوعة بشكل يسهل الرجوع إليه لاحقًا من أي موظف جديد ينضم للفريق.
          </p>

          <h3>بوست إت مخصص بشعار شركتك</h3>
          <p>
            نوفر أوراق ملاحظات لاصقة مطبوعة بشعار شركتك واسمها وبياناتك — فكرة هدية مؤسسية رائعة ومفيدة. يمكن طباعة الشعار على الجزء العلوي من كل ورقة بلون أو بألوان متعددة. يبدأ الحد الأدنى من 100 حزمة. تواصل معنا للحصول على عينة وعرض سعر.
          </p>

        </div>

        <div class="service-sidebar">
          <div class="sidebar-card">
            <h4>المستلزمات المكتبية</h4>
            <div class="sidebar-services">
              <a href="/office-supplies/a4-paper" class="sidebar-service-link"><span>ورق A4 وطباعة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/thermal" class="sidebar-service-link"><span>ورق حراري وكاشير</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/pens" class="sidebar-service-link"><span>أقلام وأدوات كتابة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/notebooks" class="sidebar-service-link"><span>دفاتر ومفكرات</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/files" class="sidebar-service-link"><span>ملفات وأرشفة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/stamps" class="sidebar-service-link"><span>أختام ومستلزمات</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/envelopes" class="sidebar-service-link"><span>أظرف وتغليف</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/whiteboards" class="sidebar-service-link"><span>وايت بورد وفلين بورد</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/binding" class="sidebar-service-link"><span>أدوات ربط ودباسة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/sticky-notes" class="sidebar-service-link active"><span>بوست إت وورق لاصق</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/batteries-usb" class="sidebar-service-link"><span>بطاريات وUSB</span><i class="fas fa-angle-left"></i></a>
            </div>
          </div>
          <div class="sidebar-card">
            <h4>تواصل معنا</h4>
            <div class="contact-info">
              <div class="contact-info-item"><i class="fas fa-phone"></i><span>01227392074</span></div>
              <div class="contact-info-item"><i class="fas fa-clock"></i><span>السبت - الخميس: 9ص - 6م</span></div>
            </div>
            <a href="/contact" class="btn btn-primary btn-sm" style="width:100%;text-align:center;margin-top:16px">اتصل بنا</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="section section-bg">
    <div class="container">
      <div class="section-header">
        <h2>احصل على بوست إتك في 3 خطوات بسيطة</h2>
        <div class="divider"></div>
      </div>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">1</div>
          <h4>اختر الحجم واللون</h4>
          <p>تصفح تشكيلتنا وحدد الحجم والألوان المناسبة لاحتياج مكتبك. إذا أردت بوست إت مطبوع بشعار شركتك، أرسل لنا شعارك.</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <h4>حدد الكمية</h4>
          <p>أخبرنا بالكمية المطلوبة وسنرسل لك عرض سعر بأسعار الجملة. الطلبات الكبيرة تحصل على خصومات إضافية.</p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <h4>استلم بسرعة</h4>
          <p>نجهز طلبك ونوصله إليك سواء في الإسكندرية أو أي محافظة مصرية أخرى — توصيل سريع وموثوق مع ضمان سلامة المنتجات.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section" style="padding:60px 0;background:#f8f9fa">
    <div class="container">
      <h2 style="font-size:1.8rem;font-weight:700;color:#1a1a2e;margin-bottom:24px">بوست إت مطبوع بشعار شركتك — هدية مؤسسية مميزة</h2>
      <p style="font-size:1.05rem;line-height:1.9;color:#444;margin-bottom:20px">نيو جولدن أوفيس توفر بوست إت مطبوع بشعار وبيانات شركتك للشركات والمؤسسات في مصر:</p>
      <IconCardGrid columns={3} items={[
        { icon: 'fa-building', title: 'للتوزيع الداخلي', text: 'بوست إت يحمل شعار شركتك لاستخدام موظفيك اليومي — يعزز هوية الشركة' },
        { icon: 'fa-gift', title: 'هدية ترويجية', text: 'وزّع بوست إت شركتك على عملائك كهدية مفيدة تبقى أمامهم يومياً' },
        { icon: 'fa-calendar-alt', title: 'هدية المؤتمرات', text: 'مثالي كهدية في المعارض والمؤتمرات لتقديم علامتك التجارية' },
      ]} />
      <p style="font-size:1rem;color:#555;margin-top:20px">الحد الأدنى للطلب 100 حزمة — تواصل معنا للحصول على عينة مجانية وعرض سعر.</p>
      <p style="font-size:1rem;color:#555;margin-top:12px">نتعامل مع الطباعة بجودة عالية تضمن وضوح الشعار وثبات الألوان حتى بعد فترة طويلة من التعرض للضوء، ونوفر خيار اختيار عدد ألوان الطباعة حسب ميزانيتك — من لون واحد بسيط إلى طباعة متعددة الألوان لشعارات أكثر تفصيلًا.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>أسئلة شائعة عن البوست إت والأوراق اللاصقة</h2>
        <div class="divider"></div>
      </div>
      <div class="faq-list">

        <div class="faq-item">
          <div class="faq-question">هل البوست إت يترك أثراً على الجدران والأسطح؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">البوست إت الأصلي من 3M مصمم بغراء خاص قابل لإعادة الاستخدام لا يترك أثراً على معظم الأسطح عند الإزالة بحذر. تجنب تركه لفترات طويلة جداً (أكثر من بضعة أسابيع) على نفس المكان، خاصة في البيئات ذات الحرارة المرتفعة. للجدران المطلية الحديثة: اختبر على منطقة صغيرة أولاً للتأكد.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">ما الفرق بين البوست إت العادي وعلامات التبويب (Flags)؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">البوست إت العادي: ورقة لاصقة كاملة يمكن كتابة ملاحظات عليها، يُصلح لوضعه على أي سطح كمكرم أو جهاز كمبيوتر أو وثيقة. علامات التبويب (Flags): أصغر حجماً وأرق، تُستخدم لوضع إشارة على صفحة معينة في كتاب أو ملف لتسهيل العثور عليها لاحقاً، بعضها شبه شفاف لا يحجب النص.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">هل يمكن طباعة التسميات اللاصقة على طابعتي العادية؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">نعم، ورق التسميات A4 الذي نوفره مصمم للطباعة مباشرة على الطابعات الليزرية والإنكجت العادية. فقط تأكد من اختيار نوع الورق المناسب لطابعتك (ليزر أو إنكجت). نوفر ورق تسميات بعروض خلايا متعددة تناسب جميع الاستخدامات — من تسمية الملفات إلى بطاقات الأسعار.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">ما ماكينة التسمية الأنسب للمكتب؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">للمكتب الصغير أو الاستخدام الشخصي: ماكينة Brother PT-H110 أو ما يشابهها — صغيرة الحجم وسهلة الاستخدام بأشرطة TZe المتوفرة. للمكتب الكبير والاستخدام الكثيف: ماكينة تدعم الطباعة من الكمبيوتر مثل Brother QL-800 التي تطبع تسميات عالية الجودة بسرعة كبيرة. تواصل معنا لمعرفة الأفضل لاحتياجك.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">هل البوست إت المطبوع بشعار الشركة مختلف عن العادي في اللصق؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
