---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import PageHero from '../../components/PageHero.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';
import ContentIntro from '../../components/ContentIntro.astro';
import IconCardGrid from '../../components/IconCardGrid.astro';
import { getSeoFor } from '../../lib/siteSeo';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "أظرف بريدية وتغليف",
  "description": "أظرف بريدية وتغليف في مصر — مقاسات C4 وC5 وDL وأظرف مخصصة بشعار الشركة.",
  "serviceType": "أظرف بريدية",
  "provider": {
    "@type": "LocalBusiness",
    "name": "نيو جولدن أوفيس",
    "url": "https://newgoldenoffice.com",
    "telephone": "+201227392074",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "26 عبد المنعم سند",
      "addressLocality": "الإبراهيمية، باب شرق",
      "addressRegion": "الإسكندرية",
      "addressCountry": "EG"
    }
  },
  "areaServed": { "@type": "Country", "name": "Egypt" }
});
---
<BaseLayout
  {...getSeoFor('/office-supplies/envelopes')}
  schemaJson={schemaJson}
  preloadImage="/images/office-supplies-hub.webp"
>
  <PageHero
    title="أظرف بريدية وكراتين تغليف في مصر"
    subtitle="نيو جولدن أوفيس — مورد الأظرف ومستلزمات التغليف في مصر. أظرف ورقية وكرتونية ومبطنة بالجملة للشركات والأفراد"
    heroImage="/images/office-supplies-hub.webp"
    heroIcon="fa-envelope"
    breadcrumbs={[
      { label: 'الرئيسية', href: '/' },
      { label: 'مستلزمات مكتبية', href: '/office-supplies' },
      { label: 'أظرف وتغليف' }
    ]}
  />

  <section class="section">
    <div class="container">
      <div class="service-detail-grid">

        <div class="service-content">
          <ContentIntro
            heading="تشكيلة الأظرف ومستلزمات التغليف"
            text="في نيو جولدن أوفيس، نؤمن بأن التغليف الجيد لا يحمي المحتوى فحسب، بل يعكس أيضاً صورة احترافية عن مؤسستك وعلامتك التجارية. لذلك نوفر أوسع تشكيلة من الأظرف ومستلزمات التغليف في الإسكندرية ومصر — تناسب جميع الأغراض من المراسلات الرسمية إلى الشحن والتجارة الإلكترونية."
          />
          <p>
            سواء كنت تحتاج إلى ظرف واحد لمراسلة رسمية، أو آلاف الأظرف لمراسلات دورية لشركتك، أو مستلزمات تغليف لمشروع شحن متكامل — لدينا ما تحتاجه بأسعار الجملة التنافسية وجودة موثوقة.
          </p>
          <p>
            نساعد أيضًا الشركات التي تحتاج توريدًا دوريًا من الأظرف لعملياتها اليومية (فواتير، مراسلات، عقود) بعقد شهري ثابت يضمن عدم نفاد المخزون في أي وقت، مع مندوب حساب يراجع الكميات معك دوريًا.
          </p>
          <p>
            نوفر أيضًا خدمة الطباعة المخصصة بشعار شركتك على الأظرف، وهي إضافة بسيطة التكلفة تعطي انطباعًا احترافيًا فور استلام أي جهة لمراسلاتك المطبوعة.
          </p>
          <p>
            نساعدك في اختيار الوزن والخامة المناسبة حسب أهمية المستند المرسل، من مراسلات يومية بسيطة إلى عقود ومستندات رسمية تستحق تغليفًا أكثر ثباتًا واحترافية.
          </p>
          <p>
            نوفر أيضًا للشركات التي ترسل طرودًا أو عينات منتجات أظرف مبطنة تحمي المحتوى من الصدمات أثناء النقل، بمقاسات متعددة تناسب حجم المحتوى المرسل.
          </p>
          <p>
            نساعدك أيضًا في حساب الكمية السنوية التقريبية بناءً على معدل مراسلاتك الحالي، لضمان تعاقد بالكمية الصحيحة دون نقص أو فائض غير ضروري.
          </p>
          <p>
            نوضح دائمًا تفاصيل السعر والمواصفات بشكل كامل قبل أي تعاقد، حتى تتخذ قرارك بثقة تامة ودون أي غموض.
          </p>

          <h3>أظرف ورقية الإسكندرية — الأنواع المتاحة</h3>
          <IconCardGrid columns={4} items={[
            { icon: 'fa-envelope', title: 'أظرف A4 (C4)', text: 'مقاس 229×324 مم لاستيعاب المستندات الكاملة دون طي، مثالية للعقود والتقارير والمراسلات الرسمية' },
            { icon: 'fa-envelope-open', title: 'أظرف C5 للأوراق A5', text: 'مقاس 162×229 مم للأوراق المطوية مرة واحدة، تُستخدم كثيراً في الفواتير والإشعارات' },
            { icon: 'fa-mail-bulk', title: 'أظرف DL للخطابات الرسمية', text: 'المقاس القياسي 110×220 مم الأكثر استخداماً في المراسلات الدولية والمحلية' },
            { icon: 'fa-window-maximize', title: 'أظرف نافذة شفافة للفواتير', text: 'بنافذة بلاستيكية شفافة تُظهر عنوان المستلم دون الحاجة للكتابة الخارجية' },
            { icon: 'fa-box', title: 'أظرف مبطنة بالفقاعات (Bubble Mailers)', text: 'أظرف ذاتية اللصق مبطنة من الداخل بطبقة فقاعات هواء لحماية المحتوى من الكسر والخدش' },
            { icon: 'fa-envelope-open-text', title: 'أظرف كرافت بنية اللون', text: 'أظرف ورق كرافت متينة ذات مظهر طبيعي أنيق، متوفرة بأحجام متعددة' },
            { icon: 'fa-tint-slash', title: 'أظرف بلاستيكية مقاومة للماء', text: 'أظرف بولي إيثيلين شفافة أو ملونة مقاومة للرطوبة والماء' },
          ]} />

          <h3>مستلزمات التغليف والشحن</h3>
          <p>نوفر بجانب الأظرف كافة مستلزمات التغليف والشحن التي تحتاجها لتأمين منتجاتك خلال النقل والتوصيل:</p>
          <IconCardGrid columns={3} items={[
            { icon: 'fa-box-open', title: 'كراتين شحن بأحجام متعددة', text: 'كراتين مقوى ذات جودة عالية بأحجام قياسية ومخصصة' },
            { icon: 'fa-circle', title: 'فقاعات تغليف (Bubble Wrap)', text: 'رول بلاستيك فقاعي بأحجام متعددة لتغليف المنتجات الهشة والإلكترونيات' },
            { icon: 'fa-tape', title: 'شريط لاصق تغليف', text: 'شرائط لاصقة شفافة وبنية بعرضات مختلفة، متوفر بكميات الجملة للشركات' },
            { icon: 'fa-layer-group', title: 'فوم حماية', text: 'صفائح فوم بسماكات متعددة لحشو الكراتين وحماية المنتجات من الاهتزاز والصدمات' },
            { icon: 'fa-tshirt', title: 'أكياس تغليف للملابس', text: 'أكياس بولي شفافة بمختلف القياسات لتغليف الملابس والمنسوجات' },
            { icon: 'fa-exclamation-triangle', title: 'لافتات "هش - برفق"', text: 'ملصقات تحذيرية ملونة لتنبيه عمال الشحن والتوصيل' },
          ]} />

          <MidPageCTA formId="offEnvelopesMidCta" />

          <h3>حلول التغليف للتجارة الإلكترونية</h3>
          <p>
            مع النمو السريع لسوق التجارة الإلكترونية في مصر، أصبح التغليف الاحترافي ركيزة أساسية لتجربة العميل. نوفر للمتاجر الإلكترونية باقات متكاملة من مستلزمات التغليف تجمع بين الحماية والأناقة والاقتصادية.
          </p>
          <p>
            نقدم الأظرف المبطنة والكراتين وأشرطة اللصق وأكياس التوصيل بأسعار الجملة مع خصومات متدرجة. كما نوفر خدمة الطباعة على الأظرف والأكياس لتعزيز هوية علامتك التجارية. اتصل بنا على <strong>01227392074</strong> للحصول على عرض سعر مخصص.
          </p>

          <h3 style="color:var(--primary)">دليل اختيار الظرف المناسب حسب الغرض</h3>
          <p>اختيار الظرف الخاطئ قد يعطي انطباعاً غير احترافي أو يعرّض المحتوى للتلف أثناء النقل. إليك دليلنا لمطابقة الظرف بالاستخدام:</p>
          <IconCardGrid columns={3} items={[
            { icon: 'fa-file-contract', title: 'العقود والمستندات القانونية', text: 'ظرف C4 دون طي مع بطانة داخلية معتمة (Security Envelope) تمنع رؤية المحتوى من الخارج، لحماية سرية المعلومات الحساسة كالعقود والبيانات المالية.' },
            { icon: 'fa-file-invoice-dollar', title: 'الفواتير والإشعارات الدورية', text: 'ظرف بنافذة شفافة يعرض عنوان المستلم مباشرة من الفاتورة الداخلية، مما يوفر وقت الطباعة والكتابة اليدوية على الظرف ويقلل من أخطاء العناوين.' },
            { icon: 'fa-envelope-open-text', title: 'الدعوات والمراسلات الرسمية الأنيقة', text: 'أظرف كرافت أو ورق عالي الجودة بألوان فاتحة، أحياناً مع بطانة داخلية ملونة، لإعطاء انطباع أول راقٍ يليق بمناسبات الشركة أو دعوات كبار العملاء.' },
            { icon: 'fa-shopping-cart', title: 'شحنات التجارة الإلكترونية الصغيرة', text: 'أظرف مبطنة بالفقاعات ذاتية اللصق، خفيفة الوزن لتقليل تكلفة الشحن مع حماية كافية للمنتجات الصغيرة كالإكسسوارات والهواتف وقطع الغيار الدقيقة.' },
            { icon: 'fa-cloud-rain', title: 'المستندات المعرضة للرطوبة أو النقل الخارجي', text: 'أظرف بلاستيكية مقاومة للماء من مادة البولي إيثيلين، مثالية للمستندات التي تُنقل في ظروف جوية غير مضمونة أو عبر مندوبي التوصيل.' },
          ]} />

          <h3 style="color:var(--primary)">أظرف ومستلزمات تغليف حسب نوع نشاطك</h3>
          <IconCardGrid columns={2} items={[
            { icon: 'fa-university', title: 'البنوك وشركات التأمين', text: 'تحتاج بشكل أساسي إلى أظرف أمان بنافذة شفافة للفواتير والكشوف الشهرية، مع بطانة داخلية معتمة لحماية البيانات المالية الحساسة من الأعين الفضولية.' },
            { icon: 'fa-store', title: 'متاجر التجارة الإلكترونية', text: 'تعتمد على مزيج من الأظرف المبطنة للمنتجات الصغيرة والكراتين للمنتجات الأكبر، مع أهمية استخدام لافتات "هش" الملونة للمنتجات القابلة للكسر لتنبيه عمال التوصيل.' },
            { icon: 'fa-building', title: 'الشركات التي تراسل عملاءها رسمياً بشكل متكرر', text: 'تستفيد من الأظرف المطبوعة بشعار الشركة وبياناتها الكاملة، مما يمنح كل مراسلة صادرة مظهراً احترافياً موحداً يعزز هوية العلامة التجارية.' },
            { icon: 'fa-landmark', title: 'الجهات الحكومية والمؤسسات التعليمية', text: 'تحتاج لأظرف A4 (C4) كبيرة لحفظ الشهادات والمستندات الرسمية دون طي، مع الحفاظ على جودة الورق لضمان عدم تلف المستندات المهمة.' },
          ]} />

          <h3 style="color:var(--primary)">نصائح لتخزين الأظرف ومستلزمات التغليف بشكل صحيح</h3>
          <IconCardGrid columns={2} items={[
            { icon: 'fa-box-open', text: 'خزّن الأظرف في مكان جاف بعيداً عن الرطوبة، فالرطوبة تُضعف قوة اللاصق الذاتي على الظرف وقد تجعله يلتصق قبل الاستخدام.' },
            { icon: 'fa-box-open', text: 'احفظ الأظرف في وضع أفقي مسطح دون ضغط أشياء ثقيلة عليها لتجنب التجعد أو الانحناء.' },
            { icon: 'fa-box-open', text: 'خزّن رولات الفقاعات وشريط التغليف بعيداً عن أشعة الشمس المباشرة، فالحرارة تُضعف قوة اللصق بمرور الوقت.' },
            { icon: 'fa-box-open', text: 'رتّب الكراتين المسطحة (قبل التجميع) بشكل عمودي لتوفير المساحة، وتجنب تكديس كميات كبيرة فوق بعضها لمنع تشوه الحواف.' },
          ]} />

        </div>

        <div class="service-sidebar">
          <div class="sidebar-card">
            <h4>المستلزمات المكتبية</h4>
            <div class="sidebar-services">
              <a href="/office-supplies/a4-paper" class="sidebar-service-link"><span>ورق A4 وطباعة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/thermal" class="sidebar-service-link"><span>ورق حراري وكاشير</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/pens" class="sidebar-service-link"><span>أقلام وأدوات كتابة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/notebooks" class="sidebar-service-link"><span>دفاتر ومفكرات</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/files" class="sidebar-service-link"><span>ملفات وأرشفة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/stamps" class="sidebar-service-link"><span>أختام ومستلزمات</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/envelopes" class="sidebar-service-link active"><span>أظرف وتغليف</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/whiteboards" class="sidebar-service-link"><span>وايت بورد وفلين بورد</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/binding" class="sidebar-service-link"><span>أدوات ربط ودباسة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/sticky-notes" class="sidebar-service-link"><span>بوست إت وورق لاصق</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/batteries-usb" class="sidebar-service-link"><span>بطاريات وUSB</span><i class="fas fa-angle-left"></i></a>
            </div>
          </div>
          <div class="sidebar-card">
            <h4>تواصل معنا</h4>
            <div class="contact-info">
              <div class="contact-info-item"><i class="fas fa-phone"></i><span>01227392074</span></div>
              <div class="contact-info-item"><i class="fas fa-clock"></i><span>السبت - الخميس: 9ص - 6م</span></div>
            </div>
            <a href="/contact" class="btn btn-primary btn-sm" style="width:100%;text-align:center;margin-top:16px">اتصل بنا</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="section section-bg">
    <div class="container">
      <div class="section-header">
        <h2>احصل على أظرفك ومستلزمات التغليف في 3 خطوات</h2>
        <div class="divider"></div>
      </div>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">1</div>
          <h4>اختر مقاس الظرف</h4>
          <p>تصفح تشكيلتنا الواسعة من الأظرف والمقاسات وحدد النوع المناسب لاحتياجك — للمستندات، الفواتير، الخطابات، أو الشحن والتسليم.</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <h4>حدد الكمية</h4>
          <p>أخبرنا بالكمية المطلوبة وسنقدم لك أفضل سعر ممكن. تزيد الخصومات مع زيادة الكميات — كلما طلبت أكثر كلما وفّرت أكثر.</p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <h4>استلم الطلب</h4>
          <p>استلم طلبك من متجرنا أو نرسله إليك بخدمة التوصيل السريع. نضمن سرعة التنفيذ وجودة التغليف في كل شحنة.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section" style="padding:60px 0;background:#f8f9fa">
    <div class="container">
      <h2 style="font-size:1.8rem;font-weight:700;color:#1a1a2e;margin-bottom:24px">أظرف مطبوعة بشعار شركتك — دليل المقاسات</h2>
      <p style="font-size:1.05rem;line-height:1.9;color:#444;margin-bottom:20px">نوفر أظرف بريدية مخصصة بشعار شركتك للمؤسسات والشركات في مصر. إليك دليل مقاسات الأظرف المعيارية:</p>
      <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:0.95rem">
          <thead>
            <tr style="background:#1a1a2e;color:#fff">
              <th style="padding:12px 16px;text-align:right">المقاس</th>
              <th style="padding:12px 16px;text-align:right">الأبعاد</th>
              <th style="padding:12px 16px;text-align:right">الاستخدام</th>
            </tr>
          </thead>
          <tbody>
            <tr style="background:#fff;border-bottom:1px solid #eee"><td style="padding:12px 16px;font-weight:700">DL</td><td style="padding:12px 16px">110 × 220 مم</td><td style="padding:12px 16px">رسائل A4 مطوية ثلاثاً (الأكثر شيوعاً)</td></tr>
            <tr style="background:#f8f9fa;border-bottom:1px solid #eee"><td style="padding:12px 16px;font-weight:700">C5</td><td style="padding:12px 16px">162 × 229 مم</td><td style="padding:12px 16px">رسائل A4 مطوية نصفين أو A5</td></tr>
            <tr style="background:#fff;border-bottom:1px solid #eee"><td style="padding:12px 16px;font-weight:700">C4</td><td style="padding:12px 16px">229 × 324 مم</td><td style="padding:12px 16px">رسائل A4 دون طي — للوثائق الرسمية</td></tr>
            <tr style="background:#f8f9fa"><td style="padding:12px 16px;font-weight:700">مقاسات خاصة</td><td style="padding:12px 16px">حسب الطلب</td><td style="padding:12px 16px">كتالوجات، هدايا، مستندات ضخمة</td></tr>
          </tbody>
        </table>
      </div>
      <p style="font-size:1rem;color:#555;margin-top:16px">نطبع الأظرف بشعار شركتك وبياناتها للشركات والمؤسسات في الإسكندرية والقاهرة وجميع مصر. الحد الأدنى للطلب 500 ظرف.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>أسئلة شائعة حول الأظرف والتغليف</h2>
        <div class="divider"></div>
      </div>
      <div class="faq-list">

        <div class="faq-item">
          <div class="faq-question">ما أحجام الأظرف المتاحة لديكم؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">نوفر مجموعة واسعة من أحجام الأظرف القياسية تشمل: C4 (229×324 مم) لاستيعاب ورق A4 دون طي، C5 (162×229 مم) لاستيعاب الأوراق المطوية مرة واحدة، DL (110×220 مم) الأكثر شيوعاً للخطابات الرسمية. نوفر أيضاً أحجاماً أصغر للمراسلات الشخصية وأحجاماً أكبر للمستندات الضخمة والملفات.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">هل الأظرف المبطنة مناسبة للمنتجات الهشة؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
