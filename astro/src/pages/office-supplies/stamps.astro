---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';
import { getSeoFor } from '../../lib/siteSeo';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "أختام مطاطية وبصمة",
  "description": "أختام مطاطية وبصمة للشركات في مصر — تصميم وتصنيع أختام مخصصة بأسرع وقت.",
  "serviceType": "أختام مطاطية",
  "provider": {
    "@type": "LocalBusiness",
    "name": "نيو جولدن أوفيس",
    "url": "https://newgoldenoffice.com",
    "telephone": "+201227392074",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "26 عبد المنعم سند",
      "addressLocality": "الإبراهيمية، باب شرق",
      "addressRegion": "الإسكندرية",
      "addressCountry": "EG"
    }
  },
  "areaServed": { "@type": "Country", "name": "Egypt" }
});
---
<BaseLayout
  {...getSeoFor('/office-supplies/stamps')}
  schemaJson={schemaJson}
  preloadImage="/images/office-supplies-hub.webp"
>
  <PageHero
    title="أختام ومستلزماتها في مصر"
    subtitle="نيو جولدن أوفيس — صناعة الأختام المخصصة للشركات والأفراد في مصر. أختام مطاطية، ذاتية الحبر، تاريخية — تسليم خلال 24 ساعة"
    heroImage="/images/office-supplies-hub.webp"
    heroIcon="fa-stamp"
    breadcrumbs={[
      { label: 'الرئيسية', href: '/' },
      { label: 'مستلزمات مكتبية', href: '/office-supplies' },
      { label: 'أختام ومستلزمات' }
    ]}
  />

  <section class="section">
    <div class="container">
      <div class="service-detail-grid">

        <div class="service-content">
          <h2>ختم شركة مصر — أختام احترافية لكل الاحتياجات</h2>
          <p>
            في عالم الأعمال، الختم ليس مجرد أداة — إنه هوية مؤسستك وعلامة رسميتك. في <strong>نيو جولدن أوفيس</strong>، نصنع أختاماً مخصصة تعكس احترافية شركتك بدقة عالية وجودة استثنائية. منذ عام 1999 ونحن نخدم الشركات والمؤسسات والأفراد في الإسكندرية ومختلف أنحاء مصر بمنتجات أختام من أعلى المواصفات.
          </p>
          <p>
            هذه الخبرة الممتدة لأكثر من 27 عامًا في صناعة الأختام تحديدًا جعلتنا نتقن التعامل مع أدق التفاصيل، من اختيار حجم الخط المناسب لمساحة الختم الصغيرة إلى ضمان وضوح الشعارات المعقدة عند تصغيرها لمقاس الختم القياسي.
          </p>
          <p>
            نتعامل مع كل طلب بنفس الدقة، سواء كان ختمًا شخصيًا بسيطًا أو مجموعة أختام متكاملة لشركة كبرى تحتاج توثيق كل قسم من أقسامها بختم مخصص.
          </p>
          <p>
            نحتفظ أيضًا بنسخة من تصميم كل ختم سابق طلبته، فإذا احتجت ختمًا إضافيًا مطابقًا لاحقًا (لفرع جديد مثلًا)، ننفذه بنفس المواصفات تمامًا بسرعة.
          </p>
          <p>
            نساعد أيضًا الشركات التي تتوسع بفروع جديدة في توحيد تصميم أختامها عبر كل الفروع، مع تمييز بسيط يوضح اسم أو رقم كل فرع.
          </p>
          <p>
            نقدم أيضًا استشارة مجانية حول أنسب نوع ختم لطبيعة استخدامك، سواء كان يوميًا مكثفًا أو نادرًا يحتاج فقط أختام مناسبات محددة.
          </p>
          <p>
            سواء كنت تحتاج إلى ختم شركة تجارية، بصمة مكتب حكومي، ختم عيادة طبية، أو ختم شخصي، نقدم لك تصميماً مخصصاً يناسب احتياجاتك تماماً. نستخدم أحدث تقنيات الحفر الليزري لضمان وضوح البصمة ودقتها في كل مرة، مع ضمان متانة الختم لسنوات طويلة من الاستخدام المتواصل.
          </p>
          <p>
            الحفر الليزري تحديدًا هو ما يفرق بين ختم احترافي وآخر رديء الجودة؛ فالحفر اليدوي التقليدي أو الحفر الكيميائي القديم ينتج حواف غير دقيقة تتآكل بسرعة مع الاستخدام المتكرر، بينما الحفر الليزري الدقيق ينتج حروفًا نظيفة الحواف تحافظ على وضوحها لسنوات طويلة حتى مع الاستخدام اليومي المكثف في أقسام الأرشفة والمحاسبة.
          </p>

          <h3>أنواع الأختام المتاحة</h3>
          <ul>
            <li><strong>ختم مطاطي تقليدي</strong> — ختم كلاسيكي بكاوتش ومقبض خشبي أو بلاستيكي، يستخدم مع وسادة حبر منفصلة، مثالي للاستخدام المتقطع</li>
            <li><strong>ختم ذاتي الحبر (Self-inking)</strong> — من ماركات Trodat وColop العالمية المعروفة، يحتوي بداخله على وسادة حبر متكاملة تُعيد تلقيم نفسها تلقائياً مع كل بصمة، مثالي للاستخدام المكثف اليومي</li>
            <li><strong>ختم Pre-inked ناعم البصمة</strong> — يمتص الحبر في مادة الختم نفسها لإنتاج بصمة ناعمة ومتقنة عالية الدقة، مناسب للشعارات والتصاميم التفصيلية</li>
            <li><strong>ختم التاريخ والترقيم</strong> — يُحدّث التاريخ أو الرقم تلقائياً، ضروري لأقسام الأرشفة والبريد وضبط الجودة</li>
            <li><strong>ختم الشمع (Wax Seal)</strong> — للمراسلات الراقية والحفلات والدعوات الرسمية، يضفي طابعاً كلاسيكياً وفاخراً</li>
            <li><strong>ختم الكاوتش بمقبض خشبي</strong> — الشكل التقليدي الأكثر شيوعاً في المكاتب المصرية، متين وبسيط الاستخدام</li>
          </ul>

          <h3>أوسادة الحبر والمستلزمات</h3>
          <p>إلى جانب الأختام نفسها، نوفر كامل مستلزمات الأختام لضمان استمرارية العمل دون انقطاع، فنفاد الحبر في يوم عمل مزدحم مشكلة بسيطة لكنها مزعجة إذا لم يكن البديل جاهزًا مسبقًا:</p>
          <ul>
            <li><strong>أوسادة حبر بألوان متعددة</strong> — متوفرة بالألوان الأساسية: أسود، أزرق، أحمر، أخضر، وبنفسجي، بأحجام قياسية تناسب جميع أنواع الأختام</li>
            <li><strong>حبر إعادة التعبئة</strong> — زجاجات حبر عالية الجودة لإعادة شحن الأوسادة بأسعار اقتصادية، متوفرة لأختام Trodat وColop وغيرها</li>
            <li><strong>مزيل الحبر</strong> — منظفات متخصصة لإزالة آثار الحبر من الأسطح والأختام بأمان وكفاءة</li>
          </ul>

          <MidPageCTA formId="offStampsMidCta" />

          <h3>أختام الشركات والمؤسسات</h3>
          <p>
            نتخصص في تصنيع أختام الشركات والمؤسسات الكبرى بمختلف أشكالها: أختام مديرية بالإمضاء والتوقيع، أختام العنوان والبيانات، أختام "سري" و"عاجل" و"مُعتمد" و"أُستلم"، أختام الخاتم الدائري، وأختام الشعارات التجارية المرخصة.
          </p>
          <p>
            هذه الأختام الوظيفية المتخصصة (سري، عاجل، معتمد) توفر وقتًا كبيرًا في بيئات العمل ذات حجم المستندات المرتفع كالبنوك وشركات التأمين والجهات الحكومية، حيث تُستخدم يوميًا لتصنيف المراسلات وتسريع دورة اتخاذ القرار دون الحاجة لكتابة نفس الكلمة يدويًا في كل مرة.
          </p>
          <p>
            نستطيع إنتاج ختمك خلال <strong>24 ساعة فقط</strong> من استلام التصميم أو البيانات المطلوبة، وذلك بفضل تجهيزاتنا الحديثة وخبرتنا الممتدة لأكثر من ثلاثة عقود في هذا المجال.
          </p>
          <p>
            نتعامل مع طلبات متنوعة تمامًا في طبيعتها: من رجل أعمال يحتاج ختمًا شخصيًا واحدًا فقط، إلى شركة كبرى تطلب عشرات الأختام المختلفة لفروعها وأقسامها المتعددة دفعة واحدة. في كل الحالات، نتعامل مع الطلب بنفس مستوى الدقة والاهتمام، لأننا نعرف أن الختم — مهما كان صغيرًا — يمثل هوية رسمية تُستخدم في مستندات وعقود مهمة قد يعتمد عليها قرار كامل.
          </p>
          <p>
            بالنسبة للشركات التي تتوسع وتفتح فروعًا جديدة، نقترح دائمًا توحيد تصميم الختم عبر كل الفروع مع تمييز بسيط يوضح اسم الفرع أو رقمه، ما يسهل على الإدارة المركزية تتبع مصدر أي مستند موقع لاحقًا.
          </p>

          <h3>كيفية طلب ختم مخصص</h3>
          <p>
            طلب الختم المخصص بسيط جداً: تواصل معنا عبر الهاتف على <strong>01227392074</strong> أو زر متجرنا في الإسكندرية. أرسل لنا شعارك أو النصوص المطلوبة وشكل الختم المفضل (دائري، مستطيل، مربع)، وسنتولى كل شيء من التصميم إلى التسليم.
          </p>
          <p>
            للعملاء خارج الإسكندرية، يمكن إتمام الطلب بالكامل عن بُعد عبر واتساب: ترسل صورة شعارك والبيانات المطلوبة، نرسل لك معاينة رقمية للتصميم، وبعد موافقتك نشحن الختم الجاهز إلى عنوانك في أي محافظة مصرية خلال أيام قليلة من التصنيع.
          </p>

        </div>

        <div class="service-sidebar">
          <div class="sidebar-card">
            <h4>المستلزمات المكتبية</h4>
            <div class="sidebar-services">
              <a href="/office-supplies/a4-paper" class="sidebar-service-link"><span>ورق A4 وطباعة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/thermal" class="sidebar-service-link"><span>ورق حراري وكاشير</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/pens" class="sidebar-service-link"><span>أقلام وأدوات كتابة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/notebooks" class="sidebar-service-link"><span>دفاتر ومفكرات</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/files" class="sidebar-service-link"><span>ملفات وأرشفة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/stamps" class="sidebar-service-link active"><span>أختام ومستلزمات</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/envelopes" class="sidebar-service-link"><span>أظرف وتغليف</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/whiteboards" class="sidebar-service-link"><span>وايت بورد وفلين بورد</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/binding" class="sidebar-service-link"><span>أدوات ربط ودباسة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/sticky-notes" class="sidebar-service-link"><span>بوست إت وورق لاصق</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/batteries-usb" class="sidebar-service-link"><span>بطاريات وUSB</span><i class="fas fa-angle-left"></i></a>
            </div>
          </div>
          <div class="sidebar-card">
            <h4>تواصل معنا</h4>
            <div class="contact-info">
              <div class="contact-info-item"><i class="fas fa-phone"></i><span>01227392074</span></div>
              <div class="contact-info-item"><i class="fas fa-clock"></i><span>السبت - الخميس: 9ص - 6م</span></div>
            </div>
            <a href="/contact" class="btn btn-primary btn-sm" style="width:100%;text-align:center;margin-top:16px">اتصل بنا</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="section section-bg">
    <div class="container">
      <div class="section-header">
        <h2>ختمك الخاص في 3 خطوات بسيطة</h2>
        <div class="divider"></div>
      </div>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">1</div>
          <h4>أرسل التصميم أو البيانات</h4>
          <p>أرسل لنا شعارك أو النصوص المطلوبة واختر شكل الختم وحجمه المناسب. يمكنك إرسال الملفات عبر الهاتف أو الحضور شخصياً للمتجر للمشورة المجانية.</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <h4>نُعِد الحفر والتصنيع</h4>
          <p>يقوم فريقنا المتخصص بإعداد التصميم النهائي وتنفيذ الحفر الليزري الدقيق للختم مع الاهتمام بأدق التفاصيل لضمان وضوح وجمال البصمة.</p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <h4>تسليم خلال 24 ساعة</h4>
          <p>يصلك ختمك جاهزاً للاستخدام خلال 24 ساعة من اعتماد التصميم. نوفر أيضاً خدمة الشحن السريع لجميع محافظات مصر.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section" style="padding:60px 0;background:#f8f9fa">
    <div class="container">
      <h2 style="font-size:1.8rem;font-weight:700;color:#1a1a2e;margin-bottom:24px">كيف تطلب ختم مطاطي لشركتك؟ — خطوات بسيطة</h2>
      <p style="font-size:1.05rem;line-height:1.9;color:#444;margin-bottom:20px">نصنع الأختام المطاطية للشركات والمؤسسات في مصر خلال 24-48 ساعة. إليك الخطوات:</p>
      <ol style="padding-right:24px;line-height:2.2;font-size:1rem;color:#444">
        <li><strong>حدد المعلومات:</strong> اسم الشركة، العنوان، أرقام التواصل، الرقم الضريبي (إن وُجد)</li>
        <li><strong>اختر الشكل:</strong> مستطيل، دائري، بيضاوي، أو شكل خاص</li>
        <li><strong>أرسل شعارك:</strong> أرسل شعار شركتك بصيغة PNG أو PDF إن أردت تضمينه</li>
        <li><strong>راجع التصميم:</strong> نرسل لك صورة للتصميم قبل التصنيع للموافقة</li>
        <li><strong>استلم ختمك:</strong> جاهز خلال 24-48 ساعة، مع بصمة الاختبار</li>
      </ol>
      <h3 style="font-size:1.1rem;font-weight:700;color:#1a1a2e;margin:24px 0 12px">ما هي المعلومات المطلوبة للختم؟</h3>
      <p style="font-size:1rem;color:#555;line-height:1.8">اسم الشركة أو المؤسسة، العنوان، رقم الهاتف (اختياري)، الرقم الضريبي أو السجل التجاري (اختياري)، وشعار الشركة إن أردت إضافته. نخدم عملاءنا في الإسكندرية والقاهرة وجميع محافظات مصر مع التوصيل.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>أسئلة شائعة حول الأختام</h2>
        <div class="divider"></div>
      </div>
      <div class="faq-list">

        <div class="faq-item">
          <div class="faq-question">كيف يمكنني طلب ختم مخصص لشركتي؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">تواصل معنا على الرقم 01227392074 أو زر متجرنا في الإسكندرية. أرسل لنا شعار شركتك أو النصوص المطلوبة (اسم الشركة، العنوان، رقم السجل التجاري إن وُجد) وحدد الشكل المفضل للختم (دائري، مستطيل، مربع). سيقوم فريقنا بإعداد تصميم مبدئي للموافقة عليه قبل البدء في التصنيع.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">كم يستغرق تصنيع الختم؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">في معظم الحالات، نسلم الختم خلال 24 ساعة من اعتماد التصميم النهائي. الطلبات العاجلة التي تُقدَّم في الصباح الباكر غالباً تكون جاهزة في نفس اليوم. الطلبات الكبيرة أو التصاميم المعقدة قد تستغرق يومين عمل على الأقل.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">ما الفرق بين الختم ذاتي الحبر والختم التقليدي؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">الختم ذاتي الحبر (Self-inking) يحتوي على وسادة حبر داخلية تعيد تلقيم نفسها تلقائياً بعد كل بصمة، مما يجعله مثالياً للاستخدام المكثف والمتكرر دون الحاجة للتوقف لإعادة التحميل. الختم التقليدي أبسط وأقل تكلفة ويستخدم مع وسادة حبر خارجية، وهو الخيار الأنسب إذا كان استخدامك متقطعاً وغير يومي.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">ما ألوان الحبر المتاحة للأختام؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">نوفر أوسادة حبر وحبر إعادة تعبئة بألوان متعددة تشمل: الأسود (الأكثر طلباً)، الأزرق، الأحمر، الأخضر، والبنفسجي. يمكنك أيضاً طلب أختام ذاتية الحبر بأي من هذه الألوان. الأسود والأزرق هما الأكثر استخداماً للوثائق والمراسلات الرسمية.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">هل يوجد حد أدنى للطلب؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">لا يوجد حد أدنى للطلب — نستقبل طلبات الختم الواحد وكذلك الطلبات الكبيرة للشركات والمؤسسات. عند طلب أكثر من 5 أختام يمكنك الحصول على أسعار خاصة للشركات. تواصل معنا للحصول على عرض سعر مخصص يناسب احتياجاتك وكميتك.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">هل يمكن استبدال أو تعديل ختم بعد التصنيع؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
