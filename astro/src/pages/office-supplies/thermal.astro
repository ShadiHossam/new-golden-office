---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';
import { getSeoFor } from '../../lib/siteSeo';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "ورق حراري ورول كاشير",
  "description": "ورق حراري ورول كاشير في مصر — مقاسات متعددة للمطاعم والمحلات وأجهزة POS.",
  "serviceType": "ورق حراري",
  "provider": {
    "@type": "LocalBusiness",
    "name": "نيو جولدن أوفيس",
    "url": "https://newgoldenoffice.com",
    "telephone": "+201227392074",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "26 عبد المنعم سند",
      "addressLocality": "الإبراهيمية، باب شرق",
      "addressRegion": "الإسكندرية",
      "addressCountry": "EG"
    }
  },
  "areaServed": { "@type": "Country", "name": "Egypt" }
});
---
<BaseLayout
  {...getSeoFor('/office-supplies/thermal')}
  schemaJson={schemaJson}
  preloadImage="/images/office-supplies-hub.webp"
>
  <PageHero
    title="ورق حراري وأرول كاشير في مصر"
    subtitle="نيو جولدن أوفيس — مورد معتمد للورق الحراري وأرول الكاشير في مصر. أحجام وأطوال متعددة لجميع ماكينات نقاط البيع والأجهزة المصرفية"
    heroImage="/images/office-supplies-hub.webp"
    heroIcon="fa-receipt"
    breadcrumbs={[
      { label: 'الرئيسية', href: '/' },
      { label: 'مستلزمات مكتبية', href: '/office-supplies' },
      { label: 'ورق حراري وكاشير' }
    ]}
  />

  <section class="section">
    <div class="container">
      <div class="service-detail-grid">

        <div class="service-content">
          <h2>أرول كاشير مصر — لماذا تختار ورقنا الحراري؟</h2>
          <p>
            في نيو جولدن أوفيس، نوفر أرول الورق الحراري عالية الجودة التي تلبي احتياجات جميع القطاعات التجارية والمصرفية والخدمية في مصر. منذ تأسيسنا عام 1999 في الإسكندرية، نسعى دائمًا إلى تقديم منتجات تضمن وضوح الطباعة وثبات الألوان لأطول فترة ممكنة، مما يجعلنا الشريك الموثوق للشركات والمؤسسات الكبيرة والصغيرة على حد سواء.
          </p>
          <p>
            يتميز ورقنا الحراري بمقاومته للرطوبة والحرارة العالية، وهو مصنوع وفق معايير جودة دولية صارمة. كما نوفر خيارات خالية من مادة BPA (بيسفينول أ)، مما يجعله آمنًا للاستخدام في بيئات الأغذية والصيدليات والمستشفيات.
          </p>

          <h3>مقاسات الورق الحراري المتاحة</h3>
          <p>نوفر تشكيلة واسعة من أحجام وأطوال أرول الورق الحراري لتناسب جميع أنواع الأجهزة:</p>
          <ul>
            <li><strong>57×20 م</strong> — مناسب لماكينات POS الصغيرة والمحمولة</li>
            <li><strong>57×40 م</strong> — الحجم القياسي لمعظم ماكينات الكاشير المكتبية</li>
            <li><strong>57×80 م</strong> — للاستخدام المكثف في البيئات التجارية عالية الحركة</li>
            <li><strong>80×40 م</strong> — مثالي لطابعات الفواتير ومحطات البيع المتوسطة</li>
            <li><strong>80×80 م</strong> — للطابعات الاحترافية وأجهزة نقاط البيع التجارية الكبيرة</li>
            <li><strong>112×25 م</strong> — خاص بأجهزة الفاكس الحراري وبعض طابعات التذاكر</li>
          </ul>

          <MidPageCTA formId="offThermalMidCta" />

          <h3>تطبيقات الورق الحراري</h3>
          <p>يُستخدم ورقنا الحراري في طيف واسع من الأجهزة والتطبيقات التجارية:</p>
          <ul>
            <li><i class="fas fa-check-circle" style="color:var(--secondary);margin-left:6px"></i> <strong>ماكينات POS</strong> — لطباعة إيصالات المبيعات في المحلات التجارية والسوبرماركت</li>
            <li><i class="fas fa-check-circle" style="color:var(--secondary);margin-left:6px"></i> <strong>أجهزة كاشير</strong> — صناديق النقود الإلكترونية في المطاعم والكافيهات والمحلات</li>
            <li><i class="fas fa-check-circle" style="color:var(--secondary);margin-left:6px"></i> <strong>أجهزة الصراف الآلي (ATM)</strong> — لطباعة إيصالات السحب والإيداع وكشف الحساب</li>
            <li><i class="fas fa-check-circle" style="color:var(--secondary);margin-left:6px"></i> <strong>طابعات الفاتورة</strong> — لإصدار فواتير ضريبية وإيصالات مفصلة للعملاء</li>
            <li><i class="fas fa-check-circle" style="color:var(--secondary);margin-left:6px"></i> <strong>أجهزة الفاكس الحراري</strong> — لاستقبال المستندات والوثائق المرسلة بجودة عالية</li>
            <li><i class="fas fa-check-circle" style="color:var(--secondary);margin-left:6px"></i> <strong>طابعات التذاكر</strong> — في المسارح والمواصلات والفعاليات والمعارض</li>
          </ul>
          <p>
            بالإضافة إلى ذلك، نوفر ملصقات حرارية لاصقة (Thermal Labels) بمقاسات متنوعة تُستخدم في وضع العلامات على البضائع وطباعة باركود المنتجات في المستودعات والمصانع والصيدليات.
          </p>
          <p>
            تتميز منتجاتنا بعمر تخزين يتجاوز 5 سنوات في الظروف العادية، وتحافظ على وضوح الطباعة لمدة لا تقل عن 7 سنوات بعد الطباعة إذا خُزنت بعيدًا عن الضوء المباشر والحرارة الشديدة.
          </p>

        </div>

        <div class="service-sidebar">
          <div class="sidebar-card">
            <h4>المستلزمات المكتبية</h4>
            <div class="sidebar-services">
              <a href="/office-supplies/a4-paper" class="sidebar-service-link"><span>ورق A4 وطباعة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/thermal" class="sidebar-service-link active"><span>ورق حراري وكاشير</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/pens" class="sidebar-service-link"><span>أقلام وأدوات كتابة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/notebooks" class="sidebar-service-link"><span>دفاتر ومفكرات</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/files" class="sidebar-service-link"><span>ملفات وأرشفة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/stamps" class="sidebar-service-link"><span>أختام ومستلزمات</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/envelopes" class="sidebar-service-link"><span>أظرف وتغليف</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/whiteboards" class="sidebar-service-link"><span>وايت بورد وفلين بورد</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/binding" class="sidebar-service-link"><span>أدوات ربط ودباسة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/sticky-notes" class="sidebar-service-link"><span>بوست إت وورق لاصق</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/batteries-usb" class="sidebar-service-link"><span>بطاريات وUSB</span><i class="fas fa-angle-left"></i></a>
            </div>
          </div>
          <div class="sidebar-card">
            <h4>تواصل معنا</h4>
            <div class="contact-info">
              <div class="contact-info-item"><i class="fas fa-phone"></i><span>01227392074</span></div>
              <div class="contact-info-item"><i class="fas fa-clock"></i><span>السبت - الخميس: 9ص - 6م</span></div>
            </div>
            <a href="/contact" class="btn btn-primary btn-sm" style="width:100%;text-align:center;margin-top:16px">اتصل بنا</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="section section-bg">
    <div class="container">
      <div class="section-header">
        <h2>احصل على الورق الحراري في 3 خطوات بسيطة</h2>
        <div class="divider"></div>
      </div>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">1</div>
          <h4>اختر الحجم المناسب</h4>
          <p>حدد مقاس الرول المناسب لجهازك (57mm أو 80mm أو 112mm) والطول المطلوب من قائمة المنتجات المتاحة لدينا، وتواصل معنا لمعرفة الأنسب لاحتياجاتك.</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <h4>اطلب الكمية</h4>
          <p>أخبرنا بالكمية المطلوبة سواء كانت عدة أرول أو كراتين كاملة. نقدم أسعارًا خاصة للكميات الكبيرة وعروض خاصة للعملاء الدائمين والشركات.</p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <h4>استلم بالتوصيل</h4>
          <p>نوصل طلبك لأي مكان في الإسكندرية ومصر كلها بسرعة وأمان. نضمن وصول منتجاتك في حالة ممتازة ومُعبأة بشكل احترافي يحميها من التلف.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section" style="padding:60px 0;background:#f8f9fa">
    <div class="container">
      <h2 style="font-size:1.8rem;font-weight:700;color:#1a1a2e;margin-bottom:24px">مقاسات الرول الحراري المتاحة — ورق كاشير للمطاعم والمحلات</h2>
      <p style="font-size:1.05rem;line-height:1.9;color:#444;margin-bottom:20px">نوفر جميع مقاسات الورق الحراري في مصر للمطاعم والمحلات التجارية وأجهزة POS:</p>
      <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:0.95rem">
          <thead>
            <tr style="background:#1a1a2e;color:#fff">
              <th style="padding:12px 16px;text-align:right">المقاس</th>
              <th style="padding:12px 16px;text-align:right">الاستخدام الشائع</th>
            </tr>
          </thead>
          <tbody>
            <tr style="background:#fff;border-bottom:1px solid #eee"><td style="padding:12px 16px">80 × 80 مم</td><td style="padding:12px 16px">أجهزة POS للمطاعم والسوبرماركت</td></tr>
            <tr style="background:#f8f9fa;border-bottom:1px solid #eee"><td style="padding:12px 16px">80 × 60 مم</td><td style="padding:12px 16px">طابعات كاشير المحلات التجارية</td></tr>
            <tr style="background:#fff;border-bottom:1px solid #eee"><td style="padding:12px 16px">57 × 40 مم</td><td style="padding:12px 16px">أجهزة POS المحمولة والصغيرة</td></tr>
            <tr style="background:#f8f9fa;border-bottom:1px solid #eee"><td style="padding:12px 16px">57 × 30 مم</td><td style="padding:12px 16px">أجهزة الكريدت كارد (VISA)</td></tr>
            <tr style="background:#fff"><td style="padding:12px 16px">مقاسات خاصة</td><td style="padding:12px 16px">نوفر حسب الطلب للشركات</td></tr>
          </tbody>
        </table>
      </div>
      <p style="font-size:1rem;color:#555;margin-top:20px">نوفر الرول الحراري للشركات والمطاعم والكافيهات في القاهرة والإسكندرية وجميع مصر بأسعار الجملة.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>أكثر الأسئلة شيوعًا حول الورق الحراري</h2>
        <div class="divider"></div>
      </div>
      <div class="faq-list">

        <div class="faq-item">
          <div class="faq-question">ما هو الورق الحراري وكيف يعمل؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">الورق الحراري هو نوع خاص من الورق مطلي بطبقة كيميائية حساسة للحرارة. عند تعرض هذه الطبقة لرأس الطباعة الحراري في الجهاز، تتفاعل المواد الكيميائية وتنتج النص أو الرسوم بدون الحاجة إلى حبر أو حبرة أو ريبون. هذا يجعل الطابعات الحرارية أقل تكلفة في التشغيل وأكثر موثوقية.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">هل الورق الحراري الذي تبيعونه خالٍ من مادة BPA؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">نعم، نوفر خيارات من الورق الحراري الخالي من مادة BPA (بيسفينول أ) لمن يحتاج إلى مواصفات أعلى من الأمان، وهو مناسب بشكل خاص للصيدليات والمطاعم ومحلات الأغذية والمستشفيات. يمكنك تحديد هذا الخيار عند الطلب.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">كم تدوم الطباعة على الورق الحراري؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">في الظروف العادية بعيدًا عن الضوء المباشر والحرارة الشديدة والرطوبة، تبقى الطباعة واضحة لمدة تتراوح بين 5 إلى 10 سنوات. أما إذا تعرض الورق للحرارة الشديدة أو الضوء أو بعض المواد الكيميائية مثل الكحول، فقد يتلاشى اللون بشكل أسرع.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">ما هي الأحجام المتاحة لديكم؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">لدينا تشكيلة واسعة من الأحجام تشمل: 57×20م، 57×40م، 57×80م، 80×40م، 80×80م، و112×25م. نوفر أيضًا ملصقات حرارية لاصقة بمقاسات متنوعة. إذا كان جهازك يحتاج إلى مقاس غير مدرج، تواصل معنا وسنسعى لتوفيره على 01227392074.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">هل تقدمون أسعارًا خاصة للكميات الكبيرة؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">نعم، نقدم أسعارًا خاصة ومميزة للطلبات بالجملة والكميات الكبيرة. كلما زادت الكمية المطلوبة، كلما كان السعر أفضل. نوفر أيضًا عروضًا خاصة للعملاء الدائمين والشركات التي تتعامل معنا بشكل منتظم.</div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="cta-banner">
    <div class="container">
      <h2>هل تحتاج إلى أرول ورق حراري بكميات كبيرة؟</h2>
      <p>تواصل معنا الآن واحصل على أفضل الأسعار مع ضمان الجودة والتوصيل السريع لجميع أنحاء مصر</p>
      <div class="btn-group">
        <a href="/contact" class="btn btn-secondary btn-lg">اطلب عرض سعر</a>
        <a href="tel:01227392074" class="btn btn-outline-white btn-lg"><i class="fas fa-phone"></i> 01227392074</a>
      </div>
    </div>
  </section>
</BaseLayout>
