---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';
import ContentIntro from '../../components/ContentIntro.astro';
import IconCardGrid from '../../components/IconCardGrid.astro';
import { getSeoFor } from '../../lib/siteSeo';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "دفاتر ومفكرات",
      "description": "دفاتر ومفكرات مكتبية في مصر — مقاسات وأنواع متعددة للمكاتب والمدارس والشركات.",
      "serviceType": "دفاتر مكتبية",
      "provider": {
        "@type": "LocalBusiness",
        "name": "نيو جولدن أوفيس",
        "url": "https://newgoldenoffice.com",
        "telephone": "+201227392074",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "26 عبد المنعم سند",
          "addressLocality": "الإبراهيمية، باب شرق",
          "addressRegion": "الإسكندرية",
          "addressCountry": "EG"
        }
      },
      "areaServed": { "@type": "Country", "name": "Egypt" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"ما هي أحجام الدفاتر المتوفرة لديكم؟","acceptedAnswer":{"@type":"Answer","text":"نوفر الدفاتر بجميع الأحجام الشائعة في السوق المصري، وتشمل: مقاس A4 (21×29.7 سم) للاستخدام المكتبي العام، ومقاس A5 (14.8×21 سم) للمفكرات الشخصية والحمل اليومي، ومقاس B5 المتوسط، ومقاسات الجيب (Pocket) للملاحظات السريعة. كما نوفر مقاسات Legal وLetter للأسواق التي تستخدم هذه المقاسات."}},
        {"@type":"Question","name":"هل يمكنكم طباعة شعار شركتي على الدفاتر؟","acceptedAnswer":{"@type":"Answer","text":"نعم، نقدم خدمة الطباعة المخصصة على جميع أنواع الدفاتر والمفكرات. يمكننا طباعة شعار شركتك وبياناتها على الغلاف الخارجي وكذلك على الصفحة الأولى الداخلية. فقط أرسل لنا ملف الشعار بصيغة عالية الدقة (AI, EPS, PDF) وسيتولى فريقنا الباقي."}},
        {"@type":"Question","name":"ما هو الحد الأدنى لطلبات الجملة؟","acceptedAnswer":{"@type":"Answer","text":"يختلف الحد الأدنى للطلب حسب نوع الدفتر والخدمة المطلوبة. للدفاتر العادية بدون طباعة، يمكن الطلب من كمية صغيرة. أما للدفاتر المطبوعة بشعار الشركة، فيبدأ الحد الأدنى من 50 قطعة."}},
        {"@type":"Question","name":"كم يستغرق وقت تسليم الطلبات؟","acceptedAnswer":{"@type":"Answer","text":"للطلبات العادية بدون طباعة: 24 إلى 48 ساعة من تأكيد الطلب. للطلبات المطبوعة بشعار الشركة: من 5 إلى 10 أيام عمل حسب الكمية وتعقيد التصميم."}},
        {"@type":"Question","name":"ما الفرق بين الدفاتر الحلزونية والدفاتر ذات الغلاف الصلب؟","acceptedAnswer":{"@type":"Answer","text":"الدفاتر الحلزونية تُفتح بشكل مسطح تمامًا مما يسهل الكتابة وهي الأنسب للاستخدام اليومي والاجتماعات. الدفاتر ذات الغلاف الصلب تتميز بمتانة أعلى وتحافظ على شكلها الأنيق، وهي الأنسب للمفكرات التنفيذية والهدايا المؤسسية الفاخرة."}},
        {"@type":"Question","name":"ما وزن الورق الأنسب لدفتر لا يُنزّ الحبر؟","acceptedAnswer":{"@type":"Answer","text":"ننصح بورق بوزن 70 جرام فأكثر للاستخدام العادي بالحبر الجاف، أما مع أقلام الجل أو الحبر السائل أو أقلام السبورة فننصح بورق 80 جرام أو أعلى لتفادي ظهور الحبر على الوجه الآخر من الصفحة، خصوصًا في الدفاتر المخصصة للتوقيعات والمستندات الرسمية."}},
        {"@type":"Question","name":"ما الفرق بين الورق المسطر والمربعات والمنقط؟","acceptedAnswer":{"@type":"Answer","text":"الورق المسطر (Lined) مناسب للكتابة النصية العادية والمحاضر والتقارير. الورق المربعات (Grid) يفضله المهندسون والمحاسبون للرسم البياني والجداول اليدوية. الورق المنقط (Dot Grid) خيار مرن يجمع بين حرية الصفحة البيضاء وانتظام الكتابة، وينتشر حاليًا بين مصممي الخطط ومنظمي المهام (Bullet Journal)."}},
        {"@type":"Question","name":"كيف أحافظ على الدفاتر من الرطوبة والتلف أثناء التخزين؟","acceptedAnswer":{"@type":"Answer","text":"احفظ الدفاتر في مكان جاف بعيدًا عن أشعة الشمس المباشرة ومصادر الرطوبة، وتجنب تكديس كميات كبيرة بشكل يضغط على الأغلفة لفترات طويلة. للمخزون الكبير في المستودعات، يفضل التخزين على أرفف مرتفعة عن الأرض داخل كراتينها الأصلية حتى موعد التوزيع أو الاستخدام."}},
        {"@type":"Question","name":"هل تتوفر لديكم دفاتر من ورق معاد تدويره؟","acceptedAnswer":{"@type":"Answer","text":"نعم، نوفر دفاتر مصنوعة من ورق معاد تدويره جزئيًا أو كليًا بلمسة طبيعية خام على الغلاف، وهي خيار مناسب للشركات التي تريد إبراز هويتها البيئية في هدايا المؤتمرات والمعارض، أو المدارس التي تدرّس مفاهيم الاستدامة عمليًا."}}
      ]
    }
  ]
});
---
<BaseLayout
  {...getSeoFor('/office-supplies/notebooks')}
  schemaJson={schemaJson}
  preloadImage="/images/office-supplies-hub.webp"
>
  <PageHero
    title="دفاتر مكتبية ومفكرات وكراسات في مصر"
    subtitle="نيو جولدن أوفيس — مورد الدفاتر والمفكرات المكتبية في مصر. دفاتر حلزونية، مفكرات تنفيذية، وكراسات بالجملة للشركات والمكاتب"
    heroImage="/images/office-supplies-hub.webp"
    heroIcon="fa-book"
    breadcrumbs={[
      { label: 'الرئيسية', href: '/' },
      { label: 'مستلزمات مكتبية', href: '/office-supplies' },
      { label: 'دفاتر ومفكرات' }
    ]}
  />

  <section class="section">
    <div class="container">
      <div class="service-detail-grid">

        <div class="service-content">
          <ContentIntro
            heading="تشكيلة الدفاتر والمفكرات"
            text="في نيو جولدن أوفيس، نقدم تشكيلة واسعة ومتنوعة من الدفاتر والمفكرات التي تلبي احتياجات الشركات والمكاتب والمؤسسات التعليمية في جميع أنحاء مصر. نحرص على توفير منتجات عالية الجودة تجمع بين المتانة والأناقة، مع الحفاظ على أسعار تنافسية تناسب عمليات الشراء بالجملة."
          />
          <p>نتعامل مع أفضل الموردين والمصنعين المحليين والدوليين لضمان الحصول على منتجات تستوفي أعلى معايير الجودة. كل دفتر يُختار بعناية ليضمن ورقًا ناعمًا لا يُنزّ الحبر، وغلافًا متينًا يحمي المحتوى، وتجليدًا محكمًا يتحمل الاستخدام اليومي المكثف.</p>

          <h3>أنواع الدفاتر المتاحة</h3>
          <IconCardGrid columns={4} items={[
            { icon: 'fa-book', title: 'دفاتر حلزونية بأحجام A4 وA5', text: 'بأغطية صلبة وناعمة، تُفتح 360 درجة، خيار عملي للاجتماعات والاستخدام اليومي المكثف' },
            { icon: 'fa-book-open', title: 'دفاتر مقواة بغلاف صلب', text: 'للاستخدام التنفيذي والمهني، تحافظ على شكلها مع كثرة النقل داخل الحقائب' },
            { icon: 'fa-balance-scale', title: 'لوحات كتابة قانونية (Legal Pad)', text: 'بأحجام متعددة وورق أصفر أو أبيض مسطر، شائعة في المكاتب القانونية والاستشارية' },
            { icon: 'fa-gem', title: 'مفكرات تنفيذية فاخرة', text: 'بتصاميم راقية للمدراء وكبار الموظفين، غالبًا بورق أثقل وإغلاق مغناطيسي أو بشريط مطاطي' },
            { icon: 'fa-table', title: 'كراسات مسطرة وسادة (بلانك) وبمربعات', text: 'للاستخدامات المختلفة من الكتابة العادية إلى الرسم البياني والحسابات' },
            { icon: 'fa-calendar-alt', title: 'دفاتر التخطيط اليومي والأسبوعي والشهري (Planner)', text: 'بجداول جاهزة لتنظيم المهام والمواعيد، مثالية لمديري المشاريع وفرق العمل' },
            { icon: 'fa-shoe-prints', title: 'دفاتر ملاحظات صغيرة (Pocket Notebook)', text: 'للحمل في الجيب، مناسبة لمندوبي المبيعات والمهندسين الميدانيين' },
            { icon: 'fa-pencil-ruler', title: 'كراسات الرسم والتخطيط', text: 'بأوراق مخصصة أثقل وزنًا تتحمل ألوان الرصاص والفحم دون تمزق' },
          ]} />

          <h3>دفاتر مطبوعة بشعار شركتك</h3>
          <p>تُعدّ الدفاتر المطبوعة بشعار الشركة من أكثر هدايا الشركات شيوعًا وتأثيرًا. في نيو جولدن أوفيس نوفر خدمة طباعة احترافية على الدفاتر والمفكرات تشمل طباعة الشعار على الغلاف الأمامي، وطباعة اسم الشركة ومعلومات الاتصال على الصفحة الداخلية الأولى، بالإضافة إلى إمكانية تخصيص الألوان لتتوافق مع هوية علامتك التجارية.</p>
          <p>نقدم هذه الخدمة بأسعار تنافسية جدًا عند الطلب بالجملة، مع ضمان جودة الطباعة ووضوح الألوان. يمكنك اختيار نوع الدفتر الذي يناسب ميزانيتك من بين خياراتنا المتعددة، بدءًا من الدفاتر الاقتصادية للتوزيع الواسع، وصولًا إلى المفكرات التنفيذية الفاخرة.</p>

          <MidPageCTA formId="offNotebooksMidCta" />

          <h3>دليل اختيار وزن الورق ونوع التسطير</h3>
          <p>
            كثير من العملاء يركزون على شكل الغلاف فقط ويغفلون عن العامل الأهم في تجربة الكتابة: جودة الورق الداخلي. وزن الورق يُقاس بالجرام لكل متر مربع (GSM)، وكلما ارتفع الرقم زادت سماكة الورقة ومقاومتها لنزّ الحبر من الوجه الآخر. للاستخدام العادي بالقلم الجاف يكفي وزن 70 جرام، أما إذا كان فريقك يستخدم أقلام الجل أو الحبر السائل أو الماركر بكثرة، فننصح بورق 80 جرام فأعلى لضمان صفحات نظيفة على الوجهين. المفكرات التنفيذية الفاخرة التي نوفرها تأتي غالبًا بورق يتراوح بين 90 و100 جرام مع لمسة كريمية مريحة للعين.
          </p>
          <p>
            أما نوع التسطير فيُحدَّد حسب طبيعة الاستخدام: <strong>الورق المسطر (Lined)</strong> هو الخيار التقليدي الأنسب للمحاضر والتقارير والمراسلات النصية، ويتوفر لدينا بتباعد أسطر عادي وتباعد واسع للكتابة الكبيرة. <strong>ورق المربعات (Grid/Squared)</strong> يفضله المهندسون والمحاسبون ومسؤولو المخازن لرسم الجداول والحسابات اليدوية بدقة. أما <strong>الورق المنقط (Dot Grid)</strong> فهو خيار عصري يجمع بين حرية الصفحة البيضاء وانتظام الكتابة، وينتشر حاليًا بين من يستخدمون أسلوب تنظيم المهام اليدوي (Bullet Journal) ومخططي الجداول الزمنية. وللرسم الحر والتخطيط الهندسي نوفر أيضًا <strong>الصفحات البيضاء الكاملة (Blank/Plain)</strong> دون أي تسطير.
          </p>

          <h3>أنواع التجليد ومتانتها</h3>
          <IconCardGrid columns={2} items={[
            { icon: 'fa-circle-notch', title: 'تجليد حلزوني سلكي (Wire-O)', text: 'يسمح بفتح الدفتر 360 درجة وطيه للخلف، مثالي لمن يكتب أثناء الوقوف أو في الاجتماعات المتنقلة، لكنه أقل صلابة عند التخزين الطويل بكثافة' },
            { icon: 'fa-cut', title: 'تجليد خياطة (Sewn/Stitched)', text: 'الصفحات مخيطة من المنتصف في طبقات (Signatures)، وهو الأكثر متانة ويحافظ على تماسك الصفحات حتى مع الاستخدام اليومي المكثف لسنوات' },
            { icon: 'fa-tint', title: 'تجليد لاصق (Perfect Binding)', text: 'شائع في الدفاتر الاقتصادية متوسطة السماكة، اقتصادي التكلفة لكنه أقل قدرة على الفتح المسطح الكامل' },
            { icon: 'fa-shield-alt', title: 'غلاف صلب مقوى (Hardcover)', text: 'يحمي الصفحات الداخلية من الطي والتجعد أثناء النقل داخل الحقيبة، خيار مثالي للمفكرات التنفيذية التي تُستخدم يوميًا خارج المكتب' },
          ]} />

          <h3>دفاتر لكل قطاع: من المدرسة إلى المستشفى إلى الوزارة</h3>
          <p>
            نتعامل مع قطاعات مختلفة تمامًا في احتياجاتها من الدفاتر، ولكل قطاع اعتباراته الخاصة. <strong>المدارس والمراكز التعليمية</strong> تحتاج كميات كبيرة من الكراسات الاقتصادية بأغلفة بلاستيكية متينة تتحمل الاستخدام اليومي للطلاب، مع إمكانية طباعة اسم المدرسة وشعارها على الغلاف لتوحيد الهوية بين الفصول. <strong>المستشفيات والعيادات</strong> غالبًا ما تطلب دفاتر بغلاف صلب لسجلات المتابعة اليومية وتقارير المناوبات، حيث تستلزم طبيعة العمل صفحات لا تتلف بسهولة مع كثرة التقليب. <strong>الجهات الحكومية</strong> تفضل عادة الدفاتر ذات الطابع الرسمي بغلاف مقوى داكن اللون ومقاس A4 الموحد لتوثيق المحاضر والقرارات. أما <strong>الشركات والمكاتب الخاصة</strong> فتميل إلى المفكرات التنفيذية الأنيقة كهدايا للعملاء والموظفين، أو الدفاتر الحلزونية العملية للاستخدام اليومي في الاجتماعات وورش العمل الداخلية.
          </p>

          <h3>نصائح الحفظ والعناية بالدفاتر</h3>
          <p>
            لضمان بقاء الدفاتر في أفضل حالاتها سواء لديك مخزون كبير أو استخدام شخصي، احفظها في مكان جاف بعيدًا عن أشعة الشمس المباشرة التي قد تُصفّر الأغلفة الفاتحة مع الوقت، وتجنب الرطوبة التي قد تجعّد الصفحات أو تُلصقها ببعضها. للمخزون الكبير المخصص للتوزيع أو الهدايا المؤسسية، يُفضل تركه داخل كراتينه الأصلية على أرفف مرتفعة عن الأرض حتى موعد الاستخدام، وتجنب تكديس أوزان ثقيلة فوقه لفترات طويلة حتى لا تتشوه الأغلفة الصلبة.
          </p>

          <h3>دفاتر بورق معاد تدويره وخيارات صديقة للبيئة</h3>
          <p>
            مع تزايد اهتمام الشركات بالاستدامة، نوفر أيضًا دفاتر مصنوعة من ورق معاد تدويره جزئيًا أو كليًا، بلمسة طبيعية خام على الغلاف بدلًا من الطلاء اللامع التقليدي. هذا الخيار مناسب للشركات التي تريد أن تعكس هويتها البيئية في هدايا المؤتمرات والمعارض، أو المؤسسات التعليمية التي تدرّس مفاهيم الاستدامة لطلابها عمليًا من خلال الأدوات التي تستخدمها. الجودة الكتابية لا تقل عن الدفاتر التقليدية، والفرق الوحيد هو درجة اللون الطبيعية القريبة من البيج بدلًا من الأبيض الناصع.
          </p>

          <h3>كيف تحسب الكمية المناسبة لشركتك؟</h3>
          <p>
            لتقدير الكمية السنوية المناسبة، يمكنك الاعتماد على قاعدة تقريبية بسيطة: الموظف المكتبي العادي يستهلك ما بين دفترين إلى ثلاثة دفاتر متوسطة الحجم سنويًا للاستخدام اليومي في تدوين الملاحظات والاجتماعات، بينما فرق المبيعات والمهندسون الميدانيون قد يحتاجون دفترًا صغيرًا كل شهر إلى شهرين نظرًا لطبيعة عملهم المتنقلة. للمدارس، يُحسب الأمر عادة بمعدل دفتر أو كراسة واحدة لكل مادة دراسية لكل طالب في الفصل الدراسي الواحد. مشاركة هذه الأرقام التقريبية مع فريقنا عند طلب عرض السعر تساعدنا على اقتراح الكمية والتوقيت الأنسب لتوريدك على دفعات متتالية بدلًا من شراء كمية ضخمة دفعة واحدة قد تحتاج مساحة تخزين كبيرة.
          </p>

          <h3>أسعار الجملة والتوصيل</h3>
          <p>نقدم في نيو جولدن أوفيس أسعار جملة حقيقية للطلبات الكبيرة، مع خصومات تصاعدية كلما زادت الكمية المطلوبة. نوفر خدمة توصيل سريعة وموثوقة إلى جميع محافظات مصر خلال 24 إلى 48 ساعة من تأكيد الطلب. للاستفسار عن الأسعار وعروض الجملة، تواصل معنا على الرقم 01227392074.</p>

        </div>

        <div class="service-sidebar">
          <div class="sidebar-card">
            <h4>المستلزمات المكتبية</h4>
            <div class="sidebar-services">
              <a href="/office-supplies/a4-paper" class="sidebar-service-link"><span>ورق A4 وطباعة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/thermal" class="sidebar-service-link"><span>ورق حراري وكاشير</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/pens" class="sidebar-service-link"><span>أقلام وأدوات كتابة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/notebooks" class="sidebar-service-link active"><span>دفاتر ومفكرات</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/files" class="sidebar-service-link"><span>ملفات وأرشفة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/stamps" class="sidebar-service-link"><span>أختام ومستلزمات</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/envelopes" class="sidebar-service-link"><span>أظرف وتغليف</span><i class="fas fa-angle-left"></i></a>
