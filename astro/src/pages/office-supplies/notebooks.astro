---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getSeoFor } from '../../lib/siteSeo';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "دفاتر ومفكرات",
  "description": "دفاتر ومفكرات مكتبية في مصر — مقاسات وأنواع متعددة للمكاتب والمدارس والشركات.",
  "serviceType": "دفاتر مكتبية",
  "provider": {
    "@type": "LocalBusiness",
    "name": "نيو جولدن أوفيس",
    "url": "https://newgoldenoffice.com",
    "telephone": "+201227392074",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "26 عبد المنعم سند",
      "addressLocality": "الإبراهيمية، باب شرق",
      "addressRegion": "الإسكندرية",
      "addressCountry": "EG"
    }
  },
  "areaServed": { "@type": "Country", "name": "Egypt" }
});
---
<BaseLayout
  {...getSeoFor('/office-supplies/notebooks')}
  schemaJson={schemaJson}
  preloadImage="/images/office-supplies-hub.webp"
>
  <PageHero
    title="دفاتر ومفكرات وكراسات في مصر"
    subtitle="نيو جولدن أوفيس — مورد الدفاتر والمفكرات المكتبية في مصر. دفاتر حلزونية، مفكرات تنفيذية، وكراسات بالجملة للشركات والمكاتب"
    heroImage="/images/office-supplies-hub.webp"
    heroIcon="fa-book"
    breadcrumbs={[
      { label: 'الرئيسية', href: '/' },
      { label: 'مستلزمات مكتبية', href: '/office-supplies' },
      { label: 'دفاتر ومفكرات' }
    ]}
  />

  <section class="section">
    <div class="container">
      <div class="service-detail-grid">

        <div class="service-content">

          <h2>تشكيلة الدفاتر والمفكرات</h2>
          <p>في نيو جولدن أوفيس، نقدم تشكيلة واسعة ومتنوعة من الدفاتر والمفكرات التي تلبي احتياجات الشركات والمكاتب والمؤسسات التعليمية في جميع أنحاء مصر. نحرص على توفير منتجات عالية الجودة تجمع بين المتانة والأناقة، مع الحفاظ على أسعار تنافسية تناسب عمليات الشراء بالجملة.</p>
          <p>نتعامل مع أفضل الموردين والمصنعين المحليين والدوليين لضمان الحصول على منتجات تستوفي أعلى معايير الجودة. كل دفتر يُختار بعناية ليضمن ورقًا ناعمًا لا يُنزّ الحبر، وغلافًا متينًا يحمي المحتوى، وتجليدًا محكمًا يتحمل الاستخدام اليومي المكثف.</p>

          <h3>أنواع الدفاتر المتاحة</h3>
          <ul>
            <li>دفاتر حلزونية بأحجام A4 وA5 بأغطية صلبة وناعمة</li>
            <li>دفاتر مقواة بغلاف صلب للاستخدام التنفيذي والمهني</li>
            <li>لوحات كتابة قانونية (Legal Pad) بأحجام متعددة</li>
            <li>مفكرات تنفيذية فاخرة بتصاميم راقية للمدراء</li>
            <li>كراسات مسطرة وسادة (بلانك) وبمربعات للاستخدامات المختلفة</li>
            <li>دفاتر التخطيط اليومي والأسبوعي والشهري (Planner)</li>
            <li>دفاتر ملاحظات صغيرة (Pocket Notebook) للحمل في الجيب</li>
            <li>كراسات الرسم والتخطيط بأوراق مخصصة</li>
          </ul>

          <h3>دفاتر مطبوعة بشعار شركتك</h3>
          <p>تُعدّ الدفاتر المطبوعة بشعار الشركة من أكثر هدايا الشركات شيوعًا وتأثيرًا. في نيو جولدن أوفيس نوفر خدمة طباعة احترافية على الدفاتر والمفكرات تشمل طباعة الشعار على الغلاف الأمامي، وطباعة اسم الشركة ومعلومات الاتصال على الصفحة الداخلية الأولى، بالإضافة إلى إمكانية تخصيص الألوان لتتوافق مع هوية علامتك التجارية.</p>
          <p>نقدم هذه الخدمة بأسعار تنافسية جدًا عند الطلب بالجملة، مع ضمان جودة الطباعة ووضوح الألوان. يمكنك اختيار نوع الدفتر الذي يناسب ميزانيتك من بين خياراتنا المتعددة، بدءًا من الدفاتر الاقتصادية للتوزيع الواسع، وصولًا إلى المفكرات التنفيذية الفاخرة.</p>

          <h3>أسعار الجملة والتوصيل</h3>
          <p>نقدم في نيو جولدن أوفيس أسعار جملة حقيقية للطلبات الكبيرة، مع خصومات تصاعدية كلما زادت الكمية المطلوبة. نوفر خدمة توصيل سريعة وموثوقة إلى جميع محافظات مصر خلال 24 إلى 48 ساعة من تأكيد الطلب. للاستفسار عن الأسعار وعروض الجملة، تواصل معنا على الرقم 01227392074.</p>

        </div>

        <div class="service-sidebar">
          <div class="sidebar-card">
            <h4>المستلزمات المكتبية</h4>
            <div class="sidebar-services">
              <a href="/office-supplies/a4-paper" class="sidebar-service-link"><span>ورق A4 وطباعة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/thermal" class="sidebar-service-link"><span>ورق حراري وكاشير</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/pens" class="sidebar-service-link"><span>أقلام وأدوات كتابة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/notebooks" class="sidebar-service-link active"><span>دفاتر ومفكرات</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/files" class="sidebar-service-link"><span>ملفات وأرشفة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/stamps" class="sidebar-service-link"><span>أختام ومستلزمات</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/envelopes" class="sidebar-service-link"><span>أظرف وتغليف</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/whiteboards" class="sidebar-service-link"><span>وايت بورد وفلين بورد</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/binding" class="sidebar-service-link"><span>أدوات ربط ودباسة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/sticky-notes" class="sidebar-service-link"><span>بوست إت وورق لاصق</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/batteries-usb" class="sidebar-service-link"><span>بطاريات وUSB</span><i class="fas fa-angle-left"></i></a>
            </div>
          </div>
          <div class="sidebar-card">
            <h4>تواصل معنا</h4>
            <div class="contact-info">
              <div class="contact-info-item"><i class="fas fa-phone"></i><span>01227392074</span></div>
              <div class="contact-info-item"><i class="fas fa-clock"></i><span>السبت - الخميس: 9ص - 6م</span></div>
            </div>
            <a href="/contact" class="btn btn-primary btn-sm" style="width:100%;text-align:center;margin-top:16px">اتصل بنا</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="section section-bg">
    <div class="container">
      <div class="section-header">
        <div class="section-tag">كيف نعمل</div>
        <h2>احصل على دفاترك في 3 خطوات بسيطة</h2>
        <div class="divider"></div>
      </div>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">1</div>
          <h4>اختر نوع الدفتر</h4>
          <p>تصفح تشكيلتنا الواسعة من الدفاتر والمفكرات واختر النوع والمقاس والتصميم الذي يناسب احتياجاتك سواء للاستخدام اليومي أو الهدايا المؤسسية</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <h4>حدد الكمية والطباعة</h4>
          <p>أخبرنا بالكمية المطلوبة وهل تريد طباعة شعار شركتك على الدفاتر. سنرسل لك عرض سعر مفصل خلال دقائق مع أفضل الخيارات المتاحة</p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <h4>استلم طلبك</h4>
          <p>نجهز طلبك بسرعة ونوصله إلى باب مكتبك أو شركتك في أسرع وقت ممكن مع ضمان سلامة المنتجات وجودتها حتى وصولها إليك</p>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section" style="padding:60px 0;background:#f8f9fa">
    <div class="container">
      <h2 style="font-size:1.8rem;font-weight:700;color:#1a1a2e;margin-bottom:24px">دفاتر بشعار شركتك — طباعة مخصصة بالجملة</h2>
      <p style="font-size:1.05rem;line-height:1.9;color:#444;margin-bottom:16px">نوفر دفاتر مكتبية مطبوعة بشعار شركتك وألوانك للشركات والفنادق والمستشفيات في مصر. مثالية كهدايا ترويجية أو لتوحيد هوية الشركة في الاجتماعات:</p>
      <ul style="list-style:none;padding:0;line-height:2.2;color:#444">
        <li>✅ غلاف مطبوع بشعارك وألوان علامتك التجارية</li>
        <li>✅ حجم وعدد صفحات حسب طلبك (A4, A5, A6)</li>
        <li>✅ خطوط، مربعات، أو صفحات بيضاء</li>
        <li>✅ كميات من 50 دفتر فأكثر</li>
        <li>✅ توصيل لجميع أنحاء مصر</li>
      </ul>
      <p style="font-size:1rem;color:#555;margin-top:16px">نخدم عملاءنا في القاهرة والإسكندرية وجميع محافظات مصر — تواصل معنا للحصول على عينة وعرض سعر.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div class="section-tag">أسئلة شائعة</div>
        <h2>كل ما تريد معرفته عن الدفاتر والمفكرات</h2>
        <div class="divider"></div>
      </div>
      <div class="faq-list">

        <div class="faq-item">
          <div class="faq-question">ما هي أحجام الدفاتر المتوفرة لديكم؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">نوفر الدفاتر بجميع الأحجام الشائعة في السوق المصري، وتشمل: مقاس A4 (21×29.7 سم) للاستخدام المكتبي العام، ومقاس A5 (14.8×21 سم) للمفكرات الشخصية والحمل اليومي، ومقاس B5 المتوسط، ومقاسات الجيب (Pocket) للملاحظات السريعة. كما نوفر مقاسات Legal وLetter للأسواق التي تستخدم هذه المقاسات.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">هل يمكنكم طباعة شعار شركتي على الدفاتر؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">نعم، نقدم خدمة الطباعة المخصصة على جميع أنواع الدفاتر والمفكرات. يمكننا طباعة شعار شركتك وبياناتها على الغلاف الخارجي وكذلك على الصفحة الأولى الداخلية. نستخدم تقنيات طباعة متقدمة تضمن وضوح الألوان وثباتها. فقط أرسل لنا ملف الشعار بصيغة عالية الدقة (AI, EPS, PDF) وسيتولى فريقنا الباقي.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">ما هو الحد الأدنى لطلبات الجملة؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">يختلف الحد الأدنى للطلب حسب نوع الدفتر والخدمة المطلوبة. للدفاتر العادية بدون طباعة، يمكن الطلب من كمية صغيرة. أما للدفاتر المطبوعة بشعار الشركة، فيبدأ الحد الأدنى من 50 قطعة لضمان جودة الطباعة وتحقيق سعر اقتصادي مناسب.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">كم يستغرق وقت تسليم الطلبات؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">للطلبات العادية بدون طباعة: يتم التسليم خلال 24 إلى 48 ساعة من تأكيد الطلب في الإسكندرية والمحافظات المجاورة. للطلبات المطبوعة بشعار الشركة: يحتاج الأمر من 5 إلى 10 أيام عمل حسب الكمية وتعقيد التصميم. نحرص دائمًا على الالتزام بمواعيد التسليم المتفق عليها.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">ما الفرق بين الدفاتر الحلزونية والدفاتر ذات الغلاف الصلب؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">الدفاتر الحلزونية (Spiral): تتميز بأنها تُفتح بشكل مسطح تمامًا مما يسهل الكتابة، ويمكن طي الغلاف للخلف للكتابة بيد واحدة، وهي الأنسب للاستخدام اليومي والاجتماعات. الدفاتر ذات الغلاف الصلب (Hardcover): تتميز بمتانة أعلى وعمر أطول، وتحافظ على شكلها الأنيق، وهي الأنسب للمفكرات التنفيذية والهدايا المؤسسية الفاخرة.</div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="cta-banner">
    <div class="container">
      <h2>احصل على دفاتر ومفكرات بالجملة</h2>
      <p>تواصل معنا الآن واحصل على عرض سعر مخصص لاحتياجات شركتك — توصيل سريع لجميع محافظات مصر</p>
      <div class="btn-group">
        <a href="/contact" class="btn btn-secondary btn-lg">اطلب عرض سعر</a>
        <a href="tel:01227392074" class="btn btn-outline-white btn-lg"><i class="fas fa-phone"></i> 01227392074</a>
      </div>
    </div>
  </section>
</BaseLayout>
