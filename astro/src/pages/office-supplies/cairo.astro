---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://newgoldenoffice.com/office-supplies/cairo#service",
      "name": "توريد أدوات ومستلزمات مكتبية في القاهرة",
      "serviceType": "توريد أدوات مكتبية بالجملة للشركات",
      "url": "https://newgoldenoffice.com/office-supplies/cairo",
      "areaServed": { "@type": "City", "name": "القاهرة" },
      "provider": { "@id": "https://newgoldenoffice.com/#organization" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"أين أشتري أدوات مكتبية بالجملة في القاهرة؟","acceptedAnswer":{"@type":"Answer","text":"من مورد شركات مباشر لا من متاجر التجزئة. نيو جولدن أوفيس تورد الأدوات المكتبية بالجملة لكل مناطق القاهرة التجارية الرئيسية بمسارات تسليم مجدولة، مع فاتورة ضريبية."}},
        {"@type":"Question","name":"ما هي أسعار الأدوات المكتبية بالجملة في القاهرة؟","acceptedAnswer":{"@type":"Answer","text":"السعر يتحدد بالمواصفات والماركة والكمية وحجم التعاقد. كلما زادت الكمية وانتظم التوريد انخفض سعر الوحدة."}},
        {"@type":"Question","name":"هل يوجد توريد للشركات والمصانع والمكتبات؟","acceptedAnswer":{"@type":"Answer","text":"نعم، هذا هو نشاطنا الأساسي. نورد للشركات بعقود دورية، وللمصانع بكميات كبيرة مجدولة، وللمكتبات بأسعار جملة لإعادة البيع."}},
        {"@type":"Question","name":"ما مناطق التوصيل داخل القاهرة؟","acceptedAnswer":{"@type":"Answer","text":"مساراتنا المجدولة تغطي التجمع الخامس ومدينة نصر والمعادي والقاهرة الجديدة ووسط البلد المالي."}},
        {"@type":"Question","name":"ما الحد الأدنى للطلب عند الشراء بالجملة؟","acceptedAnswer":{"@type":"Answer","text":"يختلف حسب الأصناف والكميات. الطلبات التي تتجاوز الحد الأدنى تحصل على توصيل مجاني حتى مقر الشركة."}},
        {"@type":"Question","name":"هل توفرون عقود توريد دورية للشركات في القاهرة؟","acceptedAnswer":{"@type":"Answer","text":"نعم، نحدد معك قائمة أصناف واستهلاكًا شهريًا تقريبيًا، ويتولى مندوب الحساب المخصص المتابعة والتجديد تلقائيًا."}},
        {"@type":"Question","name":"هل توفرون فاتورة ضريبية للشركات والجهات الحكومية؟","acceptedAnswer":{"@type":"Answer","text":"نعم، كل توريداتنا بفاتورة ضريبية معتمدة، ونقدم عروض أسعار رسمية مكتوبة."}},
        {"@type":"Question","name":"كيف أختار مورد أدوات مكتبية موثوقًا لشركتي؟","acceptedAnswer":{"@type":"Answer","text":"تحقق من ستة أشياء: هوية شركة واضحة، فاتورة ضريبية، عينات قبل التعاقد، مندوب مسؤول ثابت، مرونة في الكميات، وقدرة على تغطية أكثر من فئة تجهيزات."}}
      ]
    }
  ]
});
---

<BaseLayout
  title="شركة أدوات مكتبية في القاهرة | توريد بالجملة للشركات"
  description="شركة أدوات مكتبية في القاهرة بخبرة 27 عامًا: توريد بالجملة للشركات والمصانع بعقود دورية وفاتورة ضريبية ومندوب حساب مخصص. اطلب عرض سعر الآن."
  keywords="شركة أدوات مكتبية في القاهرة، توريد مستلزمات مكتبية للشركات بالقاهرة، مستلزمات مكتبية بالجملة القاهرة"
  ogTitle="شركة أدوات مكتبية في القاهرة | نيو جولدن أوفيس"
  ogDescription="توريد بالجملة للشركات والمصانع بعقود دورية وفاتورة ضريبية ومندوب حساب مخصص في القاهرة."
  ogImage="/images/office-supplies-hub.webp"
  robots="noindex, nofollow"
  schemaJson={schemaJson}
>
<style>
  .quote-section{padding:60px 0}
  .quote-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:stretch}
  .quote-form-card{background:#fff;border-radius:18px;padding:2.2rem;box-shadow:0 4px 24px rgba(27,58,107,0.1)}
  .quote-form-card h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:700;color:var(--green-dark);margin-bottom:1.5rem}
  .form-group{margin-bottom:1.1rem}
  .form-group label{display:block;font-family:'Cairo',sans-serif;font-size:0.95rem;font-weight:600;color:var(--green-dark);margin-bottom:0.4rem}
  .form-group input,.form-group select,.form-group textarea{width:100%;padding:0.8rem 1rem;border:2px solid #e5eaf3;border-radius:10px;font-family:'Tajawal',sans-serif;font-size:1rem;color:#333;background:#fafbfd;transition:border-color .3s,box-shadow .3s;outline:none;box-sizing:border-box;direction:rtl}
  .form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--green-dark);box-shadow:0 0 0 3px rgba(27,58,107,.1);background:#fff}
  .form-group textarea{height:100px;resize:vertical}
  .form-submit-btn{width:100%;padding:1rem;background:linear-gradient(135deg,var(--green-dark),var(--green-mid));color:#fff;border:none;border-radius:12px;font-family:'Cairo',sans-serif;font-size:1.05rem;font-weight:700;cursor:pointer;transition:transform .3s,box-shadow .3s;display:flex;align-items:center;justify-content:center;gap:.5rem}
  .form-submit-btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(27,58,107,.25)}
  .success-message{display:none;background:linear-gradient(135deg,#e8f5e9,#f1f8e9);border:2px solid #4caf50;border-radius:12px;padding:1.5rem;text-align:center;margin-top:1rem}
  .success-message i{font-size:2.5rem;color:#4caf50;display:block;margin-bottom:.5rem}
  .success-message p{font-family:'Cairo',sans-serif;font-size:1.05rem;color:#2e7d32;font-weight:600}
  .quote-alt-card{background:linear-gradient(135deg,#25D366 0%,#128C7E 100%);border-radius:18px;padding:2.4rem;text-align:center;color:#fff;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:1rem}
  .quote-alt-card .wa-icon{font-size:3rem}
  .quote-alt-card h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:800}
  .quote-alt-card p{opacity:.92;line-height:1.8}
  @media(max-width:768px){.quote-grid{grid-template-columns:1fr}}
</style>

<section class="page-hero">
  <div class="container">
    <div class="page-hero-inner">
      <div class="page-hero-content">
        <nav class="breadcrumb">
          <a href="/">الرئيسية</a>
          <span>/</span>
          <a href="/cairo">خدماتنا في القاهرة</a>
          <span>/</span>
          <span class="current">شركة أدوات مكتبية في القاهرة</span>
        </nav>
        <h1 class="reveal">شركة أدوات مكتبية في القاهرة</h1>
        <p class="lead reveal delay-1">توريد بالجملة للشركات والمصانع والمكتبات، عقود دورية بفاتورة ضريبية، ومندوب حساب مخصص يتابع مخزونك قبل أن ينفد</p>
      </div>
      <div class="page-hero-image">
        <img src="/images/webp-images/neat-stack-of-white-paper-on-a-black-surface-2026-04-07-00-06-05-utc.webp" alt="شركة أدوات مكتبية في القاهرة" loading="eager">
      </div>
    </div>
  </div>
</section>

<section class="stats-section">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item reveal"><div class="stat-num" data-target="27" data-suffix="+">0+</div><div class="stat-label">سنة خبرة في خدمة الشركات</div></div>
      <div class="stat-item reveal delay-1"><div class="stat-num" data-target="6">0</div><div class="stat-label">فئات منتجات كاملة</div></div>
      <div class="stat-item reveal delay-2"><div class="stat-num" data-target="5">0</div><div class="stat-label">مناطق أعمال نغطيها بجدول ثابت</div></div>
      <div class="stat-item reveal delay-3"><div class="stat-num" data-target="1">0</div><div class="stat-label">مندوب حساب مخصص لكل عميل</div></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="intro-text" style="max-width:900px;margin:0 auto 48px;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>مكتبك لا يجب أن يتوقف أبدًا بسبب نفاد الورق أو الأحبار أو الملفات. نيو جولدن أوفيس شركة أدوات مكتبية في القاهرة تتولى عنك ملف التوريدات المكتبية بالكامل: كتالوج شامل، أسعار جملة حقيقية، عقود توريد دورية بفاتورة ضريبية، ومندوب حساب مخصص يعرف احتياجات شركتك ويتوقعها قبل أن تطلب. خبرة 27 عامًا في خدمة الشركات والمؤسسات، وتغطية كاملة لمناطق القاهرة التجارية: التجمع الخامس، مدينة نصر، المعادي، القاهرة الجديدة، ووسط البلد المالي.</p>
    </div>

    <div class="section-header">
      <h2>لماذا نيو جولدن أوفيس شركة أدوات مكتبية موثوقة في القاهرة؟</h2>
      <div class="divider"></div>
    </div>
    <div class="features-grid">
      <div class="feature-card reveal"><div class="feature-icon"><i class="fas fa-award"></i></div><h4>خبرة 27 عامًا</h4><p>بدأت من مقرنا الرئيسي بالإسكندرية وامتدت لتغطية القاهرة بخدمة كاملة.</p></div>
      <div class="feature-card reveal delay-1"><div class="feature-icon"><i class="fas fa-file-invoice"></i></div><h4>هوية واضحة وتعامل رسمي</h4><p>فواتير ضريبية معتمدة وعقود توريد موثقة تناسب الشركات والجهات الحكومية.</p></div>
      <div class="feature-card reveal delay-2"><div class="feature-icon"><i class="fas fa-medal"></i></div><h4>ضمان جودة الأصناف</h4><p>ماركات معروفة ومجربة، وأي صنف لا يطابق المواصفات يُستبدل دون جدال.</p></div>
      <div class="feature-card reveal delay-3"><div class="feature-icon"><i class="fas fa-headset"></i></div><h4>دعم عملاء فعلي</h4><p>مندوب حساب مخصص لكل عميل شركات، يرد ويتابع ويحل أي ملاحظة.</p></div>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>توريد مستلزمات مكتبية للشركات بالقاهرة — كتالوج ما نوفره</h2>
      <div class="divider"></div>
    </div>
    <div class="services-grid">
      <div class="service-card reveal"><div class="service-icon"><i class="fas fa-copy"></i></div><h3 class="service-title">أوراق التصوير والطباعة</h3><p class="service-desc">كل المقاسات والجرامات، من ورق التصوير اليومي إلى أوراق الطباعة الخاصة بالتقارير والعروض.</p></div>
      <div class="service-card reveal delay-1"><div class="service-icon"><i class="fas fa-pen"></i></div><h3 class="service-title">أقلام وأدوات الكتابة</h3><p class="service-desc">أقلام جاف وحبر ورصاص وماركرات، بماركات معروفة ودرجات سعرية متعددة.</p></div>
      <div class="service-card reveal delay-2"><div class="service-icon"><i class="fas fa-box-archive"></i></div><h3 class="service-title">ملفات وأنظمة الأرشفة</h3><p class="service-desc">ملفات، حوافظ، بوكس فايل، فواصل، ودواليب أرشفة مكتبية حسب حجم المستندات.</p></div>
      <div class="service-card reveal delay-3"><div class="service-icon"><i class="fas fa-book"></i></div><h3 class="service-title">دفاتر وكشاكيل ومطبوعات المكتب</h3><p class="service-desc">دفاتر ملاحظات، كشاكيل، بلوكات، ودفاتر إيصالات وحسابات بمقاسات مختلفة.</p></div>
      <div class="service-card reveal"><div class="service-icon"><i class="fas fa-fill-drip"></i></div><h3 class="service-title">أحبار ومستلزمات الطباعة</h3><p class="service-desc">أحبار وتونر لأشهر الماكينات، مع إمكانية توحيد التوريد مع أحبار ماكينات التصوير.</p><a href="/copiers/cartridges" class="btn btn-outline btn-sm">أحبار وتونر <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal delay-1"><div class="service-icon"><i class="fas fa-thumbtack"></i></div><h3 class="service-title">أدوات مكتبية متنوعة</h3><p class="service-desc">دباسات، خرامات، مقصات، لاصقات، منظمات مكتب، سبورات، ومستلزمات قاعات الاجتماعات.</p></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>البيع بالجملة وتوريدات الأدوات المكتبية للشركات والمؤسسات</h2>
      <div class="divider"></div>
    </div>
    <div class="intro-text" style="max-width:900px;margin:0 auto;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p style="text-align:center">نحن مورد B2B بالدرجة الأولى. عملاؤنا الأساسيون في القاهرة هم الشركات والمؤسسات والمصانع والمكتبات، ولكل فئة منهم نظام توريد يناسبها:</p>
      <ul style="max-width:750px;margin:24px auto 0;padding-inline-start:20px;line-height:2.1">
        <li><strong>الشركات والمكاتب الإدارية:</strong> توريد شهري أو أسبوعي لكل مستلزمات المكتب بقائمة أصناف ثابتة وأسعار جملة متفق عليها.</li>
        <li><strong>المصانع والمنشآت الكبيرة:</strong> توريدات بكميات كبيرة لإدارات الشؤون الإدارية والمخازن.</li>
        <li><strong>المكتبات ومحلات الأدوات المكتبية:</strong> أسعار جملة لإعادة البيع وتشكيلات موسمية.</li>
        <li><strong>الجهات والمؤسسات الرسمية:</strong> تعامل مستندي كامل بعروض أسعار رسمية وفاتورة ضريبية معتمدة.</li>
      </ul>
    </div>
  </div>
</section>

<MidPageCTA formId="offCairoMidCta" />

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>كيف نخدم القاهرة بهذه الكفاءة بدون فرع؟</h2>
      <div class="divider"></div>
    </div>
    <p style="max-width:800px;margin:0 auto 32px;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">سؤال منطقي، وإجابته نقطة قوتنا لا نقطة ضعفنا: نظام تشغيل مبني على الانضباط لا على قرب المسافة.</p>
    <div class="steps-grid">
      <div class="step-card reveal"><div class="step-num">1</div><h4>مسارات تسليم مجدولة</h4><p>سياراتنا تغطي مناطق القاهرة التجارية بجدول ثابت، فتعرف شركتك مسبقًا موعد وصول طلبها.</p></div>
      <div class="step-card reveal delay-1"><div class="step-num">2</div><h4>مندوب حساب مخصص</h4><p>يتابع مخزونك الدوري، ويذكّرك قبل نفاد الأصناف الأساسية، ويحل أي ملاحظة فورًا.</p></div>
      <div class="step-card reveal delay-2"><div class="step-num">3</div><h4>حد أدنى للتوصيل المجاني</h4><p>طلبات الشركات التي تتجاوز الحد الأدنى تصل مجانًا حتى باب مقرك.</p></div>
    </div>
    <p style="max-width:800px;margin:24px auto 0;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">عدم تحميل عملائنا تكلفة فرع إضافي في القاهرة يعني أسعار جملة أفضل بنفس مستوى الخدمة: انتظام وقابلية للتخطيط وتكلفة أقل.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>عقود توريد دورية بفاتورة ضريبية</h2>
      <div class="divider"></div>
    </div>
    <div class="features-grid">
      <div class="feature-card reveal"><div class="feature-icon"><i class="fas fa-list-check"></i></div><h4>قائمة أصناف معتمدة</h4><p>نحدد معك تشكيلة الأصناف التي تستهلكها شركتك فعلًا، بالمواصفات والماركات المتفق عليها.</p></div>
      <div class="feature-card reveal delay-1"><div class="feature-icon"><i class="fas fa-calendar-days"></i></div><h4>جدول توريد ثابت</h4><p>شهري أو أسبوعي حسب حجم الاستهلاك، بمواعيد معروفة مسبقًا.</p></div>
      <div class="feature-card reveal delay-2"><div class="feature-icon"><i class="fas fa-bell"></i></div><h4>متابعة تلقائية</h4><p>مندوب الحساب يتابع مخزونك ويذكّرك قبل نفاد الأصناف الأساسية.</p></div>
      <div class="feature-card reveal delay-3"><div class="feature-icon"><i class="fas fa-sliders"></i></div><h4>مرونة في الكميات</h4><p>عدّل الكميات من شهر لآخر حسب الاستهلاك الفعلي دون التزامات جامدة.</p></div>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>ما الذي يحدد أسعار الأدوات المكتبية بالجملة؟</h2>
      <div class="divider"></div>
    </div>
    <div class="intro-text" style="max-width:900px;margin:0 auto;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <ul style="max-width:700px;margin:0 auto;padding-inline-start:20px;line-height:2.1">
        <li><strong>المواصفات والماركة:</strong> ورق 80 جرام يختلف عن 70 جرام، والقلم الياباني يختلف عن البديل الاقتصادي.</li>
        <li><strong>الكمية:</strong> سعر الكرتونة غير سعر العشر كراتين. كلما زادت الكمية انخفض سعر الوحدة.</li>
        <li><strong>حجم التعاقد ومدته:</strong> عقود التوريد الدورية تحصل على أسعار أفضل من الطلبات المتفرقة.</li>
        <li><strong>تشكيلة الطلب:</strong> توحيد كل احتياجاتك المكتبية في توريدة واحدة يخفض تكلفة التشغيل والتسليم.</li>
      </ul>
      <p style="margin-top:20px;text-align:center">أرسل لنا قائمة الأصناف والكميات على 01227392074 وستصلك تسعيرة رسمية مفصلة مع بدائل اقتصادية حيث أمكن.</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>تغطيتنا داخل القاهرة حيًا بحي</h2>
      <div class="divider"></div>
    </div>
    <div class="features-grid">
      <div class="feature-card reveal"><div class="feature-icon"><i class="fas fa-city"></i></div><h4>التجمع الخامس</h4><p>مقار الشركات الحديثة، توريد دوري منتظم لمستلزمات المكاتب الكبيرة.</p></div>
      <div class="feature-card reveal delay-1"><div class="feature-icon"><i class="fas fa-building"></i></div><h4>مدينة نصر</h4><p>كثافة شركات ومراكز أعمال، مسار تسليم منتظم للطلبات المتكررة.</p></div>
      <div class="feature-card reveal delay-2"><div class="feature-icon"><i class="fas fa-briefcase"></i></div><h4>المعادي</h4><p>مكاتب الشركات والمقار الإقليمية، مسار تسليم مجدول بموعد معروف مسبقًا.</p></div>
