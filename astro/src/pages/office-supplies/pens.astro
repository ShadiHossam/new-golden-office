---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import PageHero from '../../components/PageHero.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';
import ContentIntro from '../../components/ContentIntro.astro';
import IconCardGrid from '../../components/IconCardGrid.astro';
import ComparisonGrid from '../../components/ComparisonGrid.astro';
import { getSeoFor } from '../../lib/siteSeo';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "أقلام وأدوات كتابة",
      "description": "أقلام وأدوات كتابة مكتبية في مصر — BIC وPilot وStabilo وأقلام تحديد ومارك للمكاتب والشركات.",
      "serviceType": "أقلام مكتبية",
      "provider": {
        "@type": "LocalBusiness",
        "name": "نيو جولدن أوفيس",
        "url": "https://newgoldenoffice.com",
        "telephone": "+201227392074",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "26 عبد المنعم سند",
          "addressLocality": "الإبراهيمية، باب شرق",
          "addressRegion": "الإسكندرية",
          "addressCountry": "EG"
        }
      },
      "areaServed": { "@type": "Country", "name": "Egypt" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"ما هي الماركات المتوفرة لديكم؟","acceptedAnswer":{"@type":"Answer","text":"نوفر مجموعة واسعة من أشهر الماركات العالمية، من بينها: BIC وPentel وPilot للأقلام الجافة والجل، وSharpie وArtline للماركر الدائم، وStaedtler وFaber-Castell للرصاص والأقلام الاحترافية، وTipp-Ex وBIC Wite-Out لسائل التصحيح."}},
        {"@type":"Question","name":"هل يمكن الشراء بكميات كبيرة للشركات والمؤسسات؟","acceptedAnswer":{"@type":"Answer","text":"بالتأكيد، نخدم الشركات والمؤسسات والمدارس والجهات الحكومية بتوريد الأقلام وأدوات الكتابة بالكميات الكبيرة بأسعار الجملة. نوفر خدمة التوريد المنتظم الشهري مع فواتير ضريبية رسمية."}},
        {"@type":"Question","name":"ما الفرق بين قلم الجل وقلم الحبر الجاف؟","acceptedAnswer":{"@type":"Answer","text":"قلم الحبر الجاف يستخدم حبرًا زيتيًا يجف فورًا عند الكتابة، مقاومًا للتلطيخ ومناسبًا للكتابة السريعة اليومية. أما قلم الجل فيستخدم حبرًا مائيًا يعطي خطًا أكثر سلاسة ولمعانًا، مفضل للتوقيعات والكتابة الاحترافية."}},
        {"@type":"Question","name":"هل أقلام الوايت بورد تُمسح بسهولة؟","acceptedAnswer":{"@type":"Answer","text":"نعم، أقلام الوايت بورد التي نوفرها مصممة خصيصًا للكتابة على السبورات البيضاء وتُمسح بسهولة بقطعة قماش جافة. يجب عدم تركها لفترات طويلة جدًا دون مسح لأن الحبر قد يُصعب مسحه."}},
        {"@type":"Question","name":"هل يوجد حد أدنى للطلب؟","acceptedAnswer":{"@type":"Answer","text":"لا يوجد حد أدنى للطلب بالنسبة للأصناف المتاحة في المخزن، يمكنك طلب علبة واحدة أو حتى قلم واحد. تسري أسعار الجملة الخاصة عادةً بدءًا من كرتونة كاملة."}},
        {"@type":"Question","name":"ما مقاس رأس القلم الأنسب لكل استخدام؟","acceptedAnswer":{"@type":"Answer","text":"مقاس 0.5mm أو 0.7mm مناسب للكتابة اليومية العادية بخط متوسط الوضوح. المقاس 1.0mm أو أعلى يعطي خطًا أعرض وأسرع تدفقًا للحبر، مفضل لمن يكتب بسرعة أو يوقع كثيرًا. أما 0.38mm أو 0.4mm فهو الأدق، ويناسب الكتابة الصغيرة والرسم الهندسي التفصيلي."}},
        {"@type":"Question","name":"كم تدوم صلاحية القلم قبل أن يجف الحبر؟","acceptedAnswer":{"@type":"Answer","text":"الأقلام الجافة والجل المغلقة جيدًا تحافظ على صلاحية الحبر لمدة تتراوح بين سنتين وثلاث سنوات من تاريخ التصنيع إذا خُزنت بعيدًا عن الحرارة الشديدة. بمجرد فتح استخدام القلم بانتظام يطيل عمره الفعلي، بينما تركه دون استخدام لأشهر طويلة قد يُجفف رأس الكتابة خاصة في أقلام الوايت بورد والماركر الدائم."}}
      ]
