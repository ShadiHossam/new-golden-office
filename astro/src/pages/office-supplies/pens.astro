});
---
<BaseLayout
  {...getSeoFor('/office-supplies/pens')}
  schemaJson={schemaJson}
  preloadImage="/images/office-supplies-hub.webp"
>
  <PageHero
    title="أقلام مكتبية وأدوات كتابة في مصر — للمكاتب والمدارس"
    subtitle="نيو جولدن أوفيس — وجهتك الأولى لشراء الأقلام وأدوات الكتابة بالجملة في مصر. ماركات عالمية وأسعار تنافسية للشركات والمؤسسات"
    heroImage="/images/office-supplies-hub.webp"
    heroIcon="fa-pen"
    breadcrumbs={[
      { label: 'الرئيسية', href: '/' },
      { label: 'مستلزمات مكتبية', href: '/office-supplies' },
      { label: 'أقلام وأدوات كتابة' }
    ]}
  />

  <section class="section">
    <div class="container">
      <div class="service-detail-grid">

        <div class="service-content">
          <ContentIntro
            heading="أقلام بالجملة مصر — مجموعة أقلام وأدوات الكتابة"
            text="منذ تأسيسها عام 1999 في الإسكندرية، وفّرت نيو جولدن أوفيس للشركات والمؤسسات والمدارس أفضل ماركات الأقلام وأدوات الكتابة العالمية بأسعار منافسة. نؤمن بأن القلم الجيد هو أساس الإنتاجية، لذلك نختار بعناية كل منتج نضعه في متجرنا ليكون على أعلى مستوى من الجودة والموثوقية."
          />
          <p>
            نقدم تشكيلة هائلة تضم مئات الأنواع والألوان والأحجام من أقلام الحبر الجاف والجل والحبر السائل وأقلام الرصاص الميكانيكية والهايلايتر وأقلام الوايت بورد والماركر الدائم. سواء كنت تبحث عن أقلام يومية بسيطة للمكتب أو أقلام فاخرة للهدايا المؤسسية، ستجد ما تبحث عنه لدينا.
          </p>

          <h3>أنواع الأقلام المتاحة</h3>
          <p>نوفر مجموعة شاملة من أقلام الكتابة لكل الاستخدامات والمناسبات:</p>
          <IconCardGrid columns={4} items={[
            { icon: 'fa-pen', title: 'أقلام حبر جاف (BIC، Pentel، Pilot)', text: 'الخيار الأمثل للكتابة اليومية في المكاتب والمدارس، بألوان أزرق وأسود وأحمر وكميات جملة بأسعار مميزة' },
            { icon: 'fa-pen-fancy', title: 'أقلام جل', text: 'تكتب بسلاسة استثنائية وتعطي خطًا دقيقًا وواضحًا، مثالية للتوقيعات والكتابة الاحترافية' },
            { icon: 'fa-pen-nib', title: 'أقلام حبر سائل (Rollerball)', text: 'تجمع بين سلاسة قلم الجل وجفاف قلم الحبر الجاف، مثالية للكتابة السريعة والمريحة' },
            { icon: 'fa-pencil-alt', title: 'أقلام رصاص ميكانيكية', text: 'بقياسات 0.5mm و0.7mm وريفيل قابلة للاستبدال، مناسبة للرسم الهندسي والكتابة الدقيقة' },
            { icon: 'fa-highlighter', title: 'أقلام فوسفورية (هايلايتر) بألوان متعددة', text: 'لتمييز النصوص المهمة في المستندات والكتب، متوفرة بألوان أصفر وبرتقالي وأخضر وزهري وأزرق' },
            { icon: 'fa-chalkboard', title: 'أقلام وايت بورد', text: 'حبر قابل للمسح بسهولة من السبورات البيضاء، بأطراف رفيعة وعريضة وألوان متعددة' },
            { icon: 'fa-marker', title: 'ماركر دائم (Sharpie، Artline)', text: 'يكتب على أي سطح تقريبًا بما في ذلك البلاستيك والزجاج والمعدن، مقاوم للماء والشحوب' },
          ]} />

          <MidPageCTA formId="offPensMidCta" />

          <h3>أدوات تصحيح الكتابة</h3>
          <p>نوفر أيضًا مجموعة متكاملة من أدوات تصحيح الكتابة لضمان مستندات نظيفة واحترافية:</p>
          <IconCardGrid columns={3} items={[
            { icon: 'fa-eraser', title: 'سائل تصحيح (Tipp-Ex، BIC Wite-Out)', text: 'يغطي الأخطاء فوريًا ويجف بسرعة للكتابة فوقه، متوفر بأحجام مختلفة' },
            { icon: 'fa-tape', title: 'شريط تصحيح', text: 'يصحح الأخطاء بدون سائل أو وقت انتظار للجفاف، مريح للاستخدام وأكثر نظافة' },
            { icon: 'fa-shapes', title: 'ممحاة بلاستيك وكاوتش', text: 'بأشكال وأحجام متنوعة، للرصاص والأقلام الخاصة، ناعمة ولا تترك أثرًا على الورق' },
          ]} />

          <p>
            نوفر خدمة التوريد المؤسسي التي تتيح للشركات والمدارس والمستشفيات والجهات الحكومية الحصول على احتياجاتها من الأقلام وأدوات الكتابة دفعة واحدة بأسعار الجملة مع إمكانية الطلب الدوري المنتظم.
          </p>

          <h3>دليل اختيار مقاس رأس القلم (Tip Size)</h3>
          <p>
            كثير من العملاء لا ينتبهون لأثر مقاس رأس القلم على تجربة الكتابة، رغم أنه أحد أهم الفروقات العملية بين الأقلام. المقاس <strong>0.5mm أو 0.7mm</strong> هو الأكثر شيوعًا للكتابة اليومية العادية ويعطي خطًا متوسط الوضوح يناسب معظم الأعمال المكتبية. المقاس <strong>1.0mm فأعلى</strong> يعطي خطًا أعرض وتدفق حبر أسرع، وهو خيار مريح لمن يكتب بسرعة كبيرة أو يوقّع على عدد كبير من المستندات يوميًا لأنه يقلل الضغط المطلوب على الورقة. أما المقاس <strong>0.38mm أو 0.4mm</strong> فهو الأدق على الإطلاق، ويُفضَّل للكتابة الصغيرة والمفصلة، مثل ملء الجداول الضيقة أو الرسم الهندسي الدقيق، لكنه يحتاج ورقًا أنعم قليلًا حتى لا يخترق السطح.
          </p>

          <h3>الفرق الكيميائي بين أنواع الحبر</h3>
          <p>
            يعتمد أداء كل قلم على نوع الحبر المستخدم داخله. <strong>الحبر الزيتي (Oil-based)</strong> المستخدم في الأقلام الجافة التقليدية يجف بسرعة عند تلامسه الهواء، وهو الأنسب للأيدي اليسرى التي تسحب القلم فوق ما كُتب للتو لأنه لا يتلطخ بسهولة. <strong>حبر الجل (Gel ink)</strong> قائم على الماء مع جزيئات صبغية معلقة تعطي كثافة لون أعمق ولمعانًا واضحًا، لكنه يحتاج وقتًا أطول قليلًا للجفاف الكامل على الورق. <strong>الحبر السائل (Liquid ink)</strong> في أقلام الـ Rollerball هو الأكثر سيولة من الاثنين، يعطي إحساسًا قريبًا من قلم الحبر الحقيقي (Fountain Pen) مع سهولة الاستخدام اليومي، لكنه يستهلك كمية حبر أكبر لكل قلم فتقل مدة استخدامه مقارنة بالقلم الجاف العادي.
          </p>

          <h3>الراحة أثناء الكتابة الطويلة (Ergonomics)</h3>
          <p>
            لمن يكتب لساعات طويلة يوميًا — مثل المحاسبين أثناء إعداد الدفاتر والموظفين الإداريين والمعلمين أثناء تصحيح الأوراق — يُنصح باختيار أقلام بمقبض مطاطي مانع للانزلاق (Grip) يقلل الضغط على الأصابع ويمنع التعب المبكر لليد. الأقلام ذات الجسم الأثقل قليلًا توفر توازنًا أفضل أثناء الكتابة المطولة، بينما الأقلام الخفيفة جدًا تناسب أكثر الاستخدام السريع المتقطع. نساعد عملاءنا المؤسسيين في اختيار الطراز الأنسب حسب طبيعة العمل اليومي لفريقهم.
          </p>

          <h3>الأقلام حسب فئة العميل</h3>
          <p>
            <strong>المحاسبون ومسؤولو المخازن</strong> يحتاجون عادة أقلام رصاص ميكانيكية دقيقة بمقاس 0.5mm مع ممحاة مدمجة للتعديل السريع على الجداول والحسابات اليدوية. <strong>المعلمون</strong> يعتمدون كثيرًا على أقلام الهايلايتر المتعددة الألوان لتصحيح الكراسات وتمييز الملاحظات، بالإضافة إلى أقلام وايت بورد يومية للشرح. <strong>المدراء والتنفيذيون</strong> يفضلون أقلام الجل أو الحبر السائل الفاخرة للتوقيعات الرسمية والعقود المهمة. أما <strong>فرق المبيعات الميدانية</strong> فتحتاج أقلامًا جافة اقتصادية بكميات كبيرة توزَّع مع النماذج والفواتير في الزيارات اليومية للعملاء.
          </p>

          <h3>أقلام مخصصة بشعار شركتك للهدايا الترويجية</h3>
          <p>
            من أكثر الخدمات طلبًا لدينا هي طباعة شعار الشركة على الأقلام كهدية ترويجية للعملاء أو للتوزيع في المؤتمرات والمعارض. نوفر طباعة الشعار بلون واحد أو أكثر على جسم القلم مباشرة، مع اختيار لون جسم القلم نفسه ليتوافق مع هوية علامتك التجارية (أسود، أزرق، أبيض، أو ألوان مخصصة عند توفر الكمية الكافية). الحد الأدنى المعتاد لهذه الخدمة يبدأ من 100 قلم، وتزداد جودة السعر كلما زادت الكمية. نرسل لك عادة نموذجًا تصوريًا (Mockup) للتصميم قبل بدء الطباعة الفعلية لضمان رضاك التام عن الشكل النهائي.
          </p>
          <p>
            يفضل كثير من عملائنا المؤسسيين طلب مزيج من نوعين: أقلام اقتصادية بشعار الشركة للتوزيع الواسع في المعارض، وأقلام أعلى جودة (جل أو حبر سائل) بنفس الشعار كهدايا خاصة لكبار العملاء والشركاء. هذا التنويع يوازن بين التكلفة الإجمالية وقيمة الانطباع الذي تتركه الهدية.
          </p>

          <h3>العناية بالأقلام وإطالة عمرها</h3>
          <p>
            لإطالة عمر الأقلام في مخزونك، احفظها أفقيًا أو رأسية السن للأسفل في درج أو حافظة بعيدًا عن الحرارة المباشرة وأشعة الشمس التي قد تُجفف الحبر أو تُذيب بعض المكونات البلاستيكية في الأقلام الفاخرة. أغلق أقلام الوايت بورد والماركر الدائم جيدًا بعد كل استخدام لأن رأسها معرض للجفاف السريع في الهواء المفتوح أكثر من الأقلام الجافة والجل. للمخزون الكبير المخصص للتوزيع، يُفضل تدوير المخزون بحيث تُستخدم الدفعات الأقدم أولًا (نظام FIFO) لضمان عدم بقاء أي قلم في المخزن لفترة تتجاوز صلاحيته الفعلية.
          </p>

        </div>

        <div class="service-sidebar">
          <div class="sidebar-card">
            <h4>المستلزمات المكتبية</h4>
            <div class="sidebar-services">
              <a href="/office-supplies/a4-paper" class="sidebar-service-link"><span>ورق A4 وطباعة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/thermal" class="sidebar-service-link"><span>ورق حراري وكاشير</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/pens" class="sidebar-service-link active"><span>أقلام وأدوات كتابة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/notebooks" class="sidebar-service-link"><span>دفاتر ومفكرات</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/files" class="sidebar-service-link"><span>ملفات وأرشفة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/stamps" class="sidebar-service-link"><span>أختام ومستلزمات</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/envelopes" class="sidebar-service-link"><span>أظرف وتغليف</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/whiteboards" class="sidebar-service-link"><span>وايت بورد وفلين بورد</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/binding" class="sidebar-service-link"><span>أدوات ربط ودباسة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/sticky-notes" class="sidebar-service-link"><span>بوست إت وورق لاصق</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/batteries-usb" class="sidebar-service-link"><span>بطاريات وUSB</span><i class="fas fa-angle-left"></i></a>
            </div>
          </div>
          <div class="sidebar-card">
            <h4>تواصل معنا</h4>
            <div class="contact-info">
              <div class="contact-info-item"><i class="fas fa-phone"></i><span>01227392074</span></div>
              <div class="contact-info-item"><i class="fas fa-clock"></i><span>السبت - الخميس: 9ص - 6م</span></div>
            </div>
            <a href="/contact" class="btn btn-primary btn-sm" style="width:100%;text-align:center;margin-top:16px">اتصل بنا</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="section section-bg">
    <div class="container">
      <div class="section-header">
        <h2>احصل على أقلامك في 3 خطوات سهلة</h2>
        <div class="divider"></div>
      </div>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">1</div>
          <h4>حدد نوع القلم</h4>
          <p>اختر نوع القلم أو الماركة المطلوبة من قائمتنا الشاملة، أو تواصل معنا وسيساعدك فريقنا في اختيار الأنسب لاحتياجات مكتبك أو مدرستك أو شركتك.</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <h4>اختر الكمية</h4>
          <p>حدد الكمية المطلوبة سواء كانت علبة واحدة أو كراتين. كلما زادت الكمية كلما حصلت على سعر أفضل. نوفر عروضًا خاصة للطلبات الكبيرة والاشتراكات الشهرية.</p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <h4>استلم طلبك</h4>
          <p>نوصل طلبك لأي عنوان في مصر بسرعة وأمان. يمكن تسليم طلبات الإسكندرية في نفس اليوم، وطلبات باقي المحافظات خلال يوم إلى يومي عمل.</p>
        </div>
      </div>
    </div>
  </section>

