---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';
import ContentIntro from '../../components/ContentIntro.astro';
import IconCardGrid from '../../components/IconCardGrid.astro';
import { getSeoFor } from '../../lib/siteSeo';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "ملفات وأرشفة مكتبية",
  "description": "ملفات وأرشفة مكتبية في مصر — حلول تنظيم وأرشفة الوثائق للمكاتب والشركات.",
  "serviceType": "ملفات مكتبية",
  "provider": {
    "@type": "LocalBusiness",
    "name": "نيو جولدن أوفيس",
    "url": "https://newgoldenoffice.com",
    "telephone": "+201227392074",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "26 عبد المنعم سند",
      "addressLocality": "الإبراهيمية، باب شرق",
      "addressRegion": "الإسكندرية",
      "addressCountry": "EG"
    }
  },
  "areaServed": { "@type": "Country", "name": "Egypt" }
});
---
<BaseLayout
  {...getSeoFor('/office-supplies/files')}
  schemaJson={schemaJson}
  preloadImage="/images/office-supplies-hub.webp"
>
  <PageHero
    title="ملفات أرشفة مكتبية في مصر"
    subtitle="نيو جولدن أوفيس — وجهتك الأولى لحلول الأرشفة والملفات المكتبية في مصر. منتجات عالية الجودة بأسعار الجملة للشركات والمؤسسات"
    heroImage="/images/office-supplies-hub.webp"
    heroIcon="fa-folder"
    breadcrumbs={[
      { label: 'الرئيسية', href: '/' },
      { label: 'مستلزمات مكتبية', href: '/office-supplies' },
      { label: 'ملفات وأرشفة' }
    ]}
  />

  <section class="section">
    <div class="container">
      <div class="service-detail-grid">

        <div class="service-content">
          <ContentIntro
            heading="حلول الأرشفة والملفات المكتبية"
            text="تعتمد الشركات والمؤسسات الناجحة على أنظمة أرشفة فعّالة تحافظ على وثائقها ومستنداتها بشكل منظم وسهل الوصول. في نيو جولدن أوفيس، نقدم مجموعة شاملة من حلول الأرشفة والملفات المكتبية التي تغطي جميع الاحتياجات، من ملفات الحلقات الكلاسيكية إلى صناديق الأرشيف الحديثة، وصولًا إلى أنظمة الملفات المعلقة المتطورة."
          />
          <p>ندرك أن لكل شركة احتياجاتها الخاصة من الأرشفة، لذلك نوفر مجموعة متكاملة تناسب المكاتب الصغيرة والمؤسسات الكبيرة على حدٍّ سواء. نحرص على توفير الكميات الكبيرة بأسعار الجملة مع خدمة توصيل موثوقة إلى جميع محافظات مصر.</p>
          <p>نساعد أيضًا الجهات الحكومية والمكاتب القانونية التي تحتاج معايير أرشفة صارمة في اختيار الأنظمة المناسبة لحفظ المستندات الحساسة لسنوات طويلة دون تلف أو فقدان، مع إمكانية التوريد الدوري لمواكبة نمو حجم الأرشيف.</p>
          <p>نرشح دائمًا نظام التصنيف الأنسب لطبيعة عملك، سواء كان ترتيبًا زمنيًا بسيطًا أو تصنيفًا متعدد المستويات حسب القسم والموضوع ورقم الملف.</p>
          <p>وللمستندات النهائية التي تحتاج مظهرًا احترافيًا قبل الأرشفة، مثل التقارير السنوية والعقود، نوفر أيضًا <a href="/office-supplies/binding">خدمة التجليد للمستندات المؤرشفة</a> والتقارير الرسمية.</p>
          <p>نساعد أيضًا الشركات التي تنقل مكاتبها أو توسع أرشيفها في اختيار الحلول المناسبة لحجم المستندات الجديد دون الحاجة لإعادة تنظيم الأرشيف بالكامل من الصفر.</p>
          <p>نوفر أيضًا استشارة مجانية لتقييم نظام الأرشفة الحالي لديك واقتراح تحسينات بسيطة قد توفر عليك وقتًا كبيرًا في البحث عن المستندات لاحقًا.</p>

          <h3>ملفات مكتبية — الأنواع المتاحة</h3>
          <IconCardGrid columns={4} items={[
            { icon: 'fa-book', title: 'ملفات حلقات (2 حلقة - 4 حلقة)', text: 'بألوان متعددة ومقاسات A4 وA5' },
            { icon: 'fa-archive', title: 'صناديق الأرشيف', text: 'كرتونية وبلاستيكية لحفظ الوثائق طويل الأمد' },
            { icon: 'fa-folder-open', title: 'ملفات معلقة للأدراج (Suspension Files)', text: 'لتنظيم المستندات بالأدراج' },
            { icon: 'fa-clone', title: 'جيوب بلاستيك شفافة', text: 'بنوعيها L-shape وبجيبين لحماية المستندات' },
            { icon: 'fa-folder', title: 'ملفات كرتون', text: 'للمراسلات والمستندات الورقية اليومية' },
            { icon: 'fa-inbox', title: 'حوامل ملفات مكتبية', text: 'للعرض على المكتب أو الرف' },
            { icon: 'fa-paperclip', title: 'ملفات إبرة (Clip File)', text: 'للمستندات المؤقتة والعروض التقديمية' },
            { icon: 'fa-briefcase', title: 'أكياس وحافظات ملفات', text: 'للنقل والحمل خارج المكتب' },
          ]} />

          <h3>نظام ترميز الألوان للأرشفة</h3>
          <p>يُعدّ نظام ترميز الألوان من أكثر الأساليب فعالية في تنظيم الأرشيف المكتبي وتسريع الوصول إلى المستندات. نوفر ملفاتنا بمجموعة واسعة من الألوان المتناسقة تشمل: الأحمر للملفات العاجلة والمهمة، الأزرق للمراسلات الرسمية، الأخضر للملفات المالية والمحاسبية، الأصفر للمستندات قيد التنفيذ، والبرتقالي للمشاريع الجارية.</p>
          <p>كما نوفر ملصقات تعريفية وتابات ألوان مكملة لإتمام منظومة الأرشفة بشكل احترافي. هذا النظام يوفر على موظفيك ساعات من البحث في الأرشيف ويقلل الأخطاء في تصنيف المستندات.</p>

          <MidPageCTA formId="offFilesMidCta" />

          <h3>حلول الأرشفة للشركات</h3>
          <p>نقدم لكبار العملاء من الشركات والمؤسسات باقات متكاملة لحلول الأرشفة تشمل توفير جميع مستلزمات التنظيم من ملفات وصناديق وملصقات وحوامل بأسعار جملة حصرية. يستفيد عملاؤنا من الشركات من عقود توريد دورية تضمن توافر المخزون باستمرار، مع أولوية في التسليم وخدمة عملاء مخصصة.</p>

          <h3 style="color:var(--primary)">دليل اختيار نظام الأرشفة المناسب لحجم مستنداتك</h3>
          <p>اختيار نظام الأرشفة الصحيح يعتمد بشكل أساسي على حجم المستندات ومعدل الرجوع إليها. إليك دليلنا لمساعدتك في اتخاذ القرار الصحيح:</p>
          <IconCardGrid columns={2} items={[
            { icon: 'fa-file-alt', title: 'مستندات نشطة يُرجع إليها يومياً (حتى 300 ورقة لكل ملف)', text: 'ملفات الحلقات بمقاس متوسط (سُمك 4 سم) هي الخيار الأمثل، إذ تتيح إضافة وحذف الأوراق بسهولة دون تفكيك الملف بالكامل.' },
            { icon: 'fa-calendar-week', title: 'مستندات دورية تُراجع أسبوعياً أو شهرياً (فواتير، مراسلات)', text: 'ملفات معلقة (Suspension Files) في أدراج مخصصة توفر وصولاً سريعاً مع تصنيف واضح بالتاب والعنوان دون الحاجة لفتح كل ملف على حدة.' },
            { icon: 'fa-archive', title: 'أرشيف قديم نادراً ما يُراجع (سجلات قانونية، ضرائب سابقة)', text: 'صناديق الأرشيف الكرتونية المرقمة هي الأنسب اقتصادياً ومساحياً، حيث يمكن تكديسها على الأرفف لسنوات مع حماية جيدة من الغبار.' },
            { icon: 'fa-laptop', title: 'مؤسسات في مرحلة انتقالية نحو الأرشفة الرقمية', text: 'ننصح بالاحتفاظ بنظام هجين: أرشفة المستندات النشطة والقانونية الملزمة ورقياً، مع مسح ضوئي تدريجي للأرشيف القديم ونقله لصناديق مؤقتة حتى اكتمال الرقمنة، لتفادي فقدان أي مستند أثناء مرحلة التحول.' },
          ]} />

          <h3 style="color:var(--primary)">حلول الأرشفة حسب نوع منشأتك</h3>
          <IconCardGrid columns={3} items={[
            { icon: 'fa-balance-scale', title: 'المكاتب القانونية', text: 'تحتاج لملفات حلقات كبيرة ومتينة لحفظ ملفات القضايا التي قد تمتد لسنوات، مع نظام ترميز ألوان دقيق يميز بين القضايا الجارية والمغلقة والعاجلة.' },
            { icon: 'fa-hospital', title: 'المستشفيات والعيادات', text: 'تعتمد على ملفات معلقة مرمّزة بالألوان حسب القسم الطبي (باطنة، جراحة، أطفال...) لتسريع الوصول لملف المريض عند الحاجة الطارئة، إلى جانب صناديق أرشيف مغلقة لحفظ السجلات القديمة بسرية.' },
            { icon: 'fa-school', title: 'المدارس والجامعات', text: 'تحتاج لأرشفة ملفات الطلاب والدرجات والشهادات في ملفات حلقات مصنفة حسب الصف أو الدفعة الدراسية، مع صناديق أرشيف لحفظ سجلات الخريجين على المدى الطويل.' },
            { icon: 'fa-calculator', title: 'شركات المحاسبة والمراجعة', text: 'تعتمد بشكل كبير على الفواصل الملونة والجيوب البلاستيكية الشفافة لتنظيم المستندات المالية شهرياً، مع الحاجة لأرشفة صارمة قد تمتد لخمس سنوات وفق القانون المصري لحفظ السجلات الضريبية.' },
            { icon: 'fa-landmark', title: 'الجهات الحكومية', text: 'تتطلب أنظمة أرشفة موحدة الشكل والترقيم وفق اللوائح الإدارية الرسمية، ونوفر ملفات وصناديق بمواصفات ثابتة تناسب متطلبات الأرشيف الحكومي.' },
          ]} />

          <h3 style="color:var(--primary)">نصائح للحفاظ على الوثائق الأرشيفية على المدى الطويل</h3>
          <IconCardGrid columns={3} items={[
            { icon: 'fa-tint', text: 'خزّن صناديق الأرشيف في مكان جاف جيد التهوية بعيداً عن الرطوبة، فالرطوبة هي العدو الأول للورق وتسبب التعفن والعفن الفطري على المدى الطويل.' },
            { icon: 'fa-arrow-up', text: 'ارفع الصناديق عن الأرض على أرفف أو منصات لتجنب أي تسرب مياه محتمل من الأرضية.' },
            { icon: 'fa-bug', text: 'استخدم صناديق ذات جودة تصنيع جيدة تمنع دخول الحشرات والقوارض، خاصة للأرشيف الذي سيبقى مغلقاً لسنوات دون فتح.' },
            { icon: 'fa-layer-group', text: 'تجنب تكديس عدد كبير جداً من الصناديق فوق بعضها لتفادي انضغاط وتشوه الصناديق السفلية بمرور الوقت.' },
            { icon: 'fa-calendar-check', text: 'راجع الأرشيف دورياً (سنوياً على الأقل) لفرز المستندات التي انتهت مدة الاحتفاظ القانوني بها والتخلص منها بطريقة آمنة، مما يوفر مساحة تخزين قيّمة.' },
          ]} />

        </div>

        <div class="service-sidebar">
          <div class="sidebar-card">
            <h4>المستلزمات المكتبية</h4>
            <div class="sidebar-services">
              <a href="/office-supplies/a4-paper" class="sidebar-service-link"><span>ورق A4 وطباعة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/thermal" class="sidebar-service-link"><span>ورق حراري وكاشير</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/pens" class="sidebar-service-link"><span>أقلام وأدوات كتابة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/notebooks" class="sidebar-service-link"><span>دفاتر ومفكرات</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/files" class="sidebar-service-link active"><span>ملفات وأرشفة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/stamps" class="sidebar-service-link"><span>أختام ومستلزمات</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/envelopes" class="sidebar-service-link"><span>أظرف وتغليف</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/whiteboards" class="sidebar-service-link"><span>وايت بورد وفلين بورد</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/binding" class="sidebar-service-link"><span>أدوات ربط ودباسة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/sticky-notes" class="sidebar-service-link"><span>بوست إت وورق لاصق</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/batteries-usb" class="sidebar-service-link"><span>بطاريات وUSB</span><i class="fas fa-angle-left"></i></a>
            </div>
          </div>
          <div class="sidebar-card">
            <h4>تواصل معنا</h4>
            <div class="contact-info">
              <div class="contact-info-item"><i class="fas fa-phone"></i><span>01227392074</span></div>
              <div class="contact-info-item"><i class="fas fa-clock"></i><span>السبت - الخميس: 9ص - 6م</span></div>
            </div>
            <a href="/contact" class="btn btn-primary btn-sm" style="width:100%;text-align:center;margin-top:16px">اتصل بنا</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="section section-bg">
    <div class="container">
      <div class="section-header">
        <h2>نظم أرشيفك في 3 خطوات سهلة</h2>
        <div class="divider"></div>
      </div>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">1</div>
          <h4>اختر نوع الملف</h4>
          <p>تصفح تشكيلتنا من ملفات الحلقات وصناديق الأرشيف والملفات المعلقة والجيوب البلاستيكية، واختر ما يناسب طبيعة مستنداتك واحتياجات شركتك</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <h4>حدد الكمية</h4>
          <p>أخبرنا بالكمية المطلوبة من كل نوع والألوان المفضلة إن وجدت، وسنرسل لك عرض سعر مفصل مع خصومات الكميات الكبيرة فورًا</p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <h4>استلم بالتوصيل</h4>
          <p>نجهز طلبك بعناية ونوصله إليك في أسرع وقت ممكن مع ضمان سلامة جميع المنتجات وتغليفها بشكل محكم لتصلك في حالة ممتازة</p>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section" style="padding:60px 0;background:#f8f9fa">
    <div class="container">
      <h2 style="font-size:1.8rem;font-weight:700;color:#1a1a2e;margin-bottom:24px">حلول الأرشفة المكتبية للشركات في مصر</h2>
      <p style="font-size:1.05rem;line-height:1.9;color:#444;margin-bottom:20px">نيو جولدن أوفيس توفر حلول أرشفة شاملة للشركات والمؤسسات في الإسكندرية والقاهرة وجميع مصر:</p>
      <IconCardGrid columns={3} items={[
        { icon: 'fa-book', title: 'أرشفة يدوية', text: 'ملفات شنابر، فواصل، صناديق أرشفة مرقمة لتنظيم الوثائق الورقية.' },
        { icon: 'fa-inbox', title: 'أرشفة الأدراج', text: 'ملفات مُعلقة لأدراج المكاتب لسهولة البحث والوصول السريع.' },
        { icon: 'fa-boxes', title: 'أرشفة الرفوف', text: 'صناديق وعلب أرشفة كرتونية أو بلاستيكية لحفظ السجلات.' },
      ]} />
      <p style="font-size:1rem;color:#555;margin-top:20px">نوفر حلول أرشفة متكاملة للشركات بالكميات الكبيرة بأسعار الجملة — نخدم جميع محافظات مصر.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>كل ما تريد معرفته عن الملفات والأرشفة</h2>
        <div class="divider"></div>
      </div>
      <div class="faq-list">

        <div class="faq-item">
          <div class="faq-question">ما هي مقاسات ملفات الحلقات المتوفرة لديكم؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">نوفر ملفات الحلقات بمقاسات متعددة تناسب جميع الاحتياجات: المقاس الصغير (سُمك 2 سم) ويستوعب حوالي 150 ورقة، والمقاس المتوسط (سُمك 4 سم) ويستوعب حوالي 300 ورقة، والمقاس الكبير (سُمك 7 سم) ويستوعب حوالي 600 ورقة. جميعها متوفرة بنظام الحلقتين (2D) وبنظام الأربع حلقات (4D) بألوان متعددة.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">ما الفرق بين صناديق الأرشيف وملفات الحلقات؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">صناديق الأرشيف (Box Files): مثالية لحفظ الوثائق طويل الأمد والأرشيف القديم، تتميز بسعة تخزينية كبيرة وحماية ممتازة من الغبار والرطوبة، ويمكن وضعها على الأرفف بسهولة. ملفات الحلقات (Ring Binders): الأنسب للمستندات النشطة التي يحتاج إليها باستمرار، تتميز بسهولة الإضافة والحذف والترتيب.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">متى أختار الجيوب البلاستيكية بدلًا من الملفات الكرتونية؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">الجيوب البلاستيكية الشفافة: الأنسب عندما تريد حماية المستند مع إمكانية قراءته دون إخراجه، وعندما تحتاج إلى حماية من الرطوبة والأوساخ، وللمستندات المهمة أو التي تُعرض أمام العملاء. الملفات الكرتونية: الأنسب للاستخدام اليومي والمراسلات العادية لأنها أخف وأرخص.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">كيف أطبق نظام ترميز الألوان في أرشيف شركتي؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">تطبيق نظام ترميز الألوان بسيط وفعّال: ابدأ بتحديد أقسام أرشيفك الرئيسية (مالي، قانوني، إداري، مشاريع...)، ثم خصص لكل قسم لونًا مميزًا. ننصح بنظام بسيط: أحمر = عاجل، أزرق = مالي، أخضر = مشاريع، أصفر = قيد التنفيذ. تواصل معنا وسنساعدك في تصميم النظام المناسب لشركتك.</div>
          </div>
        </div>

