---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';
import ContentIntro from '../../components/ContentIntro.astro';
import IconCardGrid from '../../components/IconCardGrid.astro';
import ComparisonGrid from '../../components/ComparisonGrid.astro';
import { getSeoFor } from '../../lib/siteSeo';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "ورق A4",
  "description": "ورق A4 للطباعة والنسخ في مصر — أحجام وأوزان متعددة للمكاتب والشركات بأسعار الجملة.",
  "serviceType": "ورق مكتبي",
  "provider": {
    "@type": "LocalBusiness",
    "name": "نيو جولدن أوفيس",
    "url": "https://newgoldenoffice.com",
    "telephone": "+201227392074",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "26 عبد المنعم سند",
      "addressLocality": "الإبراهيمية، باب شرق",
      "addressRegion": "الإسكندرية",
      "addressCountry": "EG"
    }
  },
  "areaServed": { "@type": "Country", "name": "Egypt" }
});
---
<BaseLayout
  {...getSeoFor('/office-supplies/a4-paper')}
  schemaJson={schemaJson}
  preloadImage="/images/office-supplies-hub.webp"
>
  <PageHero
    title="ورق A4 للبيع في مصر — جميع الأنواع والأوزان"
    subtitle="ورق طباعة A4 عالي الجودة بجميع الأوزان والماركات العالمية — متوافق مع كل الطابعات والناسخات. أسعار جملة مميزة وتوصيل سريع لجميع أنحاء مصر."
    heroImage="/images/office-supplies-hub.webp"
    heroIcon="fa-file"
    breadcrumbs={[
      { label: 'الرئيسية', href: '/' },
      { label: 'مستلزمات مكتبية', href: '/office-supplies' },
      { label: 'ورق A4 وطباعة' }
    ]}
  />

  <section class="section">
    <div class="container">
      <div class="service-detail-grid">

        <div class="service-content">
          <ContentIntro
            heading="ورق A4 — الخيار الأول للمكاتب والشركات في مصر"
            text="يُعدّ ورق A4 من أكثر المستلزمات المكتبية طلباً على الإطلاق، إذ لا يمكن لأي مكتب أو شركة أو مؤسسة الاستغناء عنه يوماً واحداً. في نيو جولدن أوفيس، نوفر أشمل تشكيلة من ورق الطباعة A4 في الإسكندرية ومصر، مع ضمان التوافق مع جميع أنواع الطابعات والناسخات الليزرية والنافثة للحبر."
          />
          <p>
            نتعامل مع الشركات والمصانع والمدارس بنفس مستوى الاهتمام بالتفاصيل مهما كان حجم الطلب، ونضمن دائمًا توريد ورق من نفس الدفعة والجودة عند التعاقد الدوري، لتفادي أي فارق ملحوظ في اللون أو السمك بين شحنة وأخرى قد يؤثر على مظهر مستنداتك المطبوعة.
          </p>
          <p>
            نوفر أيضًا للشركات التي تطبع مستندات رسمية أو عروضًا تقديمية مهمة خيارات ورق أعلى في الجودة والبياض، تعطي انطباعًا أكثر احترافية عند تقديمها لعميل أو جهة رسمية.
          </p>
          <p>
            نضبط أيضًا جدول توريد يناسب استهلاك مكتبك الفعلي، فلا تحتاج لتخزين كميات كبيرة تشغل مساحة، ولا تصل لنقطة نفاد المخزون في وقت الذروة.
          </p>
          <p>
            نوفر أيضًا خيار التخزين المؤقت لدينا للشركات التي تطلب كميات كبيرة دفعة واحدة، مع تسليم دفعات صغيرة دورية حسب الحاجة الفعلية بدل استلام الكمية كاملة مرة واحدة.
          </p>

          <h3 style="margin-top:32px;color:var(--primary)">ورق طباعة مصر — الأوزان المتاحة وما يناسبك</h3>
          <p>اختيار الوزن الصحيح للورق يؤثر مباشرة على جودة الطباعة وعمر الماكينة. نوفر لك:</p>
          <ComparisonGrid items={[
            { title: 'ورق 80 جرام', text: 'الخيار الأمثل للطباعة اليومية ووثائق المكتب. سماكة جيدة تمنع ظهور الطباعة من الخلف وتُعطي مظهراً احترافياً.' },
            { title: 'ورق 75 جرام', text: 'التوازن المثالي بين السعر والجودة. شائع الاستخدام في الشركات والمؤسسات التي تحتاج طباعة بكميات كبيرة بتكلفة معقولة.' },
            { title: 'ورق 70 جرام', text: 'الخيار الاقتصادي للطباعة الداخلية والمسودات. مناسب جداً للحجم العالي من الطباعة حيث يكون المحتوى أهم من السماكة.' },
          ]} />

          <h3 style="color:var(--primary)">أبرز الماركات لدينا</h3>
          <p>نحرص على توفير أفضل ماركات ورق الطباعة العالمية المعتمدة والموثوقة في السوق المصري:</p>
          <IconCardGrid columns={4} items={[
            { icon: 'fa-star', title: 'Double A', text: 'الماركة التايلاندية الأولى عالمياً في ورق الطباعة. بياض ممتاز يصل 104%، سطح أملس، ومقاومة للانحناء داخل الطابعة.' },
            { icon: 'fa-star', title: 'Navigator', text: 'ماركة برتغالية مشهورة بجودتها العالية وسعرها التنافسي. مثالية للمكاتب التي تحتاج جودة ممتازة بتكلفة مناسبة.' },
            { icon: 'fa-star', title: 'Xerox', text: 'الماركة الأمريكية الأيقونية. ورق مصمم خصيصاً للناسخات والطابعات الليزرية بمعايير دقة عالية جداً. الأنسب لطباعة الوثائق القانونية والعقود.' },
            { icon: 'fa-star', title: 'IK', text: 'ماركة اندونيسية واسعة الانتشار في مصر. توفر جودة جيدة بأسعار تنافسية جداً، مثالية للمؤسسات التعليمية والجهات الحكومية.' },
          ]} />

          <MidPageCTA formId="offA4PaperMidCta" />

          <h3 style="color:var(--primary)">ورق ملون وخصائص الطباعة</h3>
          <p>
            بالإضافة للورق الأبيض المعتاد، نوفر ورق A4 ملون بطيف واسع من الألوان للاستخدامات الإبداعية والتصنيفية. يُستخدم الورق الملون لتنظيم الملفات بالألوان، وفي المدارس والمؤتمرات، وللإعلانات الداخلية. نستورد ورق ألوان عالي الجودة يحافظ على حدة الطباعة ولا يتسرب الحبر عليه.
          </p>
          <p>
            نسبة البياض في الورق تتراوح بين 90% في الدرجات الاقتصادية و104% في الدرجات الممتازة. كلما ارتفعت نسبة البياض، كانت الطباعة أكثر وضوحاً وتبايناً — خاصة عند طباعة الصور والرسوم البيانية.
          </p>

          <h3 style="color:var(--primary)">بيع بالرزمة أو الكرتونة أو الجملة</h3>
          <p>نبيع ورق A4 بجميع الكميات التي تحتاجها:</p>
          <ComparisonGrid items={[
            { title: 'رزمة واحدة (500 ورقة)', text: 'للاستخدام الشخصي أو التجربة' },
            { title: 'كرتونة (5 رزم = 2500 ورقة)', text: 'الحجم الأمثل للمكاتب المتوسطة' },
            { title: 'أكثر من 10 كرتونة', text: 'أسعار جملة حصرية مع خصومات تصل 20%' },
          ]} />
          <p>
            اتصل بنا على <strong>01227392074</strong> لمعرفة أسعار اليوم وتوافر الكميات. نحدّث أسعارنا باستمرار لنضمن لك دائماً أفضل سعر في السوق.
          </p>

          <h3 style="color:var(--primary)">ورق A4 حسب طبيعة استخدامك</h3>
          <p>اختيار الورق المناسب يختلف حسب طبيعة نشاطك، وهذه أبرز التوصيات التي نقدمها لعملائنا وفق نوع منشآتهم:</p>
          <IconCardGrid columns={3} items={[
            { icon: 'fa-briefcase', title: 'المكاتب والشركات العادية', text: 'ورق 75 أو 80 جرام بنسبة بياض 96-100% يمنحك توازناً ممتازاً بين الجودة والتكلفة لطباعة المراسلات والتقارير اليومية.' },
            { icon: 'fa-print', title: 'المطابع ومكاتب الطباعة التجارية', text: 'تحتاج إلى ثبات تام في المواصفات بين الأحمال المختلفة، لذلك ننصح بالتعاقد على كمية ثابتة من ماركة واحدة (مثل Xerox أو Double A) بدلاً من تبديل الماركات، لتفادي أي فروقات دقيقة في السماكة أو البياض قد تظهر في جودة الطباعة النهائية.' },
            { icon: 'fa-school', title: 'المدارس والجامعات', text: 'الورق الاقتصادي 70 جرام مناسب جداً للامتحانات والمذكرات الداخلية عالية الكمية، مع الاحتفاظ بورق 80 جرام للشهادات والوثائق الرسمية التي تحتاج مظهراً أرقى.' },
            { icon: 'fa-hospital', title: 'المستشفيات والعيادات', text: 'نوصي بورق 80 جرام لملفات المرضى نظراً لتكرار التعامل معها وحاجتها للمتانة، مع إمكانية استخدام ورق ملون لتصنيف الأقسام الطبية المختلفة بسرعة.' },
            { icon: 'fa-landmark', title: 'الجهات الحكومية', text: 'الالتزام بالمواصفات الرسمية المعتمدة أولوية، ونوفر ورقاً بمواصفات ثابتة موثقة تناسب متطلبات التوريد الحكومي والمناقصات.' },
          ]} />

          <h3 style="color:var(--primary)">كيف تحافظ على جودة ورق A4 وتخزنه بشكل صحيح</h3>
          <p>
            التخزين غير السليم للورق يمكن أن يفسد جودته حتى قبل استخدامه، مما يسبب مشاكل انحشار متكررة في الطابعات والناسخات. إليك أهم النصائح التي نشاركها مع عملائنا:
          </p>
          <IconCardGrid columns={2} items={[
            { icon: 'fa-tint', text: 'احفظ الورق في مكان جاف بعيداً عن الرطوبة، فالرطوبة تجعل حواف الورق تتموج وتسبب انحشاره داخل الطابعة.' },
            { icon: 'fa-box', text: 'لا تفتح الرزمة إلا عند الحاجة الفعلية للاستخدام — الغلاف البلاستيكي المحكم يحافظ على مستوى الرطوبة الداخلي المناسب للورق.' },
            { icon: 'fa-arrow-up', text: 'خزّن الكراتين مرفوعة عن الأرض على منصة أو رف، وتجنب وضعها مباشرة على أرضية قد تتسرب منها الرطوبة.' },
            { icon: 'fa-print', text: 'عند تعبئة درج الطابعة، لا تتجاوز الحد الأقصى الموصى به وتجنب خلط رزم مختلفة العمر أو الماركة في نفس الدرج لتفادي فروقات السماكة الطفيفة.' },
          ]} />

          <h3 style="color:var(--primary)">ورق A4 صديق للبيئة (معاد التدوير)</h3>
          <p>
            مع تزايد وعي الشركات بمسؤوليتها البيئية، أصبح الطلب على ورق A4 المعاد تدويره أو المُصنّع من مصادر غابات مستدامة (FSC Certified) في تزايد مستمر. نوفر خيارات ورق صديقة للبيئة تحافظ على جودة طباعة جيدة مع بصمة كربونية أقل، وهي خيار ممتاز للشركات التي تسعى لتعزيز صورتها كمؤسسة مسؤولة بيئياً أمام عملائها وشركائها.
          </p>

        </div>

        <div class="service-sidebar">
          <div class="sidebar-card">
            <h4>المستلزمات المكتبية</h4>
            <div class="sidebar-services">
              <a href="/office-supplies/a4-paper" class="sidebar-service-link active"><span>ورق A4 وطباعة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/thermal" class="sidebar-service-link"><span>ورق حراري وكاشير</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/pens" class="sidebar-service-link"><span>أقلام وأدوات كتابة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/notebooks" class="sidebar-service-link"><span>دفاتر ومفكرات</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/files" class="sidebar-service-link"><span>ملفات وأرشفة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/stamps" class="sidebar-service-link"><span>أختام ومستلزمات</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/envelopes" class="sidebar-service-link"><span>أظرف وتغليف</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/whiteboards" class="sidebar-service-link"><span>وايت بورد وفلين بورد</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/binding" class="sidebar-service-link"><span>أدوات ربط ودباسة</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/sticky-notes" class="sidebar-service-link"><span>بوست إت وورق لاصق</span><i class="fas fa-angle-left"></i></a>
              <a href="/office-supplies/batteries-usb" class="sidebar-service-link"><span>بطاريات وUSB</span><i class="fas fa-angle-left"></i></a>
            </div>
          </div>
          <div class="sidebar-card">
            <h4>تواصل معنا</h4>
            <div class="contact-info">
              <div class="contact-info-item"><i class="fas fa-phone"></i><span>01227392074</span></div>
              <div class="contact-info-item"><i class="fas fa-clock"></i><span>السبت - الخميس: 9ص - 6م</span></div>
            </div>
            <a href="/contact" class="btn btn-primary btn-sm" style="width:100%;text-align:center;margin-top:16px">اتصل بنا</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="section section-bg">
    <div class="container">
      <div class="section-header">
        <h2>احصل على ورق A4 بسهولة</h2>
        <div class="divider"></div>
      </div>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">1</div>
          <h4>اختر المواصفات</h4>
          <p>حدد الوزن المطلوب (80 أو 75 أو 70 جرام)، والماركة المفضلة (Double A أو Navigator أو غيرها)، وهل تريد ورقاً أبيض أم ملوناً.</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <h4>اطلب بالجملة</h4>
          <p>تواصل معنا بالكمية التي تريدها — رزمة أو كرتونة أو أكثر — وسنرسل لك عرض سعر فوري مع أفضل خصومات الكمية.</p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <h4>استلم في موعدك</h4>
          <p>نوصّل طلبك للإسكندرية خلال 24 ساعة وباقي محافظات مصر خلال 48-72 ساعة. ندير الشحن بالكامل دون أي تعقيد.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section" style="padding:60px 0;background:#f8f9fa">
    <div class="container">
      <h2 style="font-size:1.8rem;font-weight:700;color:#1a1a2e;margin-bottom:24px">ورق A4 للشركات بأسعار الجملة في مصر</h2>
      <p style="font-size:1.05rem;line-height:1.9;color:#444;margin-bottom:20px">نوفر ورق A4 للشركات والمؤسسات في الإسكندرية والقاهرة وجميع مصر بأسعار الجملة. كلما زادت الكمية، انخفض السعر:</p>
      <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:0.95rem">
          <thead>
            <tr style="background:#1a1a2e;color:#fff">
              <th style="padding:12px 16px;text-align:right">الكمية</th>
              <th style="padding:12px 16px;text-align:right">السعر التقريبي</th>
              <th style="padding:12px 16px;text-align:right">مناسب لـ</th>
            </tr>
          </thead>
          <tbody>
            <tr style="background:#fff;border-bottom:1px solid #eee">
              <td style="padding:12px 16px">رزمة واحدة (500 ورقة)</td>
              <td style="padding:12px 16px">سعر التجزئة</td>
              <td style="padding:12px 16px">الاستخدام الشخصي</td>
            </tr>
            <tr style="background:#f8f9fa;border-bottom:1px solid #eee">
              <td style="padding:12px 16px">كرتونة (5 رزم = 2,500 ورقة)</td>
              <td style="padding:12px 16px">خصم 10-15%</td>
              <td style="padding:12px 16px">المكاتب الصغيرة</td>
            </tr>
            <tr style="background:#fff;border-bottom:1px solid #eee">
              <td style="padding:12px 16px">10+ كرتونة</td>
              <td style="padding:12px 16px">خصم 20-25%</td>
              <td style="padding:12px 16px">الشركات المتوسطة</td>
            </tr>
            <tr style="background:#f8f9fa">
              <td style="padding:12px 16px">طلبات بالطن أو السائل</td>
              <td style="padding:12px 16px">أفضل سعر الجملة</td>
              <td style="padding:12px 16px">المصانع والفنادق الكبرى</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p style="font-size:0.9rem;color:#777;margin-top:12px">* نوفر ورق A4 من الماركات الموثوقة: Double A، Navigator، IK Plus، Xerox بأوزان 70/75/80 جرام.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>أسئلة وأجوبة عن ورق A4</h2>
        <div class="divider"></div>
      </div>
      <div class="faq-list" style="max-width:820px;margin:0 auto">

        <div class="faq-item">
          <div class="faq-question">ما الفرق بين ورق 80 جرام و75 جرام و70 جرام؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">الفرق في السماكة والوزن. الورق 80 جرام أكثر سماكة وأفضل جودة للوثائق الرسمية والعروض التقديمية. الورق 75 جرام هو الأكثر استخداماً في المكاتب لأنه يوازن بين الجودة والسعر. الورق 70 جرام اقتصادي مناسب للمسودات والطباعة الداخلية الكثيفة.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">هل ورق A4 لديكم متوافق مع طابعتي؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">نعم، جميع ورق A4 الذي نبيعه متوافق مع كل أنواع الطابعات: الليزرية، النافثة للحبر (Inkjet)، الناسخات المكتبية، وآلات الاستنساخ. الماركات التي نوفرها مثل Double A وNavigator وXerox مصممة خصيصاً لتحقيق أقصى أداء مع مختلف تقنيات الطباعة.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">ما هي نسبة البياض (Brightness) في الورق الذي تبيعونه؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">تتراوح نسبة البياض في منتجاتنا بين 90% للدرجات الاقتصادية و104% للدرجات الممتازة مثل Double A. كلما ارتفعت النسبة، كانت الطباعة أوضح وأكثر حدة للتفاصيل الدقيقة والصور والرسوم البيانية.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">هل تتوفر لديكم ورق A4 ملون؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">نعم، نوفر ورق A4 ملون بطيف واسع من الألوان يشمل الأزرق، الأخضر، الأصفر، الوردي، البرتقالي وغيرها. الورق الملون يستخدم في تصنيف الملفات، الإعلانات الداخلية، أنشطة المدارس، والفعاليات. نوفره بأوزان مختلفة وبالكميات التي تناسبك.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">كيف أحسب كمية ورق A4 التي يحتاجها مكتبي شهرياً؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">قاعدة عامة: الموظف الذي يطبع بشكل معتدل يستهلك حوالي 1-2 رزمة (500-1000 ورقة) شهرياً. المكتب الذي يعمل بكثافة طباعة قد يصل لـ 5 رزم شهرياً للموظف الواحد. ننصح بالطلب بالكرتونة (5 رزم) لتوفير التخزين وتخفيض التكلفة عبر خصم الكمية.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">لماذا ينحشر الورق داخل طابعتي بشكل متكرر؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">أكثر أسباب انحشار الورق شيوعاً: تخزين الورق في مكان رطب مما يجعل حوافه متموجة، خلط رزم من ماركات أو أعمار مختلفة في نفس الدرج، أو تجاوز السعة القصوى للدرج. إذا استمرت المشكلة رغم التخزين السليم، جرب ماركة ذات سماكة أعلى مثل ورق 80 جرام بدلاً من 70 جرام، فالورق الأكثر سماكة عادة أقل عرضة للانحشار في الطابعات القديمة.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">هل يوجد فرق في الجودة بين ورق A4 المستورد والمُصنّع محلياً؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">الماركات المستوردة مثل Double A وNavigator تخضع لمعايير تصنيع دولية صارمة وتتميز بثبات أعلى في السماكة والبياض بين الرزم المختلفة. البدائل المحلية والآسيوية الاقتصادية توفر جودة مقبولة جداً للاستخدام اليومي العادي بسعر أوفر، لكنها قد تُظهر تبايناً طفيفاً بين الدفعات. نساعدك في اختيار الخيار الأنسب حسب ميزانيتك ومستوى الجودة المطلوب لطبيعة مستنداتك.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">هل تقدمون عقود توريد سنوية لورق A4 للشركات؟ <i class="fas fa-plus"></i></div>
          <div class="faq-answer">
            <div class="faq-answer-inner">نعم، نوفر للشركات والمؤسسات عقود توريد دورية (شهرية أو ربع سنوية) بأسعار ثابتة متفق عليها لمدة العقد، مما يحميك من تقلبات السوق ويضمن استمرارية التوريد دون الحاجة لمتابعة الطلب كل مرة. هذا الخيار مناسب بشكل خاص للمطابع والمدارس والشركات متوسطة وكبيرة الحجم.</div>
          </div>
        </div>

      </div>
    </div>
  </section>

