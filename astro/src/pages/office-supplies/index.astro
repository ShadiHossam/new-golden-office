---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import PageHero from '../../components/PageHero.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';
import IconCardGrid from '../../components/IconCardGrid.astro';
import ComparisonGrid from '../../components/ComparisonGrid.astro';
import { getSeoFor } from '../../lib/siteSeo';
---
<BaseLayout
  {...getSeoFor('/office-supplies')}
  preloadImage="/images/office-supplies-hub.webp"
>
  <PageHero
    title="ورق ومستلزمات مكتبية في مصر — كل ما تحتاجه"
    subtitle="نيو جولدن أوفيس وجهتك الأولى للمستلزمات المكتبية المتكاملة في الإسكندرية ومصر — جودة موثوقة، أسعار تنافسية، وتوصيل سريع منذ عام 1999."
    heroImage="/images/office-supplies-hub.webp"
    heroIcon="fa-boxes"
    breadcrumbs={[
      { label: 'الرئيسية', href: '/' },
      { label: 'مستلزمات مكتبية' }
    ]}
    showCta={false}
  />

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>ورق مكتبي ومستلزمات متكاملة لكل احتياجاتك</h2>
        <div class="divider"></div>
      </div>
      <div class="section-content" style="max-width:860px;margin:0 auto 40px;text-align:center">
        <p style="font-size:1.1rem;line-height:2;color:#444;margin-bottom:20px">
          منذ تأسيسها عام 1999، تُعدّ <strong>نيو جولدن أوفيس</strong> من أعرق موردي المستلزمات المكتبية في الإسكندرية ومصر. نحن نعتقد أن المكتب الناجح يبدأ بتجهيزات صحيحة: من أول ورقة طباعة حتى آخر دباسة على المكتب. لذلك جمعنا لك أوسع تشكيلة من المنتجات المكتبية تحت سقف واحد مع خدمة عملاء متميزة وأسعار الجملة المناسبة لجميع الأحجام.
        </p>
        <p style="font-size:1.1rem;line-height:2;color:#444;margin-bottom:20px">
          نخدم الشركات الكبرى والصغيرة، والمدارس والجامعات، والمكاتب الحكومية، والعيادات، والمطاعم، وأصحاب المشاريع الناشئة — أياً كان حجمك، لدينا ما تحتاجه بالكميات التي تريدها. يمكنك الاختيار بين الشراء بالقطعة الواحدة أو بالجملة مع خصومات متدرجة تصل حتى 25% على الطلبات الكبيرة.
        </p>
        <p style="font-size:1.1rem;line-height:2;color:#444">
          تشمل تشكيلتنا أكثر من ألف منتج مكتبي من أفضل الماركات العالمية والمحلية. نعمل بنظام الطلب المسبق مع ضمان الوصول في الموعد المحدد، ونوفر أيضاً خدمة الاستشارة المجانية لمساعدتك في اختيار الأنسب لمتطلبات عملك ومستوى ميزانيتك. اتصل بنا الآن على <strong>01227392074</strong> للحصول على عرض سعر مخصص لمشروعك.
        </p>
      </div>

      <div class="section-header" style="margin-top:60px">
        <h2>جميع فئات المستلزمات المكتبية</h2>
        <div class="divider"></div>
      </div>
      <div class="services-grid">

        <a href="/office-supplies/a4-paper" class="service-card">
          <div class="service-icon"><i class="fas fa-file"></i></div>
          <h3>ورق A4 وطباعة</h3>
          <p>ورق طباعة بجميع الأوزان والماركات — 80 جرام، 75 جرام، 70 جرام. متوافق مع جميع الطابعات والناسخات.</p>
          <span class="service-link">اكتشف المنتجات <i class="fas fa-angle-left"></i></span>
        </a>

        <a href="/office-supplies/thermal" class="service-card">
          <div class="service-icon"><i class="fas fa-receipt"></i></div>
          <h3>ورق حراري وكاشير</h3>
          <p>رولات ورق حراري بجميع المقاسات لماكينات الكاشير، أجهزة نقاط البيع، والفاتورة الإلكترونية.</p>
          <span class="service-link">اكتشف المنتجات <i class="fas fa-angle-left"></i></span>
        </a>

        <a href="/office-supplies/pens" class="service-card">
          <div class="service-icon"><i class="fas fa-pen"></i></div>
          <h3>أقلام وأدوات كتابة</h3>
          <p>أقلام جاف، قلم حبر، هايلايتر، ماركر، وأقلام رصاص من ماركات BIC وFaber-Castell وغيرها.</p>
          <span class="service-link">اكتشف المنتجات <i class="fas fa-angle-left"></i></span>
        </a>

        <a href="/office-supplies/notebooks" class="service-card">
          <div class="service-icon"><i class="fas fa-book"></i></div>
          <h3>دفاتر ومفكرات</h3>
          <p>دفاتر مسطرة، دفاتر مربعات، مفكرات يومية وأجندات بأحجام مختلفة للاستخدام المكتبي والشخصي.</p>
          <span class="service-link">اكتشف المنتجات <i class="fas fa-angle-left"></i></span>
        </a>

        <a href="/office-supplies/files" class="service-card">
          <div class="service-icon"><i class="fas fa-folder"></i></div>
          <h3>ملفات وأرشفة</h3>
          <p>ملفات بلاستيكية، كراتين أرشفة، ملفات معلق، فواصل، وكل ما تحتاجه لتنظيم وثائقك وأوراقك.</p>
          <span class="service-link">اكتشف المنتجات <i class="fas fa-angle-left"></i></span>
        </a>

        <a href="/office-supplies/stamps" class="service-card">
          <div class="service-icon"><i class="fas fa-stamp"></i></div>
          <h3>أختام ومستلزمات</h3>
          <p>أختام مطاطية، أختام ذاتية الحبر، وسادات حبر، وأختام تاريخ بأشكال وأحجام متعددة.</p>
          <span class="service-link">اكتشف المنتجات <i class="fas fa-angle-left"></i></span>
        </a>

        <a href="/office-supplies/envelopes" class="service-card">
          <div class="service-icon"><i class="fas fa-envelope"></i></div>
          <h3>أظرف وتغليف</h3>
          <p>أظرف بريد بجميع المقاسات، أكياس بلاستيك، ورق تغليف، وشرائط لاصقة للاستخدامات المتعددة.</p>
          <span class="service-link">اكتشف المنتجات <i class="fas fa-angle-left"></i></span>
        </a>

        <a href="/office-supplies/whiteboards" class="service-card">
          <div class="service-icon"><i class="fas fa-chalkboard"></i></div>
          <h3>وايت بورد وفلين بورد</h3>
          <p>لوحات وايت بورد للمكاتب وغرف الاجتماعات، لوحات فلين، وممحايات وأقلام ماركر لوايت بورد.</p>
          <span class="service-link">اكتشف المنتجات <i class="fas fa-angle-left"></i></span>
        </a>

        <a href="/office-supplies/binding" class="service-card">
          <div class="service-icon"><i class="fas fa-paperclip"></i></div>
          <h3>أدوات ربط ودباسة</h3>
          <p>دباسات، مشابك ورق، مقصات، أوراق دبابيس، ثقاب ورق، وكل أدوات ربط المستندات.</p>
          <span class="service-link">اكتشف المنتجات <i class="fas fa-angle-left"></i></span>
        </a>

        <a href="/office-supplies/sticky-notes" class="service-card">
          <div class="service-icon"><i class="fas fa-sticky-note"></i></div>
          <h3>بوست إت وورق لاصق</h3>
          <p>أوراق بوست إت بجميع الأحجام والألوان، ورق لاصق للتعليق، وبطاقات تصنيف وترقيم.</p>
          <span class="service-link">اكتشف المنتجات <i class="fas fa-angle-left"></i></span>
        </a>

        <a href="/office-supplies/batteries-usb" class="service-card">
          <div class="service-icon"><i class="fas fa-battery-full"></i></div>
          <h3>بطاريات وUSB</h3>
          <p>بطاريات قلوية بجميع المقاسات، فلاشات USB، كروت ذاكرة، وملحقات إلكترونية للمكتب.</p>
          <span class="service-link">اكتشف المنتجات <i class="fas fa-angle-left"></i></span>
        </a>

      </div>
    </div>
  </section>

  <MidPageCTA formId="offIndexMidCta" />

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>المستلزمات المكتبية حسب نوع منشأتك</h2>
        <div class="divider"></div>
      </div>
      <div class="section-content" style="max-width:900px;margin:0 auto 20px">
        <p style="font-size:1.05rem;line-height:1.9;color:#444;margin-bottom:20px">
          احتياجات كل منشأة من المستلزمات المكتبية تختلف حسب طبيعة نشاطها وحجم فريقها وكثافة استهلاكها اليومي. من خبرتنا الممتدة منذ عام 1999 في تجهيز مئات المكاتب والمؤسسات، لاحظنا أن التخطيط الصحيح للمشتريات يوفر على العميل وقتاً ومالاً كبيرين. إليك كيف نساعد كل نوع من عملائنا في بناء قائمة مشتريات مناسبة لطبيعة عمله:
        </p>
      </div>
      <div class="services-grid">
        <div class="service-card" style="cursor:default">
          <div class="service-icon"><i class="fas fa-briefcase"></i></div>
          <h3>المكتب الصغير والشركة الناشئة</h3>
          <p>عادة ما يحتاج المكتب الذي يضم من 3 إلى 15 موظفاً إلى تجهيز أساسي: أقلام وأدوات كتابة، ورق A4 بوزن 75 أو 80 جرام بكمية كرتونة إلى كرتونتين شهرياً، ملفات حلقات وملفات معلقة لتنظيم المستندات، ودباسة ومشابك ورق. ننصح أصحاب المشاريع الناشئة بعدم المبالغة في المخزون في البداية والاعتماد على طلبات شهرية صغيرة قابلة للتعديل مع نمو الفريق، لتفادي تجميد رأس المال في مخزون زائد.</p>
        </div>
        <div class="service-card" style="cursor:default">
          <div class="service-icon"><i class="fas fa-building"></i></div>
          <h3>الشركات المتوسطة والكبيرة</h3>
          <p>الشركات التي تضم عشرات أو مئات الموظفين تحتاج إلى عقد توريد دوري ثابت يضمن عدم انقطاع المخزون في أي قسم. نساعد هذه الشركات في وضع جدول شهري أو ربع سنوي يغطي الورق، الأقلام، أدوات الأرشفة، وأدوات الربط بكميات محسوبة حسب عدد الموظفين، مع فوترة ضريبية مجمّعة تسهل عملية المحاسبة الداخلية وإمكانية الشراء بالأجل للعملاء الدائمين.</p>
        </div>
        <div class="service-card" style="cursor:default">
          <div class="service-icon"><i class="fas fa-school"></i></div>
          <h3>المدارس والجامعات</h3>
          <p>المؤسسات التعليمية لها موسمية واضحة في الطلب، إذ يرتفع الاستهلاك بشكل كبير مع بداية العام الدراسي وفترات الامتحانات. نوفر للمدارس باقات تجهيز تشمل الأقلام والدفاتر وورق الطباعة بكميات كبيرة قبل بداية الفصل الدراسي، مع أسعار جملة تراعي ميزانية القطاع التعليمي المحدودة، وإمكانية التوريد على دفعات متتالية بدلاً من دفعة واحدة لتخفيف الضغط على ميزانية المدرسة.</p>
        </div>
        <div class="service-card" style="cursor:default">
          <div class="service-icon"><i class="fas fa-hospital"></i></div>
          <h3>المستشفيات والعيادات</h3>
          <p>القطاع الطبي يحتاج إلى استمرارية مطلقة في توفر المستلزمات الإدارية دون أي تأخير، إذ يرتبط ذلك مباشرة بسجلات المرضى والفواتير الطبية. نوفر للمستشفيات والعيادات ملفات أرشفة مرمّزة بالألوان لتصنيف ملفات المرضى، ورقاً حرارياً لماكينات الفوترة، وأختاماً طبية، مع أولوية في التسليم السريع للطلبات الطارئة وخط تواصل مباشر لإعادة التموين الفوري.</p>
        </div>
        <div class="service-card" style="cursor:default">
          <div class="service-icon"><i class="fas fa-landmark"></i></div>
          <h3>الجهات الحكومية</h3>
          <p>التعامل مع الجهات الحكومية يتطلب التزاماً صارماً بالمواصفات الرسمية والفوترة الضريبية الكاملة وأحياناً إجراءات توريد وفق نظام المناقصات. لدينا خبرة طويلة في تلبية متطلبات الجهات الحكومية من ورق رسمي وملفات أرشفة معتمدة وأختام وأدوات مكتبية أساسية، مع الالتزام الكامل بمواعيد التسليم المتفق عليها والمستندات الرسمية المطلوبة لإتمام التعاقد.</p>
        </div>
        <div class="service-card" style="cursor:default">
          <div class="service-icon"><i class="fas fa-print"></i></div>
          <h3>المطابع ودور النشر</h3>
          <p>المطابع تستهلك كميات ضخمة من الورق بشكل يومي، لذلك تحتاج إلى مورد قادر على تلبية الطلبات الكبيرة بأسعار الطن أو الحمولة الكاملة، مع ضمان ثبات المواصفات (الوزن، البياض، السُمك) بين الدفعات المختلفة لتفادي أي تفاوت في جودة المطبوعات. نوفر أيضاً للمطابع مستلزمات التغليف اللازمة لتسليم المطبوعات النهائية للعملاء بشكل احترافي.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-bg">
    <div class="container">
      <div class="section-header">
        <h2>اطلب مستلزماتك في 3 خطوات بسيطة</h2>
        <div class="divider"></div>
      </div>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">1</div>
          <h4>اختر ما تحتاجه</h4>
          <p>تصفح فئاتنا المتنوعة واختر المنتجات التي تناسب احتياجات مكتبك سواء بالقطعة أو بالكرتونة أو بالجملة.</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <h4>تواصل معنا للسعر</h4>
          <p>اتصل بنا على 01227392074 أو أرسل قائمة طلباتك عبر واتساب وسنرسل لك عرض سعر فوري مع خصومات الجملة.</p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <h4>استلم في موعدك</h4>
          <p>نوفر التوصيل داخل الإسكندرية خلال 24 ساعة، وباقي محافظات مصر خلال 48-72 ساعة. ندير الشحن من أوله لآخره.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section" style="padding:60px 0;background:#f8f9fa">
    <div class="container">
      <h2 style="font-size:1.8rem;font-weight:700;color:#1a1a2e;margin-bottom:24px">توريد مستلزمات مكتبية للشركات والمؤسسات في مصر</h2>
      <p style="font-size:1.05rem;line-height:1.9;color:#444;margin-bottom:20px">نخدم عملاءنا في <a href="/cairo/office-supplies">القاهرة</a> و<a href="/alexandria/office-supplies">الإسكندرية</a> وجميع محافظات مصر بتوريد المستلزمات المكتبية للشركات والمؤسسات والمصانع والفنادق والمستشفيات. ما يميزنا عن متاجر التجزئة الكبرى:</p>
      <IconCardGrid columns={4} items={[
        { icon: 'fa-money-bill-wave', title: 'أسعار الجملة', text: 'خصومات خاصة للطلبات الكبيرة والعقود السنوية' },
        { icon: 'fa-truck', title: 'توصيل لجميع المحافظات', text: 'توصيل سريع لجميع أنحاء مصر بأمان تام' },
        { icon: 'fa-tag', title: 'تخصيص بشعار الشركة', text: 'دفاتر، أظرف، أقلام وأختام بشعارك وألوان علامتك التجارية' },
        { icon: 'fa-clipboard-list', title: 'عقود توريد دورية', text: 'نوفر اتفاقيات توريد شهرية أو فصلية بأسعار ثابتة مضمونة' },
      ]} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>كيف تختار مورد المستلزمات المكتبية المناسب؟</h2>
        <div class="divider"></div>
      </div>
      <div class="section-content" style="max-width:900px;margin:0 auto">
        <p style="font-size:1.05rem;line-height:1.9;color:#444;margin-bottom:16px">
          اختيار مورد المستلزمات المكتبية ليس قراراً بسيطاً، فهو يؤثر على استمرارية عملك اليومي وميزانيتك على المدى الطويل. إليك أهم المعايير التي ننصح كل عميل بالنظر إليها عند اختيار مورده:
        </p>
        <IconCardGrid columns={3} items={[
          { icon: 'fa-warehouse', title: 'عمق المخزون واستمراريته', text: 'المورد الجيد يحتفظ بمخزون كافٍ من الأصناف الأساسية بحيث لا يضطر عميله للانتظار أسابيع لتوفر صنف نفد فجأة. نحن نحتفظ بمخزون دائم يغطي أكثر من ألف منتج مكتبي.' },
          { icon: 'fa-tags', title: 'وضوح التسعير وثبات الأسعار', text: 'التذبذب المستمر في الأسعار يصعّب التخطيط المالي. نحدّث أسعارنا بشفافية ونثبتها في العقود السنوية مع عملائنا المؤسسيين لتجنب أي مفاجآت.' },
          { icon: 'fa-balance-scale', title: 'المرونة في الكميات', text: 'سواء أردت شراء قلم واحد أو حاوية كاملة من الورق، يجب أن يستوعب المورد الجيد الطلبات الصغيرة والضخمة بنفس الجدية والاهتمام.' },
          { icon: 'fa-shipping-fast', title: 'سرعة التوصيل وتغطيته الجغرافية', text: 'نغطي كل محافظات مصر، وليس الإسكندرية والقاهرة فقط، مع التزام واضح بمواعيد التسليم المتفق عليها.' },
          { icon: 'fa-file-invoice', title: 'الفوترة الضريبية السليمة', text: 'بالنسبة للشركات، الفاتورة الإلكترونية المطابقة لمتطلبات مصلحة الضرائب المصرية ضرورة وليست رفاهية.' },
          { icon: 'fa-headset', title: 'الدعم بعد البيع', text: 'إمكانية الاستبدال أو الإرجاع في حال وجود عيب تصنيع، وخط تواصل مباشر لأي استفسار أو طلب عاجل.' },
        ]} />

        <h3 style="margin-top:32px;color:var(--primary)">دليل تخطيط ميزانية المستلزمات المكتبية الشهرية</h3>
        <p style="font-size:1.05rem;line-height:1.9;color:#444;margin-bottom:16px">
          أحد أكثر الأسئلة التي نسمعها من عملائنا الجدد: "كم يجب أن أخصص شهرياً للمستلزمات المكتبية؟" الإجابة تعتمد على حجم فريقك وطبيعة عملك، لكن كقاعدة عامة استرشادية:
        </p>
        <ComparisonGrid items={[
          { title: 'مكتب صغير (حتى 10 موظفين)', text: 'ميزانية شهرية تغطي رزمة إلى رزمتي ورق A4 لكل موظف تقريباً، مع تجديد دوري لأدوات الكتابة والملفات كل شهرين إلى ثلاثة.' },
