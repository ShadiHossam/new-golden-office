---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';
import { getSeoFor } from '../../lib/siteSeo';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما الفرق بين ماكينة التصوير والطابعة متعددة الوظائف؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ماكينة التصوير (الفوتوكوبي) مُصمَّمة أساساً للاستخدام المكثف في بيئات العمل كالمكاتب ومحلات التصوير، وتتميز بسرعات طباعة عالية (من 20 إلى أكثر من 100 صفحة في الدقيقة)، وسعة كبيرة لورق الإدخال، وعمر افتراضي أطول. أما الطابعة متعددة الوظائف فهي مناسبة للاستخدام المتوسط في المنازل والمكاتب الصغيرة. الاختيار يعتمد على حجم الطباعة اليومي ومتطلبات عملك."
      }
    },
    {
      "@type": "Question",
      "name": "هل تتعاملون مع جميع الماركات؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم، نتعامل مع جميع الماركات العالمية الرئيسية لماكينات التصوير: كانون Canon، ريكو Ricoh، كيوسيرا Kyocera، توشيبا Toshiba، زيروكس Xerox. وللطابعات نتعامل مع: HP، كانون Canon، إبسون Epson، براذر Brother. سواء كنت تريد شراء جهاز جديد أو صيانة جهازك الحالي، نقدم الخدمة لجميع هذه الماركات."
      }
    },
    {
      "@type": "Question",
      "name": "هل تقدمون عقود صيانة دورية للشركات؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم، نُقدم عقود صيانة دورية مخصصة للشركات والمؤسسات. تشمل العقود زيارات صيانة وقائية منتظمة (شهرية أو ربع سنوية)، وأولوية في الاستجابة عند الأعطال الطارئة، وتقارير دورية عن حالة الأجهزة، وخصومات على قطع الغيار والمستهلكات. تواصل معنا للحصول على عرض سعر مخصص لاحتياجات شركتك."
      }
    },
    {
      "@type": "Question",
      "name": "ما مناطق التغطية الجغرافية لخدماتكم؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "مقرنا الرئيسي في الإسكندرية، ونقدم خدماتنا في الإسكندرية والقاهرة الكبرى والجيزة ومحافظات الدلتا والوجه البحري والوجه القبلي. يمكن ترتيب زيارات ميدانية لأي منطقة في مصر حسب الطلب. تواصل معنا وسنُحدد إمكانية الوصول إلى موقعكم."
      }
    },
    {
      "@type": "Question",
      "name": "هل تبيعون ماكينات تصوير مستعملة مجددة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم، نتوفر على ماكينات تصوير مستعملة تم تجديدها بالكامل (Refurbished) وهي خيار ممتاز لمن يريد الحصول على ماكينة بجودة عالية بسعر أقل. جميع الماكينات المجددة لدينا تمر بفحص شامل وإصلاح كامل قبل البيع، مع ضمان يصل إلى 6 أشهر. تواصل معنا للاستفسار عن المتوفر حالياً."
      }
    },
    {
      "@type": "Question",
      "name": "كم سعر ماكينة التصوير في مصر؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تتفاوت أسعار ماكينات التصوير في مصر بشكل كبير حسب الماركة والموديل والمواصفات وحالة الجهاز (جديد أو مستعمل مجدد). نوفر ضمان وخدمة ما بعد البيع لجميع الماكينات. تواصل معنا عبر واتساب وأخبرنا باحتياجك وسنرسل لك عرض سعر مجاني ودقيق خلال دقائق."
      }
    },
    {
      "@type": "Question",
      "name": "هل الأفضل شراء ماكينة تصوير أم الاكتفاء بعقد صيانة على ماكينة موجودة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "إذا كانت ماكينتك الحالية أقل من 5-6 سنوات وتعمل بأداء مقبول، فغالباً عقد صيانة دورية معنا أوفر من شراء جهاز جديد. أما إذا كانت الماكينة تتعطل بشكل متكرر أو تجاوزت دورة إنتاجها المتوقعة أو أصبحت قطع غيارها نادرة، فالشراء يكون الخيار الأكثر جدوى على المدى المتوسط. فريقنا يقيّم حالة ماكينتك مجاناً ويقترح عليك الحل الأنسب اقتصادياً."
      }
    },
    {
      "@type": "Question",
      "name": "ما الفرق بين احتياج المكتب الصغير واحتياج مطبعة أو محل تصوير؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "المكتب الصغير الذي يطبع أقل من 3000 صفحة شهرياً يكفيه جهاز متعدد الوظائف متوسط السرعة (20-30 صفحة/دقيقة) مع درج ورق واحد أو اثنين. أما المطبعة أو محل التصوير الذي يطبع عشرات الآلاف من الصفحات شهرياً فيحتاج ماكينة إنتاجية عالية السرعة (60-100+ صفحة/دقيقة) بدورة إنتاج شهرية مرتفعة وأدراج ورق متعددة وخيارات تجليد وتشطيب. نساعدك في تحديد الفئة الصحيحة بناءً على حجم طباعتك الفعلي."
      }
    },
    {
      "@type": "Question",
      "name": "هل تقدمون استشارة مجانية لتقييم احتياجات شركتي؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم، نقدم زيارة استشارية مجانية بدون التزام لتقييم حجم طباعتك الحالي وعدد المستخدمين والمساحة المتاحة، ثم نقترح عليك الحل الأمثل من حيث نوع الجهاز والماركة والسعة، سواء كان الحل شراء جهاز جديد أو مجدد أو مجرد عقد صيانة على جهازك الحالي."
      }
    },
    {
      "@type": "Question",
      "name": "هل يمكن تأجير ماكينة تصوير بدلاً من شرائها؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم، نوفر خيار التأجير الشهري للشركات التي تفضل عدم الاستثمار في شراء جهاز بالكامل، خاصة للمشاريع المؤقتة أو الشركات الناشئة. يشمل عقد التأجير الصيانة الدورية وقطع الغيار، ويمكن تحويل عقد التأجير لاحقًا إلى شراء إذا رغبت الشركة في تملك الجهاز."
      }
    },
    {
      "@type": "Question",
      "name": "كم يستغرق توريد وتركيب ماكينة تصوير جديدة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "الأجهزة المتوفرة في المخزون يتم توريدها وتركيبها عادة خلال يوم إلى يومي عمل. أما الطلبات الخاصة بمواصفات معينة أو ماركات غير متوفرة حاليًا فقد تستغرق أسبوعًا إلى أسبوعين حسب التوريد من المصنّع أو الوكيل."
      }
    }
  ]
});
---

<BaseLayout
  {...getSeoFor('/copiers')}
  preloadImage="/images/copiers-hub.webp"
  schemaJson={schemaJson}
>
<PageHero
  title="ماكينات تصوير في مصر — والطابعات لكل الماركات"
  subtitle="مركزكم الأول في مصر لبيع وصيانة ماكينات التصوير والطابعات — نجيب بأفضل حل لاحتياجك بجميع الماركات العالمية"
  heroImage="/images/copiers-hub.webp"
  heroIcon="fa-copy"
  showCta={true}
  breadcrumbs={[
    { label: 'الرئيسية', href: '/' },
    { label: 'ماكينات التصوير والطابعات' }
  ]}
/>

<!-- Service Detail -->
<section class="service-detail">
  <div class="container">
    <div class="service-detail-grid">

      <!-- Main Content -->
      <div class="service-content">
        <h2>نجيب بأفضل حل لكل احتياج في عالم ماكينات التصوير والطابعات</h2>
        <p>
          منذ تأسيس شركة نيو جولدن أوفيس عام 1999 في الإسكندرية، ونحن نُقدم خدمات متكاملة في مجال ماكينات التصوير والطابعات لعملائنا في جميع أنحاء مصر. بدأت رحلتنا بمحل صغير في الإبراهيمية، وتطورنا على مدى أكثر من 27 عاماً لنصبح أحد أبرز المراجع الموثوقة في سوق ماكينات التصوير والطابعات في مصر.
        </p>
        <p>
          نحن نتعامل مع أكبر الماركات العالمية في مجال ماكينات التصوير، وفي مقدمتها: <strong>كانون Canon</strong> بسلاسلها المتعددة من imageRUNNER وiR ADVANCE، وماكينات <strong>ريكو Ricoh</strong> بسلسلة MP الشهيرة، وماكينات <strong>كيوسيرا Kyocera</strong> بتقنية TASKalfa المتطورة، فضلاً عن ماكينات <strong>توشيبا Toshiba</strong> سلسلة e-STUDIO و<strong>زيروكس Xerox</strong> WorkCentre.
        </p>
        <p>
          أما في مجال الطابعات، فنحن وكلاء ومورِّدون معتمدون لطابعات <strong>HP</strong> LaserJet وDeskJet وOfficeJet، وطابعات <strong>Canon</strong> PIXMA وimageCLASS، وطابعات <strong>Epson</strong> EcoTank وWorkForce، وطابعات <strong>Brother</strong> بسلاسل DCP وMFC المتعددة الوظائف.
        </p>

        <h3>خدماتنا في مجال ماكينات التصوير والطابعات</h3>
        <div class="features-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;margin:24px 0;">
          <div class="feature-card" style="background:var(--bg-light);border-radius:12px;padding:24px;border-right:4px solid var(--secondary);">
            <i class="fas fa-copy" style="font-size:2rem;color:var(--secondary);margin-bottom:12px;display:block;"></i>
            <h4>بيع ماكينات التصوير</h4>
            <p>نوفر أحدث ماكينات التصوير الجديدة والمجددة من كانون وريكو وكيوسيرا وتوشيبا وزيروكس بأسعار منافسة.</p>
            <a href="/copiers/buy" class="btn btn-outline btn-sm" style="margin-top:12px;display:inline-flex;">اعرف المزيد</a>
          </div>
          <div class="feature-card" style="background:var(--bg-light);border-radius:12px;padding:24px;border-right:4px solid var(--secondary);">
            <i class="fas fa-print" style="font-size:2rem;color:var(--secondary);margin-bottom:12px;display:block;"></i>
            <h4>بيع طابعات</h4>
            <p>طابعات ليزر وإنكجيت من HP وكانون وإبسون وبراذر لجميع الاستخدامات المنزلية والمكتبية ومحلات الطباعة.</p>
            <a href="/copiers/printers" class="btn btn-outline btn-sm" style="margin-top:12px;display:inline-flex;">اعرف المزيد</a>
          </div>
          <div class="feature-card" style="background:var(--bg-light);border-radius:12px;padding:24px;border-right:4px solid var(--secondary);">
            <i class="fas fa-tools" style="font-size:2rem;color:var(--secondary);margin-bottom:12px;display:block;"></i>
            <h4>صيانة ماكينات التصوير</h4>
            <p>فريق فنيين متخصصين لصيانة جميع أنواع وماركات ماكينات التصوير والطابعات مع ضمان على الإصلاح.</p>
            <a href="/copiers/maintenance" class="btn btn-outline btn-sm" style="margin-top:12px;display:inline-flex;">اعرف المزيد</a>
          </div>
          <div class="feature-card" style="background:var(--bg-light);border-radius:12px;padding:24px;border-right:4px solid var(--secondary);">
            <i class="fas fa-tint" style="font-size:2rem;color:var(--secondary);margin-bottom:12px;display:block;"></i>
            <h4>كارتريدج وأحبار</h4>
            <p>كارتريدج أصلي وبديل لجميع موديلات الطابعات، خدمة تعبئة الكارتريدج، توفير أحبار الليزر والإنكجيت.</p>
            <a href="/copiers/cartridges" class="btn btn-outline btn-sm" style="margin-top:12px;display:inline-flex;">اعرف المزيد</a>
          </div>
        </div>

        <h3>لماذا تختار نيو جولدن أوفيس؟</h3>
        <p>
          في سوق مليء بالبدائل والاختيارات، ما الذي يُميّزنا؟ الإجابة ببساطة هي الخبرة والثقة والخدمة المتكاملة. منذ عام 1999 ونحن نُراكم خبراتنا في هذا المجال، ونتابع كل تطور تقني في صناعة ماكينات التصوير والطابعات. فريقنا الفني يتلقى تدريبات مستمرة على أحدث الأجهزة والتقنيات من الماركات العالمية الكبرى.
        </p>
        <p>
          نحرص على توفير قطع الغيار الأصلية والمعتمدة، ولا نتنازل عن جودة الإصلاح مقابل السرعة. عملاؤنا في الشركات والمكاتب والمستشفيات والمدارس ومحلات الطباعة في الإسكندرية والقاهرة وسائر محافظات مصر يُشهدون لنا بذلك على مدى عقود متواصلة.
        </p>
        <p>
          نُقدم أيضاً عقود صيانة دورية للشركات التي تُريد ضمان استمرارية عمل أجهزتها دون توقف. يشمل العقد زيارات صيانة وقائية منتظمة، وأولوية في الاستجابة عند الأعطال، وخصومات على قطع الغيار والمستهلكات.
        </p>

        <MidPageCTA formId="copIndexMidCta" />

        <h3>نخدم جميع أنحاء مصر</h3>
        <p>
          رغم أن مقرنا الرئيسي في الإسكندرية، إلا أن نطاق خدماتنا يمتد ليشمل القاهرة الكبرى، والجيزة، والمنصورة، والإسماعيلية، والسويس، وطنطا، وأسيوط، والمنيا، وسائر محافظات مصر. يتوفر لدينا فريق متنقل يمكنه الوصول إليك أينما كنت في مصر لتقديم خدمات التركيب والصيانة والدعم الفني.
        </p>

        <h3 style="margin-top:40px;">أي حل يناسب طبيعة عملك؟</h3>
        <p>
          قبل أن تقرر شراء ماكينة تصوير أو طابعة، يجدر أولاً تحديد فئة الاستخدام التي تنطبق عليك، لأن السعر والسرعة ودورة الإنتاج المناسبة تختلف اختلافاً جذرياً من فئة إلى أخرى. إليك دليل سريع يوضح ما ننصح به فعلياً لكل نوع من عملائنا:
        </p>
        <div class="features-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;margin:24px 0;">
          <div class="feature-card" style="background:var(--bg-light);border-radius:12px;padding:24px;border-right:4px solid var(--secondary);">
            <i class="fas fa-user-tie" style="font-size:2rem;color:var(--secondary);margin-bottom:12px;display:block;"></i>
            <h4>المكتب الصغير (1-10 موظفين)</h4>
            <p>طابعة أو ماكينة متعددة الوظائف متوسطة السرعة (20-30 صفحة/دقيقة) تكفي غالباً، خاصة إذا كان حجم الطباعة الشهري أقل من 3000 ورقة. الأولوية هنا للتوفير في الشراء الأولي وسهولة التشغيل.</p>
          </div>
          <div class="feature-card" style="background:var(--bg-light);border-radius:12px;padding:24px;border-right:4px solid var(--secondary);">
            <i class="fas fa-print" style="font-size:2rem;color:var(--secondary);margin-bottom:12px;display:block;"></i>
            <h4>محل الطباعة أو التصوير</h4>
            <p>يحتاج ماكينة إنتاجية بسرعة 60-100+ صفحة/دقيقة ودورة إنتاج شهرية عالية جداً، مع أدراج ورق متعددة وقدرة على تحمل الاستخدام المكثف يومياً دون تعطل. هنا تكلفة الصفحة أهم من سعر الشراء.</p>
          </div>
          <div class="feature-card" style="background:var(--bg-light);border-radius:12px;padding:24px;border-right:4px solid var(--secondary);">
            <i class="fas fa-school" style="font-size:2rem;color:var(--secondary);margin-bottom:12px;display:block;"></i>
            <h4>المدارس والجهات التعليمية</h4>
            <p>احتياج موسمي متغير بين فترات الامتحانات (طباعة كثيفة) وباقي العام (طباعة معتدلة). ننصح غالباً بماكينة متوسطة إلى كبيرة مع عقد صيانة يضمن جاهزيتها في فترات الذروة.</p>
          </div>
          <div class="feature-card" style="background:var(--bg-light);border-radius:12px;padding:24px;border-right:4px solid var(--secondary);">
            <i class="fas fa-building" style="font-size:2rem;color:var(--secondary);margin-bottom:12px;display:block;"></i>
            <h4>الشركات والمؤسسات الكبرى</h4>
            <p>عادة تحتاج أكثر من جهاز موزع على الأقسام، مع شبكة موحدة وإدارة مركزية للطباعة، وعقد صيانة شامل يضمن استمرارية العمل دون توقف في أي قسم.</p>
          </div>
        </div>

        <!-- How It Works -->
        <h3 style="margin-top:40px;">كيف نعمل؟</h3>
        <div class="steps-grid">
          <div class="step-item">
            <div class="step-number">1</div>
            <div class="step-content">
              <h4>تواصل معنا وأخبرنا باحتياجاتك</h4>
              <p>اتصل بنا أو أرسل لنا رسالة واتساب وأخبرنا بحجم عملك واحتياجاتك من ماكينة التصوير أو الطابعة. سنُحلل احتياجاتك بدقة.</p>
            </div>
          </div>
          <div class="step-item">
            <div class="step-number">2</div>
            <div class="step-content">
              <h4>نوفر لك أفضل الخيارات المناسبة لميزانيتك</h4>
              <p>بناءً على احتياجاتك وميزانيتك، نعرض عليك أفضل الخيارات من الماركات العالمية المعتمدة مع مقارنة كاملة بين المواصفات والأسعار.</p>
            </div>
          </div>
          <div class="step-item">
            <div class="step-number">3</div>
            <div class="step-content">
              <h4>نوصل ونثبت الجهاز مع ضمان وخدمة ما بعد البيع</h4>
              <p>نتولى التوصيل والتركيب والتشغيل التجريبي، ونُدرب فريقك على استخدام الجهاز. نُقدم ضمان وخدمة ما بعد البيع لراحة بالك.</p>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <h3 style="margin-top:40px;">الأسئلة الشائعة</h3>
        <div class="faq-list">
          <div class="faq-item">
            <button class="faq-question">ما الفرق بين ماكينة التصوير والطابعة متعددة الوظائف؟ <i class="fas fa-chevron-down"></i></button>
            <div class="faq-answer"><div class="faq-answer-inner">
              <p>ماكينة التصوير (الفوتوكوبي) مُصمَّمة أساساً للاستخدام المكثف في بيئات العمل كالمكاتب ومحلات التصوير، وتتميز بسرعات طباعة عالية (من 20 إلى أكثر من 100 صفحة في الدقيقة)، وسعة كبيرة لورق الإدخال، وعمر افتراضي أطول. أما الطابعة متعددة الوظائف فهي مناسبة للاستخدام المتوسط في المنازل والمكاتب الصغيرة. الاختيار يعتمد على حجم الطباعة اليومي ومتطلبات عملك.</p>
            </div></div>
          </div>
          <div class="faq-item">
            <button class="faq-question">هل تتعاملون مع جميع الماركات؟ <i class="fas fa-chevron-down"></i></button>
            <div class="faq-answer"><div class="faq-answer-inner">
              <p>نعم، نتعامل مع جميع الماركات العالمية الرئيسية لماكينات التصوير: كانون Canon، ريكو Ricoh، كيوسيرا Kyocera، توشيبا Toshiba، زيروكس Xerox. وللطابعات نتعامل مع: HP، كانون Canon، إبسون Epson، براذر Brother. سواء كنت تريد شراء جهاز جديد أو صيانة جهازك الحالي، نقدم الخدمة لجميع هذه الماركات.</p>
            </div></div>
          </div>
          <div class="faq-item">
            <button class="faq-question">هل تقدمون عقود صيانة دورية للشركات؟ <i class="fas fa-chevron-down"></i></button>
            <div class="faq-answer"><div class="faq-answer-inner">
              <p>نعم، نُقدم عقود صيانة دورية مخصصة للشركات والمؤسسات. تشمل العقود زيارات صيانة وقائية منتظمة (شهرية أو ربع سنوية)، وأولوية في الاستجابة عند الأعطال الطارئة، وتقارير دورية عن حالة الأجهزة، وخصومات على قطع الغيار والمستهلكات. تواصل معنا للحصول على عرض سعر مخصص لاحتياجات شركتك.</p>
            </div></div>
          </div>
          <div class="faq-item">
            <button class="faq-question">ما مناطق التغطية الجغرافية لخدماتكم؟ <i class="fas fa-chevron-down"></i></button>
            <div class="faq-answer"><div class="faq-answer-inner">
              <p>مقرنا الرئيسي في الإسكندرية، ونقدم خدماتنا في الإسكندرية والقاهرة الكبرى والجيزة ومحافظات الدلتا والوجه البحري والوجه القبلي. يمكن ترتيب زيارات ميدانية لأي منطقة في مصر حسب الطلب. تواصل معنا وسنُحدد إمكانية الوصول إلى موقعكم.</p>
            </div></div>
          </div>
          <div class="faq-item">
            <button class="faq-question">هل تبيعون ماكينات تصوير مستعملة مجددة؟ <i class="fas fa-chevron-down"></i></button>
            <div class="faq-answer"><div class="faq-answer-inner">
              <p>نعم، نتوفر على ماكينات تصوير مستعملة تم تجديدها بالكامل (Refurbished) وهي خيار ممتاز لمن يريد الحصول على ماكينة بجودة عالية بسعر أقل. جميع الماكينات المجددة لدينا تمر بفحص شامل وإصلاح كامل قبل البيع، مع ضمان يصل إلى 6 أشهر. تواصل معنا للاستفسار عن المتوفر حالياً.</p>
            </div></div>
          </div>
          <div class="faq-item">
            <button class="faq-question">كم سعر ماكينة التصوير في مصر؟ <i class="fas fa-plus"></i></button>
            <div class="faq-answer"><div class="faq-answer-inner">
              <p>تتفاوت أسعار ماكينات التصوير في مصر بشكل كبير حسب الماركة والموديل والمواصفات وحالة الجهاز (جديد أو مستعمل مجدد). نوفر ضمان وخدمة ما بعد البيع لجميع الماكينات. تواصل معنا عبر واتساب وأخبرنا باحتياجك وسنرسل لك عرض سعر مجاني ودقيق خلال دقائق.</p>
            </div></div>
          </div>
          <div class="faq-item">
            <button class="faq-question">هل الأفضل شراء ماكينة تصوير أم الاكتفاء بعقد صيانة على ماكينة موجودة؟ <i class="fas fa-plus"></i></button>
            <div class="faq-answer"><div class="faq-answer-inner">
              <p>إذا كانت ماكينتك الحالية أقل من 5-6 سنوات وتعمل بأداء مقبول، فغالباً عقد صيانة دورية معنا أوفر من شراء جهاز جديد. أما إذا كانت الماكينة تتعطل بشكل متكرر أو تجاوزت دورة إنتاجها المتوقعة أو أصبحت قطع غيارها نادرة، فالشراء يكون الخيار الأكثر جدوى على المدى المتوسط. فريقنا يقيّم حالة ماكينتك مجاناً ويقترح عليك الحل الأنسب اقتصادياً.</p>
            </div></div>
          </div>
          <div class="faq-item">
