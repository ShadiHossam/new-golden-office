---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import PageHero from '../../components/PageHero.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';
import IconCardGrid from '../../components/IconCardGrid.astro';
import { getSeoFor } from '../../lib/siteSeo';
import ServiceSidebar from '../../components/ServiceSidebar.astro';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما الفرق بين ماكينة التصوير والطابعة متعددة الوظائف؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ماكينة التصوير (الفوتوكوبي) مُصمَّمة أساساً للاستخدام المكثف في بيئات العمل كالمكاتب ومحلات التصوير، وتتميز بسرعات طباعة عالية (من 20 إلى أكثر من 100 صفحة في الدقيقة)، وسعة كبيرة لورق الإدخال، وعمر افتراضي أطول. أما الطابعة متعددة الوظائف فهي مناسبة للاستخدام المتوسط في المنازل والمكاتب الصغيرة. الاختيار يعتمد على حجم الطباعة اليومي ومتطلبات عملك."
      }
    },
    {
      "@type": "Question",
      "name": "هل تتعاملون مع جميع الماركات؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم، نتعامل مع جميع الماركات العالمية الرئيسية لماكينات التصوير: كانون Canon، ريكو Ricoh، كيوسيرا Kyocera، توشيبا Toshiba، زيروكس Xerox. وللطابعات نتعامل مع: HP، كانون Canon، إبسون Epson، براذر Brother. سواء كنت تريد شراء جهاز جديد أو صيانة جهازك الحالي، نقدم الخدمة لجميع هذه الماركات."
      }
    },
    {
      "@type": "Question",
      "name": "هل تقدمون عقود صيانة دورية للشركات؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم، نُقدم عقود صيانة دورية مخصصة للشركات والمؤسسات. تشمل العقود زيارات صيانة وقائية منتظمة (شهرية أو ربع سنوية)، وأولوية في الاستجابة عند الأعطال الطارئة، وتقارير دورية عن حالة الأجهزة، وخصومات على قطع الغيار والمستهلكات. تواصل معنا للحصول على عرض سعر مخصص لاحتياجات شركتك."
      }
    },
    {
      "@type": "Question",
      "name": "ما مناطق التغطية الجغرافية لخدماتكم؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "مقرنا الرئيسي في الإسكندرية، ونقدم خدماتنا في الإسكندرية والقاهرة الكبرى والجيزة ومحافظات الدلتا والوجه البحري والوجه القبلي. يمكن ترتيب زيارات ميدانية لأي منطقة في مصر حسب الطلب. تواصل معنا وسنُحدد إمكانية الوصول إلى موقعكم."
      }
    },
    {
      "@type": "Question",
      "name": "هل تبيعون ماكينات تصوير مستعملة مجددة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم، نتوفر على ماكينات تصوير مستعملة تم تجديدها بالكامل (Refurbished) وهي خيار ممتاز لمن يريد الحصول على ماكينة بجودة عالية بسعر أقل. جميع الماكينات المجددة لدينا تمر بفحص شامل وإصلاح كامل قبل البيع، مع ضمان يصل إلى 6 أشهر. تواصل معنا للاستفسار عن المتوفر حالياً."
      }
    },
    {
      "@type": "Question",
      "name": "كم سعر ماكينة التصوير في مصر؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تتفاوت أسعار ماكينات التصوير في مصر حسب الماركة والسرعة وحالة الجهاز. في 2026: ماكينة التصوير المستوردة المجددة أبيض وأسود مقاس A3 تبدأ من 18,000 جنيه، والألوان تبدأ من 21,000 جنيه، والطابعة الليزر الجديدة الصغيرة تبدأ من 6,000 جنيه. الأسعار تتغير مع سعر الصرف، فتواصل معنا عبر واتساب وأخبرنا باحتياجك وسنرسل لك عرض سعر مجاني ودقيق."
      }
    },
    {
      "@type": "Question",
      "name": "هل الأفضل شراء ماكينة تصوير أم الاكتفاء بعقد صيانة على ماكينة موجودة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "إذا كانت ماكينتك الحالية أقل من 5-6 سنوات وتعمل بأداء مقبول، فغالباً عقد صيانة دورية معنا أوفر من شراء جهاز جديد. أما إذا كانت الماكينة تتعطل بشكل متكرر أو تجاوزت دورة إنتاجها المتوقعة أو أصبحت قطع غيارها نادرة، فالشراء يكون الخيار الأكثر جدوى على المدى المتوسط. فريقنا يقيّم حالة ماكينتك مجاناً ويقترح عليك الحل الأنسب اقتصادياً."
      }
    },
    {
      "@type": "Question",
      "name": "ما الفرق بين احتياج المكتب الصغير واحتياج مطبعة أو محل تصوير؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "المكتب الصغير الذي يطبع أقل من 3000 صفحة شهرياً يكفيه جهاز متعدد الوظائف متوسط السرعة (20-30 صفحة/دقيقة) مع درج ورق واحد أو اثنين. أما المطبعة أو محل التصوير الذي يطبع عشرات الآلاف من الصفحات شهرياً فيحتاج ماكينة إنتاجية عالية السرعة (60-100+ صفحة/دقيقة) بدورة إنتاج شهرية مرتفعة وأدراج ورق متعددة وخيارات تجليد وتشطيب. نساعدك في تحديد الفئة الصحيحة بناءً على حجم طباعتك الفعلي."
      }
    },
    {
      "@type": "Question",
      "name": "هل تقدمون استشارة مجانية لتقييم احتياجات شركتي؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم، نقدم زيارة استشارية مجانية بدون التزام لتقييم حجم طباعتك الحالي وعدد المستخدمين والمساحة المتاحة، ثم نقترح عليك الحل الأمثل من حيث نوع الجهاز والماركة والسعة، سواء كان الحل شراء جهاز جديد أو مجدد أو مجرد عقد صيانة على جهازك الحالي."
      }
    },
    {
      "@type": "Question",
      "name": "هل يمكن تأجير ماكينة تصوير بدلاً من شرائها؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم، نوفر خيار التأجير الشهري للشركات التي تفضل عدم الاستثمار في شراء جهاز بالكامل، خاصة للمشاريع المؤقتة أو الشركات الناشئة. يشمل عقد التأجير الصيانة الدورية وقطع الغيار، ويمكن تحويل عقد التأجير لاحقًا إلى شراء إذا رغبت الشركة في تملك الجهاز."
      }
    },
    {
      "@type": "Question",
      "name": "كم يستغرق توريد وتركيب ماكينة تصوير جديدة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "الأجهزة المتوفرة في المخزون يتم توريدها وتركيبها عادة خلال يوم إلى يومي عمل. أما الطلبات الخاصة بمواصفات معينة أو ماركات غير متوفرة حاليًا فقد تستغرق أسبوعًا إلى أسبوعين حسب التوريد من المصنّع أو الوكيل."
      }
    }
  ]
});
---

<BaseLayout
  {...getSeoFor('/copiers')}
  schemaJson={schemaJson}
>
<PageHero
  title="ماكينات التصوير والطابعات في مصر: شراء وصيانة وأحبار"
  subtitle="مركزكم الأول في مصر لشراء وصيانة ماكينات التصوير والطابعات. نختار معك الجهاز الأنسب لعملك وميزانيتك من كل الماركات العالمية"
  heroImage="/images/copiers-hub.webp"
  heroIcon="fa-copy"
  showCta={true}
  breadcrumbs={[
    { label: 'الرئيسية', href: '/' },
    { label: 'ماكينات التصوير والطابعات' }
  ]}
/>

<!-- Service Detail -->
<section class="stats-section">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item reveal"><div class="stat-num" data-target="27" data-suffix="+">0+</div><div class="stat-label">سنة خبرة في السوق المصري</div></div>
      <div class="stat-item reveal delay-1"><div class="stat-num" data-target="5000" data-prefix="+">0</div><div class="stat-label">عميل راضٍ في جميع أنحاء مصر</div></div>
      <div class="stat-item reveal delay-3"><div class="stat-num" data-target="6">0</div><div class="stat-label">خدمات متكاملة تحت سقف واحد</div></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="service-detail-grid">
      <div class="service-content">
    <div class="section-header">
      <h2>الحل الأنسب لكل احتياج في ماكينات التصوير والطابعات</h2>
      <div class="divider"></div>
    </div>
    <p class="landing-lead">منذ تأسيس شركة نيو جولدن أوفيس عام 1999 في الإسكندرية، ونحن نُقدم خدمات متكاملة في مجال ماكينات التصوير والطابعات لعملائنا في جميع أنحاء مصر. بدأنا كشركة توريد وصيانة للشركات والمؤسسات، وتطورنا على مدى أكثر من 27 عاماً لنصبح أحد أبرز المراجع الموثوقة في سوق ماكينات التصوير والطابعات في مصر.</p>
    <div class="landing-body service-content">
<p>
        نتعامل مع أشهر الماركات العالمية في ماكينات التصوير مثل <strong>كانون Canon</strong> و<strong>ريكو Ricoh</strong> و<strong>كيوسيرا Kyocera</strong> و<strong>توشيبا Toshiba</strong> و<strong>زيروكس Xerox</strong>، وفي الطابعات مثل <strong>HP</strong> و<strong>Canon</strong> و<strong>Epson</strong> و<strong>Brother</strong>.
      </p>
      <p>
        ولا نحصرك في ماركة أو موديل بعينه: نوفر الجديد والمستورد المجدد، ونرشح لك الجهاز حسب حجم طباعتك الشهري وميزانيتك وتوفر الأحبار وقطع الغيار في السوق.
      </p>
    </div>
          <div class="intro-merged-block">
    <div class="section-header">
      <h2>خدماتنا في مجال ماكينات التصوير والطابعات</h2>
      <div class="divider"></div>
    </div>
    <div class="landing-body service-content">
<IconCardGrid columns={2} items={[
        { icon: 'fa-copy', title: 'شراء ماكينات التصوير', text: 'نوفر أحدث ماكينات التصوير الجديدة والمجددة من كانون وريكو وكيوسيرا وتوشيبا وزيروكس بأسعار منافسة. <a href="/copiers/buy">اعرف المزيد</a>' },
        { icon: 'fa-print', title: 'شراء طابعات', text: 'طابعات ليزر وإنكجيت من HP وكانون وإبسون وبراذر لجميع الاستخدامات المنزلية والمكتبية ومحلات الطباعة. <a href="/copiers/printers">اعرف المزيد</a>' },
        { icon: 'fa-tools', title: 'صيانة ماكينات التصوير', text: 'فريق فنيين متخصصين لصيانة جميع أنواع وماركات ماكينات التصوير والطابعات مع ضمان على الإصلاح. <a href="/copiers/maintenance">اعرف المزيد</a>' },
        { icon: 'fa-tint', title: 'كارتريدج وأحبار', text: 'كارتريدج أصلي وبديل لجميع موديلات الطابعات، خدمة تعبئة الكارتريدج، توفير أحبار الليزر والإنكجيت. <a href="/copiers/cartridges">اعرف المزيد</a>' },
      ]} />
    </div>
          </div>
      </div>
      <ServiceSidebar category="copiers" current="/copiers" />
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>لماذا تختار نيو جولدن أوفيس؟</h2>
      <div class="divider"></div>
    </div>
    <div class="landing-body service-content">
      <IconCardGrid columns={2} items={[
        { icon: 'fa-tools', title: 'خبرة في كل الماركات الكبرى', text: 'نبيع ونصين ماكينات كانون وريكو وكيوسيرا وتوشيبا وزيروكس، وطابعات HP وإبسون وبراذر، بقطع غيار أصلية.' },
        { icon: 'fa-file-contract', title: 'عقود صيانة دورية للشركات', text: 'زيارات وقائية شهرية أو ربع سنوية، وأولوية في الاستجابة عند الأعطال، وتقارير دورية عن حالة الأجهزة، وخصومات على قطع الغيار والمستهلكات.' },
        { icon: 'fa-tags', title: 'جديد أو مجدد أو تأجير', text: 'ماكينات جديدة، أو مجددة بالكامل بضمان يصل إلى 6 أشهر، أو تأجير شهري يشمل الصيانة وقطع الغيار ويمكن تحويله لشراء لاحقًا.' },
        { icon: 'fa-map-marked-alt', title: 'فريق متنقل في كل مصر', text: 'نصل للتركيب والصيانة في القاهرة الكبرى والجيزة والإسكندرية والمنصورة وطنطا والإسماعيلية والسويس وأسيوط والمنيا، ونرتب زيارات لباقي المحافظات حسب الطلب.' },
      ]} />
    </div>
  </div>
</section>

<MidPageCTA formId="copIndexMidCta" />

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>أي حل يناسب طبيعة عملك؟</h2>
      <div class="divider"></div>
    </div>
    <div class="landing-body service-content">
<p>
        قبل أن تقرر شراء ماكينة تصوير أو طابعة، يجدر أولاً تحديد فئة الاستخدام التي تنطبق عليك، لأن السعر والسرعة ودورة الإنتاج المناسبة تختلف اختلافاً جذرياً من فئة إلى أخرى. إليك دليل سريع يوضح ما ننصح به فعلياً لكل نوع من عملائنا:
      </p>
      <IconCardGrid columns={2} items={[
        { icon: 'fa-user-tie', title: 'المكتب الصغير (1-10 موظفين)', text: 'طابعة أو ماكينة متعددة الوظائف متوسطة السرعة (20-30 صفحة/دقيقة) تكفي غالباً، خاصة إذا كان حجم الطباعة الشهري أقل من 3000 ورقة. الأولوية هنا للتوفير في الشراء الأولي وسهولة التشغيل.' },
        { icon: 'fa-print', title: 'محل الطباعة أو التصوير', text: 'يحتاج ماكينة إنتاجية بسرعة 60-100+ صفحة/دقيقة ودورة إنتاج شهرية عالية جداً، مع أدراج ورق متعددة وقدرة على تحمل الاستخدام المكثف يومياً دون تعطل. هنا تكلفة الصفحة أهم من سعر الشراء.' },
        { icon: 'fa-school', title: 'المدارس والجهات التعليمية', text: 'احتياج موسمي متغير بين فترات الامتحانات (طباعة كثيفة) وباقي العام (طباعة معتدلة). ننصح غالباً بماكينة متوسطة إلى كبيرة مع عقد صيانة يضمن جاهزيتها في فترات الذروة.' },
        { icon: 'fa-building', title: 'الشركات والمؤسسات الكبرى', text: 'عادة تحتاج أكثر من جهاز موزع على الأقسام، مع شبكة موحدة وإدارة مركزية للطباعة، وعقد صيانة شامل يضمن استمرارية العمل دون توقف في أي قسم.' },
      ]} />

      <!-- How It Works -->
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <div class="as-h2">كيف نعمل؟</div>
      <div class="divider"></div>
    </div>
    <div class="landing-body service-content">
<div class="steps-grid">
        <div class="step-card"><div class="step-num">1</div><div class="as-h3">تواصل معنا وأخبرنا باحتياجاتك</div><p>اتصل بنا أو أرسل لنا رسالة واتساب وأخبرنا بحجم عملك واحتياجاتك من ماكينة التصوير أو الطابعة. سنُحلل احتياجاتك بدقة.</p></div>
        <div class="step-card"><div class="step-num">2</div><div class="as-h3">نوفر لك أفضل الخيارات المناسبة لميزانيتك</div><p>بناءً على احتياجاتك وميزانيتك، نعرض عليك أفضل الخيارات من الماركات العالمية مع مقارنة كاملة بين المواصفات والأسعار.</p></div>
        <div class="step-card"><div class="step-num">3</div><div class="as-h3">نوصل ونثبت الجهاز مع ضمان وخدمة ما بعد البيع</div><p>نتولى التوصيل والتركيب والتشغيل التجريبي، ونُدرب فريقك على استخدام الجهاز. نُقدم ضمان وخدمة ما بعد البيع لراحة بالك.</p></div>
      </div>

      <!-- FAQ -->
    </div>
  </div>
</section>

<section class="section section-sm">
  <div class="container">
    <div class="sidebar-cards-row cols-1">
<div class="sidebar-card">
                <div class="as-h3"><i class="fas fa-phone" style="color:var(--secondary);margin-left:8px;"></i> تواصل معنا الآن</div>
                <div class="contact-info">
                  <div class="contact-info-item">
                    <i class="fas fa-phone"></i>
                    <div><strong>01227392074</strong><br><a href="tel:01227392074" class="btn btn-primary btn-sm" style="margin-top:8px;display:inline-flex;">اتصل الآن</a></div>
                  </div>
                  <div class="contact-info-item">
                    <i class="fab fa-whatsapp" style="color:#25D366;"></i>
                    <div><strong>واتساب</strong><br><a href="https://wa.me/201227392074" class="btn btn-whatsapp btn-sm" style="margin-top:8px;display:inline-flex;">ابدأ محادثة</a></div>
                  </div>
                  <div class="contact-info-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <span>26 عبد المنعم سند، الإبراهيمية، باب شرق، الإسكندرية</span>
                  </div>
                  <div class="contact-info-item">
                    <i class="fas fa-clock"></i>
                    <span>السبت – الخميس: 9ص – 6م</span>
                  </div>
                </div>
              </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>أبرز الماركات المتاحة في مصر</h2>
      <div class="divider"></div>
    </div>
    <div class="landing-body service-content">
      <IconCardGrid columns={2} items={[
        { icon: 'fa-copy', title: 'ماكينات التصوير', text: 'كانون Canon وريكو Ricoh وكيوسيرا Kyocera وتوشيبا Toshiba وزيروكس Xerox هي الأكثر انتشاراً في مصر، وأحبارها وقطع غيارها متوفرة في السوق، مما يسهّل الصيانة ويقلل وقت التوقف.' },
        { icon: 'fa-print', title: 'الطابعات', text: 'HP وCanon وEpson وBrother تغطي كل الاستخدامات: طابعات ليزر للمكاتب، وطابعات بخزانات حبر للطباعة الملونة الكثيرة بتكلفة أقل، وأجهزة متعددة الوظائف للطباعة والتصوير والمسح الضوئي.' },
      ]} />
    </div>
