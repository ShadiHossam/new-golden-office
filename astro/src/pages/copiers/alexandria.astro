---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://newgoldenoffice.com/copiers/alexandria#service",
      "name": "بيع وصيانة ماكينات تصوير في الإسكندرية",
      "serviceType": "بيع وصيانة ماكينات تصوير مستندات",
      "url": "https://newgoldenoffice.com/copiers/alexandria",
      "provider": { "@id": "https://newgoldenoffice.com/#organization" },
      "areaServed": { "@type": "City", "name": "الإسكندرية" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"ما الماركات التي توفرها الشركة؟","acceptedAnswer":{"@type":"Answer","text":"نوفر توشيبا وريكو وزيروكس وكيوسيرا وكانون وكونيكا مينولتا، بيعًا وصيانة وأحبارًا، ونرشح الأنسب بحيادية حسب الاستخدام."}},
        {"@type":"Question","name":"أيهما أفضل: ماكينة جديدة أم استيراد خارج؟","acceptedAnswer":{"@type":"Answer","text":"الجديد أطول عمرًا ويناسب الاعتماد اليومي الكثيف. الاستيراد خارج أقل تكلفة بشرط شرائه من جهة تفحصه وتضمنه."}},
        {"@type":"Question","name":"كم سعر ماكينة التصوير في الإسكندرية؟","acceptedAnswer":{"@type":"Answer","text":"السعر يتحدد بالفئة والسرعة والماركة والحالة والملحقات، ويصلك عرض سعر مفصل يشمل الجهاز والضمان."}},
        {"@type":"Question","name":"هل الصيانة متاحة بسرعة داخل الإسكندرية؟","acceptedAnswer":{"@type":"Answer","text":"نعم، مقرنا داخل الإسكندرية وفرق الصيانة تتحرك بسرعة، ولعملاء عقود الصيانة أولوية استجابة."}},
        {"@type":"Question","name":"هل الأحبار المتوفرة أصلية؟","acceptedAnswer":{"@type":"Answer","text":"نوفر الأحبار والخراطيش الأصلية، ومتوافقات عالية الجودة لمن يفضلها."}},
        {"@type":"Question","name":"هل يوجد ضمان على الماكينات؟","acceptedAnswer":{"@type":"Answer","text":"نعم، كل ماكينة تأتي بضمان موثق للجديد وللاستيراد المستعمل معًا."}},
        {"@type":"Question","name":"هل يمكن تأجير ماكينة تصوير بالشهر؟","acceptedAnswer":{"@type":"Answer","text":"نعم، نوفر إيجارًا شهريًا يشمل الصيانة، يناسب المشاريع المؤقتة والفروع الجديدة."}},
        {"@type":"Question","name":"هل يوجد بيع بالتقسيط؟","acceptedAnswer":{"@type":"Answer","text":"نعم، نوفر خيارات تقسيط تُعرض بالأرقام كاملة قبل أي التزام."}}
      ]
    }
  ]
});
---

<BaseLayout
  title="شركة ماكينات تصوير في الإسكندرية | بيع وصيانة وأحبار"
  description="شركة ماكينات تصوير في الإسكندرية بخبرة 27 عامًا. بيع جديد واستيراد خارج، صيانة وأحبار وقطع غيار، تقسيط وإيجار وعقود شركات. اطلب عرض سعر الآن."
  keywords="شركة ماكينات تصوير في الإسكندرية، صيانة ماكينات تصوير الاسكندرية، شراء ماكينة تصوير الاسكندرية"
  ogTitle="شركة ماكينات تصوير في الإسكندرية | نيو جولدن أوفيس"
  ogDescription="بيع جديد واستيراد خارج، صيانة وأحبار وقطع غيار، تقسيط وإيجار وعقود شركات في الإسكندرية."
  ogImage="/images/copiers-hub.webp"
  robots="noindex, nofollow"
  schemaJson={schemaJson}
>
<style>
  .quote-section{padding:60px 0}
  .quote-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:stretch}
  .quote-form-card{background:#fff;border-radius:18px;padding:2.2rem;box-shadow:0 4px 24px rgba(27,58,107,0.1)}
  .quote-form-card h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:700;color:var(--green-dark);margin-bottom:1.5rem}
  .form-group{margin-bottom:1.1rem}
  .form-group label{display:block;font-family:'Cairo',sans-serif;font-size:0.95rem;font-weight:600;color:var(--green-dark);margin-bottom:0.4rem}
  .form-group input,.form-group select,.form-group textarea{width:100%;padding:0.8rem 1rem;border:2px solid #e5eaf3;border-radius:10px;font-family:'Tajawal',sans-serif;font-size:1rem;color:#333;background:#fafbfd;transition:border-color .3s,box-shadow .3s;outline:none;box-sizing:border-box;direction:rtl}
  .form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--green-dark);box-shadow:0 0 0 3px rgba(27,58,107,.1);background:#fff}
  .form-group textarea{height:100px;resize:vertical}
  .form-submit-btn{width:100%;padding:1rem;background:linear-gradient(135deg,var(--green-dark),var(--green-mid));color:#fff;border:none;border-radius:12px;font-family:'Cairo',sans-serif;font-size:1.05rem;font-weight:700;cursor:pointer;transition:transform .3s,box-shadow .3s;display:flex;align-items:center;justify-content:center;gap:.5rem}
  .form-submit-btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(27,58,107,.25)}
  .success-message{display:none;background:linear-gradient(135deg,#e8f5e9,#f1f8e9);border:2px solid #4caf50;border-radius:12px;padding:1.5rem;text-align:center;margin-top:1rem}
  .success-message i{font-size:2.5rem;color:#4caf50;display:block;margin-bottom:.5rem}
  .success-message p{font-family:'Cairo',sans-serif;font-size:1.05rem;color:#2e7d32;font-weight:600}
  .quote-alt-card{background:linear-gradient(135deg,#25D366 0%,#128C7E 100%);border-radius:18px;padding:2.4rem;text-align:center;color:#fff;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:1rem}
  .quote-alt-card .wa-icon{font-size:3rem}
  .quote-alt-card h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:800}
  .quote-alt-card p{opacity:.92;line-height:1.8}
  @media(max-width:768px){.quote-grid{grid-template-columns:1fr}}
</style>

<section class="page-hero">
  <div class="container">
    <div class="page-hero-inner">
      <div class="page-hero-content">
        <nav class="breadcrumb">
          <a href="/">الرئيسية</a>
          <span>/</span>
          <a href="/alexandria">خدماتنا في الإسكندرية</a>
          <span>/</span>
          <span class="current">شركة ماكينات تصوير في الإسكندرية</span>
        </nav>
        <h1 class="reveal">شركة ماكينات تصوير في الإسكندرية</h1>
        <p class="lead reveal delay-1">بيع جديد واستيراد خارج، صيانة وأحبار وقطع غيار أصلية، تقسيط وإيجار وعقود صيانة سنوية للشركات، من مقر فعلي بخبرة 27 عامًا</p>
      </div>
      <div class="page-hero-image">
        <img src="/images/copier-mfp-office-1784572494696-842827.jpg" alt="شركة ماكينات تصوير في الإسكندرية" loading="eager">
      </div>
    </div>
  </div>
</section>

<section class="stats-section">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item reveal"><div class="stat-num" data-target="27" data-suffix="+">0+</div><div class="stat-label">سنة خبرة في خدمة مكاتب الإسكندرية</div></div>
      <div class="stat-item reveal delay-1"><div class="stat-num" data-target="6">0</div><div class="stat-label">ماركات عالمية نوفرها بحيادية</div></div>
      <div class="stat-item reveal delay-2"><div class="stat-num" data-target="2">0</div><div class="stat-label">خيارات: جديد واستيراد خارج</div></div>
      <div class="stat-item reveal delay-3"><div class="stat-num" data-target="1">0</div><div class="stat-label">مورد واحد للجهاز والحبر والصيانة</div></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="intro-text" style="max-width:900px;margin:0 auto 48px;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>إذا كنت تبحث عن شركة ماكينات تصوير في الإسكندرية توفر الجهاز والحبر والصيانة وقطع الغيار من مكان واحد، فأنت في العنوان الصحيح. نيو جولدن أوفيس تخدم مكاتب وشركات ومدارس الإسكندرية منذ 27 عامًا من مقرنا الفعلي: 26 عبد المنعم سند، الإبراهيمية، باب شرق. نبيع ماكينات جديدة واستيراد خارج من أشهر الماركات، ونقدم صيانة وأحبارًا وتونر أصليًا، مع خيارات تقسيط وإيجار وعقود صيانة سنوية للشركات.</p>
    </div>

    <div class="section-header">
      <h2>لماذا نيو جولدن أوفيس؟</h2>
      <div class="divider"></div>
    </div>
    <div class="features-grid">
      <div class="feature-card reveal"><div class="feature-icon"><i class="fas fa-award"></i></div><h4>27 عامًا من العمل الفعلي</h4><p>مررنا بأجيال كاملة من الموديلات ونعرف ما يصمد في الاستخدام المصري الكثيف.</p></div>
      <div class="feature-card reveal delay-1"><div class="feature-icon"><i class="fas fa-building"></i></div><h4>مقر حقيقي داخل الإسكندرية</h4><p>لا مخزن بعيد ولا وسيط. تزورنا وترى الماكينات وتستلم خدمتك من فريق تعرفه.</p></div>
      <div class="feature-card reveal delay-2"><div class="feature-icon"><i class="fas fa-scale-balanced"></i></div><h4>حيادية الماركة</h4><p>نوفر توشيبا وريكو وزيروكس وكيوسيرا وكانون وكونيكا مينولتا بترشيح محايد.</p></div>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>بيع ماكينات تصوير: جديد واستيراد خارج</h2>
      <div class="divider"></div>
    </div>
    <div class="services-grid">
      <div class="service-card reveal"><div class="service-icon"><i class="fas fa-star"></i></div><h3 class="service-title">الماكينة الجديدة</h3><p class="service-desc">أحدث التقنيات وأطول عمر تشغيلي وضمان كامل من اليوم الأول، للشركات التي لا تحتمل مفاجآت.</p><a href="/copiers/buy" class="btn btn-outline btn-sm">ماكينات للبيع <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal delay-1"><div class="service-icon"><i class="fas fa-recycle"></i></div><h3 class="service-title">استيراد خارج (استعمال خارج)</h3><p class="service-desc">ماكينات مستعملة بحالة جيدة وعداد منخفض، مفحوصة وبضمان موثق، بتكلفة أقل وضوحًا.</p></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>الماركات التي نوفرها</h2>
      <div class="divider"></div>
    </div>
    <div style="overflow-x:auto;max-width:900px;margin:0 auto">
      <table style="width:100%;border-collapse:collapse;font-size:0.95rem">
        <thead><tr style="background:var(--green-dark);color:var(--white)"><th style="padding:14px 16px;text-align:right">الماركة</th><th style="padding:14px 16px;text-align:right">أبرز ما تُعرف به</th><th style="padding:14px 16px;text-align:right">الأنسب لمن؟</th></tr></thead>
        <tbody>
          <tr style="background:var(--white);border-bottom:1px solid #eee"><td style="padding:12px 16px">توشيبا e-Studio</td><td style="padding:12px 16px">انتشار واسع وقطع غيار متوفرة دائمًا</td><td style="padding:12px 16px">خيار عملي مضمون</td></tr>
          <tr style="background:#f8f9fa;border-bottom:1px solid #eee"><td style="padding:12px 16px">ريكو Ricoh MP</td><td style="padding:12px 16px">تحمّل قوي للأحجام الكبيرة</td><td style="padding:12px 16px">الاستخدام الكثيف</td></tr>
          <tr style="background:var(--white);border-bottom:1px solid #eee"><td style="padding:12px 16px">زيروكس Xerox</td><td style="padding:12px 16px">جودة ألوان قوية</td><td style="padding:12px 16px">طباعة مواد ألوان وعروض</td></tr>
          <tr style="background:#f8f9fa;border-bottom:1px solid #eee"><td style="padding:12px 16px">كيوسيرا Kyocera</td><td style="padding:12px 16px">مكونات طويلة العمر</td><td style="padding:12px 16px">تكلفة تشغيل منخفضة</td></tr>
          <tr style="background:var(--white);border-bottom:1px solid #eee"><td style="padding:12px 16px">كانون Canon</td><td style="padding:12px 16px">سهولة استخدام وموثوقية</td><td style="padding:12px 16px">المكاتب الصغيرة والمتوسطة</td></tr>
          <tr style="background:#f8f9fa"><td style="padding:12px 16px">كونيكا مينولتا</td><td style="padding:12px 16px">إنتاجية عالية وأداء ألوان</td><td style="padding:12px 16px">الطباعة الملونة الاحترافية</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>لقطاع الاستيراد والتصدير ولقطاع التعليم</h2>
      <div class="divider"></div>
    </div>
    <div class="intro-text" style="max-width:900px;margin:0 auto;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p><strong>قرب الميناء، حيث لا يحتمل المستند التأخير.</strong> مكاتب الاستيراد والتصدير والتخليص حول الميناء تتعامل يوميًا مع مستندات شحن وفواتير وبوالص لا بد أن تُنسخ وتُطبع في وقتها. لهذه المكاتب نوفر ماكينات تتحمل الاستخدام الكثيف واستجابة صيانة سريعة، مع توريد أحبار منتظم.</p>
      <p style="margin-top:16px"><strong>للمدارس والجامعات ومراكز الدروس.</strong> قطاع التعليم يطبع بكثافة موسمية عالية: مذكرات وامتحانات وأوراق عمل بكميات كبيرة في فترات ضيقة. نرشح ماكينات بسرعات إنتاج مناسبة وتكلفة نسخة اقتصادية، مع عقود صيانة تضمن جاهزية الماكينة في مواسم الامتحانات.</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>صيانة ماكينات تصوير الاسكندرية</h2>
      <div class="divider"></div>
    </div>
    <div class="features-grid">
      <div class="feature-card reveal"><div class="feature-icon"><i class="fas fa-bolt"></i></div><h4>الأعطال المفاجئة</h4><p>تشخيص وإصلاح سريع بفنيين متخصصين وقطع غيار أصلية من مخزوننا داخل الإسكندرية.</p><a href="/copiers/maintenance" class="btn btn-outline btn-sm">صيانة الماكينات <i class="fas fa-arrow-left"></i></a></div>
      <div class="feature-card reveal delay-1"><div class="feature-icon"><i class="fas fa-broom"></i></div><h4>الصيانة الوقائية الدورية</h4><p>تنظيف الوحدات، فحص الأسطوانات والسخانات، ومعايرة جودة الطباعة.</p></div>
      <div class="feature-card reveal delay-2"><div class="feature-icon"><i class="fas fa-shield-halved"></i></div><h4>ضمان موثق</h4><p>كل ماكينة نبيعها، جديدة أو استيرادًا، تأتي بضمان موثق يحدد ما يغطيه بوضوح.</p></div>
    </div>
  </div>
</section>

<MidPageCTA formId="copAlexandriaMidCta" />

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>أحبار وتونر وقطع غيار أصلية</h2>
      <div class="divider"></div>
    </div>
    <p style="max-width:800px;margin:0 auto;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">الحبر الرديء يدمر الأسطوانة ويطفئ جودة المستندات تدريجيًا. نوفر <a href="/copiers/cartridges">أحبار وخراطيش ماكينات التصوير</a> الأصلية والمتوافقة عالية الجودة، مع توريد سريع وجدولة توريد شهرية للشركات. ونوفر قطع غيار أصلية: أسطوانات، سخانات، وحدات حرارية، ورولات سحب الورق. إذا كنت تجهز منظومة طباعة كاملة، اطلع على <a href="/copiers/printers">الطابعات المكتبية</a> لتكتمل المنظومة من مورد واحد.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>إيجار ماكينات تصوير وعقود صيانة سنوية</h2>
      <div class="divider"></div>
    </div>
    <div class="features-grid">
      <div class="feature-card reveal"><div class="feature-icon"><i class="fas fa-calendar-days"></i></div><h4>الإيجار الشهري</h4><p>ماكينة تعمل في مقرك بعقد يشمل الصيانة، بلا تكلفة شراء مقدمة، مناسب للمشاريع المؤقتة والفروع الجديدة.</p></div>
      <div class="feature-card reveal delay-1"><div class="feature-icon"><i class="fas fa-file-contract"></i></div><h4>عقود الصيانة السنوية</h4><p>زيارات وقائية منتظمة، أولوية استجابة عند الأعطال، وتقرير دوري عن حالة كل جهاز.</p></div>
      <div class="feature-card reveal delay-2"><div class="feature-icon"><i class="fas fa-credit-card"></i></div><h4>البيع بالتقسيط</h4><p>توزيع التكلفة على أشهر بدل دفعة واحدة، بأرقام كاملة قبل أي التزام.</p></div>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>ما الذي يحدد سعر ماكينة التصوير؟</h2>
      <div class="divider"></div>
    </div>
    <div class="intro-text" style="max-width:900px;margin:0 auto;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <ul style="max-width:700px;margin:0 auto;padding-inline-start:20px;line-height:2.1">
        <li><strong>الفئة والسرعة:</strong> ماكينة الإنتاج الكثيف غير الماكينة المكتبية.</li>
        <li><strong>جديد أم استيراد خارج:</strong> فارق كبير في تكلفة الشراء بين الحالتين.</li>
        <li><strong>أبيض وأسود أم ألوان:</strong> الألوان أعلى سعرًا شراءً وتشغيلًا.</li>
        <li><strong>الماركة والموديل وسنة الإصدار.</strong></li>
        <li><strong>الملحقات:</strong> وحدة تغذية، فرز، دوبلكس، وتجهيزات الشبكة.</li>
      </ul>
      <p style="margin-top:20px;text-align:center">اطلب عرض سعر عبر 01227392074 وسيصلك العرض مفصلًا: سعر الجهاز، الضمان، وتكلفة التشغيل المتوقعة.</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>مناطق نخدمها في الإسكندرية</h2>
      <div class="divider"></div>
    </div>
    <p style="max-width:800px;margin:0 auto;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">استجابة سريعة في وسط البلد وسموحة وسيدي جابر وميامي وجليم ولوران، وخدمة منتظمة للأسواق التقليدية في المنشية والعطارين ولمحال الكورنيش، وتغطية كاملة لباقي مناطق الإسكندرية بمواعيد نتفق عليها. ونخدم القاهرة أيضًا عبر <a href="/copiers/cairo">صفحة ماكينات التصوير في القاهرة</a>.</p>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>أسئلة شائعة عن ماكينات التصوير في الإسكندرية</h2>
      <div class="divider"></div>
    </div>
    <div class="faq-list">
