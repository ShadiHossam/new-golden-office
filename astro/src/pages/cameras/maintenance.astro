---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import PageHero from '../../components/PageHero.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';
import ContentIntro from '../../components/ContentIntro.astro';
import IconCardGrid from '../../components/IconCardGrid.astro';
import { getSeoFor } from '../../lib/siteSeo';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "صيانة كاميرات المراقبة",
  "description": "صيانة وإصلاح كاميرات المراقبة وأجهزة DVR وNVR في مصر — تنظيف، إصلاح أعطال، تحديث برامج، وعقود صيانة سنوية.",
  "serviceType": "صيانة كاميرات مراقبة",
  "provider": {
    "@type": "LocalBusiness",
    "name": "نيو جولدن أوفيس",
    "url": "https://newgoldenoffice.com",
    "telephone": "+201227392074",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "26 عبد المنعم سند",
      "addressLocality": "الإبراهيمية، باب شرق",
      "addressRegion": "الإسكندرية",
      "addressCountry": "EG"
    }
  },
  "areaServed": { "@type": "Country", "name": "Egypt" }
});
---

<BaseLayout
  {...getSeoFor('/cameras/maintenance')}
  schemaJson={schemaJson}
  preloadImage="/images/cameras-hub.webp"
>
<PageHero
  title="صيانة كاميرات مراقبة في مصر — عقود سنوية وإصلاح سريع"
  subtitle="فريق صيانة متخصص لجميع أنواع كاميرات المراقبة وأجهزة DVR وNVR — استجابة سريعة، قطع غيار أصلية، عقود صيانة سنوية بأسعار تنافسية في جميع أنحاء مصر"
  heroImage="/images/cameras-hub.webp"
  heroIcon="fa-wrench"
  breadcrumbs={[
    { label: 'الرئيسية', href: '/' },
    { label: 'كاميرات المراقبة', href: '/cameras' },
    { label: 'صيانة أنظمة المراقبة' }
  ]}
/>

<section class="service-detail">
  <div class="container"><div class="service-detail-grid">
    <div class="service-content">
      <ContentIntro
        heading="إصلاح كاميرات مراقبة — نظام في أفضل حالة دائماً"
        text="كاميرات المراقبة تعمل 24 ساعة يومياً على مدار السنة، وهذا يعني أنها معرضة للغبار والحرارة والاهتراء أكثر من أي جهاز إلكتروني آخر. الصيانة الدورية ليست رفاهية بل ضرورة لضمان استمرار عمل نظامك بكفاءة عالية واكتشاف المشكلات قبل أن تتحول إلى أعطال مكلفة. فريق نيو جولدن أوفيس يوفر خدمة صيانة شاملة لجميع أنواع أنظمة المراقبة."
      />

      <h3><i class="fas fa-exclamation-triangle" style="color:var(--secondary);margin-left:8px;"></i> أشهر مشكلات كاميرات المراقبة</h3>
      <p>تواجه أنظمة المراقبة عدة مشكلات شائعة نتعامل معها يومياً:</p>
      <IconCardGrid columns={4} items={[
        { icon: 'fa-eye', title: 'ضبابية الصورة أو ضعف الجودة', text: 'غالباً بسبب تراكم الغبار على العدسة أو تلف الزجاج الأمامي أو ضعف الإضاءة الليلية' },
        { icon: 'fa-unlink', title: 'انقطاع الصورة أو ضوضاء', text: 'مشكلة في الكابل أو الموصلات أو بطاقة التسجيل في جهاز DVR' },
        { icon: 'fa-video-slash', title: 'الكاميرة لا تظهر في جهاز التسجيل', text: 'انقطاع كهرباء أو تلف مصدر الطاقة أو مشكلة في الكابل' },
        { icon: 'fa-power-off', title: 'توقف جهاز DVR/NVR فجأة', text: 'تلف في مصدر الطاقة أو الهاردسك أو اللوحة الأم' },
        { icon: 'fa-mobile-alt', title: 'عدم القدرة على المشاهدة من الهاتف', text: 'مشكلة في إعدادات الإنترنت أو تحديث برنامج الجهاز' },
        { icon: 'fa-arrows-alt', title: 'الكاميرة تتحرك من مكانها', text: 'ضعف مسامير التثبيت أو تآكل الدعامة بفعل الطقس' },
        { icon: 'fa-hdd', title: 'الهاردسك لا يعمل أو لا يُسجّل', text: 'تلف الهاردسك بسبب الاهتراء أو انقطاع الكهرباء المفاجئ' },
      ]} />

      <h3><i class="fas fa-calendar-check" style="color:var(--secondary);margin-left:8px;"></i> الصيانة الوقائية الدورية</h3>
      <p>نوصي بصيانة دورية كل 6 أشهر تشمل:</p>
      <IconCardGrid columns={4} items={[
        { icon: 'fa-broom', title: 'تنظيف العدسات', text: 'إزالة الغبار والأوساخ من الزجاج الأمامي بمواد متخصصة لا تخدش السطح' },
        { icon: 'fa-network-wired', title: 'فحص الكابلات والموصلات', text: 'التأكد من سلامة التوصيلات وعدم وجود تلف أو صدأ في الموصلات' },
        { icon: 'fa-moon', title: 'اختبار الإضاءة الليلية', text: 'التحقق من عمل الـ IR بشكل صحيح وتغيير المصابيح الليدية إذا لزم' },
        { icon: 'fa-thumbtack', title: 'فحص مسامير التثبيت', text: 'تشديد جميع مسامير وأذرع تثبيت الكاميرات لمنع الحركة' },
        { icon: 'fa-fan', title: 'تنظيف جهاز DVR/NVR', text: 'إزالة الغبار من فتحات التهوية وفحص مراوح التبريد' },
        { icon: 'fa-hdd', title: 'فحص الهاردسك', text: 'اختبار صحة الهاردسك للتنبه لأي بادئات تلف مبكراً' },
        { icon: 'fa-sync-alt', title: 'تحديث الفيرموير', text: 'تحديث برنامج الكاميرات وجهاز التسجيل لآخر إصدار لتحسين الأداء والأمان' },
        { icon: 'fa-mobile-alt', title: 'اختبار المشاهدة عن بُعد', text: 'التحقق من صحة ربط الهاتف والمشاهدة عن بُعد وإعادة الإعداد إذا لزم' },
      ]} />

      <MidPageCTA formId="camMaintenanceMidCta" />

      <h3><i class="fas fa-wrench" style="color:var(--secondary);margin-left:8px;"></i> إصلاح أعطال DVR وNVR</h3>
      <p>نتخصص في إصلاح جميع أعطال أجهزة التسجيل بما في ذلك:</p>
      <IconCardGrid columns={3} items={[
        { icon: 'fa-hdd', title: 'استبدال الهاردسك', text: 'تركيب هاردسك جديد مع استرجاع التسجيلات القديمة إذا كانت لا تزال موجودة' },
        { icon: 'fa-bolt', title: 'إصلاح مصدر الطاقة', text: 'إصلاح أو استبدال وحدة Power Supply المتضررة' },
        { icon: 'fa-tv', title: 'إصلاح بطاقات الفيديو', text: 'إصلاح بطاقات الاستقبال في حالة انقطاع قنوات' },
        { icon: 'fa-key', title: 'استرجاع كلمة المرور', text: 'إعادة ضبط كلمة المرور في حالة نسيانها بدون فقدان التسجيلات' },
        { icon: 'fa-redo', title: 'تحديث وإعادة تثبيت البرنامج', text: 'في حالة تعطل نظام التشغيل في الجهاز' },
      ]} />

      <h3><i class="fas fa-network-wired" style="color:var(--secondary);margin-left:8px;"></i> فحص واختبار الكابلات</h3>
      <IconCardGrid columns={3} items={[
        { icon: 'fa-plug', title: 'جهاز Cable Tester', text: 'نختبر كل كابل لاكتشاف الانقطاعات والأعطال الخفية' },
        { icon: 'fa-exchange-alt', title: 'استبدال الكابلات التالفة', text: 'تغيير الكابلات القديمة أو المتضررة بأخرى جديدة عالية الجودة' },
        { icon: 'fa-route', title: 'إعادة تمديد جزئي', text: 'في حالة التمديدات التالفة بسبب الرطوبة أو القوارض' },
      ]} />

      <h3><i class="fas fa-file-contract" style="color:var(--secondary);margin-left:8px;"></i> عقود الصيانة السنوية</h3>
      <p>توفر نيو جولدن أوفيس عقود صيانة سنوية توفر لك:</p>
      <IconCardGrid columns={3} items={[
        { icon: 'fa-calendar-check', text: 'زيارتان للصيانة الوقائية سنوياً (كل 6 أشهر)' },
        { icon: 'fa-clock', text: 'أولوية الاستجابة في حالات الطوارئ خلال 24 ساعة' },
        { icon: 'fa-tag', text: 'خصم 20% على قطع الغيار والإصلاحات' },
        { icon: 'fa-file-alt', text: 'تقرير صيانة مكتوب بعد كل زيارة' },
        { icon: 'fa-headset', text: 'دعم فني هاتفي مجاني طوال فترة العقد' },
      ]} />

      <h3><i class="fas fa-cloud-sun-rain" style="color:var(--secondary);margin-left:8px;"></i> الصيانة الموسمية حسب مناخ مصر</h3>
      <p>مناخ مصر المتقلب بين حرارة صيف شديدة وأمطار شتوية على الساحل الشمالي يفرض جدول صيانة يتكيف مع كل فصل بدلاً من روتين ثابت طوال العام:</p>
      <IconCardGrid columns={3} items={[
        { icon: 'fa-sun', title: 'فصل الصيف (يونيو-سبتمبر)', text: 'ارتفاع درجات الحرارة يزيد إجهاد المكونات الإلكترونية داخل الكاميرا خاصة في الأماكن المكشوفة، وتزيد العواصف الترابية من تراكم الغبار على العدسات بمعدل أسرع من باقي العام. نوصي بفحص تهوية جهاز DVR/NVR كل شهرين خلال هذا الفصل لتفادي ارتفاع حرارته الداخلية' },
        { icon: 'fa-cloud-rain', title: 'فصل الشتاء (نوفمبر-فبراير)', text: 'الرطوبة والأمطار، خاصة في الإسكندرية والساحل الشمالي، قد تتسبب في تسرب الماء إلى موصلات الكاميرات الخارجية غير المحكمة الإغلاق. نفحص أختام الكاميرات الخارجية (Gaskets) قبل بداية الموسم المطير مباشرةً كإجراء وقائي' },
        { icon: 'fa-bolt', title: 'فترات انقطاع الكهرباء المتكررة', text: 'أي انقطاع مفاجئ للكهرباء يُعرّض الهاردسك لخطر التلف، خصوصاً في المناطق ذات جودة كهرباء غير مستقرة — ننصح بتركيب UPS كجزء أساسي من خطة الصيانة الوقائية وليس كإضافة اختيارية فقط' },
      ]} />

      <h3><i class="fas fa-building" style="color:var(--secondary);margin-left:8px;"></i> أولويات الصيانة حسب نوع المنشأة</h3>
      <p>وتيرة الصيانة المثالية تختلف حسب طبيعة المكان ومدى اعتماده على استمرارية التغطية الأمنية:</p>
      <IconCardGrid columns={2} items={[
        { icon: 'fa-home', title: 'منازل وشقق سكنية', text: 'صيانة سنوية واحدة كافية غالباً، مع تركيز أكبر على تنظيف الكاميرا الخارجية عند المدخل لأنها الأكثر عرضة للعوامل الجوية طوال العام' },
        { icon: 'fa-store', title: 'محلات تجارية وصيدليات', text: 'نوصي بصيانة كل 6 أشهر مع أولوية لفحص كاميرات الصندوق والمدخل، لأن أي انقطاع فيها يعني فترة بلا تغطية أمنية في أكثر نقطة حساسة في المحل' },
        { icon: 'fa-industry', title: 'مصانع ومستودعات', text: 'تحتاج جدول صيانة أكثر تكراراً (كل 3-4 أشهر) بسبب التعرض المستمر للغبار الصناعي والاهتزازات، مع فحص دوري لكابلات الطاقة الممتدة لمسافات طويلة' },
        { icon: 'fa-landmark', title: 'مدارس ومستشفيات ومباني حكومية', text: 'نظراً لحساسية هذه المواقع وضرورة استمرار التغطية الأمنية بلا انقطاع، نوصي بعقد صيانة شامل مع زيارات ربع سنوية وأولوية استجابة طارئة خلال ساعات لا أيام' },
      ]} />

      <h3><i class="fas fa-coins" style="color:var(--secondary);margin-left:8px;"></i> ما الذي يؤثر على تكلفة صيانة كاميرات المراقبة؟</h3>
      <p>تختلف تكلفة كل زيارة صيانة حسب عدة عوامل موضوعية نراعيها عند تحديد السعر:</p>
      <IconCardGrid columns={3} items={[
        { icon: 'fa-video', title: 'عدد الكاميرات والأجهزة المطلوب فحصها', text: 'كلما زاد العدد زاد وقت الفحص والتنظيف المطلوب لإنجاز الزيارة بشكل كامل' },
        { icon: 'fa-wrench', title: 'نوع العطل ومدى تعقيده', text: 'فحص بسيط أو تنظيف عدسة يختلف تماماً في الوقت والجهد عن استبدال هاردسك أو إصلاح لوحة داخلية في جهاز DVR' },
        { icon: 'fa-boxes', title: 'توفر قطع الغيار الأصلية', text: 'القطع النادرة أو الموديلات القديمة المتوقف تصنيعها قد تحتاج وقتاً إضافياً للتوريد قبل الإصلاح' },
        { icon: 'fa-map-marker-alt', title: 'المسافة والموقع', text: 'المواقع خارج الإسكندرية والقاهرة الكبرى قد تتضمن تكلفة انتقال إضافية للفريق الفني' },
        { icon: 'fa-clock', title: 'طارئ أم مجدول مسبقاً', text: 'طلبات الصيانة الطارئة خارج ساعات العمل الرسمية تُحتسب بشكل مختلف عن الزيارات الدورية المجدولة' },
        { icon: 'fa-file-signature', title: 'عقد سنوي أم زيارة منفردة', text: 'الاشتراك في عقد صيانة سنوي يقلل التكلفة الإجمالية بشكل ملحوظ مقارنة بدفع كل زيارة بشكل منفصل' },
      ]} />
    </div>

    <aside class="service-sidebar">
      <div class="sidebar-card">
        <h4><i class="fas fa-list" style="color:var(--secondary);margin-left:8px;"></i> خدمات الكاميرات</h4>
        <div class="sidebar-services">
          <a href="/cameras/install" class="sidebar-service-link"><span>بيع وتركيب كاميرات</span><i class="fas fa-angle-left"></i></a>
          <a href="/cameras/dvr-nvr" class="sidebar-service-link"><span>أنظمة DVR و NVR</span><i class="fas fa-angle-left"></i></a>
          <a href="/cameras/ip-wifi" class="sidebar-service-link"><span>كاميرات IP وواي فاي</span><i class="fas fa-angle-left"></i></a>
          <a href="/cameras/maintenance" class="sidebar-service-link active"><span>صيانة المراقبة</span><i class="fas fa-angle-left"></i></a>
        </div>
      </div>
      <div class="sidebar-card">
        <h4><i class="fas fa-phone-alt" style="color:var(--secondary);margin-left:8px;"></i> تواصل معنا</h4>
        <div class="contact-info">
          <div class="contact-info-item"><i class="fas fa-phone-alt"></i><a href="tel:+201227392074">01227392074</a></div>
          <div class="contact-info-item"><i class="fab fa-whatsapp"></i><a href="https://wa.me/201227392074" target="_blank">واتساب مباشر</a></div>
          <div class="contact-info-item"><i class="fas fa-clock"></i><span>السبت - الخميس: 9ص — 6م</span></div>
        </div>
      </div>
      <div class="sidebar-card" style="background:var(--primary);color:var(--white);">
        <h4 style="color:var(--secondary);border-color:var(--secondary);">اطلب صيانة طارئة</h4>
        <p style="font-size:0.9rem;margin-bottom:16px;opacity:0.9;">كاميراتك معطلة؟ تواصل الآن واحصل على موعد سريع</p>
        <a href="https://wa.me/201227392074?text=أحتاج%20صيانة%20عاجلة%20لكاميرات%20المراقبة" target="_blank" class="btn btn-primary" style="width:100%;justify-content:center;"><i class="fab fa-whatsapp"></i> صيانة طارئة</a>
      </div>
      <div class="sidebar-card">
        <h4><i class="fas fa-shield-alt" style="color:var(--secondary);margin-left:8px;"></i> مميزات عقود الصيانة</h4>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px;">
          <li style="font-size:0.9rem;display:flex;gap:8px;align-items:flex-start;"><i class="fas fa-check" style="color:var(--secondary);margin-top:3px;flex-shrink:0;"></i><span>زيارتان وقائيتان سنوياً</span></li>
          <li style="font-size:0.9rem;display:flex;gap:8px;align-items:flex-start;"><i class="fas fa-check" style="color:var(--secondary);margin-top:3px;flex-shrink:0;"></i><span>أولوية الاستجابة في 24 ساعة</span></li>
          <li style="font-size:0.9rem;display:flex;gap:8px;align-items:flex-start;"><i class="fas fa-check" style="color:var(--secondary);margin-top:3px;flex-shrink:0;"></i><span>خصم 20% على قطع الغيار</span></li>
          <li style="font-size:0.9rem;display:flex;gap:8px;align-items:flex-start;"><i class="fas fa-check" style="color:var(--secondary);margin-top:3px;flex-shrink:0;"></i><span>دعم هاتفي مجاني طوال العقد</span></li>
        </ul>
      </div>
    </aside>
  </div></div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>كيف نتعامل مع طلبات الصيانة</h2>
      <div class="divider"></div>
    </div>
    <div class="steps-grid">
      <div class="step-card reveal"><div class="step-num">١</div><h4>التشخيص الأول</h4><p>عند تواصلك معنا، يسألك فنيّنا عن طبيعة المشكلة ويحاول تشخيصها هاتفياً وإرشادك لحل سريع إذا كانت بسيطة</p></div>
      <div class="step-card reveal delay-1"><div class="step-num">٢</div><h4>الزيارة الميدانية</h4><p>يزور فريقنا الفني موقعك في أسرع وقت ممكن، يفحص النظام كاملاً ويُقدّم تقرير مفصل عن الأعطال وتكلفة الإصلاح</p></div>
      <div class="step-card reveal delay-2"><div class="step-num">٣</div><h4>الإصلاح والضمان</h4><p>نُصلح العطل بقطع غيار أصلية، ونختبر النظام كاملاً قبل المغادرة ونقدم ضماناً على كل إصلاح يصل لـ 6 أشهر</p></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>أسئلة شائعة عن صيانة كاميرات المراقبة</h2>
      <div class="divider"></div>
    </div>
    <div class="faq-list">
      <div class="faq-item"><div class="faq-question">كم مرة تحتاج كاميرات المراقبة للصيانة؟ <i class="fas fa-plus"></i></div><div class="faq-answer"><div class="faq-answer-inner">توصي بصيانة وقائية كل 6 أشهر للأنظمة في البيئات التجارية والصناعية، وكل سنة للأنظمة المنزلية. الصيانة الدورية تُطيل عمر النظام وتمنع الأعطال المفاجئة التي قد تُعطّل المراقبة لأيام.</div></div></div>
      <div class="faq-item"><div class="faq-question">هل يمكن استرجاع التسجيلات من هاردسك تالف؟ <i class="fas fa-plus"></i></div><div class="faq-answer"><div class="faq-answer-inner">في بعض الحالات نعم. إذا كان التلف جزئياً في الهاردسك وليس في جميع القطاعات، يمكن استخدام برامج متخصصة لاسترجاع جزء من التسجيلات. كلما أسرعت بالتواصل معنا عند تعطل الهاردسك، كانت فرص الاسترجاع أعلى.</div></div></div>
      <div class="faq-item"><div class="faq-question">صورة الكاميرا أصبحت ضبابية — كيف أُصلحها؟ <i class="fas fa-plus"></i></div><div class="faq-answer"><div class="faq-answer-inner">الضبابية في معظم الأحيان بسبب تراكم الغبار على العدسة ويُحل بتنظيفها بقطعة قماش ناعمة ومحلول تنظيف مناسب. أحياناً تكون الضبابية بسبب تكثّف الرطوبة داخل الكاميرة (condensation) وهنا نحتاج فتحها وتجفيفها. في الحالتين يُحل المشكلة خلال زيارة صيانة واحدة.</div></div></div>
      <div class="faq-item"><div class="faq-question">هل تُصلحون كاميرات تم شراؤها من مكان آخر؟ <i class="fas fa-plus"></i></div><div class="faq-answer"><div class="faq-answer-inner">نعم، نُصلح جميع أنواع وماركات أنظمة المراقبة بغض النظر عن مكان الشراء. فريقنا الفني معتمد ومتدرّب على Hikvision وDahua وUNIView وHILook وEZVIZ وغيرها. نتعامل مع أعطال الكاميرات والأجهزة والكابلات بشكل احترافي.</div></div></div>
      <div class="faq-item"><div class="faq-question">ما تكلفة زيارة الصيانة؟ <i class="fas fa-plus"></i></div><div class="faq-answer"><div class="faq-answer-inner">تكلفة زيارة الصيانة تعتمد على موقعك وطبيعة العطل. تواصل معنا لتحديد السعر بناءً على موقعك. عملاء عقود الصيانة السنوية يستمتعون بأولوية في المواعيد وخصم على تكلفة الزيارات والقطع.</div></div></div>
      <div class="faq-item"><div class="faq-question">كم سعر صيانة كاميرات المراقبة في مصر؟ <i class="fas fa-plus"></i></div><div class="faq-answer"><div class="faq-answer-inner">تتفاوت أسعار صيانة كاميرات المراقبة في مصر حسب نوع العطل وقطع الغيار المطلوبة. نوفر أيضاً عقود صيانة سنوية بأسعار مخفضة للشركات والمحلات — تواصل معنا للاستفسار.</div></div></div>
      <div class="faq-item"><div class="faq-question">الكاميرا تعمل لكن التسجيل يتوقف بعد فترة قصيرة، ما السبب؟ <i class="fas fa-plus"></i></div><div class="faq-answer"><div class="faq-answer-inner">أشهر سبب هو امتلاء الهاردسك أو تلف قطاع منه، يليه ضعف في إعدادات الجدولة الزمنية للتسجيل، أو مشكلة في كابل الشبكة بين الكاميرا وجهاز التسجيل تسبب انقطاعاً متكرراً. فريقنا يفحص الإعدادات والهاردسك والكابلات معاً لتحديد السبب الدقيق بدل تخمينه، ويوثّق النتيجة في تقرير واضح لك.</div></div></div>
      <div class="faq-item"><div class="faq-question">هل يمكن ترقية نظام قديم بدل استبداله بالكامل؟ <i class="fas fa-plus"></i></div><div class="faq-answer"><div class="faq-answer-inner">في كثير من الحالات نعم؛ يمكن استبدال جهاز التسجيل القديم بآخر أحدث مع الإبقاء على الكابلات الموجودة، أو إضافة كاميرات جديدة متوافقة مع النظام الحالي. نقيّم النظام القائم أولاً لنحدد ما يستحق الاستبدال وما يمكن الاستمرار في استخدامه لتوفير التكلفة على العميل قدر الإمكان.</div></div></div>
      <div class="faq-item"><div class="faq-question">هل تقدمون عقود صيانة وقائية دورية للشركات؟ <i class="fas fa-plus"></i></div><div class="faq-answer"><div class="faq-answer-inner">نعم، عقودنا السنوية تشمل زيارات دورية مجدولة لتنظيف العدسات وفحص الكابلات والتأكد من سلامة التسجيل والتخزين، بالإضافة لأولوية استجابة عند حدوث أي عطل طارئ خارج الزيارات المجدولة، مع تقرير حالة مكتوب بعد كل زيارة لتوثيق حالة النظام.</div></div></div>
    </div>
  </div>
</section>

