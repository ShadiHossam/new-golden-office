---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';
import { getSeoFor } from '../../lib/siteSeo';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "كاميرات IP وواي فاي",
      "description": "بيع وتركيب كاميرات IP وواي فاي في مصر — راقب منزلك ومحلك من موبايلك في أي مكان مع نيو جولدن أوفيس الإسكندرية.",
      "serviceType": "كاميرات مراقبة لاسلكية",
      "provider": {
        "@type": "LocalBusiness",
        "name": "نيو جولدن أوفيس",
        "url": "https://newgoldenoffice.com",
        "telephone": "+201227392074",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "26 عبد المنعم سند",
          "addressLocality": "الإبراهيمية، باب شرق",
          "addressRegion": "الإسكندرية",
          "addressCountry": "EG"
        }
      },
      "areaServed": { "@type": "Country", "name": "Egypt" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "هل تعمل كاميرات واي فاي عند انقطاع الإنترنت؟",
          "acceptedAnswer": { "@type": "Answer", "text": "عند انقطاع الإنترنت، تستمر الكاميرات في التسجيل على الـ MicroSD المحلية أو على جهاز NVR الموجود في شبكتك المحلية. فقط خاصية المشاهدة عن بُعد تنقطع، أي يمكنك رؤية الصور من الشاشة المتصلة بالنظام مباشرةً." }
        },
        {
          "@type": "Question",
          "name": "كيف أعرف أن إشارة واي فاي كافية للكاميرة؟",
          "acceptedAnswer": { "@type": "Answer", "text": "نقوم بقياس قوة الإشارة في موقع الكاميرة قبل التثبيت. إذا كانت الإشارة ضعيفة، نوصي بتركيب Wireless Range Extender أو استخدام الكابل Cat6 بدلاً من Wi-Fi في تلك النقطة تحديداً. نضمن استقرار الاتصال 100%." }
        },
        {
          "@type": "Question",
          "name": "هل يمكن اختراق كاميرات واي فاي؟",
          "acceptedAnswer": { "@type": "Answer", "text": "الكاميرات الحديثة من Hikvision وDahua وEZVIZ تستخدم تشفير SSL/TLS قوي يحمي الصورة والبيانات. نحن نضبط كلمات مرور قوية ونفعّل التشفير عند التثبيت. باتباع الإرشادات الصحيحة، أمان الكاميرات الحديثة عالٍ جداً." }
        },
        {
          "@type": "Question",
          "name": "ما الفرق بين كاميرات PTZ وكاميرات واي فاي العادية؟",
          "acceptedAnswer": { "@type": "Answer", "text": "كاميرا PTZ هي نوع من كاميرات IP تتميز بالحركة الكاملة — تدور يمين ويسار وأعلى وأسفل وتكبّر. تستبدل عدة كاميرات ثابتة في الأماكن الكبيرة. الكاميرات العادية ثابتة الزاوية، أوفر وكافية في معظم التطبيقات المنزلية والتجارية." }
        },
        {
          "@type": "Question",
          "name": "ما سعر كاميرات IP وواي فاي في مصر؟",
          "acceptedAnswer": { "@type": "Answer", "text": "تتفاوت أسعار كاميرات الواي فاي وIP في مصر حسب الدقة والمواصفات. تواصل مع نيو جولدن أوفيس للحصول على عرض سعر مجاني يشمل الكاميرات والتركيب في القاهرة والإسكندرية وجميع أنحاء مصر." }
        },
        {
          "@type": "Question",
          "name": "الكاميرا تظهر \"غير متصلة\" في التطبيق، ما الحل؟",
          "acceptedAnswer": { "@type": "Answer", "text": "أولاً تأكد من اتصال الراوتر بالإنترنت وأن الكاميرا موصولة بالكهرباء. جرب إعادة تشغيل الراوتر والكاميرا معاً، فهذا يحل المشكلة في أغلب الحالات خلال دقائق. إذا استمرت المشكلة، فقد تكون كلمة مرور الواي فاي تغيرت وتحتاج الكاميرا لإعادة ربط بالشبكة من جديد." }
        },
        {
          "@type": "Question",
          "name": "هل يمكن مراقبة عدة فروع لشركتي من تطبيق واحد؟",
          "acceptedAnswer": { "@type": "Answer", "text": "نعم، يمكن ربط كاميرات IP من عدة مواقع مختلفة على نفس حساب التطبيق، فتشاهد جميع الفروع من شاشة واحدة بغض النظر عن موقعك. هذا الحل مثالي لأصحاب سلاسل المحلات والصيدليات والمطاعم متعددة الفروع." }
        },
        {
          "@type": "Question",
          "name": "هل توجد كاميرات تعمل بالطاقة الشمسية أو البطارية بدون كهرباء؟",
          "acceptedAnswer": { "@type": "Answer", "text": "نعم، نوفر كاميرات تعمل بالبطارية القابلة للشحن أو بالطاقة الشمسية، وهي مثالية للفيلات والشاليهات الساحلية والمواقع الإنشائية التي لا تتوفر فيها كهرباء دائمة أو التي تُستخدم موسمياً فقط." }
        },
        {
          "@type": "Question",
          "name": "كم مساحة تخزين أحتاجها لكاميرات IP في المنزل أو المحل؟",
          "acceptedAnswer": { "@type": "Answer", "text": "تعتمد المساحة على عدد الكاميرات ودقتها ومدة الاحتفاظ بالتسجيل. لمنزل بأربع كاميرات دقة عالية مع الاحتفاظ بأسبوعين من التسجيل، غالباً تكفي هارديسك 2 تيرابايت. للمحلات والمشاريع الأكبر نحسب المساحة الدقيقة حسب عدد الكاميرات ومدة الأرشفة المطلوبة." }
        },
        {
          "@type": "Question",
          "name": "هل يمكن ترقية نظام كاميرات واي فاي قائم بإضافة كاميرات جديدة لاحقاً؟",
          "acceptedAnswer": { "@type": "Answer", "text": "نعم، أنظمة IP وواي فاي مصممة بطبيعتها لتكون قابلة للتوسع. يمكنك البدء بعدد قليل من الكاميرات ثم إضافة المزيد لاحقاً على نفس الشبكة والتطبيق دون الحاجة لاستبدال النظام بالكامل، بشرط أن يدعم جهاز التسجيل عدداً كافياً من القنوات، ونحن نراعي هذا الهامش منذ التصميم الأول للنظام." }
        }
      ]
    }
  ]
});
---

<BaseLayout
  {...getSeoFor('/cameras/ip-wifi')}
  schemaJson={schemaJson}
  preloadImage="/images/cameras-hub.webp"
>
<PageHero
  title="كاميرات واي فاي وIP في مصر — راقب من موبايلك"
  subtitle="كاميرات ذكية لاسلكية وشبكية للمنازل والمكاتب والمحلات — تثبيت سهل، مشاهدة فورية من هاتفك، كشف ذكي للوجوه والحركة والصوت مع تنبيهات لحظية"
  heroImage="/images/cameras-hub.webp"
  heroIcon="fa-wifi"
  breadcrumbs={[
    { label: 'الرئيسية', href: '/' },
    { label: 'كاميرات المراقبة', href: '/cameras' },
    { label: 'كاميرات IP وواي فاي' }
  ]}
/>

<section class="service-detail">
  <div class="container"><div class="service-detail-grid">
    <div class="service-content">
      <h2>تقنية المستقبل في مراقبة المنازل والأعمال</h2>
      <p>كاميرات IP وواي فاي هي أحدث ما وصلت إليه تقنيات المراقبة الحديثة. بدلاً من التعقيد الذي تفرضه الكاميرات التقليدية من كابلات طويلة وإعدادات معقدة، أصبح بإمكانك تثبيت كاميرة في أي مكان تريده والبدء في المشاهدة من هاتفك خلال دقائق. نيو جولدن أوفيس تقدم حلول IP وواي فاي متكاملة للمنازل والمكاتب والمحلات التجارية في جميع أنحاء مصر.</p>

      <h3><i class="fas fa-balance-scale" style="color:var(--secondary);margin-left:8px;"></i> IP مقابل Analog: أيهما تختار؟</h3>
      <ul>
        <li><i class="fas fa-check-circle"></i><span><strong>كاميرات Analog التقليدية:</strong> تحتاج كابل Coaxial لكل كاميرة وجهاز DVR. الأرخص في الأنظمة الكبيرة ولكنها أقل مرونة في التثبيت</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>كاميرات IP (شبكية):</strong> تعمل عبر شبكة Cat6 أو Wi-Fi، دقة صورة أعلى بكثير، إعداد أسهل، قابلة للتوسع بلا حدود</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>النتيجة:</strong> للمشاريع الجديدة ننصح بـ IP لجودتها العالية ومرونتها؛ للأنظمة الموجودة Analog تبقى خياراً اقتصادياً ممتازاً</span></li>
      </ul>

      <h3><i class="fas fa-wifi" style="color:var(--secondary);margin-left:8px;"></i> مميزات كاميرات واي فاي</h3>
      <ul>
        <li><i class="fas fa-check-circle"></i><span><strong>تثبيت بدون كابلات:</strong> لا تحتاج سوى مقبس كهرباء وشبكة Wi-Fi موجودة مسبقاً في المكان</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>المرونة في الموضع:</strong> يمكن نقل الكاميرة وتغيير مكانها بسهولة دون أي أعمال توصيل</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>التثبيت السريع:</strong> يستغرق تثبيت كاميرة واي فاي 15 دقيقة فقط مقارنة بساعات للكاميرات التقليدية</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>المشاهدة الفورية:</strong> تبدأ في رؤية الصورة على هاتفك فوراً بعد إعداد الكاميرة</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>التحديثات التلقائية:</strong> الكاميرات تتلقى تحديثات برمجية تلقائية لتحسين الأداء وإضافة مميزات جديدة</span></li>
      </ul>

      <h3><i class="fas fa-arrows-alt" style="color:var(--secondary);margin-left:8px;"></i> كاميرات PTZ (الدوّارة)</h3>
      <p>كاميرات PTZ (Pan-Tilt-Zoom) تمنحك السيطرة الكاملة على المراقبة:</p>
      <ul>
        <li><i class="fas fa-check-circle"></i><span><strong>التحريك الأفقي (Pan):</strong> تدور 360 درجة لتغطية جميع الاتجاهات بكاميرة واحدة</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>التحريك الرأسي (Tilt):</strong> تتحرك لأعلى ولأسفل لمتابعة الأشخاص والأحداث</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>التكبير الضوئي (Zoom):</strong> تكبير ضوئي حتى 20x لرؤية التفاصيل الدقيقة من مسافة بعيدة</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>المتابعة التلقائية:</strong> تتبع الأشخاص المتحركين تلقائياً دون أي تدخل منك</span></li>
      </ul>

      <MidPageCTA formId="camIpWifiMidCta" />

      <h3><i class="fas fa-brain" style="color:var(--secondary);margin-left:8px;"></i> الكشف الذكي المتقدم</h3>
      <p>كاميرات IP الحديثة مزودة بذكاء اصطناعي يميزها تماماً عن الكاميرات التقليدية:</p>
      <ul>
        <li><i class="fas fa-check-circle"></i><span><strong>كشف الوجوه (Face Detection):</strong> تنبيهك عند ظهور وجه أمام الكاميرة مع إمكانية التعرف على الوجوه المسجلة</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>كشف الحركة الذكي:</strong> يميز بين حركة الإنسان والحيوانات والرياح لتقليل التنبيهات الزائفة</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>كشف الصوت (Sound Detection):</strong> تنبيهك عند ارتفاع الأصوات كالصراخ أو كسر الزجاج</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>كشف البكاء:</strong> متاح في كاميرات المنازل للرد الفوري على بكاء الأطفال</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>كشف اختراق المنطقة:</strong> رسم مناطق محظورة ويتلقى تنبيهاً فور دخول أحد إليها</span></li>
      </ul>

      <h3><i class="fas fa-microphone" style="color:var(--secondary);margin-left:8px;"></i> الصوت ثنائي الاتجاه (Two-Way Audio)</h3>
      <p>كاميرات IP الحديثة مزودة بمكبر صوت وميكروفون يتيح لك التحدث مع من يظهر أمام الكاميرة مباشرةً من هاتفك — مثالي للتعامل مع الزوار والعمال والمراقبة التفاعلية.</p>

      <h3><i class="fas fa-cloud" style="color:var(--secondary);margin-left:8px;"></i> خيارات التخزين</h3>
      <ul>
        <li><i class="fas fa-check-circle"></i><span><strong>التخزين السحابي:</strong> نسخ احتياطية في السحابة لضمان عدم فقدان التسجيلات حتى لو تعطّل الجهاز أو سُرق</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>MicroSD محلية:</strong> تخزين محلي في الكاميرة نفسها حتى 256GB بدون الحاجة لجهاز DVR</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>NAS Storage:</strong> تخزين شبكي محلي لاحترافيين يريدون أرشفة طويلة المدى</span></li>
      </ul>

      <h3><i class="fas fa-mobile-alt" style="color:var(--secondary);margin-left:8px;"></i> التحكم عبر التطبيق</h3>
      <p>جميع كاميرات IP وواي فاي لدينا تأتي بتطبيق مجاني يدعم Android وiPhone يتيح لك:</p>
      <ul>
        <li><i class="fas fa-check-circle"></i><span>مشاهدة البث المباشر بجودة عالية في أي وقت</span></li>
        <li><i class="fas fa-check-circle"></i><span>مراجعة التسجيلات السابقة وتصديرها</span></li>
        <li><i class="fas fa-check-circle"></i><span>التحكم في كاميرات PTZ من هاتفك</span></li>
        <li><i class="fas fa-check-circle"></i><span>استقبال تنبيهات فورية على الهاتف</span></li>
        <li><i class="fas fa-check-circle"></i><span>ضبط إعدادات الكاميرة والحركة والصوت</span></li>
      </ul>

      <h3><i class="fas fa-wifi" style="color:var(--secondary);margin-left:8px;"></i> حل مشكلات الاتصال الشائعة في كاميرات واي فاي</h3>
      <p>على عكس كاميرات النظام التقليدي، أغلب مشكلات كاميرات واي فاي وIP لا علاقة لها بعطل في الجهاز نفسه بل بإعدادات الشبكة، وإليك أشهرها وحلولها:</p>
      <ul>
        <li><i class="fas fa-check-circle"></i><span><strong>الكاميرا تظهر "غير متصلة" (Offline) في التطبيق:</strong> غالباً بسبب انقطاع مؤقت في الإنترنت أو تغيّر كلمة مرور الراوتر. إعادة تشغيل الراوتر والكاميرا معاً تحل المشكلة في أغلب الحالات خلال دقائق</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>بطء أو تقطّع البث المباشر:</strong> ناتج عادةً عن ضعف إشارة واي فاي أو ازدحام الشبكة بأجهزة كثيرة — نوصي بتخصيص شبكة واي فاي منفصلة (Guest Network) للكاميرات لتخفيف الحمل عن شبكة الاستخدام اليومي</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>إشعارات متأخرة أو لا تصل إطلاقاً:</strong> قد يكون السبب إعدادات توفير الطاقة في الهاتف التي توقف عمل التطبيق في الخلفية — نساعدك في ضبط إعدادات الهاتف بالشكل الصحيح لتصلك التنبيهات فوراً</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>نسيان كلمة مرور الكاميرا أو التطبيق:</strong> نوفر خدمة استرجاع آمنة عبر الرقم التسلسلي للجهاز أو إعادة الضبط من المصنع مع محاولة الحفاظ على الإعدادات الأساسية قدر الإمكان</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>تحديثات التطبيق تسبب مشاكل توافق مؤقتة:</strong> نتابع تحديثات الشركات المصنّعة عن كثب ونرشدك متى يكون التحديث آمناً ومتى يُفضّل الانتظار لإصدار أكثر استقراراً</span></li>
      </ul>

      <h3><i class="fas fa-user-friends" style="color:var(--secondary);margin-left:8px;"></i> سيناريوهات استخدام يومية لكاميرات IP وواي فاي</h3>
      <p>ما يميز هذه الفئة من الكاميرات أنها دخلت في تفاصيل حياة الناس اليومية بطرق لم تكن ممكنة مع الأنظمة التقليدية:</p>
      <ul>
        <li><i class="fas fa-check-circle"></i><span><strong>الآباء العاملون:</strong> مراقبة الأطفال والمربية من مكان العمل مباشرة عبر الهاتف، مع تنبيه فوري عند البكاء أو أي حركة غير معتادة في غرفة الطفل</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>الاطمئنان على كبار السن:</strong> كاميرات بصوت ثنائي الاتجاه تتيح لأفراد العائلة التواصل الفوري مع الوالدين المسنين والاطمئنان عليهم في أي وقت من اليوم</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>أصحاب الأعمال متعددة الفروع:</strong> ربط عدة فروع بكاميرات IP على حساب واحد في التطبيق لمراقبة جميع المواقع من شاشة واحدة دون الحاجة لزيارة كل فرع بشكل يومي</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>أصحاب العقارات الساحلية والمسافرون:</strong> كاميرات تعمل بالطاقة الشمسية أو البطارية لمراقبة الفيلات والشاليهات الساحلية التي تبقى خالية معظم أيام السنة دون كهرباء دائمة</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>الطلاب والمقيمون في شقق مستقلة:</strong> كاميرة واي فاي بسيطة عند الباب لمراقبة الزوار واستلام الطرود بأمان دون أي تمديدات أو تعديلات في الشقة المستأجرة</span></li>
      </ul>
    </div>

    <aside class="service-sidebar">
      <div class="sidebar-card">
        <h4><i class="fas fa-list" style="color:var(--secondary);margin-left:8px;"></i> خدمات الكاميرات</h4>
        <div class="sidebar-services">
          <a href="/cameras/install" class="sidebar-service-link"><span>بيع وتركيب كاميرات</span><i class="fas fa-angle-left"></i></a>
          <a href="/cameras/dvr-nvr" class="sidebar-service-link"><span>أنظمة DVR و NVR</span><i class="fas fa-angle-left"></i></a>
          <a href="/cameras/ip-wifi" class="sidebar-service-link active"><span>كاميرات IP وواي فاي</span><i class="fas fa-angle-left"></i></a>
          <a href="/cameras/maintenance" class="sidebar-service-link"><span>صيانة المراقبة</span><i class="fas fa-angle-left"></i></a>
        </div>
      </div>
