---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import PageHero from '../../components/PageHero.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';
import IconCardGrid from '../../components/IconCardGrid.astro';
import { getSeoFor } from '../../lib/siteSeo';
import ServiceSidebar from '../../components/ServiceSidebar.astro';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "كاميرات IP وواي فاي",
      "description": "شراء وتركيب كاميرات IP وواي فاي في مصر، راقب منزلك ومحلك من موبايلك في أي مكان مع نيو جولدن أوفيس الإسكندرية.",
      "serviceType": "كاميرات مراقبة لاسلكية",
      "provider": {
        "@type": "LocalBusiness",
        "name": "نيو جولدن أوفيس",
        "url": "https://newgoldenoffice.com",
        "telephone": "+201227392074",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "26 عبد المنعم سند",
          "addressLocality": "الإبراهيمية، باب شرق",
          "addressRegion": "الإسكندرية",
          "addressCountry": "EG"
        }
      },
      "areaServed": { "@type": "Country", "name": "Egypt" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "هل تعمل كاميرات واي فاي عند انقطاع الإنترنت؟",
          "acceptedAnswer": { "@type": "Answer", "text": "عند انقطاع الإنترنت، تستمر الكاميرات في التسجيل على الـ MicroSD المحلية أو على جهاز NVR الموجود في شبكتك المحلية. فقط خاصية المشاهدة عن بُعد تنقطع، أي يمكنك رؤية الصور من الشاشة المتصلة بالنظام مباشرةً." }
        },
        {
          "@type": "Question",
          "name": "كيف أعرف أن إشارة واي فاي كافية للكاميرة؟",
          "acceptedAnswer": { "@type": "Answer", "text": "نقوم بقياس قوة الإشارة في موقع الكاميرة قبل التثبيت. إذا كانت الإشارة ضعيفة، نوصي بتركيب Wireless Range Extender أو استخدام الكابل Cat6 بدلاً من Wi-Fi في تلك النقطة تحديداً. نضمن استقرار الاتصال 100%." }
        },
        {
          "@type": "Question",
          "name": "هل يمكن اختراق كاميرات واي فاي؟",
          "acceptedAnswer": { "@type": "Answer", "text": "الكاميرات الحديثة من Hikvision وDahua وEZVIZ تستخدم تشفير SSL/TLS قوي يحمي الصورة والبيانات. نحن نضبط كلمات مرور قوية ونفعّل التشفير عند التثبيت. باتباع الإرشادات الصحيحة، أمان الكاميرات الحديثة عالٍ جداً." }
        },
        {
          "@type": "Question",
          "name": "ما الفرق بين كاميرات PTZ وكاميرات واي فاي العادية؟",
          "acceptedAnswer": { "@type": "Answer", "text": "كاميرا PTZ هي نوع من كاميرات IP تتميز بالحركة الكاملة، تدور يمين ويسار وأعلى وأسفل وتكبّر. تستبدل عدة كاميرات ثابتة في الأماكن الكبيرة. الكاميرات العادية ثابتة الزاوية، أوفر وكافية في معظم التطبيقات المنزلية والتجارية." }
        },
        {
          "@type": "Question",
          "name": "ما سعر كاميرات IP وواي فاي في مصر؟",
          "acceptedAnswer": { "@type": "Answer", "text": "تبدأ أسعار كاميرات الواي فاي الداخلية من 1,100 جنيه، وكاميرات IP السلكية من 1,800 جنيه للكاميرا، والكاميرات الدوّارة PTZ من 5,000 جنيه. السعر النهائي يعتمد على الدقة والماركة وعدد الكاميرات وجهاز التسجيل. تواصل مع نيو جولدن أوفيس لمعاينة مجانية وعرض سعر شامل التركيب في جميع محافظات مصر." }
        },
        {
          "@type": "Question",
          "name": "الكاميرا تظهر \"غير متصلة\" في التطبيق، ما الحل؟",
          "acceptedAnswer": { "@type": "Answer", "text": "أولاً تأكد من اتصال الراوتر بالإنترنت وأن الكاميرا موصولة بالكهرباء. جرب إعادة تشغيل الراوتر والكاميرا معاً، فهذا يحل المشكلة في أغلب الحالات خلال دقائق. إذا استمرت المشكلة، فقد تكون كلمة مرور الواي فاي تغيرت وتحتاج الكاميرا لإعادة ربط بالشبكة من جديد." }
        },
        {
          "@type": "Question",
          "name": "هل يمكن مراقبة عدة فروع لشركتي من تطبيق واحد؟",
          "acceptedAnswer": { "@type": "Answer", "text": "نعم، يمكن ربط كاميرات IP من عدة مواقع مختلفة على نفس حساب التطبيق، فتشاهد جميع الفروع من شاشة واحدة بغض النظر عن موقعك. هذا الحل مثالي لأصحاب سلاسل المحلات والصيدليات والمطاعم متعددة الفروع." }
        },
        {
          "@type": "Question",
          "name": "هل توجد كاميرات تعمل بالطاقة الشمسية أو البطارية بدون كهرباء؟",
          "acceptedAnswer": { "@type": "Answer", "text": "نعم، نوفر كاميرات تعمل بالبطارية القابلة للشحن أو بالطاقة الشمسية، وهي مثالية للفيلات والشاليهات الساحلية والمواقع الإنشائية التي لا تتوفر فيها كهرباء دائمة أو التي تُستخدم موسمياً فقط." }
        },
        {
          "@type": "Question",
          "name": "كم مساحة تخزين أحتاجها لكاميرات IP في المنزل أو المحل؟",
          "acceptedAnswer": { "@type": "Answer", "text": "تعتمد المساحة على عدد الكاميرات ودقتها ومدة الاحتفاظ بالتسجيل. لمنزل بأربع كاميرات دقة عالية مع الاحتفاظ بأسبوعين من التسجيل، غالباً تكفي هارديسك 2 تيرابايت. للمحلات والمشاريع الأكبر نحسب المساحة الدقيقة حسب عدد الكاميرات ومدة الأرشفة المطلوبة." }
        },
        {
          "@type": "Question",
          "name": "هل يمكن ترقية نظام كاميرات واي فاي قائم بإضافة كاميرات جديدة لاحقاً؟",
          "acceptedAnswer": { "@type": "Answer", "text": "نعم، أنظمة IP وواي فاي مصممة بطبيعتها لتكون قابلة للتوسع. يمكنك البدء بعدد قليل من الكاميرات ثم إضافة المزيد لاحقاً على نفس الشبكة والتطبيق دون الحاجة لاستبدال النظام بالكامل، بشرط أن يدعم جهاز التسجيل عدداً كافياً من القنوات، ونحن نراعي هذا الهامش منذ التصميم الأول للنظام." }
        }
      ]
    }
  ]
});
---

<BaseLayout
  {...getSeoFor('/cameras/ip-wifi')}
  schemaJson={schemaJson}
>
<PageHero
  title="كاميرات واي فاي وIP في مصر: نختار لك الأنسب لبيتك وشغلك"
  subtitle="اختر الكاميرا المناسبة لمنزلك أو شركتك أو محلك واترك الباقي علينا: معاينة مجانية، ترشيح أفضل خيار يناسب ميزانيتك، أسعار تبدأ من 1,100 جنيه، وتركيب وتشغيل على موبايلك مع ضمان ودعم بعد البيع"
  heroImage="/images/hero-cameras-ip-wifi.webp"
  heroIcon="fa-wifi"
  breadcrumbs={[
    { label: 'الرئيسية', href: '/' },
    { label: 'كاميرات المراقبة', href: '/cameras' },
    { label: 'كاميرات IP وواي فاي' }
  ]}
/>

<section class="stats-section">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item reveal"><div class="stat-num" data-target="27" data-suffix="+">0+</div><div class="stat-label">سنة خبرة في السوق المصري</div></div>
      <div class="stat-item reveal delay-1"><div class="stat-num" data-target="5000" data-prefix="+">0</div><div class="stat-label">عميل راضٍ في جميع أنحاء مصر</div></div>
      <div class="stat-item reveal delay-3"><div class="stat-num" data-target="6">0</div><div class="stat-label">خدمات متكاملة تحت سقف واحد</div></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="service-detail-grid">
      <div class="service-content">
    <div class="section-header">
      <h2><i class="fas fa-handshake" style="color:var(--secondary);margin-left:8px;"></i> ماذا سنفعل لك بالضبط؟ نريحك من البداية للنهاية</h2>
      <div class="divider"></div>
    </div>
    <p class="landing-lead">لا تحتاج أن تكون خبيراً في الكاميرات ولا أن تقضي أياماً في مقارنة الموديلات والأسعار. أخبرنا بمكانك وما تريد مراقبته، وفريقنا يتولى كل شيء حتى تشاهد الصورة على موبايلك.</p>
    <div class="landing-body service-content">
<IconCardGrid columns={2} items={[
        { icon: 'fa-clipboard-check', title: 'معاينة مجانية للمكان', text: 'نعاين المكان أو نراجع صوره معك، ونحدد عدد الكاميرات وأماكنها الصحيحة لتغطية كل زاوية مهمة بدون كاميرات زائدة' },
        { icon: 'fa-search-dollar', title: 'أفضل خيار بأفضل سعر', text: 'نقارن لك بين الأنواع والماركات ونرشّح ما يناسب شركتك أو محلك أو منزلك وميزانيتك، فلا تدفع في مواصفات لا تحتاجها' },
        { icon: 'fa-file-invoice-dollar', title: 'عرض سعر واضح بدون مفاجآت', text: 'عرض سعر مكتوب يشمل الكاميرات وجهاز التسجيل والتخزين والتركيب قبل أن نبدأ، بدون أي تكاليف مخفية' },
        { icon: 'fa-tools', title: 'تركيب وضبط احترافي', text: 'فنيون متخصصون يركبون الكاميرات ويضبطون الزوايا والتسجيل والكشف الذكي والتنبيهات بالشكل الصحيح من أول يوم' },
        { icon: 'fa-mobile-alt', title: 'تشغيل على موبايلك', text: 'نربط النظام بالتطبيق على موبايلك وموبايل من تريد، ونشرح لك المشاهدة المباشرة ومراجعة التسجيلات خطوة بخطوة' },
        { icon: 'fa-headset', title: 'ضمان ودعم بعد البيع', text: 'ضمان على الأجهزة ومتابعة بعد التركيب، وأي مشكلة في الاتصال أو التطبيق نحلها معك بسرعة' },
      ]} />
      <div style="text-align:center;margin-top:24px;">
        <a href="https://wa.me/201227392074?text=أريد%20معاينة%20مجانية%20وعرض%20سعر%20كاميرات%20مراقبة" target="_blank" class="btn btn-primary btn-lg"><i class="fab fa-whatsapp"></i> اطلب معاينة مجانية وعرض سعر</a>
      </div>
    </div>
        </div>
      <ServiceSidebar category="cameras" current="/cameras/ip-wifi" />
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2><i class="fas fa-balance-scale" style="color:var(--secondary);margin-left:8px;"></i> الفرق بين كاميرا IP وكاميرا الواي فاي: أيهما تختار؟</h2>
      <div class="divider"></div>
    </div>
    <div class="landing-body service-content">
<p>أول سؤال يسأله أغلب عملائنا قبل الشراء. هذه مقارنة مباشرة تساعدك تختار، وإذا كنت محتاراً نرشّح لك الأنسب بعد المعاينة:</p>
      <div style="overflow-x:auto;margin-bottom:16px;">
        <table style="width:100%;font-size:0.95rem;border-collapse:collapse;">
          <thead><tr style="background:var(--primary);color:var(--white);"><th style="padding:12px 14px;text-align:right;">وجه المقارنة</th><th style="padding:12px 14px;text-align:right;">كاميرا IP (سلكية)</th><th style="padding:12px 14px;text-align:right;">كاميرا واي فاي (لاسلكية)</th></tr></thead>
          <tbody>
            <tr style="border-bottom:1px solid var(--border);"><td style="padding:12px 14px;font-weight:700;">طريقة الاتصال</td><td style="padding:12px 14px;">كابل شبكة Cat6 ينقل الصورة والكهرباء معاً (PoE)</td><td style="padding:12px 14px;">لاسلكياً عبر راوتر الواي فاي + فيشة كهرباء فقط</td></tr>
            <tr style="border-bottom:1px solid var(--border);background:var(--bg);"><td style="padding:12px 14px;font-weight:700;">ثبات الاتصال</td><td style="padding:12px 14px;">ثابت 24/7 ولا يتأثر بضعف الراوتر</td><td style="padding:12px 14px;">يعتمد على قوة إشارة الواي فاي في المكان</td></tr>
            <tr style="border-bottom:1px solid var(--border);"><td style="padding:12px 14px;font-weight:700;">جودة الصورة</td><td style="padding:12px 14px;">من 2 حتى 8 ميجا (4K)</td><td style="padding:12px 14px;">غالباً من 2 حتى 5 ميجا</td></tr>
            <tr style="border-bottom:1px solid var(--border);background:var(--bg);"><td style="padding:12px 14px;font-weight:700;">التركيب</td><td style="padding:12px 14px;">يحتاج تمديد كابلات</td><td style="padding:12px 14px;">سريع وبدون تكسير أو تمديدات</td></tr>
            <tr style="border-bottom:1px solid var(--border);"><td style="padding:12px 14px;font-weight:700;">التسجيل</td><td style="padding:12px 14px;"><a href="/cameras/dvr-nvr">جهاز NVR</a> وهارد ديسك</td><td style="padding:12px 14px;">كارت MicroSD أو سحابة أو جهاز NVR</td></tr>
            <tr style="border-bottom:1px solid var(--border);background:var(--bg);"><td style="padding:12px 14px;font-weight:700;">عدد الكاميرات المناسب</td><td style="padding:12px 14px;">من 4 إلى عشرات الكاميرات</td><td style="padding:12px 14px;">حتى 8 كاميرات تقريباً</td></tr>
            <tr style="border-bottom:1px solid var(--border);"><td style="padding:12px 14px;font-weight:700;">الأنسب لـ</td><td style="padding:12px 14px;">الشركات والمحلات والمخازن والمصانع</td><td style="padding:12px 14px;">الشقق والمكاتب الصغيرة والأماكن المؤجرة</td></tr>
            <tr style="background:var(--bg);"><td style="padding:12px 14px;font-weight:700;">السعر يبدأ من</td><td style="padding:12px 14px;font-weight:700;">1,800 جنيه للكاميرا</td><td style="padding:12px 14px;font-weight:700;">1,100 جنيه للكاميرا</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2><i class="fas fa-video" style="color:var(--secondary);margin-left:8px;"></i> أنواع كاميرات المراقبة</h2>
      <div class="divider"></div>
    </div>
    <div class="landing-body service-content">
<p>لكل مكان نوع كاميرا مناسب، واختيار النوع الصحيح يوفر عليك عدد الكاميرات والتكلفة:</p>
      <IconCardGrid columns={3} items={[
        { icon: 'fa-video', title: 'كاميرا Bullet (خارجية)', image: '/images/ip-wifi-outdoor-camera.webp', text: 'الشكل الأسطواني المعروف، مقاومة للمياه والأتربة، مثالية للأسوار والمداخل والجراجات وواجهات المحلات' },
        { icon: 'fa-circle', title: 'كاميرا Dome (سقف)', image: '/images/ip-wifi-dome-camera.webp', text: 'تُركب في السقف بشكل أنيق وغير لافت، مثالية للمكاتب والمحلات والممرات والاستقبال' },
        { icon: 'fa-home', title: 'كاميرا واي فاي داخلية (Cube)', image: '/images/ip-wifi-indoor-home-camera.webp', text: 'صغيرة وتوضع على رف أو حائط، بصوت ثنائي الاتجاه، مثالية للشقق وغرف الأطفال ومتابعة كبار السن' },
        { icon: 'fa-arrows-alt', title: 'كاميرا PTZ (دوّارة)', image: '/images/ip-wifi-ptz-camera.webp', text: 'تدور 360 درجة وتكبّر الصورة، كاميرا واحدة تغطي ساحة أو مخزن أو جراج كامل' },
        { icon: 'fa-solar-panel', title: 'كاميرا بطارية وطاقة شمسية', image: '/images/ip-wifi-solar-camera.webp', text: 'تعمل بدون كهرباء دائمة، مثالية للفيلات والشاليهات والمزارع والمواقع الإنشائية' },
        { icon: 'fa-sim-card', title: 'كاميرا 4G بشريحة', image: '/images/ip-wifi-4g-site-camera.webp', text: 'تعمل بشريحة موبايل بدلاً من الواي فاي، للمواقع التي لا يتوفر فيها إنترنت أرضي' },
      ]} />
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2><i class="fas fa-tags" style="color:var(--secondary);margin-left:8px;"></i> الأسعار والأنواع: أشهر الكاميرات وأسعارها في مصر</h2>
      <div class="divider"></div>
    </div>
    <div class="landing-body service-content">
<p>مقارنة سريعة بين أكثر أنواع الكاميرات طلباً في مصر والسعر الذي تبدأ منه كل فئة، لتعرف ميزانيتك قبل التواصل معنا:</p>
      <div style="overflow-x:auto;margin-bottom:16px;">
        <table style="width:100%;font-size:0.95rem;border-collapse:collapse;">
          <thead><tr style="background:var(--primary);color:var(--white);"><th style="padding:12px 14px;text-align:right;">نوع الكاميرا</th><th style="padding:12px 14px;text-align:right;">الأنسب لـ</th><th style="padding:12px 14px;text-align:right;">الدقة الشائعة</th><th style="padding:12px 14px;text-align:right;">السعر يبدأ من</th></tr></thead>
          <tbody>
            <tr style="border-bottom:1px solid var(--border);"><td style="padding:12px 14px;font-weight:700;">واي فاي داخلية</td><td style="padding:12px 14px;">الشقق وغرف الأطفال والمكاتب الصغيرة</td><td style="padding:12px 14px;">2 – 4 ميجا</td><td style="padding:12px 14px;font-weight:700;">1,100 جنيه</td></tr>
            <tr style="border-bottom:1px solid var(--border);background:var(--bg);"><td style="padding:12px 14px;font-weight:700;">واي فاي خارجية</td><td style="padding:12px 14px;">البلكونات والمداخل والحدائق</td><td style="padding:12px 14px;">2 – 4 ميجا</td><td style="padding:12px 14px;font-weight:700;">1,800 جنيه</td></tr>
            <tr style="border-bottom:1px solid var(--border);"><td style="padding:12px 14px;font-weight:700;">IP سلكية (Bullet / Dome)</td><td style="padding:12px 14px;">المحلات والشركات والمخازن</td><td style="padding:12px 14px;">2 – 4 ميجا</td><td style="padding:12px 14px;font-weight:700;">1,800 جنيه</td></tr>
            <tr style="border-bottom:1px solid var(--border);background:var(--bg);"><td style="padding:12px 14px;font-weight:700;">IP بدقة 4K</td><td style="padding:12px 14px;">الواجهات ومداخل السيارات وقراءة اللوحات</td><td style="padding:12px 14px;">8 ميجا</td><td style="padding:12px 14px;font-weight:700;">4,500 جنيه</td></tr>
            <tr style="border-bottom:1px solid var(--border);"><td style="padding:12px 14px;font-weight:700;">بطارية / طاقة شمسية</td><td style="padding:12px 14px;">الفيلات والشاليهات والمواقع بدون كهرباء</td><td style="padding:12px 14px;">2 – 4 ميجا</td><td style="padding:12px 14px;font-weight:700;">3,500 جنيه</td></tr>
            <tr style="background:var(--bg);"><td style="padding:12px 14px;font-weight:700;">PTZ دوّارة</td><td style="padding:12px 14px;">الساحات والمصانع والجراجات الكبيرة</td><td style="padding:12px 14px;">2 – 4 ميجا مع زووم</td><td style="padding:12px 14px;font-weight:700;">5,000 جنيه</td></tr>
          </tbody>
