---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';
import ContentIntro from '../../components/ContentIntro.astro';
import IconCardGrid from '../../components/IconCardGrid.astro';
import ComparisonGrid from '../../components/ComparisonGrid.astro';
import { getSeoFor } from '../../lib/siteSeo';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "بيع وتركيب كاميرات مراقبة",
      "description": "بيع وتركيب كاميرات مراقبة احترافية من Hikvision وDahua وUNIView وHILook وEZVIZ في جميع أنحاء مصر",
      "provider": {
        "@type": "LocalBusiness",
        "name": "نيو جولدن أوفيس",
        "url": "https://newgoldenoffice.com",
        "telephone": "+201227392074",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "26 عبد المنعم سند",
          "addressLocality": "الإبراهيمية، باب شرق",
          "addressRegion": "الإسكندرية",
          "addressCountry": "EG"
        }
      },
      "areaServed": { "@type": "Country", "name": "Egypt" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "ما أفضل ماركة كاميرات مراقبة للمنازل في مصر؟",
          "acceptedAnswer": { "@type": "Answer", "text": "للمنازل نوصي بـ HILook أو EZVIZ لأنهما يوفران جودة عالية بأسعار مناسبة، مع سهولة الاستخدام عبر التطبيق. أما للمحلات والمشاريع التجارية فننصح بـ Hikvision أو Dahua لأنهما الأكثر موثوقية وطول عمراً في البيئات التجارية الصعبة." }
        },
        {
          "@type": "Question",
          "name": "كم تكلفة تركيب كاميرا مراقبة واحدة في مصر؟",
          "acceptedAnswer": { "@type": "Answer", "text": "تتوقف التكلفة على نوع الكاميرا ودقتها والمسافة التي تحتاج لتمديد كابل فيها، وتُحدَّد بناءً على المعاينة الشاملة للمكان. تواصل معنا للحصول على عرض سعر مفصّل ومجاني." }
        },
        {
          "@type": "Question",
          "name": "هل يمكن تركيب كاميرات مراقبة في شقة سكنية؟",
          "acceptedAnswer": { "@type": "Answer", "text": "نعم بالتأكيد. للشقق السكنية نوصي بكاميرات Dome صغيرة داخلية للغرف والممرات وكاميرة خارجية عند المدخل الرئيسي. يمكن توصيل النظام بسهولة بشبكة الإنترنت المنزلية للمشاهدة من الهاتف في أي وقت ومن أي مكان." }
        },
        {
          "@type": "Question",
          "name": "هل الكاميرات تعمل في حالة انقطاع الكهرباء؟",
          "acceptedAnswer": { "@type": "Answer", "text": "الكاميرات العادية تحتاج إلى كهرباء مستمرة. لحل مشكلة انقطاع الكهرباء، يمكننا تزويد النظام بـ UPS (مولد احتياطي صغير) يضمن استمرار عمل النظام لساعات إضافية بعد انقطاع الكهرباء. بعض كاميرات واي فاي لديها بطارية داخلية أيضاً." }
        },
        {
          "@type": "Question",
          "name": "هل تقدمون الخدمة خارج الإسكندرية؟",
          "acceptedAnswer": { "@type": "Answer", "text": "نعم، نخدم جميع محافظات مصر. لدينا فرق فنية تعمل في القاهرة وضواحيها والجيزة وطنطا والمنصورة والمحافظات الأخرى. للمشاريع خارج الإسكندرية والقاهرة، يُرجى التواصل مسبقاً لتحديد موعد مناسب." }
        },
        {
          "@type": "Question",
          "name": "كم سعر تركيب كاميرات المراقبة في مصر؟",
          "acceptedAnswer": { "@type": "Answer", "text": "تتفاوت أسعار تركيب كاميرات المراقبة في مصر حسب العدد والجودة. تشمل الأسعار الكاميرات وجهاز التسجيل DVR/NVR والكابلات والتركيب الاحترافي. تواصل معنا للحصول على عرض سعر مجاني مخصص لاحتياجاتك." }
        },
        {
          "@type": "Question",
          "name": "هل تركيب الكاميرات يتلف حوائط المنزل أو المحل؟",
          "acceptedAnswer": { "@type": "Answer", "text": "ليس بالضرورة. نوفر خيارات تمديد سطحي أنيق لا يتطلب حفراً كبيراً، وللمستأجرين نوصي بكاميرات واي فاي لا تحتاج أي تمديدات كابلات على الإطلاق. في حال احتجنا للحفر لتمديد كابل مخفي داخل الحائط، نقوم بذلك بعناية فائقة ونعيد تشطيب المكان بأقل أثر ممكن." }
        },
        {
          "@type": "Question",
          "name": "ما أفضل ارتفاع وزاوية لتركيب الكاميرا؟",
          "acceptedAnswer": { "@type": "Answer", "text": "الارتفاع المثالي غالباً يتراوح بين 2.5 و3.5 متر — منخفض بما يكفي لالتقاط تفاصيل واضحة للوجوه، ومرتفع بما يكفي لمنع العبث بالكاميرا. الزاوية المثلى تكون مائلة قليلاً لأسفل لتغطية أكبر مساحة دون النظر مباشرة إلى مصدر ضوء قوي يسبب الوهج." }
        },
        {
          "@type": "Question",
          "name": "هل يمكن التركيب في شقة أو محل مستأجر دون التزامات دائمة؟",
          "acceptedAnswer": { "@type": "Answer", "text": "نعم، نوفر حلول تركيب غير دائمة تماماً مناسبة للمستأجرين، مثل كاميرات واي فاي بحوامل قابلة للفك والتركيب بدون حفر، وتمديدات سطحية يمكن إزالتها بسهولة عند انتهاء عقد الإيجار دون أي أثر يُذكر على الحوائط أو الأسقف." }
        },
        {
          "@type": "Question",
          "name": "كم يستغرق تركيب نظام كاميرات كامل لمحل أو مكتب؟",
          "acceptedAnswer": { "@type": "Answer", "text": "تركيب نظام من 4 إلى 8 كاميرات يستغرق عادة يوم عمل واحد، من تمديد الكابلات إلى تركيب جهاز التسجيل وضبط الإعدادات وربط النظام بتطبيق المشاهدة عن بُعد. الأنظمة الأكبر في المصانع أو المباني متعددة الطوابق قد تحتاج يومين إلى ثلاثة أيام حسب تعقيد التمديدات." }
        }
      ]
    }
  ]
});
---

<BaseLayout
  {...getSeoFor('/cameras/install')}
  schemaJson={schemaJson}
  preloadImage="/images/cameras-hub.webp"
>
<PageHero
  title="طلب تركيب كاميرات مراقبة في مصر، معاينة مجانية"
  subtitle="احجز معاينة مجانية وتركيب احترافي بواسطة فنيين معتمدين لأحدث كاميرات المراقبة من أفضل الماركات العالمية، مع ضمان شامل وخدمة ما بعد البيع في جميع أنحاء مصر"
  heroImage="/images/cameras-hub.webp"
  heroIcon="fa-video"
  breadcrumbs={[
    { label: 'الرئيسية', href: '/' },
    { label: 'كاميرات المراقبة', href: '/cameras' },
    { label: 'بيع وتركيب كاميرات' }
  ]}
/>

<section class="service-detail">
  <div class="container"><div class="service-detail-grid">
    <div class="service-content">
      <ContentIntro
        heading="طلب تركيب كاميرات القاهرة والإسكندرية — احترافية وجودة لا تُقارَن"
        text="تُقدّم شركة نيو جولدن أوفيس، التي تأسست عام 1999 في الإسكندرية، خدمة متكاملة لبيع وتركيب كاميرات المراقبة في جميع أنحاء مصر. نوفر حلول مراقبة مناسبة للمنازل والشقق السكنية والمحلات التجارية والسوبرماركت والمصانع والشركات والمجمعات السكنية. فريقنا الفني المتخصص يصمم لك النظام المثالي بعد معاينة مجانية للمكان."
      />

      <h3><i class="fas fa-video" style="color:var(--secondary);margin-left:8px;"></i> الماركات المتاحة لدينا</h3>
      <ComparisonGrid items={[
        { title: 'Hikvision', text: 'الرائد العالمي الأول في صناعة كاميرات المراقبة، جودة لا مثيل لها بتقنيات متطورة' },
        { title: 'Dahua', text: 'أنظمة مراقبة ذكية بتقنية الذكاء الاصطناعي ودقة تصل إلى 8 ميجابكسل' },
        { title: 'UNIView (UNV)', text: 'حلول احترافية مناسبة للمشاريع الكبيرة والمؤسسات' },
        { title: 'HILook', text: 'الخيار الأمثل للجودة العالية بأسعار مناسبة للمشاريع المتوسطة' },
        { title: 'EZVIZ', text: 'كاميرات ذكية سهلة الاستخدام مثالية للمنازل والمكاتب الصغيرة' },
      ]} />

      <h3><i class="fas fa-camera" style="color:var(--secondary);margin-left:8px;"></i> أنواع الكاميرات المتوفرة</h3>
      <p>نوفر تشكيلة شاملة من الكاميرات تناسب كل احتياج وبيئة:</p>
      <IconCardGrid columns={3} items={[
        { icon: 'fa-home', title: 'كاميرات داخلية (Indoor)', text: 'صغيرة الحجم، مخفية أو ظاهرة، مناسبة للمحلات والمكاتب والمنازل' },
        { icon: 'fa-cloud-sun-rain', title: 'كاميرات خارجية (Outdoor)', text: 'مقاومة للماء والغبار بتصنيف IP66/67، تتحمل قسوة الطقس المصري' },
        { icon: 'fa-circle', title: 'كاميرات Dome', text: 'شكل نصف كروي أنيق، مناسبة للأسقف، زاوية رؤية 130 درجة' },
        { icon: 'fa-video', title: 'كاميرات Bullet', text: 'اسطوانية الشكل، مدى رؤية أطول، مثالية للمداخل والطرقات' },
        { icon: 'fa-arrows-alt', title: 'كاميرات PTZ', text: 'متحركة يُمكن التحكم بها عن بُعد، مناسبة للمواقف والأماكن الواسعة' },
      ]} />

      <h3><i class="fas fa-eye" style="color:var(--secondary);margin-left:8px;"></i> دقة الصورة المتاحة</h3>
      <ComparisonGrid items={[
        { title: '2MP (1080p Full HD)', text: 'مناسبة للاستخدام العام في المحلات والمنازل بسعر اقتصادي' },
        { title: '4MP (2K)', text: 'دقة أعلى للتعرف على التفاصيل والوجوه بوضوح أكبر' },
        { title: '8MP (4K Ultra HD)', text: 'أعلى دقة متاحة للمشاريع التي تتطلب تفاصيل دقيقة جداً' },
      ]} />

      <MidPageCTA formId="camInstallMidCta" />

      <h3><i class="fas fa-moon" style="color:var(--secondary);margin-left:8px;"></i> تقنيات الرؤية الليلية</h3>
      <ComparisonGrid items={[
        { title: 'الأشعة تحت الحمراء (IR)', text: 'رؤية ليلية كلاسيكية بمدى يصل إلى 60 متر' },
        { title: 'Full Color Night', text: 'رؤية ملونة في الظلام الدامس بدون حاجة لإضاءة إضافية' },
        { title: 'Smart Light', text: 'إضاءة تلقائية عند الكشف عن حركة مشبوهة' },
      ]} />

      <h3><i class="fas fa-tools" style="color:var(--secondary);margin-left:8px;"></i> عملية التركيب الاحترافية</h3>
      <IconCardGrid columns={3} items={[
        { icon: 'fa-clipboard-check', title: 'المعاينة المجانية', text: 'زيارة المكان وتحديد أفضل نقاط تركيب الكاميرات ومسارات الكابلات' },
        { icon: 'fa-network-wired', title: 'تمديد الكابلات', text: 'نستخدم كابلات Coaxial عالية الجودة أو Cat6 لأنظمة IP مع حماية PVC للتمديدات' },
        { icon: 'fa-thumbtack', title: 'التثبيت الدقيق', text: 'ثبات تام للكاميرات بزوايا محسوبة لتغطية أقصى مساحة ممكنة' },
        { icon: 'fa-sliders-h', title: 'الضبط والإعداد', text: 'ضبط جهاز التسجيل DVR/NVR وربطه بالإنترنت للمشاهدة عن بُعد' },
        { icon: 'fa-graduation-cap', title: 'التدريب الكامل', text: 'شرح تفصيلي لكيفية استخدام النظام ومشاهدة الكاميرات من الهاتف' },
      ]} />

      <h3><i class="fas fa-network-wired" style="color:var(--secondary);margin-left:8px;"></i> أنواع الكابلات المستخدمة</h3>
      <ComparisonGrid items={[
        { title: 'كابل Coaxial RG59', text: 'للكاميرات التقليدية Analog وHD-TVI، ثابت وموثوق' },
        { title: 'كابل Cat5e/Cat6', text: 'لكاميرات IP، يدعم بروتوكول PoE لتوصيل الطاقة والبيانات بكابل واحد' },
        { title: 'حماية PVC وقنوات السيلكون', text: 'تمديدات نظيفة ومحمية تدوم لسنوات طويلة' },
      ]} />

      <h3><i class="fas fa-route" style="color:var(--secondary);margin-left:8px;"></i> تحديات تمديد الكابلات وكيف نتغلب عليها</h3>
      <p>كل مبنى له طبيعة إنشائية مختلفة تفرض تحديات خاصة أثناء التركيب، وهذا الجزء غالباً ما يُهمَل عند التخطيط الذاتي دون خبرة فنية:</p>
      <IconCardGrid columns={2} items={[
        { icon: 'fa-ruler', title: 'حدود المسافة لكل نوع كابل', text: 'كابل Coaxial RG59 يعمل بكفاءة حتى 200 متر تقريباً، بينما Cat6 العادي محدود بـ100 متر قبل أن تضعف الإشارة — نستخدم مقويات إشارة (Repeaters) أو محولات الألياف الضوئية عند الحاجة لمسافات أطول في المصانع والمستودعات الكبيرة' },
        { icon: 'fa-building', title: 'المباني ذات الجدران الخرسانية السميكة', text: 'نلجأ للتمديد الخارجي المحمي عبر قنوات بلاستيكية مثبتة بعناية بدل الحفر العشوائي الذي يضعف البنية الإنشائية' },
        { icon: 'fa-route', title: 'العبور بين الطوابق أو بين مبانٍ منفصلة', text: 'نخطط مسار الكابل مسبقاً عبر فتحات الخدمات الموجودة أصلاً في المبنى لتفادي أي تمديدات ظاهرة أو غير آمنة' },
        { icon: 'fa-bolt', title: 'التداخل الكهرومغناطيسي', text: 'في المصانع القريبة من ماكينات كهربائية ثقيلة، نستخدم كابلات مُدرَّعة (Shielded) لمنع تشويش الصورة الناتج عن الحقول الكهرومغناطيسية' },
      ]} />

      <h3><i class="fas fa-map-marked-alt" style="color:var(--secondary);margin-left:8px;"></i> سيناريوهات التركيب حسب نوع المكان</h3>
      <p>خطة التركيب ونقاط الكاميرات تختلف جذرياً حسب طبيعة المبنى، وإليك كيف نتعامل مع كل حالة:</p>
      <IconCardGrid columns={3} items={[
        { icon: 'fa-home', title: 'فيلات ومنازل مستقلة', text: 'نغطي المداخل الرئيسية والخلفية والحديقة والسور الخارجي، مع مراعاة اتجاه الشمس لتجنب الوهج (Glare) في ساعات معينة من اليوم، والتركيب عادة يستغرق يوماً واحداً' },
        { icon: 'fa-building', title: 'شقق سكنية ومباني إيجار', text: 'نستخدم تمديدات سطحية أنيقة أو كاميرات واي فاي لا تتطلب حفراً أو تعديلات دائمة في الجدران، وهو الخيار الأمثل للمستأجرين الذين لا يريدون إتلاف الحائط' },
        { icon: 'fa-store', title: 'محلات تجارية داخل مولات أو أسواق', text: 'نأخذ إذناً من إدارة المبنى قبل أي تمديد ظاهر، ونعتمد غالباً على مسارات الأسقف المعلقة (False Ceiling) لإخفاء الكابلات بالكامل' },
        { icon: 'fa-industry', title: 'مصانع ومستودعات', text: 'التركيب هنا يتطلب سلالم ورافعات للوصول لارتفاعات عالية، وكابلات مقاومة للحرارة والأتربة، وقد يمتد العمل ليومين أو ثلاثة حسب حجم المنشأة' },
        { icon: 'fa-hard-hat', title: 'مواقع إنشائية تحت التشييد', text: 'نوفر حلولاً مؤقتة تعمل بالبطارية والطاقة الشمسية لمراقبة المعدات والمواد قبل اكتمال التوصيلات الكهربائية الدائمة' },
      ]} />

      <h3><i class="fas fa-times-circle" style="color:var(--secondary);margin-left:8px;"></i> أخطاء شائعة في تركيب الكاميرات يجب تجنبها</h3>
      <p>نصادف كثيراً عملاء حاولوا التركيب بأنفسهم أو استعانوا بفني غير متخصص ووقعوا في هذه الأخطاء المتكررة:</p>
      <IconCardGrid columns={3} items={[
        { icon: 'fa-sun', title: 'تركيب الكاميرا في مواجهة الشمس مباشرة', text: 'يسبب وهجاً شديداً يجعل الصورة غير واضحة في أوقات معينة من اليوم — الحل هو اختيار زاوية مائلة أو استخدام كاميرات بتقنية WDR لموازنة الإضاءة' },
        { icon: 'fa-arrows-alt-v', title: 'الارتفاع الخاطئ', text: 'التركيب المنخفض جداً يُعرّض الكاميرا للتلاعب أو السرقة، والمرتفع جداً يُصعّب التعرف على الوجوه — الارتفاع المثالي عادة بين 2.5 و3.5 متر حسب زاوية العدسة' },
        { icon: 'fa-low-vision', title: 'إهمال المناطق العمياء (Blind Spots)', text: 'تركيب عدد قليل من الكاميرات بدون تخطيط يترك زوايا كاملة غير مغطاة — لهذا تُعد المعاينة الميدانية المجانية خطوة أساسية لا نتجاوزها أبداً' },
        { icon: 'fa-plug', title: 'كابلات وموصلات رخيصة غير محمية', text: 'تتلف بسرعة مع الرطوبة والحرارة في الصيف المصري، ونستخدم دائماً موصلات مقاومة للماء ومحمية بغلاف مطاطي' },
        { icon: 'fa-wifi', title: 'عدم اختبار زاوية Wi-Fi قبل التثبيت النهائي', text: 'في كاميرات واي فاي، التركيب في نقطة ضعيفة الإشارة يسبب انقطاعاً متكرراً — نقيس قوة الإشارة دائماً قبل التثبيت النهائي بالمسامير' },
      ]} />

      <div class="cta-banner" style="margin-top:40px;border-radius:12px;">
        <h2>احصل على معاينة مجانية لمكانك</h2>
        <p>فريقنا الفني يزورك مجاناً لتقييم احتياجاتك وتقديم عرض سعر مفصّل بدون أي التزام. وبعد التركيب، لا تنسَ طلب <a href="/cameras/maintenance">عقد صيانة دوري لكاميراتك</a> للحفاظ على أداء النظام لسنوات.</p>
        <a href="https://wa.me/201227392074?text=أريد%20معاينة%20مجانية%20لتركيب%20كاميرات%20مراقبة" target="_blank" class="btn btn-lg" style="background:var(--white);color:var(--secondary-dark);font-weight:700;"><i class="fab fa-whatsapp" style="color:#25D366;"></i> احجز معاينة مجانية</a>
