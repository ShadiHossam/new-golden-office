---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import PageHero from '../../components/PageHero.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';
import ContentIntro from '../../components/ContentIntro.astro';
import IconCardGrid from '../../components/IconCardGrid.astro';
import ComparisonGrid from '../../components/ComparisonGrid.astro';
import { getSeoFor } from '../../lib/siteSeo';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "أنظمة DVR و NVR للتسجيل",
      "description": "بيع وتركيب أجهزة DVR وNVR بقنوات متعددة وتخزين عالي السعة في جميع أنحاء مصر",
      "provider": {
        "@type": "LocalBusiness",
        "name": "نيو جولدن أوفيس",
        "url": "https://newgoldenoffice.com",
        "telephone": "+201227392074",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "26 عبد المنعم سند",
          "addressLocality": "الإبراهيمية، باب شرق",
          "addressRegion": "الإسكندرية",
          "addressCountry": "EG"
        }
      },
      "areaServed": { "@type": "Country", "name": "Egypt" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "هل يمكن استخدام الهاردسك العادي في جهاز DVR؟",
          "acceptedAnswer": { "@type": "Answer", "text": "لا يُنصح بذلك. الهاردسكات العادية مصممة للكمبيوتر وليست للتسجيل المستمر 24/7. نستخدم هاردسكات WD Purple أو Seagate SkyHawk المصممة خصيصاً للمراقبة وتتحمل التشغيل المستمر لسنوات طويلة بدون أعطال." }
        },
        {
          "@type": "Question",
          "name": "ماذا يحدث للتسجيلات عند امتلاء الهاردسك؟",
          "acceptedAnswer": { "@type": "Answer", "text": "عند امتلاء الهاردسك، يقوم الجهاز تلقائياً بحذف أقدم التسجيلات والكتابة فوقها — وهو ما يُسمى \"الكتابة الدورية\". هذا يضمن استمرار التسجيل بلا انقطاع. يمكنك أيضاً ضبط الجهاز لإيقاف التسجيل عند الامتلاء إذا كنت تريد الاحتفاظ بالتسجيلات." }
        },
        {
          "@type": "Question",
          "name": "كيف أشاهد الكاميرات من هاتفي؟",
          "acceptedAnswer": { "@type": "Answer", "text": "بعد التثبيت، نقوم بربط الجهاز بشبكة الإنترنت في موقعك. ثم نثبت التطبيق المخصص على هاتفك (Hik-Connect لـ Hikvision أو DMSS لـ Dahua) وندرّبك على استخدامه. بعدها يمكنك مشاهدة الكاميرات من أي مكان في العالم طالما هاتفك متصل بالإنترنت." }
        },
        {
          "@type": "Question",
          "name": "هل يمكن توسيع جهاز DVR الموجود بإضافة كاميرات جديدة؟",
          "acceptedAnswer": { "@type": "Answer", "text": "نعم، إذا كان لديك قنوات شاغرة في الجهاز يمكن إضافة كاميرات جديدة بسهولة. إذا لم يكن هناك قنوات شاغرة، يمكن استبدال الجهاز بآخر بعدد قنوات أكبر مع الإبقاء على نفس الكاميرات والكابلات في معظم الحالات." }
        },
        {
          "@type": "Question",
          "name": "ما ضمان جهاز DVR/NVR؟",
          "acceptedAnswer": { "@type": "Answer", "text": "جميع أجهزة DVR وNVR التي نبيعها تأتي بضمان سنة من المصنع وضماننا الإضافي يصل إلى 3 سنوات. في حالة أي عطل خلال فترة الضمان، نقوم بالإصلاح أو الاستبدال بشكل مجاني في أسرع وقت ممكن." }
        },
        {
          "@type": "Question",
          "name": "كم سعر جهاز DVR أو NVR في مصر؟",
          "acceptedAnswer": { "@type": "Answer", "text": "تتفاوت أسعار أجهزة DVR وNVR في مصر حسب عدد القنوات وجودة التسجيل. تواصل مع نيو جولدن أوفيس للحصول على أفضل سعر مع ضمان وتركيب." }
        },
        {
          "@type": "Question",
          "name": "كيف أحسب سعة التخزين المناسبة لعدد الكاميرات لدي؟",
          "acceptedAnswer": { "@type": "Answer", "text": "تعتمد السعة على دقة الكاميرات وعددها وأسلوب التسجيل. كقاعدة تقريبية، كاميرة 2MP بضغط H.265+ تستهلك 4-6GB يومياً عند التسجيل المستمر. اضرب هذا الرقم في عدد الكاميرات وعدد أيام الأرشفة المطلوبة لتحصل على تقدير تقريبي، ثم أضف هامش أمان 20%. فريقنا يقوم بهذا الحساب بدقة عند المعاينة." }
        },
        {
          "@type": "Question",
          "name": "ما هو نظام RAID ومتى أحتاجه؟",
          "acceptedAnswer": { "@type": "Answer", "text": "RAID تقنية تخزين تحفظ نسخة مطابقة من التسجيلات على أكثر من هاردسك في آن واحد، فإذا تعطل أحد الهاردسكات لا تفقد أي بيانات. ننصح به للمشاريع الحساسة كالبنوك ومحال الذهب والمصانع الكبرى، بينما يكفي هاردسك واحد عالي الجودة للمنازل والمحلات الصغيرة." }
        },
        {
          "@type": "Question",
          "name": "هل يحتاج جهاز NVR مفتاح شبكة خاص (PoE Switch)؟",
          "acceptedAnswer": { "@type": "Answer", "text": "نعم إذا كنت تستخدم كاميرات IP تعمل بتقنية PoE، فأنت تحتاج مفتاح شبكة يدعم PoE لتوصيل الطاقة والبيانات لكل كاميرا عبر كابل واحد. نساعدك في اختيار المفتاح المناسب حسب عدد الكاميرات المطلوب توصيلها." }
        },
        {
          "@type": "Question",
          "name": "هل تحديث الفيرموير لجهاز DVR/NVR آمن ولا يؤثر على التسجيلات القديمة؟",
          "acceptedAnswer": { "@type": "Answer", "text": "نعم، تحديث الفيرموير من الشركة المصنعة لا يمسح التسجيلات المخزنة على الهاردسك، لكن ننصح دوماً بعمل نسخة احتياطية للإعدادات المهمة قبل أي تحديث احترازياً. نقوم بهذه التحديثات ضمن خدمة الصيانة الدورية لضمان أمان النظام وأحدث الميزات." }
        }
      ]
    }
  ]
});
---

<BaseLayout
  {...getSeoFor('/cameras/dvr-nvr')}
  schemaJson={schemaJson}
  preloadImage="/images/cameras-hub.webp"
>
<PageHero
  title="أنظمة DVR و NVR للتسجيل في مصر"
  subtitle="أجهزة تسجيل عالية الجودة بقنوات 4 و8 و16 و32 — تخزين ضخم حتى 8TB، مشاهدة من هاتفك في أي مكان وزمان، مع كشف الحركة وتنبيهات فورية"
  heroImage="/images/cameras-hub.webp"
  heroIcon="fa-hdd"
  breadcrumbs={[
    { label: 'الرئيسية', href: '/' },
    { label: 'كاميرات المراقبة', href: '/cameras' },
    { label: 'أنظمة DVR و NVR' }
  ]}
/>

<section class="service-detail">
  <div class="container"><div class="service-detail-grid">
    <div class="service-content">
      <ContentIntro
        heading="جهاز تسجيل كاميرات مصر: القلب النابض لنظام المراقبة"
        text="جهاز التسجيل هو العقل المدبر لأي نظام مراقبة — فهو يستقبل الصور من جميع الكاميرات ويخزّنها ويتيح لك مراجعتها في أي وقت. في نيو جولدن أوفيس، نوفر أفضل أجهزة DVR وNVR من Hikvision وDahua بجميع السعات والمواصفات لتناسب كل نوع من المشاريع سواء كانت منازل أو محلات أو مصانع أو فنادق."
      />

      <h3><i class="fas fa-balance-scale" style="color:var(--secondary);margin-left:8px;"></i> الفرق بين DVR و NVR</h3>
      <p>كثيراً ما يتساءل العملاء عن الفرق بين الجهازين، وإليك شرحاً مبسطاً:</p>
      <ComparisonGrid items={[
        { title: 'DVR (Digital Video Recorder)', text: 'يعمل مع الكاميرات التقليدية Analog وHD-TVI عبر كابل Coaxial. الأرخص ثمناً والأوفر للمشاريع الموجودة سابقاً. يدعم دقة حتى 4K مع الكاميرات الحديثة.' },
        { title: 'NVR (Network Video Recorder)', text: 'يعمل مع كاميرات IP عبر كابل Cat5e/Cat6 أو Wi-Fi. أعلى جودة صورة، يدعم PoE لتوصيل طاقة الكاميرا عبر الكابل نفسه، مثالي للمشاريع الجديدة.' },
      ]} />

      <h3><i class="fas fa-th-large" style="color:var(--secondary);margin-left:8px;"></i> أعداد القنوات المتاحة</h3>
      <ComparisonGrid items={[
        { title: '4 قنوات', text: 'مثالي للمنازل والمحلات الصغيرة، يكفي لتغطية مدخل رئيسي وغرف أو أركان قليلة' },
        { title: '8 قنوات', text: 'الأنسب للمحلات والمكاتب المتوسطة، يتيح تغطية شاملة لجميع أرجاء المكان' },
        { title: '16 قنوات', text: 'للمحلات الكبيرة والشركات والفنادق الصغيرة ومجمعات التسوق' },
        { title: '32 قنوات فأكثر', text: 'للمصانع والمستشفيات والمجمعات السكنية والمشاريع الضخمة' },
      ]} />

      <h3><i class="fas fa-hdd" style="color:var(--secondary);margin-left:8px;"></i> سعة التخزين (الهاردسك)</h3>
      <p>نوفر هاردسكات WD Purple وSeagate SkyHawk المصممة خصيصاً للتسجيل المستمر في أنظمة المراقبة:</p>
      <ComparisonGrid items={[
        { title: '1 TB', text: 'يخزّن 7 إلى 15 يوم تسجيل لنظام 4 كاميرات 2MP' },
        { title: '2 TB', text: 'يخزّن 20 إلى 30 يوم تسجيل لنفس النظام' },
        { title: '4 TB', text: 'يخزّن حتى 60 يوم لنظام 8 كاميرات — الأنسب للمحلات التجارية' },
        { title: '8 TB', text: 'للمشاريع الكبيرة التي تتطلب أرشفة طويلة المدى' },
      ]} />

      <MidPageCTA formId="camDvrNvrMidCta" />

      <h3><i class="fas fa-mobile-alt" style="color:var(--secondary);margin-left:8px;"></i> المشاهدة عن بُعد من الهاتف</h3>
      <IconCardGrid columns={4} items={[
        { icon: 'fa-mobile-alt', title: 'تطبيق Hik-Connect (Hikvision)', text: 'يتيح مشاهدة البث المباشر والتسجيلات السابقة من هاتفك في أي مكان' },
        { icon: 'fa-mobile', title: 'تطبيق DMSS (Dahua)', text: 'واجهة سهلة وسريعة لإدارة الكاميرات بالكامل من الهاتف' },
        { icon: 'fa-bell', title: 'التنبيهات الفورية', text: 'يرسل الجهاز إشعاراً على هاتفك فور رصد أي حركة في الكاميرات' },
        { icon: 'fa-file-export', title: 'تصدير التسجيلات', text: 'يمكن تصدير أي مقطع إلى USB أو إرساله مباشرةً عبر الهاتف' },
      ]} />

      <h3><i class="fas fa-shield-alt" style="color:var(--secondary);margin-left:8px;"></i> تقنيات الكشف الذكي</h3>
      <IconCardGrid columns={4} items={[
        { icon: 'fa-running', title: 'كشف الحركة (Motion Detection)', text: 'يُسجّل فقط عند وجود حركة لتوفير مساحة التخزين' },
        { icon: 'fa-arrows-alt-h', title: 'كشف العبور الخطي (Line Crossing)', text: 'تنبيه عند تجاوز خط افتراضي تحدده أنت' },
        { icon: 'fa-user-shield', title: 'كشف التسلل في المنطقة (Intrusion Detection)', text: 'تنبيه عند دخول شخص إلى منطقة محظورة' },
        { icon: 'fa-user', title: 'كشف الوجوه (Face Detection)', text: 'متاح في الأجهزة المتقدمة لتحديد هوية الأشخاص' },
      ]} />

      <h3><i class="fas fa-compress-alt" style="color:var(--secondary);margin-left:8px;"></i> تقنيات الضغط المتاحة</h3>
      <ComparisonGrid items={[
        { title: 'H.264', text: 'ضغط قياسي متوافق مع جميع الأجهزة، جودة جيدة' },
        { title: 'H.265', text: 'ضغط متطور يوفر 50% من مساحة التخزين بنفس الجودة' },
        { title: 'H.265+', text: 'أحدث تقنية من Hikvision تقلل المساحة حتى 75% مقارنة بـ H.264' },
      ]} />

      <h3><i class="fas fa-calculator" style="color:var(--secondary);margin-left:8px;"></i> كيف تحسب سعة التخزين المطلوبة بدقة؟</h3>
      <p>بدلاً من التخمين، نحسب لكل عميل السعة المناسبة بناءً على معدل البت (Bitrate) لكل كاميرا وعدد أيام الأرشفة المطلوبة وأسلوب التسجيل المختار. عملياً، كاميرة 2MP بضغط H.265+ تستهلك تقريباً 4 إلى 6 جيجابايت يومياً عند التسجيل المستمر، بينما كاميرة 4MP تستهلك من 8 إلى 12 جيجابايت يومياً. اختيار أسلوب التسجيل يغيّر هذا الحساب جذرياً:</p>
      <ComparisonGrid items={[
        { title: 'التسجيل المستمر (24/7)', text: 'يستهلك أكبر مساحة تخزين لكنه يضمن عدم فقدان أي لحظة — الأنسب للمصانع والبنوك ومحال الذهب والمجوهرات' },
        { title: 'التسجيل عند الحركة فقط (Motion-Triggered)', text: 'يوفر من 60 إلى 80% من مساحة التخزين مقارنة بالتسجيل المستمر — مثالي للمنازل والمكاتب ذات الحركة المتوسطة' },
        { title: 'التسجيل المجدول (Scheduled Recording)', text: 'تسجيل في أوقات محددة فقط، مثل ساعات العمل الرسمية — مناسب للمحلات التي تُغلق أبوابها ليلاً' },
      ]} />

      <h3><i class="fas fa-network-wired" style="color:var(--secondary);margin-left:8px;"></i> الشبكة والكهرباء لأنظمة NVR — ما يجب معرفته</h3>
      <p>عند التحول لنظام IP بالكامل عبر NVR، هناك اعتبارات إضافية لا وجود لها في أنظمة DVR التقليدية القائمة على الكابل المحوري، ويغفل عنها كثير من العملاء عند التخطيط:</p>
      <IconCardGrid columns={2} items={[
        { icon: 'fa-network-wired', title: 'مفاتيح الشبكة الداعمة لـ PoE (PoE Switch)', text: 'توفر الطاقة والبيانات لكل كاميرا عبر كابل واحد فقط، وتحدد عدد الكاميرات التي يمكن توصيلها دفعة واحدة حسب عدد منافذها (8/16/24 منفذ)' },
        { icon: 'fa-tachometer-alt', title: 'عرض النطاق الترددي للشبكة (Bandwidth)', text: 'كل كاميرا 4K تستهلك جزءاً محسوباً من سرعة الشبكة الداخلية، لذا نصمم الشبكة بحيث لا تتأثر أجهزة الكمبيوتر والطابعات بحركة بيانات الكاميرات' },
        { icon: 'fa-battery-full', title: 'مصدر طاقة احتياطي (UPS)', text: 'ننصح به دوماً لجهاز التسجيل ذاته لضمان استمرار التسجيل لدقائق أو ساعات عند انقطاع الكهرباء المفاجئ، وهي ظاهرة متكررة في مصر خاصةً في فصل الصيف' },
        { icon: 'fa-copy', title: 'الأرشفة الاحتياطية (RAID/Backup)', text: 'للمشاريع الحساسة كالبنوك والمصانع الكبرى، نوفر أجهزة تسجيل بخاصية RAID تُخزّن نسخة مطابقة على أكثر من هاردسك في آن واحد، فإذا تعطل أحدها لا تُفقد أي بيانات' },
      ]} />

      <h3><i class="fas fa-exclamation-triangle" style="color:var(--secondary);margin-left:8px;"></i> أعطال أجهزة DVR/NVR الأكثر شيوعاً</h3>
      <p>على عكس مشكلات الكاميرات نفسها، أعطال جهاز التسجيل لها طابع مختلف ونتعامل معها يومياً في مصر:</p>
      <IconCardGrid columns={3} items={[
        { icon: 'fa-power-off', title: 'الجهاز لا يُقلع (No Power/No Boot)', text: 'غالباً بسبب تلف مصدر الطاقة الداخلي أو مشكلة في اللوحة الأم، يحتاج فحصاً واستبدال القطعة التالفة' },
        { icon: 'fa-video-slash', title: 'فقدان قناة أو أكثر فجأة', text: 'قد يكون بسبب تلف الكابل أو منفذ الاستقبال في الجهاز نفسه، أو تعارض عنوان IP في حالة أنظمة NVR' },
        { icon: 'fa-hourglass-half', title: 'بطء الواجهة أو تجمد الشاشة', text: 'عادةً ناتج عن امتلاء الهاردسك بالكامل أو قِدَم إصدار الفيرموير، ويُحل بالتنظيف أو التحديث' },
        { icon: 'fa-search', title: 'عدم ظهور التسجيلات القديمة رغم وجود مساحة', text: 'قد يكون بسبب تهيئة غير صحيحة للهاردسك أو تلف في جدول الفهرسة، ويحتاج أدوات استرجاع متخصصة' },
        { icon: 'fa-exclamation-circle', title: 'تعارض في عناوين الشبكة (IP Conflict) في أنظمة NVR', text: 'يحدث عند تكرار نفس عنوان IP بين كاميرتين، ويُحل بإعادة توزيع العناوين بشكل صحيح ومنظم' },
      ]} />

      <h3><i class="fas fa-industry" style="color:var(--secondary);margin-left:8px;"></i> أي جهاز تختار حسب طبيعة نشاطك؟</h3>
      <p>اختيار عدد القنوات وسعة التخزين يجب أن يُبنى على طبيعة نشاطك ومستوى الحساسية، وليس فقط على السعر الأقل:</p>
      <IconCardGrid columns={2} items={[
        { icon: 'fa-home', title: 'منزل أو شقة سكنية (4-6 كاميرات)', text: 'يكفي جهاز بـ4 أو 8 قنوات وهاردسك 1-2TB مع تسجيل عند الحركة فقط لتوفير المساحة' },
        { icon: 'fa-store', title: 'محل تجاري أو صيدلية (6-10 كاميرات)', text: 'نوصي بجهاز 8 أو 16 قناة وهاردسك 2-4TB، مع تسجيل مستمر على كاميرات الصندوق والمدخل تحديداً' },
        { icon: 'fa-industry', title: 'مصنع أو مستودع (16-32 كاميرا)', text: 'جهاز NVR بقنوات 16 أو 32 مع دعم RAID وهاردسك 8TB أو أكثر، مع تسجيل مستمر ونسخ احتياطي' },
        { icon: 'fa-gem', title: 'بنوك ومحال ذهب ومجوهرات', text: 'نوصي دوماً بأعلى دقة ممكنة مع RAID وتسجيل مستمر واحتفاظ لا يقل عن 90 يوماً لتحقيق التوافق مع متطلبات التأمين والجهات الرقابية' },
      ]} />

      <div class="cta-banner" style="margin-top:40px;border-radius:12px;">
        <h2>استشر خبراءنا في اختيار جهاز التسجيل المناسب</h2>
        <p>أخبرنا بعدد الكاميرات والمساحة المطلوبة وسنوصي لك بالجهاز الأمثل بأفضل سعر</p>
        <a href="https://wa.me/201227392074?text=أريد%20الاستفسار%20عن%20جهاز%20DVR%20أو%20NVR%20مناسب" target="_blank" class="btn btn-lg" style="background:var(--white);color:var(--secondary-dark);font-weight:700;"><i class="fab fa-whatsapp" style="color:#25D366;"></i> استشر خبيرنا</a>
      </div>
