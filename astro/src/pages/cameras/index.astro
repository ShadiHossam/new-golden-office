---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getSeoFor } from '../../lib/siteSeo';
---

<BaseLayout
  {...getSeoFor('/cameras')}
  preloadImage="/images/cameras-hub.webp"
>
<PageHero
  title="كاميرات المراقبة — حماية شاملة لمنزلك ومحلك"
  subtitle="أنظمة مراقبة احترافية بأحدث التقنيات من Hikvision وDahua وUNIView وHILook — تركيب وضمان وصيانة في جميع أنحاء مصر"
  heroImage="/images/cameras-hub.webp"
  heroIcon="fa-video"
  breadcrumbs={[
    { label: 'الرئيسية', href: '/' },
    { label: 'كاميرات المراقبة' }
  ]}
  showCta={false}
/>

<section class="stats-section">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item reveal"><div class="stat-num">+1500</div><div class="stat-label">نظام مراقبة مُركَّب</div></div>
      <div class="stat-item reveal delay-1"><div class="stat-num">+800</div><div class="stat-label">عميل موثوق في مصر</div></div>
      <div class="stat-item reveal delay-2"><div class="stat-num">3 سنوات</div><div class="stat-label">ضمان شامل على الأنظمة</div></div>
      <div class="stat-item reveal delay-3"><div class="stat-num">24 ساعة</div><div class="stat-label">استجابة لطلبات الصيانة</div></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <div class="section-tag">خدماتنا</div>
      <h2>حلول مراقبة متكاملة لكل الاحتياجات</h2>
      <p>من المنازل والمحلات التجارية إلى المصانع والمجمعات السكنية — نوفر لك النظام المناسب بأفضل جودة وأحدث تقنية</p>
      <div class="divider"></div>
    </div>
    <div class="services-grid" style="margin-bottom:70px;">
      <a href="/cameras/install" class="service-card reveal">
        <div class="service-icon"><i class="fas fa-video"></i></div>
        <h3>بيع وتركيب كاميرات</h3>
        <p>كاميرات داخلية وخارجية بدقة HD و4K، رؤية ليلية، زوايا عريضة، مع تركيب احترافي وتمديد الأسلاك وضبط الإعدادات الكاملة</p>
        <span class="service-link">اعرف أكثر <i class="fas fa-arrow-left"></i></span>
      </a>
      <a href="/cameras/dvr-nvr" class="service-card reveal delay-1">
        <div class="service-icon"><i class="fas fa-hdd"></i></div>
        <h3>أنظمة DVR و NVR</h3>
        <p>أجهزة تسجيل عالية الجودة بقنوات 4/8/16/32، تخزين حتى 8TB، مشاهدة عن بُعد من أي هاتف، مع ضغط H.265+ لتوفير المساحة</p>
        <span class="service-link">اعرف أكثر <i class="fas fa-arrow-left"></i></span>
      </a>
      <a href="/cameras/ip-wifi" class="service-card reveal delay-2">
        <div class="service-icon"><i class="fas fa-wifi"></i></div>
        <h3>كاميرات IP وواي فاي</h3>
        <p>كاميرات شبكية ولاسلكية للمنازل والمكاتب، دعم تطبيقات الهاتف، كشف الحركة، تنبيهات فورية، وتخزين سحابي متاح</p>
        <span class="service-link">اعرف أكثر <i class="fas fa-arrow-left"></i></span>
      </a>
      <a href="/cameras/maintenance" class="service-card reveal delay-3">
        <div class="service-icon"><i class="fas fa-wrench"></i></div>
        <h3>صيانة أنظمة المراقبة</h3>
        <p>صيانة دورية وطارئة لجميع أنظمة الكاميرات، تنظيف العدسات، تحديث البرامج، استبدال الهاردسك، واسترجاع التسجيلات</p>
        <span class="service-link">اعرف أكثر <i class="fas fa-arrow-left"></i></span>
      </a>
    </div>

    <div style="max-width:860px;margin:0 auto;">
      <div class="section-tag" style="margin-bottom:18px;">لماذا نيو جولدن أوفيس؟</div>
      <h2 style="margin-bottom:24px;">نجيب بأفضل حل لحماية منشآتك في مصر</h2>
      <p>منذ عام 1999، تُقدّم شركة نيو جولدن أوفيس خدمات متكاملة في مجال كاميرات المراقبة وأنظمة الأمن لأفراد وشركات وحكومات في جميع أنحاء مصر. مع تصاعد معدلات التحضر والنمو الاقتصادي في مصر، باتت كاميرات المراقبة ضرورة لا رفاهية — سواء لحماية المنزل أو المحل التجاري أو المصنع أو المجمع السكني.</p>
      <p>نتعامل مع أفضل الماركات العالمية في صناعة المراقبة: <strong>Hikvision</strong> الرائد العالمي الأول في كاميرات الأمن، و<strong>Dahua</strong> المعروف بأنظمته الذكية عالية الجودة، و<strong>UNIView</strong> المتخصص في الحلول الاحترافية، و<strong>HILook</strong> الخيار الأمثل للمشاريع ذات الميزانيات المدروسة. كل هذه الماركات متاحة لدينا بأسعار تنافسية مع ضمان موثَّق ودعم فني مستمر.</p>
      <h3 style="margin-top:32px;margin-bottom:16px;"><i class="fas fa-shield-alt" style="color:var(--secondary);margin-left:8px;"></i> لماذا كاميرات المراقبة ضرورة في مصر؟</h3>
      <p>في ظل التوسع العمراني الكبير الذي تشهده مصر وتنامي المشاريع التجارية والسكنية، أصبح تأمين المنشآت من أولويات أصحاب الأعمال والأفراد على حد سواء. كاميرات المراقبة لا تقتصر على تسجيل الأحداث بعد وقوعها، بل هي رادع فعّال يمنع الحوادث قبل حدوثها.</p>
      <h3 style="margin-top:32px;margin-bottom:16px;"><i class="fas fa-check-circle" style="color:var(--secondary);margin-left:8px;"></i> ما يميزنا في كاميرات المراقبة</h3>
      <ul>
        <li><i class="fas fa-check"></i><span>استشارة مجانية لتقييم احتياجاتك وتحديد أفضل نظام مراقبة مناسب لمساحتك وميزانيتك</span></li>
        <li><i class="fas fa-check"></i><span>تركيب احترافي بواسطة فنيين معتمدين مع تمديد نظيف للكابلات وثبات تام لمحوري الكاميرا</span></li>
        <li><i class="fas fa-check"></i><span>ضبط كامل للنظام وتدريب العميل على التشغيل والمشاهدة عن بُعد من الهاتف</span></li>
        <li><i class="fas fa-check"></i><span>ضمان 3 سنوات على الأجهزة وخدمة صيانة دورية للحفاظ على أداء النظام</span></li>
        <li><i class="fas fa-check"></i><span>أسعار تنافسية ومرنة مع إمكانية تحديث النظام القديم أو توسعته مستقبلاً</span></li>
      </ul>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <div class="section-tag">كيف نعمل</div>
      <h2>ثلاث خطوات للحصول على نظام مراقبة متكامل</h2>
      <p>عملية بسيطة وسريعة من الاستشارة حتى التسليم الكامل</p>
      <div class="divider"></div>
    </div>
    <div class="steps-grid">
      <div class="step-card reveal">
        <div class="step-num">١</div>
        <h4>تواصل وتقييم مجاني</h4>
        <p>اتصل بنا أو تواصل عبر واتساب وسنرسل فنياً متخصصاً لمعاينة المكان وتقييم احتياجاتك وتحديد أفضل نقاط تركيب الكاميرات</p>
      </div>
      <div class="step-card reveal delay-1">
        <div class="step-num">٢</div>
        <h4>اختيار النظام المناسب</h4>
        <p>نقدم عروض أسعار واضحة ومفصّلة مع توضيح الفرق بين الخيارات المتاحة من كاميرات وأجهزة تسجيل ووحدات تخزين تناسب ميزانيتك</p>
      </div>
      <div class="step-card reveal delay-2">
        <div class="step-num">٣</div>
        <h4>التركيب والتسليم</h4>
        <p>يقوم فريقنا الفني بتركيب الكاميرات وتمديد الكابلات وضبط جهاز التسجيل وربطه بالهاتف، ثم تدريبك الكامل على استخدام النظام</p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <div class="section-tag">أسئلة شائعة</div>
      <h2>أسئلة شائعة عن كاميرات المراقبة</h2>
      <div class="divider"></div>
    </div>
    <div class="faq-list">
      <div class="faq-item"><div class="faq-question">كم كاميرا أحتاج لتأمين محلي أو مصنعي؟ <i class="fas fa-plus"></i></div><div class="faq-answer"><div class="faq-answer-inner">يعتمد العدد على مساحة المكان وطبيعته. للمحلات الصغيرة تكفي عادةً 4 كاميرات (مدخل، صندوق، 2 داخل). للمحلات المتوسطة 8 كاميرات. للمصانع والمستودعات الكبيرة نصمم أنظمة من 16 إلى 32 كاميرا أو أكثر. فريقنا يقوم بمعاينة مجانية ويوصي بالعدد والأماكن الأمثل.</div></div></div>
      <div class="faq-item"><div class="faq-question">هل أستطيع مشاهدة الكاميرات من هاتفي أثناء السفر؟ <i class="fas fa-plus"></i></div><div class="faq-answer"><div class="faq-answer-inner">نعم بالتأكيد. جميع أنظمتنا الحديثة تدعم المشاهدة عن بُعد عبر تطبيق مخصص على الهاتف (Android وiPhone). ما تحتاجه هو اتصال إنترنت في موقع الكاميرات وعلى هاتفك.</div></div></div>
      <div class="faq-item"><div class="faq-question">ما الفرق بين الكاميرات الداخلية والخارجية؟ <i class="fas fa-plus"></i></div><div class="faq-answer"><div class="faq-answer-inner">الكاميرات الخارجية مصممة لتحمّل عوامل الطقس (مطر، غبار، حرارة) وتحمل تصنيف IP66 أو IP67 للحماية. كما تتميز بزاوية رؤية أوسع ومدى رؤية ليلية أطول. الكاميرات الداخلية أصغر حجماً ومصممة للبيئات المغلقة.</div></div></div>
      <div class="faq-item"><div class="faq-question">كم يستغرق تركيب نظام الكاميرات؟ <i class="fas fa-plus"></i></div><div class="faq-answer"><div class="faq-answer-inner">للمنازل والمحلات الصغيرة (4-8 كاميرات) يستغرق التركيب من 4 إلى 8 ساعات في نفس اليوم. للمشاريع الكبيرة (16 كاميرا فأكثر) قد يمتد العمل ليوم أو يومين.</div></div></div>
      <div class="faq-item"><div class="faq-question">ما مدة تخزين التسجيلات وكيف يمكن استرجاعها؟ <i class="fas fa-plus"></i></div><div class="faq-answer"><div class="faq-answer-inner">تعتمد مدة التخزين على حجم الهاردسك وعدد الكاميرات وجودة التسجيل. بهاردسك 1TB يمكن تخزين التسجيلات من 7 إلى 30 يوم. بهاردسك 4TB تصل المدة لـ 60-90 يوم.</div></div></div>
      <div class="faq-item"><div class="faq-question">كم سعر نظام كاميرات المراقبة في مصر؟ <i class="fas fa-plus"></i></div><div class="faq-answer"><div class="faq-answer-inner">تتفاوت أسعار أنظمة كاميرات المراقبة في مصر حسب عدد الكاميرات وجودتها. تشمل الأسعار الكاميرات وجهاز التسجيل DVR/NVR والكابلات والتركيب الاحترافي. تواصل معنا للحصول على عرض سعر مجاني مخصص لاحتياجاتك.</div></div></div>
    </div>
  </div>
</section>

<section class="content-section" style="padding:60px 0;background:#f8f9fa">
  <div class="container">
    <h2 style="font-size:1.8rem;font-weight:700;color:#1a1a2e;margin-bottom:24px">أفضل كاميرات مراقبة في مصر 2025 — دليلك الشامل</h2>
    <p style="font-size:1.05rem;line-height:1.9;color:#444;margin-bottom:16px">عند البحث عن أفضل كاميرات مراقبة في مصر، تبرز عدة ماركات عالمية تجمع بين الجودة العالية والسعر المناسب. في نيو جولدن أوفيس الإسكندرية نعمل مع Hikvision وDahua وUNIView وHILook وEZVIZ — وهي الأكثر مبيعاً وموثوقية في السوق المصري.</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;margin-top:24px">
      <div style="background:#fff;border-radius:12px;padding:24px;border:1px solid #e0e0e0">
        <h3 style="font-size:1.1rem;font-weight:700;color:#1a1a2e;margin-bottom:8px">كاميرات للمنازل</h3>
        <p style="color:#555;font-size:0.95rem;line-height:1.7">كاميرات داخلية وخارجية بدقة HD وFull HD مع إمكانية المشاهدة من الموبايل.</p>
      </div>
      <div style="background:#fff;border-radius:12px;padding:24px;border:1px solid #e0e0e0">
        <h3 style="font-size:1.1rem;font-weight:700;color:#1a1a2e;margin-bottom:8px">كاميرات للمحلات التجارية</h3>
        <p style="color:#555;font-size:0.95rem;line-height:1.7">أنظمة مراقبة متكاملة مع تسجيل 24 ساعة وتنبيهات فورية عند أي حركة.</p>
      </div>
      <div style="background:#fff;border-radius:12px;padding:24px;border:1px solid #e0e0e0">
        <h3 style="font-size:1.1rem;font-weight:700;color:#1a1a2e;margin-bottom:8px">كاميرات للشركات والمصانع</h3>
        <p style="color:#555;font-size:0.95rem;line-height:1.7">حلول مراقبة صناعية بكاميرات عالية الدقة مقاومة للعوامل الجوية والغبار.</p>
      </div>
    </div>
  </div>
</section>

<section class="cta-banner">
  <div class="container">
    <h2>احصل على استشارة مجانية لنظام المراقبة</h2>
    <p>فريقنا جاهز لزيارتك ومعاينة مكانك وتقديم أفضل حل مراقبة يناسبك بأسعار لا تُقارَن في السوق المصري</p>
    <div class="btn-group" style="justify-content:center;">
      <a href="/contact" class="btn btn-outline btn-lg"><i class="fas fa-phone-alt"></i> اتصل بنا الآن</a>
      <a href="https://wa.me/201227392074?text=أريد%20استشارة%20مجانية%20لنظام%20كاميرات%20المراقبة" target="_blank" class="btn btn-lg" style="background:var(--white);color:var(--secondary-dark);font-weight:700;"><i class="fab fa-whatsapp" style="color:#25D366;"></i> واتساب مباشر</a>
    </div>
  </div>
</section>
</BaseLayout>
