---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://newgoldenoffice.com/cairo/printing#service",
      "url": "https://newgoldenoffice.com/cairo/printing",
      "name": "شركة طباعة القاهرة",
      "description": "خدمات طباعة أوفست وديجيتال للشركات في القاهرة: كروت شخصية، بروشورات، فلايرات، بنرات واستاندات، تغليف، هدايا دعائية، وطباعة بالجملة، مع بروفة قبل الطباعة وتسليم في مقر الشركة.",
      "inLanguage": "ar",
      "serviceType": ["طباعة أوفست","طباعة ديجيتال","طباعة بالجملة","طباعة كروت شخصية","طباعة بروشورات وفلايرات","طباعة بنرات ولافتات","طباعة تغليف وعبوات","هدايا دعائية","تصميم جرافيك"],
      "areaServed": [
        {"@type":"City","name":"القاهرة"},
        {"@type":"Place","name":"التجمع الخامس"},
        {"@type":"Place","name":"مدينة نصر"},
        {"@type":"Place","name":"المعادي"},
        {"@type":"Place","name":"القاهرة الجديدة"},
        {"@type":"Place","name":"وسط البلد"}
      ],
      "provider": { "@id": "https://newgoldenoffice.com/#organization" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"كم تكلفة خدمات الطباعة في القاهرة؟","acceptedAnswer":{"@type":"Answer","text":"التكلفة تعتمد على الكمية والخامة والتشطيب وطريقة الطباعة وحجم التعاقد. أرسل التصميم والكمية والمواصفات ويصلك عرض سعر مفصل وواضح البنود قبل أي التزام."}},
        {"@type":"Question","name":"ما الفرق بين الطباعة الأوفست والديجيتال ومتى أختار كلًّا منهما؟","acceptedAnswer":{"@type":"Answer","text":"الأوفست مناسبة للكميات الكبيرة بتكلفة وحدة أقل وثبات لوني أعلى، والديجيتال مناسبة للكميات الصغيرة والطلبات العاجلة لأنها تبدأ من الملف مباشرة."}},
        {"@type":"Question","name":"ما الحد الأدنى للكمية للطباعة؟","acceptedAnswer":{"@type":"Answer","text":"يختلف حسب المنتج وطريقة الطباعة: الديجيتال تتيح كميات صغيرة، والأوفست تصبح اقتصادية مع الكميات الأكبر."}},
        {"@type":"Question","name":"كم مدة تسليم الطلب المستعجل داخل القاهرة؟","acceptedAnswer":{"@type":"Answer","text":"لدينا مسار استعجال بأولوية تشغيل خاصة لطلبات الفعاليات والمواعيد الضيقة. أخبرنا بموعدك من أول اتصال ونؤكد لك فورًا إمكانية التنفيذ."}},
        {"@type":"Question","name":"هل أحصل على بروفة قبل الطباعة النهائية؟","acceptedAnswer":{"@type":"Answer","text":"نعم، في كل طلب دون استثناء. نراجع الملف فنيًا ثم نرسل بروفة تعتمدها بنفسك، ولا يدخل الطلب للتشغيل إلا بعد اعتمادك."}},
        {"@type":"Question","name":"ما مناطق التوصيل داخل القاهرة؟","acceptedAnswer":{"@type":"Answer","text":"نغطي التجمع الخامس ومدينة نصر والمعادي والقاهرة الجديدة ووسط البلد المالي بمسارات تسليم مجدولة، والتسليم في مقر شركتك."}},
        {"@type":"Question","name":"هل توفرون خدمات أخرى غير الطباعة مثل التصميم؟","acceptedAnswer":{"@type":"Answer","text":"نعم. نقدم خدمات التصميم الجرافيكي والمراجعة الفنية، كما نجهز المكاتب بالكامل: ماكينات تصوير، أدوات مكتبية، تكييفات، كاميرات مراقبة، وماكينات عد نقود."}},
        {"@type":"Question","name":"هل توفرون طباعة بالجملة وتعاقدات توريد للشركات؟","acceptedAnswer":{"@type":"Answer","text":"نعم. نضع لشركتك تعاقد توريد بجدول منتظم وأسعار كميات، وتصلك كل دفعة في موعدها بنفس المواصفات المحفوظة."}},
        {"@type":"Question","name":"هل يوجد لديكم فرع في القاهرة وكيف أتواصل معكم؟","acceptedAnswer":{"@type":"Answer","text":"نخدم القاهرة بتغطية كاملة عبر مسارات تسليم مجدولة ومندوب حساب مخصص وفرق ميدانية تصل إلى مقر شركتك، فلا تحتاج زيارة فرع أصلًا."}}
      ]
    }
  ]
});
---

<BaseLayout
  title="شركة طباعة في القاهرة، أوفست وديجيتال | نيو جولدن أوفيس"
  description="شركة طباعة القاهرة بخبرة 27 عامًا: أوفست وديجيتال، كروت وبروشورات وبنرات وتغليف وهدايا دعائية، بروفة قبل الطباعة وتسليم في مقرك. اطلب عرض سعر الآن."
  keywords="شركة طباعة القاهرة، طباعة اوفست القاهرة، طباعة بالجملة القاهرة، خدمات طباعة للشركات بالقاهرة"
  ogTitle="شركة طباعة القاهرة | نيو جولدن أوفيس"
  ogDescription="شركة طباعة القاهرة بخبرة 27 عامًا: أوفست وديجيتال، كروت وبروشورات وبنرات وتغليف وهدايا دعائية، تسليم في مقرك."
  ogImage="/images/printing-hub.webp"
  schemaJson={schemaJson}
>
<style>
  .quote-section{padding:60px 0}
  .quote-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:stretch}
  .quote-form-card{background:#fff;border-radius:18px;padding:2.2rem;box-shadow:0 4px 24px rgba(27,58,107,0.1)}
  .quote-form-card h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:700;color:var(--green-dark);margin-bottom:1.5rem}
  .form-group{margin-bottom:1.1rem}
  .form-group label{display:block;font-family:'Cairo',sans-serif;font-size:0.95rem;font-weight:600;color:var(--green-dark);margin-bottom:0.4rem}
  .form-group input,.form-group select,.form-group textarea{width:100%;padding:0.8rem 1rem;border:2px solid #e5eaf3;border-radius:10px;font-family:'Tajawal',sans-serif;font-size:1rem;color:#333;background:#fafbfd;transition:border-color .3s,box-shadow .3s;outline:none;box-sizing:border-box;direction:rtl}
  .form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--green-dark);box-shadow:0 0 0 3px rgba(27,58,107,.1);background:#fff}
  .form-group textarea{height:100px;resize:vertical}
  .form-submit-btn{width:100%;padding:1rem;background:linear-gradient(135deg,var(--green-dark),var(--green-mid));color:#fff;border:none;border-radius:12px;font-family:'Cairo',sans-serif;font-size:1.05rem;font-weight:700;cursor:pointer;transition:transform .3s,box-shadow .3s;display:flex;align-items:center;justify-content:center;gap:.5rem}
  .form-submit-btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(27,58,107,.25)}
  .success-message{display:none;background:linear-gradient(135deg,#e8f5e9,#f1f8e9);border:2px solid #4caf50;border-radius:12px;padding:1.5rem;text-align:center;margin-top:1rem}
  .success-message i{font-size:2.5rem;color:#4caf50;display:block;margin-bottom:.5rem}
  .success-message p{font-family:'Cairo',sans-serif;font-size:1.05rem;color:#2e7d32;font-weight:600}
  .quote-alt-card{background:linear-gradient(135deg,#25D366 0%,#128C7E 100%);border-radius:18px;padding:2.4rem;text-align:center;color:#fff;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:1rem}
  .quote-alt-card .wa-icon{font-size:3rem}
  .quote-alt-card h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:800}
  .quote-alt-card p{opacity:.92;line-height:1.8}
  @media(max-width:768px){.quote-grid{grid-template-columns:1fr}}
</style>

<section class="page-hero">
  <div class="container">
    <div class="page-hero-inner">
      <div class="page-hero-content">
        <nav class="breadcrumb">
          <a href="/">الرئيسية</a>
          <span>/</span>
          <a href="/cairo">خدماتنا في القاهرة</a>
          <span>/</span>
          <span class="current">شركة طباعة القاهرة</span>
        </nav>
        <h1 class="reveal">شركة طباعة القاهرة</h1>
        <p class="lead reveal delay-1">أوفست وديجيتال، كروت وبروشورات وبنرات وتغليف وهدايا دعائية، بروفة تعتمدها وتسليم في مقر شركتك، بخبرة 27 عامًا ونظام تشغيل كامل بدون فرع</p>
      </div>
      <div class="page-hero-image">
        <img src="/images/webp-images/man-and-woman-working-with-printing-machine-2026-01-08-07-07-12-utc.webp" alt="شركة طباعة القاهرة" loading="eager">
      </div>
    </div>
  </div>
</section>

<section class="stats-section">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item reveal">
        <div class="stat-num" data-target="27" data-suffix="+">0+</div>
        <div class="stat-label">سنة خبرة في الطباعة</div>
      </div>
      <div class="stat-item reveal delay-1">
        <div class="stat-num" data-target="9">0</div>
        <div class="stat-label">أنواع مطبوعات كاملة</div>
      </div>
      <div class="stat-item reveal delay-2">
        <div class="stat-num" data-target="5">0</div>
        <div class="stat-label">مناطق أعمال نغطيها بالقاهرة</div>
      </div>
      <div class="stat-item reveal delay-3">
        <div class="stat-num" data-target="1">0</div>
        <div class="stat-label">مسؤول حساب واحد يتابع طلبك</div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="intro-text" style="max-width:900px;margin:0 auto 48px;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>تبحث عن شركة طباعة القاهرة تنفذ مطبوعات شركتك بجودة ثابتة وموعد مضمون؟ نيو جولدن أوفيس تخدم الشركات في التجمع الخامس ومدينة نصر والمعادي والقاهرة الجديدة ووسط البلد المالي بخبرة 27 عامًا في الطباعة وتجهيز المكاتب. ننفذ طباعة أوفست وديجيتال، كروت شخصية وبروشورات وفلايرات، بنرات واستاندات، تغليف وهدايا دعائية، مع بروفة تعتمدها قبل التشغيل وتسليم يصلك في مقر شركتك. تتعامل مع مسؤول حساب واحد يعرف ملفاتك ومواصفاتك من أول طلب لآخر تسليم.</p>
      <p style="margin-top:16px">هذا التخصص في التعامل المؤسسي جعل كثيرًا من شركات القاهرة تعتمد علينا كمورد طباعة دائم بدل البحث عن مطبعة جديدة كل مرة، لأن مندوب حسابك يحتفظ بملف كامل لهويتك البصرية ومواصفاتك المعتمدة، فيسرّع أي طلب جديد لاحق دون إعادة شرح التفاصيل من الصفر مرة أخرى.</p>
      <p style="margin-top:16px">نحتفظ أيضًا بنسخة من كل تصميم سابق طبعناه لك، فإذا احتجت إعادة طباعة نفس الكمية لاحقًا، ننفذها بنفس المواصفات تمامًا دون الحاجة لإرسال الملفات مرة أخرى.</p>
      <p style="margin-top:16px">نساعد أيضًا الشركات الجديدة التي لم تحدد هويتها البصرية بعد في اختيار الألوان والخطوط المناسبة لمجال عملها، قبل البدء في تنفيذ أي مطبوعات فعلية.</p>
      <p style="margin-top:16px">نتابع أيضًا مواعيد التجديد السنوي لعملائنا في القاهرة، ونذكّرهم مسبقًا بأي مطبوعات دورية تحتاج تجديدًا كالتقاويم والكتالوجات الموسمية.</p>
      <p style="margin-top:16px">نساعد أيضًا في تنسيق الطباعة مع باقي عناصر الهوية البصرية، لضمان اتساق كامل بين الكروت والبروشورات واللافتات وأي مطبوع آخر يمثل شركتك.</p>
      <p style="margin-top:16px">نرحب دائمًا بزيارتك لمقرنا في الإسكندرية لمعاينة نماذج أعمال سابقة قبل اتخاذ قرارك النهائي.</p>
      <p style="margin-top:16px;text-align:center">تعرف على <a href="/cairo">خدماتنا الشاملة في القاهرة</a> بكل تخصصاتنا الستة. ونغطي أيضًا الإسكندرية بنفس الجودة: <a href="/alexandria/printing">خدمات الطباعة في الإسكندرية</a> لتوحيد مطبوعات فروعك عند مورد واحد.</p>
    </div>

    <div class="section-header">
      <h2>لماذا تعتمد الشركات على نيو جولدن أوفيس كشركة طباعة في القاهرة؟</h2>
      <div class="divider"></div>
    </div>
    <div class="features-grid">
      <div class="feature-card reveal">
        <div class="feature-icon"><i class="fas fa-award"></i></div>
        <h4>خبرة 27 عامًا</h4>
        <p>في تنفيذ مطبوعات الشركات، أقدمية يصعب أن تجدها عند منافس.</p>
      </div>
      <div class="feature-card reveal delay-1">
        <div class="feature-icon"><i class="fas fa-user-tie"></i></div>
        <h4>مسؤول حساب واحد</h4>
        <p>رقم واحد يعرف تاريخ طلباتك ومواصفاتك بالكامل.</p>
      </div>
      <div class="feature-card reveal delay-2">
        <div class="feature-icon"><i class="fas fa-check-double"></i></div>
        <h4>بروفة قبل الطباعة</h4>
        <p>في كل طلب، فلا مفاجآت في اللون أو المقاس أو النص.</p>
      </div>
      <div class="feature-card reveal delay-3">
        <div class="feature-icon"><i class="fas fa-truck"></i></div>
        <h4>تسليم في مقرك</h4>
        <p>داخل مناطق الأعمال الرئيسية في القاهرة.</p>
      </div>
      <div class="feature-card reveal">
        <div class="feature-icon"><i class="fas fa-layer-group"></i></div>
        <h4>تشكيلة كاملة</h4>
        <p>من الكارت الشخصي إلى التغليف والتعاقدات الدورية، فلا تحتاج موردًا ثانيًا.</p>
      </div>
    </div>
    <p style="max-width:800px;margin:24px auto 0;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">وإذا كان مكتبك يحتاج أكثر من الطباعة، فنحن نجهز المكاتب بالكامل في القاهرة: <a href="/cairo/ac">التكييفات</a>، <a href="/cairo/cameras">كاميرات المراقبة</a>، <a href="/cairo/copiers">ماكينات تصوير</a>، <a href="/cairo/office-supplies">مستلزمات مكتبية</a>، و<a href="/cairo/cash-machines">ماكينات عد نقود</a>. تجهيز شامل؟ شوف <a href="/cairo/office-setup">صفحة تجهيز مكتب متكامل في القاهرة</a>.</p>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>كيف نخدم القاهرة بتغطية كاملة بدون فرع؟</h2>
      <div class="divider"></div>
    </div>
    <p style="max-width:800px;margin:0 auto 32px;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">لا نتعامل مع طلبات القاهرة كطلبات "من بعيد"، بل عبر ثلاث ركائز تشغيلية:</p>
    <div class="steps-grid">
      <div class="step-card reveal">
        <div class="step-num">1</div>
        <h4>مسارات تسليم مجدولة</h4>
        <p>تغطي التجمع الخامس ومدينة نصر والمعادي والقاهرة الجديدة ووسط البلد المالي.</p>
      </div>
      <div class="step-card reveal delay-1">
        <div class="step-num">2</div>
        <h4>مندوب حساب مخصص</h4>
        <p>يستلم ملفاتك، يرسل البروفة، يجيب أسئلتك الفنية، ويتابع الطلب حتى الاستلام.</p>
      </div>
      <div class="step-card reveal delay-2">
        <div class="step-num">3</div>
        <h4>فرق ميدانية متنقلة</h4>
        <p>تصل إليك للمعاينة والاستلام والتسليم أينما كان مقر شركتك.</p>
      </div>
    </div>
    <p style="max-width:800px;margin:24px auto 0;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">عدم وجود فرع في القاهرة ليس نقصًا نعوضه، بل اختيار تشغيلي: بدلًا من أن تأتي أنت إلينا، نأتي نحن إليك.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>طباعة اوفست القاهرة وخدماتنا الكاملة للشركات</h2>
      <div class="divider"></div>
    </div>
    <div class="services-grid">
      <div class="service-card reveal"><div class="service-icon"><i class="fas fa-id-card"></i></div><h3 class="service-title">كروت شخصية (بزنس كارد)</h3><p class="service-desc">خامات وتشطيبات متعددة: ورق سميك فاخر، سيلوفان مط أو لامع، سبوت UV، وحواف مستديرة عند الطلب.</p><a href="/printing/business-cards" class="btn btn-outline-primary btn-sm">طباعة بزنس كارد <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal delay-1"><div class="service-icon"><i class="fas fa-book-open"></i></div><h3 class="service-title">بروشورات وفلايرات وكتالوجات</h3><p class="service-desc">فلايرات للتوزيع، بروشورات مطوية بأنظمة طي مختلفة، وكتالوجات متعددة الصفحات.</p><a href="/printing/brochures" class="btn btn-outline-primary btn-sm">بروشورات وفلايرات <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal delay-2"><div class="service-icon"><i class="fas fa-image"></i></div><h3 class="service-title">بنرات واستاندات ولافتات</h3><p class="service-desc">بنرات مؤتمرات، رول أب للمعارض، استاندات عرض، ولافتات فينيل للفروع والفعاليات.</p><a href="/printing/banners" class="btn btn-outline-primary btn-sm">طباعة بنرات <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal delay-3"><div class="service-icon"><i class="fas fa-file-lines"></i></div><h3 class="service-title">أوراق رسمية ومطبوعات الهوية</h3><p class="service-desc">ليتر هيد، أظرف، فولدرات، دفاتر فواتير وإيصالات، بهوية موحدة ومحفوظة لكل إعادة طباعة.</p></div>
      <div class="service-card reveal"><div class="service-icon"><i class="fas fa-box"></i></div><h3 class="service-title">تغليف وعبوات</h3><p class="service-desc">علب وأغلفة مطبوعة بشعارك، أكياس ورقية للمحال والمعارض، وشنط تسليم للعملاء.</p></div>
      <div class="service-card reveal delay-1"><div class="service-icon"><i class="fas fa-gift"></i></div><h3 class="service-title">هدايا دعائية باسم شركتك</h3><p class="service-desc">أقلام وأجندات وأكواب وحقائب مطبوعة بشعارك، جاهزة لمعارض القاهرة ومناسبات نهاية العام.</p><a href="/printing/gifts" class="btn btn-outline-primary btn-sm">هدايا دعائية <i class="fas fa-arrow-left"></i></a></div>
