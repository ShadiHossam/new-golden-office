---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://newgoldenoffice.com/cairo/copiers#service",
      "name": "بيع وإيجار وصيانة ماكينات تصوير في القاهرة",
      "serviceType": "بيع وإيجار وصيانة ماكينات تصوير المستندات للشركات",
      "url": "https://newgoldenoffice.com/cairo/copiers",
      "areaServed": { "@type": "City", "name": "القاهرة" },
      "provider": { "@id": "https://newgoldenoffice.com/#organization" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"كيف أختار حجم وسرعة ماكينة التصوير المناسبة؟","acceptedAnswer":{"@type":"Answer","text":"اقرأ عداد ماكينتك الحالية أو اجمع فواتير الورق لثلاثة أشهر، ثم اختر فئة سرعة تعمل مريحة تحت حدها الأقصى."}},
        {"@type":"Question","name":"ما الفرق بين ريكو وكانون وكونيكا مينولتا؟","acceptedAnswer":{"@type":"Answer","text":"ريكو الأوسع انتشارًا بتكلفة تشغيل اقتصادية، وكانون قوية في جودة الألوان، وكونيكا مينولتا قوية في الإنتاجية."}},
        {"@type":"Question","name":"كم سعر إيجار ماكينة تصوير شهريًا؟","acceptedAnswer":{"@type":"Answer","text":"تتحدد حسب فئة الماكينة وحد النسخ الشهري، والعقد يشمل الصيانة الدورية وقطع الغيار والإصلاح الميداني."}},
        {"@type":"Question","name":"هل توفرون صيانة ميدانية في القاهرة؟","acceptedAnswer":{"@type":"Answer","text":"نعم، فرق فنية ميدانية تغطي التجمع الخامس ومدينة نصر والمعادي والقاهرة الجديدة ووسط البلد المالي بمسارات يومية."}},
        {"@type":"Question","name":"هل الماكينة المستوردة عليها ضمان؟","acceptedAnswer":{"@type":"Answer","text":"نعم، كل ماكينة استيراد تمر بفحص فني كامل وتُسلَّم بضمان حقيقي."}},
        {"@type":"Question","name":"هل الأحبار وقطع الغيار أصلية؟","acceptedAnswer":{"@type":"Answer","text":"نورد التونر الأصلي والمتوافق المعتمد فقط، ولا نتعامل مع المقلد."}},
        {"@type":"Question","name":"هل تقدمون عقود صيانة أسطول للشركات الكبرى؟","acceptedAnswer":{"@type":"Answer","text":"نعم، عقد أسطول كامل يشمل حصر الماكينات وزيارات مجدولة وتقارير دورية للإدارة."}},
        {"@type":"Question","name":"هل الغبار والرطوبة المتغيرة في القاهرة تسبب انحشار الورق؟","acceptedAnswer":{"@type":"Answer","text":"نعم، الأتربة المتراكمة داخل مسارات سحب الورق وبكرات التغذية تزيد احتمال الانحشار، وتقلبات الرطوبة الموسمية تجعل الورق يمتص رطوبة أو يجف فيتغير سمكه الفعلي فيتعثر السحب. ننصح بتخزين الورق في مكان مغلق بعيدًا عن الرطوبة المباشرة، وفحص دوري لمسار سحب الورق ضمن الصيانة الوقائية."}},
        {"@type":"Question","name":"هل يمكن ربط الماكينة بالشبكة والمسح الضوئي إلى البريد الإلكتروني؟","acceptedAnswer":{"@type":"Answer","text":"نعم، نبرمج الماكينة للطباعة الشبكية من كل أجهزة المكتب، والمسح الضوئي المباشر إلى البريد الإلكتروني أو مجلد مشترك، مع صلاحيات وصول محددة لكل قسم عند الحاجة."}},
        {"@type":"Question","name":"ما أكثر الأعطال شيوعًا في ماكينات التصوير وكيف تُحل؟","acceptedAnswer":{"@type":"Answer","text":"انحشار الورق غالبًا بسبب بكرات تغذية متسخة، خطوط أو بقع على المطبوعات بسبب تونر منخفض أو وحدة تصوير متسخة، وبطء الاستجابة الشبكية بسبب تحديث برمجي مطلوب. أغلبها يُحل بزيارة صيانة وقائية دورية واحدة."}}
      ]
    }
  ]
});
---

<BaseLayout
  title="شركة ماكينات تصوير في القاهرة | بيع وإيجار وصيانة"
  description="شركة ماكينات تصوير في القاهرة: بيع وإيجار وصيانة ماكينات تصوير المستندات وعقود أساطيل للشركات، أحبار وقطع غيار أصلية وضمان معتمد. خبرة 27 عامًا."
  keywords="شركة ماكينات تصوير في القاهرة، صيانة ماكينات تصوير القاهرة، عقود صيانة أسطول ماكينات تصوير القاهرة"
  ogTitle="شركة ماكينات تصوير في القاهرة | نيو جولدن أوفيس"
  ogDescription="بيع وإيجار وصيانة ماكينات تصوير المستندات وعقود أساطيل للشركات في القاهرة."
  ogImage="/images/copiers-hub.webp"
  schemaJson={schemaJson}
>
<style>
  .quote-section{padding:60px 0}
  .quote-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:stretch}
  .quote-form-card{background:#fff;border-radius:18px;padding:2.2rem;box-shadow:0 4px 24px rgba(27,58,107,0.1)}
  .quote-form-card h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:700;color:var(--green-dark);margin-bottom:1.5rem}
  .form-group{margin-bottom:1.1rem}
  .form-group label{display:block;font-family:'Cairo',sans-serif;font-size:0.95rem;font-weight:600;color:var(--green-dark);margin-bottom:0.4rem}
  .form-group input,.form-group select,.form-group textarea{width:100%;padding:0.8rem 1rem;border:2px solid #e5eaf3;border-radius:10px;font-family:'Tajawal',sans-serif;font-size:1rem;color:#333;background:#fafbfd;transition:border-color .3s,box-shadow .3s;outline:none;box-sizing:border-box;direction:rtl}
  .form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--green-dark);box-shadow:0 0 0 3px rgba(27,58,107,.1);background:#fff}
  .form-group textarea{height:100px;resize:vertical}
  .form-submit-btn{width:100%;padding:1rem;background:linear-gradient(135deg,var(--green-dark),var(--green-mid));color:#fff;border:none;border-radius:12px;font-family:'Cairo',sans-serif;font-size:1.05rem;font-weight:700;cursor:pointer;transition:transform .3s,box-shadow .3s;display:flex;align-items:center;justify-content:center;gap:.5rem}
  .form-submit-btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(27,58,107,.25)}
  .success-message{display:none;background:linear-gradient(135deg,#e8f5e9,#f1f8e9);border:2px solid #4caf50;border-radius:12px;padding:1.5rem;text-align:center;margin-top:1rem}
  .success-message i{font-size:2.5rem;color:#4caf50;display:block;margin-bottom:.5rem}
  .success-message p{font-family:'Cairo',sans-serif;font-size:1.05rem;color:#2e7d32;font-weight:600}
  .quote-alt-card{background:linear-gradient(135deg,#25D366 0%,#128C7E 100%);border-radius:18px;padding:2.4rem;text-align:center;color:#fff;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:1rem}
  .quote-alt-card .wa-icon{font-size:3rem}
  .quote-alt-card h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:800}
  .quote-alt-card p{opacity:.92;line-height:1.8}
  @media(max-width:768px){.quote-grid{grid-template-columns:1fr}}
</style>

<section class="page-hero">
  <div class="container">
    <div class="page-hero-inner">
      <div class="page-hero-content">
        <nav class="breadcrumb">
          <a href="/">الرئيسية</a>
          <span>/</span>
          <a href="/cairo">خدماتنا في القاهرة</a>
          <span>/</span>
          <span class="current">شركة ماكينات تصوير في القاهرة</span>
        </nav>
        <h1 class="reveal">شركة ماكينات تصوير في القاهرة</h1>
        <p class="lead reveal delay-1">بيع وإيجار وصيانة ماكينات تصوير المستندات، وعقود إدارة أساطيل كاملة للشركات الكبرى، بخبرة 27 عامًا مع كبرى الماركات</p>
      </div>
      <div class="page-hero-image">
        <img src="/images/copier-scanning-office-1784572494919-541980.jpg" alt="شركة ماكينات تصوير في القاهرة" loading="eager">
      </div>
    </div>
  </div>
</section>

<section class="stats-section">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item reveal"><div class="stat-num" data-target="27" data-suffix="+">0+</div><div class="stat-label">سنة خبرة مع كبرى الماركات</div></div>
      <div class="stat-item reveal delay-1"><div class="stat-num" data-target="6">0</div><div class="stat-label">ماركات نتعامل معها بيعًا وصيانة</div></div>
      <div class="stat-item reveal delay-2"><div class="stat-num" data-target="4">0</div><div class="stat-label">خدمات في جهة واحدة: بيع وإيجار وصيانة وأحبار</div></div>
      <div class="stat-item reveal delay-3"><div class="stat-num" data-target="1">0</div><div class="stat-label">مندوب حساب واحد لكل أسطول</div></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="intro-text" style="max-width:900px;margin:0 auto 48px;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>ماكينة التصوير المتوقفة تعني إدارة كاملة متوقفة. نيو جولدن أوفيس شركة ماكينات تصوير في القاهرة تضمن ألا يحدث ذلك في مقرك: بيع ماكينات جديدة واستيراد بحالة ممتازة، إيجار بعقد شهري شامل، صيانة بفرق فنية ميدانية، وعقود إدارة أساطيل كاملة للشركات التي تشغل عشرات الماكينات في مقر واحد أو عدة طوابق. خبرة 27 عامًا مع كبرى الماركات: ريكو وكانون وكونيكا مينولتا وتوشيبا وزيروكس وكيوسيرا.</p>
      <p style="margin-top:16px">نتعامل مع شركات القاهرة بمنطق مختلف عن المحلات التجارية الفردية؛ فريقنا يفهم أن توقف ماكينة التصوير في يوم تسليم مشروع أو اجتماع مجلس إدارة له تكلفة تتجاوز بكثير سعر الإصلاح نفسه، لهذا نُصمم عقودنا لتضمن أولوية استجابة حقيقية، لا مجرد وعد تسويقي. سواء كان مقرك مكتبًا واحدًا أو مجمعًا إداريًا بعدة طوابق، نبني لك خطة صيانة تراعي طبيعة استخدامك الفعلي وحساسية توقيت أعمالك اليومية.</p>
      <p style="margin-top:16px;text-align:center">تعرف على <a href="/cairo">خدماتنا الشاملة في القاهرة</a> بكل تخصصاتنا الستة.</p>
    </div>

    <div class="section-header">
      <h2>صيانة ماكينات تصوير القاهرة وخدماتنا: بيع وإيجار وأحبار</h2>
      <div class="divider"></div>
    </div>
    <div class="services-grid">
      <div class="service-card reveal"><div class="service-icon"><i class="fas fa-cart-shopping"></i></div><h3 class="service-title">بيع ماكينات جديدة واستيراد</h3><p class="service-desc">مع ضمان معتمد وتركيب وتدريب، مبنية على حجم التصوير الشهري الفعلي لديك.</p><a href="/copiers/buy" class="btn btn-outline-primary btn-sm">ماكينات للبيع <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal delay-1"><div class="service-icon"><i class="fas fa-calendar-days"></i></div><h3 class="service-title">إيجار بعقد شهري</h3><p class="service-desc">تكلفة شهرية ثابتة تشمل الصيانة والقطع، مناسب للمشاريع الجديدة والفروع المؤقتة.</p></div>
      <div class="service-card reveal delay-2"><div class="service-icon"><i class="fas fa-screwdriver-wrench"></i></div><h3 class="service-title">صيانة وقطع غيار أصلية</h3><p class="service-desc">زيارات وقائية مجدولة وإصلاح ميداني بأولوية استجابة لعملاء العقود.</p><a href="/copiers/maintenance" class="btn btn-outline-primary btn-sm">صيانة الماكينات <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal delay-3"><div class="service-icon"><i class="fas fa-droplet"></i></div><h3 class="service-title">أحبار وتونر أصلي</h3><p class="service-desc">توريد دوري مجدول فلا يتوقف قسم بسبب خرطوشة فارغة.</p><a href="/copiers/cartridges" class="btn btn-outline-primary btn-sm">أحبار وخراطيش <i class="fas fa-arrow-left"></i></a></div>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>عقود صيانة أسطول ماكينات التصوير: تخصصنا الأعمق</h2>
      <div class="divider"></div>
    </div>
    <div class="intro-text" style="max-width:900px;margin:0 auto;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>مقرات الشركات الكبرى في القاهرة الجديدة وأبراج المكاتب في وسط البلد المالي لا تملك ماكينة واحدة بل أسطولًا كاملًا موزعًا على الإدارات والطوابق. إدارة هذا الأسطول بشكل فردي تستنزف وقت الإدارة وتترك ثغرات أعطال مفاجئة. عقد الأسطول معنا يحل الملف بالكامل.</p>
      <p style="margin-top:16px">بدلًا من أن يتصل كل قسم بمورد مختلف كلما تعطلت ماكينته، يصبح لديك مندوب حساب واحد يعرف موقع كل جهاز وتاريخ صيانته وحالته الفنية الحالية. هذا التنظيم يقلل بشكل ملحوظ عدد الأعطال المفاجئة لأن الصيانة الوقائية تُنفذ بجدول ثابت بدل الانتظار حتى يتوقف الجهاز عن العمل، ويمنح إدارة الشركة رؤية واضحة عن أداء الأسطول ككل بدل معلومات متناثرة بين الأقسام والفروع المختلفة.</p>
    </div>
    <div class="features-grid">
      <div class="feature-card reveal"><div class="feature-icon"><i class="fas fa-clipboard-list"></i></div><h4>حصر كامل للأسطول</h4><p>بحالته الفنية وعدادات التشغيل لكل جهاز على حدة.</p></div>
      <div class="feature-card reveal delay-1"><div class="feature-icon"><i class="fas fa-calendar-check"></i></div><h4>زيارات صيانة موحدة</h4><p>تغطي الأسطول كله بجدول واحد منسق مسبقًا.</p></div>
      <div class="feature-card reveal delay-2"><div class="feature-icon"><i class="fas fa-chart-line"></i></div><h4>تقارير دورية للإدارة</h4><p>حالة كل ماكينة، الأعطال المتكررة، وتوصيات الاستبدال المستقبلية.</p></div>
      <div class="feature-card reveal delay-3"><div class="feature-icon"><i class="fas fa-user-tie"></i></div><h4>مندوب حساب واحد</h4><p>مسؤول عن الأسطول كله بدلًا من التعامل مع موردين متفرقين لكل قسم أو فرع.</p></div>
    </div>
    <div class="reveal" style="max-width:900px;margin:32px auto 0;border-radius:var(--radius-lg);overflow:hidden">
      <img src="/images/webp-images/fiew-laser-printers-in-electronic-computer-store-2026-01-05-05-44-21-utc.webp" alt="عقود صيانة أسطول ماكينات التصوير بالقاهرة" loading="lazy" style="width:100%;height:340px;object-fit:cover;display:block">
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>الماركات التي نوفرها</h2>
      <div class="divider"></div>
    </div>
    <div style="overflow-x:auto;max-width:900px;margin:0 auto">
      <table style="width:100%;border-collapse:collapse;font-size:0.95rem">
        <thead><tr style="background:var(--green-dark);color:var(--white)"><th style="padding:14px 16px;text-align:right">الماركة</th><th style="padding:14px 16px;text-align:right">نقطة القوة الأبرز</th><th style="padding:14px 16px;text-align:right">الأنسب لمن</th></tr></thead>
        <tbody>
          <tr style="background:var(--white);border-bottom:1px solid #eee"><td style="padding:12px 16px">ريكو Ricoh</td><td style="padding:12px 16px">انتشار واسع وتكلفة تشغيل اقتصادية</td><td style="padding:12px 16px">أساطيل الشركات والاستخدام الكثيف</td></tr>
          <tr style="background:#f8f9fa;border-bottom:1px solid #eee"><td style="padding:12px 16px">كانون Canon</td><td style="padding:12px 16px">جودة ألوان قوية وسهولة استخدام</td><td style="padding:12px 16px">طباعة مواد عرض وتقارير ملونة</td></tr>
          <tr style="background:var(--white);border-bottom:1px solid #eee"><td style="padding:12px 16px">كونيكا مينولتا</td><td style="padding:12px 16px">إنتاجية عالية وأداء ألوان احترافي</td><td style="padding:12px 16px">أقسام التصوير كثيفة الاستخدام</td></tr>
          <tr style="background:#f8f9fa;border-bottom:1px solid #eee"><td style="padding:12px 16px">توشيبا e-STUDIO</td><td style="padding:12px 16px">موثوقية عالية وتحمل تشغيل طويل</td><td style="padding:12px 16px">الجهات الإدارية والتصوير الكثيف</td></tr>
          <tr style="background:var(--white);border-bottom:1px solid #eee"><td style="padding:12px 16px">زيروكس Xerox</td><td style="padding:12px 16px">حلول إدارة مستندات مؤسسية</td><td style="padding:12px 16px">منظومة إدارة مستندات متكاملة</td></tr>
          <tr style="background:#f8f9fa"><td style="padding:12px 16px">كيوسيرا Kyocera</td><td style="padding:12px 16px">تكلفة تشغيل منخفضة</td><td style="padding:12px 16px">أقل تكلفة للصفحة</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>موديلات وفئات ماكينات التصوير المتاحة في القاهرة</h2>
      <div class="divider"></div>
    </div>
    <p style="max-width:800px;margin:0 auto 24px;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">الأسعار في سوق ماكينات التصوير تتحرك مع سعر الصرف وتوافر الموديلات، لذلك لا ننشر أرقامًا قديمة تضللك، بل نرسل لك عرض سعر محدّث في يوم طلبك.</p>
    <div style="overflow-x:auto;max-width:900px;margin:0 auto">
      <table style="width:100%;border-collapse:collapse;font-size:0.95rem">
        <thead><tr style="background:var(--green-dark);color:var(--white)"><th style="padding:14px 16px;text-align:right">الفئة</th><th style="padding:14px 16px;text-align:right">السرعة التقريبية</th><th style="padding:14px 16px;text-align:right">الأنسب لمن</th></tr></thead>
        <tbody>
          <tr style="background:var(--white);border-bottom:1px solid #eee"><td style="padding:12px 16px">مكتبية مدمجة A4</td><td style="padding:12px 16px">حتى 25 نسخة في الدقيقة</td><td style="padding:12px 16px">المكاتب الصغيرة والعيادات والمحال</td></tr>
          <tr style="background:#f8f9fa;border-bottom:1px solid #eee"><td style="padding:12px 16px">إدارات متوسطة A3</td><td style="padding:12px 16px">25 إلى 35 نسخة في الدقيقة</td><td style="padding:12px 16px">الإدارات والشركات متوسطة الحجم</td></tr>
