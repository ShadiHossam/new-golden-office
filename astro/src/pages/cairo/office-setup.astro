---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://newgoldenoffice.com/cairo/office-setup#service",
      "url": "https://newgoldenoffice.com/cairo/office-setup",
      "name": "تجهيز مكتب أو فرع متكامل في القاهرة",
      "description": "تنسيق ست خدمات (طباعة، مستلزمات مكتبية، تكييفات، كاميرات مراقبة، ماكينات تصوير، ماكينات عد نقود) في مشروع تجهيز واحد للفروع والمكاتب الجديدة في القاهرة، بعقد وفاتورة ومندوب حساب واحد.",
      "serviceType": "تجهيز مكاتب وفروع متكامل",
      "areaServed": [
        {"@type":"City","name":"القاهرة"},
        {"@type":"Place","name":"التجمع الخامس"},
        {"@type":"Place","name":"مدينة نصر"},
        {"@type":"Place","name":"المعادي"},
        {"@type":"Place","name":"القاهرة الجديدة"},
        {"@type":"Place","name":"وسط البلد"}
      ],
      "provider": { "@id": "https://newgoldenoffice.com/#organization" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"هل لازم أطلب الست خدمات كلها مع بعض؟","acceptedAnswer":{"@type":"Answer","text":"لأ. تقدر تبدأ بأي مزيج تحتاجه (مثلاً تكييف وكاميرات بس، أو طباعة ومستلزمات بس)، وتضيف باقي الخدمات لاحقًا على نفس الحساب. المشروع بيتوسّع مع احتياجك، مش شرط يبدأ كامل من أول يوم."}},
        {"@type":"Question","name":"إزاي بيتحدد ترتيب تنفيذ الخدمات؟","acceptedAnswer":{"@type":"Answer","text":"في ترتيب منطقي بيحمي شغلك من إعادة العمل: التكييف والتمديدات الكهربائية أولًا (قبل ما تتقفل الحوائط أو يتركّب أي جهاز حساس)، بعدها تمديد كابلات الشبكة وتركيب كاميرات المراقبة، بعدها الأثاث والمستلزمات المكتبية وماكينات التصوير وعد النقود، وأخيرًا الطباعة والهوية البصرية (لافتات، كروت، أوراق رسمية) لأنها آخر حاجة بتتغير لو تأجل افتتاح أو اتغيرت تفاصيل."}},
        {"@type":"Question","name":"هل السعر بيبقى أوفر لو حجزت أكثر من خدمة مع بعض؟","acceptedAnswer":{"@type":"Answer","text":"غالبًا نعم. حجم التعاقد الأكبر بيدّينا مساحة نرشحلك فيها شروط أفضل، وبيوفر عليك وقت التفاوض المنفصل مع كل مورد. لكن السعر النهائي بيتحدد حسب مواصفات كل خدمة على حدة، فأرسل التفاصيل وهيوصلك عرض واحد شامل."}},
        {"@type":"Question","name":"مين المسؤول عن التنسيق بين الفرق المختلفة؟","acceptedAnswer":{"@type":"Answer","text":"مندوب حساب واحد بيتابع المشروع بالكامل من أول معاينة لآخر تسليم، وهو اللي بينسق بين فريق التكييف وفريق الكاميرات وباقي الفرق عشان الجدول الزمني ميتعارضش، بدل ما تتابع كل فريق لوحده."}},
        {"@type":"Question","name":"كم مدة تنفيذ مشروع تجهيز متكامل عادةً؟","acceptedAnswer":{"@type":"Answer","text":"بيعتمد على حجم المكان وعدد الخدمات المطلوبة، لكن كمتوسط: مكتب متوسط الحجم (يشمل تكييف وكاميرات ومستلزمات وطباعة هوية) بياخد من أسبوعين لأربع أسابيع من المعاينة للتسليم النهائي. بعد المعاينة هتوصلك خطة زمنية واضحة بمراحلها."}},
        {"@type":"Question","name":"هل ده نفس النظام لو المكتب موجود بالفعل وعايز تحديث جزء منه بس؟","acceptedAnswer":{"@type":"Answer","text":"نعم، بنفس الأسلوب لكن بحجم أصغر — سواء كنت بتوسّع فرع قائم، بتغيّر التكييفات القديمة، أو بتحدّث نظام المراقبة، بنعامله كمشروع منسق بنفس مندوب الحساب وبروح ترتيب التنفيذ نفسها."}}
      ]
    }
  ]
});
---

<BaseLayout
  title="تجهيز مكتب أو فرع متكامل في القاهرة — طباعة وتكييف وكاميرات ومستلزمات | نيو جولدن أوفيس"
  description="بتفتح فرع جديد أو بتجهّز مكتب من الصفر في القاهرة؟ ننسق التكييف والكاميرات والمستلزمات المكتبية وماكينات التصوير والعد والطباعة في مشروع واحد بعقد وفاتورة ومندوب حساب واحد."
  keywords="تجهيز مكتب متكامل القاهرة، تجهيز فرع جديد القاهرة، تأسيس مكتب القاهرة، تجهيز شركة جديدة القاهرة"
  ogTitle="تجهيز مكتب أو فرع متكامل في القاهرة | نيو جولدن أوفيس"
  ogDescription="ننسق ست خدمات تجهيز المكاتب في مشروع واحد بعقد وفاتورة ومندوب حساب واحد — القاهرة."
  ogImage="/images/about-team.webp"
  schemaJson={schemaJson}
>
<style>
  .quote-section{padding:60px 0}
  .quote-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:stretch}
  .quote-form-card{background:#fff;border-radius:18px;padding:2.2rem;box-shadow:0 4px 24px rgba(27,58,107,0.1)}
  .quote-form-card h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:700;color:var(--green-dark);margin-bottom:1.5rem}
  .form-group{margin-bottom:1.1rem}
  .form-group label{display:block;font-family:'Cairo',sans-serif;font-size:0.95rem;font-weight:600;color:var(--green-dark);margin-bottom:0.4rem}
  .form-group input,.form-group select,.form-group textarea{width:100%;padding:0.8rem 1rem;border:2px solid #e5eaf3;border-radius:10px;font-family:'Tajawal',sans-serif;font-size:1rem;color:#333;background:#fafbfd;transition:border-color .3s,box-shadow .3s;outline:none;box-sizing:border-box;direction:rtl}
  .form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--green-dark);box-shadow:0 0 0 3px rgba(27,58,107,.1);background:#fff}
  .form-group textarea{height:100px;resize:vertical}
  .checkbox-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .checkbox-item{display:flex;align-items:center;gap:8px;font-family:'Tajawal',sans-serif;font-size:0.92rem;color:#333}
  .checkbox-item input{width:auto}
  .form-submit-btn{width:100%;padding:1rem;background:linear-gradient(135deg,var(--green-dark),var(--green-mid));color:#fff;border:none;border-radius:12px;font-family:'Cairo',sans-serif;font-size:1.05rem;font-weight:700;cursor:pointer;transition:transform .3s,box-shadow .3s;display:flex;align-items:center;justify-content:center;gap:.5rem}
  .form-submit-btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(27,58,107,.25)}
  .success-message{display:none;background:linear-gradient(135deg,#e8f5e9,#f1f8e9);border:2px solid #4caf50;border-radius:12px;padding:1.5rem;text-align:center;margin-top:1rem}
  .success-message i{font-size:2.5rem;color:#4caf50;display:block;margin-bottom:.5rem}
  .success-message p{font-family:'Cairo',sans-serif;font-size:1.05rem;color:#2e7d32;font-weight:600}
  .quote-alt-card{background:linear-gradient(135deg,#25D366 0%,#128C7E 100%);border-radius:18px;padding:2.4rem;text-align:center;color:#fff;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:1rem}
  .quote-alt-card .wa-icon{font-size:3rem}
  .quote-alt-card h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:800}
  .quote-alt-card p{opacity:.92;line-height:1.8}
  @media(max-width:768px){.quote-grid{grid-template-columns:1fr}.checkbox-grid{grid-template-columns:1fr}}
</style>

<section class="page-hero">
  <div class="container">
    <div class="page-hero-inner">
      <div class="page-hero-content">
        <nav class="breadcrumb">
          <a href="/">الرئيسية</a>
          <span>/</span>
          <a href="/cairo">خدماتنا في القاهرة</a>
          <span>/</span>
          <span class="current">تجهيز مكتب متكامل</span>
        </nav>
        <h1 class="reveal">تجهيز مكتب أو فرع متكامل في القاهرة</h1>
        <p class="lead reveal delay-1">بتفتح فرع جديد أو بتجهّز مكتب من الصفر؟ ننسق التكييف والكاميرات والمستلزمات المكتبية وماكينات التصوير والعد والطباعة في مشروع واحد، بترتيب تنفيذ صح وعقد وفاتورة ومندوب حساب واحد يتابعك من المعاينة للتسليم</p>
      </div>
      <div class="page-hero-image">
        <img src="/images/webp-images/interior-of-empty-modern-office-with-desks-and-com-2026-01-09-08-28-40-utc.webp" alt="تجهيز مكتب متكامل في القاهرة" loading="eager">
      </div>
    </div>
  </div>
</section>

<section class="stats-section">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item reveal">
        <div class="stat-num" data-target="6">0</div>
        <div class="stat-label">خدمات تحت مشروع واحد</div>
      </div>
      <div class="stat-item reveal delay-1">
        <div class="stat-num" data-target="1">0</div>
        <div class="stat-label">مندوب حساب يتابع المشروع كامل</div>
      </div>
      <div class="stat-item reveal delay-2">
        <div class="stat-num" data-target="4">0</div>
        <div class="stat-label">مراحل تنفيذ مرتبة</div>
      </div>
      <div class="stat-item reveal delay-3">
        <div class="stat-num" data-target="1">0</div>
        <div class="stat-label">عقد وفاتورة واحدة للمشروع</div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="intro-text" style="max-width:900px;margin:0 auto 48px;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>لما تجهّز مكتب أو فرع جديد، أكبر مشكلة مش في اختيار الأجهزة — المشكلة في التنسيق: فريق التكييف بييجي قبل الكهربائي، فريق الكاميرات بيلاقي الحوائط اتقفلت، والمطبوعات بتتأخر لحد ما تتأكد من مقاس المكتب النهائي. نيو جولدن أوفيس بتاخد المشكلة دي منك: مندوب حساب واحد بيبني لك خطة تنفيذ مرحلية للست خدمات (تكييف، كاميرات مراقبة، مستلزمات مكتبية، ماكينات تصوير، ماكينات عد نقود، وطباعة) بترتيب صح من أول يوم، وعقد وفاتورة واحدة للمشروع كله.</p>
      <p style="margin-top:16px">الخدمة دي طبيعية جدًا بالنسبة لينا لأننا أصلًا بنقدم الست خدمات دي بشكل منفصل من سنين طويلة، فبقى عندنا خبرة عملية في كل واحدة منهم، والفرق الوحيد إننا بنجمعهم تحت إدارة واحدة لمشروعك بدل ما تتعامل مع كل قسم لوحده. ده بيوفر عليك وقت التفاوض المتكرر وبيضمن إن كل قرار بتاخده في خدمة بيراعي تأثيره على باقي الخدمات.</p>
    </div>

    <div class="section-header">
      <h2>الست خدمات اللي بتتنسق في مشروعك</h2>
      <div class="divider"></div>
    </div>
    <div class="services-grid">
      <div class="service-card reveal"><div class="service-icon"><i class="fas fa-snowflake"></i></div><h3 class="service-title">التكييفات</h3><p class="service-desc">أول مرحلة تنفيذ — قبل ما تتقفل الحوائط أو يتركّب أي جهاز حساس في المكان.</p><a href="/cairo/ac" class="btn btn-outline btn-sm">التفاصيل <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal delay-1"><div class="service-icon"><i class="fas fa-video"></i></div><h3 class="service-title">كاميرات المراقبة</h3><p class="service-desc">تمديد كابلات الشبكة وتركيب الكاميرات بعد التكييف مباشرة، مع ضبط زوايا التغطية.</p><a href="/cairo/cameras" class="btn btn-outline btn-sm">التفاصيل <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal delay-2"><div class="service-icon"><i class="fas fa-copy"></i></div><h3 class="service-title">ماكينات تصوير المستندات</h3><p class="service-desc">تركيب وتجهيز الأجهزة مع باقي معدات المكتب وضبط إعدادات الشبكة الداخلية.</p><a href="/cairo/copiers" class="btn btn-outline btn-sm">التفاصيل <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal delay-3"><div class="service-icon"><i class="fas fa-pen-ruler"></i></div><h3 class="service-title">الأدوات والمستلزمات المكتبية</h3><p class="service-desc">توريد أول دفعة تجهيز كاملة مع بدء عقد التوريد الدوري الشهري.</p><a href="/cairo/office-supplies" class="btn btn-outline btn-sm">التفاصيل <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal"><div class="service-icon"><i class="fas fa-money-bill-wave"></i></div><h3 class="service-title">ماكينات عد النقود</h3><p class="service-desc">للفروع اللي بتتعامل نقدي، بتتركب وتُختبر مع باقي معدات الفرع.</p><a href="/cairo/cash-machines" class="btn btn-outline btn-sm">التفاصيل <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal delay-1"><div class="service-icon"><i class="fas fa-print"></i></div><h3 class="service-title">الطباعة والهوية البصرية</h3><p class="service-desc">آخر مرحلة عمدًا — بعد ما تتأكد من كل تفاصيل الفرع النهائية.</p><a href="/cairo/printing" class="btn btn-outline btn-sm">التفاصيل <i class="fas fa-arrow-left"></i></a></div>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>إزاي بيتم تنفيذ مشروع تجهيز متكامل؟</h2>
      <div class="divider"></div>
    </div>
    <div class="steps-grid">
      <div class="step-card reveal">
        <div class="step-num">1</div>
        <h4>معاينة شاملة</h4>
        <p>مندوب حسابك ييجي يعاين المكان، يشوف القدرة الكهربائية، توزيع المساحة، ونقاط التركيب المطلوبة لكل خدمة.</p>
      </div>
      <div class="step-card reveal delay-1">
        <div class="step-num">2</div>
        <h4>خطة تنفيذ مرحلية</h4>
        <p>يوصلك جدول زمني واضح بترتيب المراحل: التكييف والكهرباء، بعدين الشبكة والكاميرات، بعدين الأثاث والمستلزمات، وأخيرًا الطباعة والهوية.</p>
      </div>
      <div class="step-card reveal delay-2">
        <div class="step-num">3</div>
        <h4>تنفيذ منسّق</h4>
        <p>كل فريق بييجي في موعده المحدد من غير تعارض مع فريق تاني، ومندوب حسابك بيتابع كل مرحلة.</p>
      </div>
      <div class="step-card reveal delay-3">
        <div class="step-num">4</div>
        <h4>تسليم واحد وضمان موحد</h4>
        <p>تستلم المكتب جاهز بالكامل، بعقد وفاتورة وضمان موحد لكل الخدمات، مش أوراق متفرقة من ست جهات.</p>
      </div>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>إيه اللي بيحدد سعر مشروع التجهيز المتكامل؟</h2>
      <div class="divider"></div>
    </div>
    <div class="intro-text" style="max-width:900px;margin:0 auto;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <ul style="max-width:700px;margin:0 auto;padding-inline-start:20px;line-height:2.1">
        <li><strong>مساحة المكتب:</strong> عدد الغرف والمساحة الكلية بيحددوا عدد وحدات التكييف وعدد الكاميرات المطلوبة.</li>
        <li><strong>عدد الموظفين والمستخدمين:</strong> بيأثر على كمية المستلزمات المكتبية وعدد ماكينات التصوير المطلوبة.</li>
        <li><strong>طبيعة النشاط:</strong> فرع بنكي محتاج ماكينات عد نقود وكشف تزييف، أما مكتب استشارات محتاج تركيز أكبر على الطباعة والهوية البصرية.</li>
        <li><strong>عدد الفروع:</strong> لو المشروع بيغطي أكتر من فرع بنفس المواصفات، بيفتح باب أسعار جملة أفضل.</li>
        <li><strong>الجدول الزمني المطلوب:</strong> التنفيذ العاجل (لموعد افتتاح قريب) بياخد أولوية جدولة مختلفة عن مشروع بجدول مرن.</li>
        <li><strong>مستوى التخصيص:</strong> طلبات خاصة زي هوية بصرية مصممة خصيصًا أو نظام مراقبة بمواصفات أعلى من المعتاد بتُحسب كبند إضافي واضح في العرض.</li>
      </ul>
      <p style="margin-top:20px;text-align:center">أرسل تفاصيل مشروعك على 01227392074 أو من نموذج التواصل تحت، ومندوب حسابك هيرجعلك بخطة وعرض سعر مفصل خلال يوم عمل.</p>
    </div>
  </div>
</section>

<MidPageCTA formId="cairoSetupMidCta" />

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>ليه تختار نيو جولدن أوفيس لمشروع التجهيز بتاعك؟</h2>
      <div class="divider"></div>
    </div>
    <div class="features-grid">
      <div class="feature-card reveal"><div class="feature-icon"><i class="fas fa-history"></i></div><h4>27 سنة خبرة حقيقية</h4><p>مش بس في بيع المعدات، لكن في تنفيذ مشاريع تجهيز فعلية لمكاتب وفروع بكل تفاصيلها من عام 1999 وحتى اليوم.</p></div>
      <div class="feature-card reveal delay-1"><div class="feature-icon"><i class="fas fa-layer-group"></i></div><h4>ست خدمات من جهة واحدة</h4><p>مش محتاج تدور على مورد منفصل لكل خدمة، وكل حاجة بتتنسق تحت مندوب حساب واحد يعرف تفاصيل مشروعك بالكامل من أول لحظة تواصل.</p></div>
      <div class="feature-card reveal delay-2"><div class="feature-icon"><i class="fas fa-clipboard-check"></i></div><h4>خطة تنفيذ مكتوبة وواضحة</h4><p>مش وعود شفهية — بتوصلك خطة زمنية مكتوبة بمراحلها وتكلفتها قبل ما تاخد أي قرار نهائي بالتعاقد.</p></div>
      <div class="feature-card reveal delay-3"><div class="feature-icon"><i class="fas fa-headset"></i></div><h4>متابعة بعد التسليم</h4><p>مندوب حسابك بيفضل نقطة التواصل بتاعتك لأي احتياج لاحق، مش بس لحد ما تستلم المفتاح وخلاص، وده بيوفر عليك وقت كبير في أي طلب مستقبلي.</p></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>لمين الخدمة دي؟</h2>
      <div class="divider"></div>
    </div>
    <div class="features-grid">
