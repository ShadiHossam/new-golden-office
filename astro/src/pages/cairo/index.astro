---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://newgoldenoffice.com/cairo#service",
      "name": "خدمات نيو جولدن أوفيس في القاهرة",
      "serviceType": "خدمات تجهيز وصيانة المكاتب والشركات",
      "url": "https://newgoldenoffice.com/cairo",
      "areaServed": { "@type": "City", "name": "القاهرة" },
      "provider": { "@id": "https://newgoldenoffice.com/#organization" },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "فئات الخدمة في القاهرة",
        "itemListElement": [
          {"@type":"Offer","itemOffered":{"@type":"Service","name":"خدمات الطباعة للشركات في القاهرة","url":"https://newgoldenoffice.com/cairo/printing"}},
          {"@type":"Offer","itemOffered":{"@type":"Service","name":"توريد المستلزمات المكتبية للشركات بالقاهرة","url":"https://newgoldenoffice.com/cairo/office-supplies"}},
          {"@type":"Offer","itemOffered":{"@type":"Service","name":"خدمات التكييفات في القاهرة","url":"https://newgoldenoffice.com/cairo/ac"}},
          {"@type":"Offer","itemOffered":{"@type":"Service","name":"خدمات كاميرات المراقبة في القاهرة","url":"https://newgoldenoffice.com/cairo/cameras"}},
          {"@type":"Offer","itemOffered":{"@type":"Service","name":"خدمات ماكينات التصوير في القاهرة","url":"https://newgoldenoffice.com/cairo/copiers"}},
          {"@type":"Offer","itemOffered":{"@type":"Service","name":"ماكينات عد النقود في القاهرة","url":"https://newgoldenoffice.com/cairo/cash-machines"}}
        ]
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://newgoldenoffice.com/cairo#faq",
      "mainEntity": [
        {"@type":"Question","name":"كيف تخدمون القاهرة بدون فرع فيها؟","acceptedAnswer":{"@type":"Answer","text":"بنظام تشغيل مصمم خصيصًا لذلك: مسارات تسليم مجدولة تغطي مناطق القاهرة التجارية بانتظام، وفرق تركيب وصيانة ميدانية متنقلة مجهزة بالكامل، ومندوب حساب مخصص يدير علاقتك معنا من البداية للنهاية. عملاؤنا في القاهرة يحصلون على مستوى الخدمة الكامل نفسه، والخدمة تأتي إليك بدل أن تذهب أنت إلى فرع."}},
        {"@type":"Question","name":"ما المناطق التي تغطونها داخل القاهرة؟","acceptedAnswer":{"@type":"Answer","text":"نغطي مناطق الأعمال الرئيسية: التجمع الخامس، مدينة نصر، المعادي، القاهرة الجديدة، ووسط البلد المالي. إذا كان مقرك في منطقة أخرى تواصل معنا وسنؤكد لك ترتيبات الخدمة."}},
        {"@type":"Question","name":"هل يمكن التعاقد على أكثر من خدمة معًا؟","acceptedAnswer":{"@type":"Answer","text":"نعم. لو بتجهّز مكتب أو فرع جديد بالكامل، عندنا صفحة مخصصة توضح كيف ننسق الست خدمات في مشروع واحد بعقد وفاتورة ومندوب حساب واحد: newgoldenoffice.com/cairo/office-setup"}},
        {"@type":"Question","name":"هل تقدمون فاتورة ضريبية وعقود توريد للشركات والمؤسسات؟","acceptedAnswer":{"@type":"Answer","text":"نعم. نعمل مع الشركات والمؤسسات بنظام عقود توريد دورية وفواتير ضريبية رسمية، وهو النظام الأنسب للجهات التي تحتاج مستندات محاسبية منتظمة ومورّدًا معتمدًا."}},
        {"@type":"Question","name":"لماذا لا تنشرون أسعارًا ثابتة وكيف أحصل على عرض سعر؟","acceptedAnswer":{"@type":"Answer","text":"لأن التكلفة الفعلية تختلف حسب المواصفات والكمية والماركة ونطاق الخدمة. نبني عرض السعر على احتياجك الفعلي: تواصل معنا واذكر المطلوب، ويصلك عرض واضح ببنود مكتوبة قبل أي التزام."}},
        {"@type":"Question","name":"هل تقدمون عقود صيانة سنوية؟","acceptedAnswer":{"@type":"Answer","text":"نعم، للتكييفات وماكينات التصوير وأنظمة كاميرات المراقبة وماكينات عد النقود. العقد السنوي يشمل زيارات دورية مجدولة تكتشف الأعطال مبكرًا، وهو الخيار الأوفر مقارنة بالإصلاحات الطارئة المتفرقة."}},
        {"@type":"Question","name":"ما الماركات التي تتعاملون معها؟","acceptedAnswer":{"@type":"Answer","text":"نورد ماركات موثوقة في كل فئة: مثل ريكو وكانون وكونيكا مينولتا وتوشيبا في ماكينات التصوير، وجلوري وLG وكاسيدا في ماكينات عد النقود، مع ترشيح الأنسب لحجم عملك لا الأغلى سعرًا."}},
        {"@type":"Question","name":"كيف تحددون مواعيد التسليم والصيانة؟","acceptedAnswer":{"@type":"Answer","text":"بالاتفاق المسبق: مندوب حسابك ينسق معك موعدًا محددًا ضمن مسارات الخدمة المجدولة لمنطقتك. وللطلبات الدورية، مثل توريد المستلزمات، تُثبّت مواعيد منتظمة تناسب دورة عمل شركتك."}}
      ]
    }
  ]
});
---

<BaseLayout
  title="خدماتنا في القاهرة، طباعة ومستلزمات وتكييفات | نيو جولدن أوفيس"
  description="خدماتنا في القاهرة: طباعة، مستلزمات مكتبية، تكييفات، كاميرات مراقبة، ماكينات تصوير وعد نقود. خبرة 27 عامًا وتغطية كاملة لمناطق الأعمال. اطلب عرض سعر."
  keywords="خدماتنا في القاهرة، شركة نيو جولدن أوفيس بالقاهرة، خدمات متكاملة للشركات القاهرة"
  ogTitle="خدماتنا في القاهرة | نيو جولدن أوفيس"
  ogDescription="خدماتنا في القاهرة: طباعة، مستلزمات مكتبية، تكييفات، كاميرات مراقبة، ماكينات تصوير وعد نقود. خبرة 27 عامًا وتغطية كاملة لمناطق الأعمال."
  ogImage="/images/about-team.webp"
  schemaJson={schemaJson}
>
<style>
  .quote-section{padding:60px 0}
  .quote-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:stretch}
  .quote-form-card{background:#fff;border-radius:18px;padding:2.2rem;box-shadow:0 4px 24px rgba(27,58,107,0.1)}
  .quote-form-card h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:700;color:var(--green-dark);margin-bottom:1.5rem}
  .form-group{margin-bottom:1.1rem}
  .form-group label{display:block;font-family:'Cairo',sans-serif;font-size:0.95rem;font-weight:600;color:var(--green-dark);margin-bottom:0.4rem}
  .form-group input,.form-group select,.form-group textarea{width:100%;padding:0.8rem 1rem;border:2px solid #e5eaf3;border-radius:10px;font-family:'Tajawal',sans-serif;font-size:1rem;color:#333;background:#fafbfd;transition:border-color .3s,box-shadow .3s;outline:none;box-sizing:border-box;direction:rtl}
  .form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--green-dark);box-shadow:0 0 0 3px rgba(27,58,107,.1);background:#fff}
  .form-group textarea{height:100px;resize:vertical}
  .form-submit-btn{width:100%;padding:1rem;background:linear-gradient(135deg,var(--green-dark),var(--green-mid));color:#fff;border:none;border-radius:12px;font-family:'Cairo',sans-serif;font-size:1.05rem;font-weight:700;cursor:pointer;transition:transform .3s,box-shadow .3s;display:flex;align-items:center;justify-content:center;gap:.5rem}
  .form-submit-btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(27,58,107,.25)}
  .success-message{display:none;background:linear-gradient(135deg,#e8f5e9,#f1f8e9);border:2px solid #4caf50;border-radius:12px;padding:1.5rem;text-align:center;margin-top:1rem}
  .success-message i{font-size:2.5rem;color:#4caf50;display:block;margin-bottom:.5rem}
  .success-message p{font-family:'Cairo',sans-serif;font-size:1.05rem;color:#2e7d32;font-weight:600}
  .quote-alt-card{background:linear-gradient(135deg,#25D366 0%,#128C7E 100%);border-radius:18px;padding:2.4rem;text-align:center;color:#fff;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:1rem}
  .quote-alt-card .wa-icon{font-size:3rem}
  .quote-alt-card h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:800}
  .quote-alt-card p{opacity:.92;line-height:1.8}
  @media(max-width:768px){.quote-grid{grid-template-columns:1fr}}
</style>

<section class="page-hero">
  <div class="container">
    <div class="page-hero-inner">
      <div class="page-hero-content">
        <nav class="breadcrumb">
          <a href="/">الرئيسية</a>
          <span>/</span>
          <span class="current">خدماتنا في القاهرة</span>
        </nav>
        <h1 class="reveal">خدماتنا في القاهرة</h1>
        <p class="lead reveal delay-1">تغطية خدمة كاملة للشركات في القاهرة: طباعة، مستلزمات مكتبية، تكييفات، كاميرات مراقبة، ماكينات تصوير، وماكينات عد نقود، بمسارات تسليم مجدولة ومندوب حساب مخصص لكل عميل</p>
      </div>
      <div class="page-hero-image">
        <img src="/images/webp-images/cityscape-of-cairo-2026-03-25-06-11-05-utc.webp" alt="خدماتنا في القاهرة" loading="eager">
      </div>
    </div>
  </div>
</section>

<section class="stats-section">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item reveal">
        <div class="stat-num" data-target="27" data-suffix="+">0+</div>
        <div class="stat-label">سنة خبرة في السوق المصري</div>
      </div>
      <div class="stat-item reveal delay-1">
        <div class="stat-num" data-target="6">0</div>
        <div class="stat-label">فئات خدمة متكاملة</div>
      </div>
      <div class="stat-item reveal delay-2">
        <div class="stat-num" data-target="5">0</div>
        <div class="stat-label">مناطق أعمال رئيسية نغطيها</div>
      </div>
      <div class="stat-item reveal delay-3">
        <div class="stat-num" data-target="1">0</div>
        <div class="stat-label">مندوب حساب مخصص لكل عميل</div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="intro-text" style="max-width:900px;margin:0 auto 48px;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>تبحث عن مورد واحد موثوق يغطي كل احتياجات مكتبك؟ خدماتنا في القاهرة تمنحك ذلك بالضبط. شركة نيو جولدن أوفيس تقدم للشركات في القاهرة تغطية خدمة كاملة تشمل ست فئات: الطباعة، المستلزمات المكتبية، التكييفات، كاميرات المراقبة، ماكينات التصوير، وماكينات عد النقود. خبرة 27 عامًا في تجهيز وخدمة المكاتب والشركات، وفرق ميدانية متنقلة تصل إلى مقرك في التجمع الخامس ومدينة نصر والمعادي والقاهرة الجديدة ووسط البلد المالي، ومندوب حساب مخصص يتابع طلباتك من أول اتصال حتى ما بعد التسليم. مورد واحد، فاتورة واحدة، مسؤولية واحدة.</p>
      <p style="margin-top:16px">نتعامل مع شركات القاهرة بنفس مستوى الجدية الذي نتعامل به مع عملاء الإسكندرية منذ 1999، بغض النظر عن عدم وجود فرع فعلي في المدينة. الفارق الحقيقي في تجربة العميل يأتي من انضباط المواعيد ووضوح التعامل، لا من قرب المسافة الجغرافية وحدها، وهذا ما نحرص على إثباته مع كل عميل جديد في القاهرة.</p>
    </div>

    <div class="section-header">
      <h2>نخدم القاهرة بنظام تشغيل محكم، لا بكثرة الفروع</h2>
      <div class="divider"></div>
    </div>
    <div class="intro-text" style="max-width:900px;margin:0 auto;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>نموذج عملنا في القاهرة مبني على الكفاءة: مسارات تسليم مجدولة تغطي مناطق الأعمال الرئيسية بانتظام، وفرق تركيب وصيانة متنقلة مجهزة بالكامل بالعدد وقطع الغيار، ومندوب حساب مخصص لكل عميل شركات يعرف تاريخ طلباتك واحتياجاتك بالاسم. هذا النموذج ليس بديلًا عن فرع، بل هو اختيار تشغيلي واعٍ: بدلًا من أن ينتظر العميل موعدًا يناسب الفرع، تتحرك الخدمة نحو العميل بمواعيد متفق عليها مسبقًا. النتيجة التي يلمسها عملاؤنا في القاهرة: مرونة أعلى في المواعيد، واستجابة أسرع للطلبات الدورية، وأسعار تنافسية لأننا لا نحمّل عقودنا تكاليف تشغيل إضافية لا يستفيد منها العميل.</p>
      <p style="margin-top:16px">هذا النهج أثبت نجاحه مع عشرات الشركات في القاهرة التي كانت تتعامل سابقًا مع موردين متعددين لكل خدمة على حدة، ثم انتقلت لنظامنا الموحد ووجدت أن التوفير الحقيقي لا يأتي فقط من السعر، بل من الوقت الإداري الذي كان يُهدر في التنسيق بين جهات متفرقة.</p>
      <p style="margin-top:16px">نتعامل مع كل عميل جديد في القاهرة بنفس الشفافية: نشرح لك مسبقًا آلية العمل ومواعيد التسليم المتوقعة، ولا نعِد بما لا نستطيع تنفيذه، لأن سمعتنا الممتدة منذ 1999 بُنيت على الالتزام لا الوعود الفارغة.</p>
      <p style="margin-top:16px">كل مندوب حساب لدينا مسؤول عن عدد محدود من العملاء عمدًا، حتى يتمكن من متابعة تفاصيل كل شركة بدقة بدل التعامل مع عدد كبير جدًا من الحسابات دون اهتمام حقيقي بالتفاصيل.</p>
      <p style="margin-top:16px">نراجع أيضًا بشكل دوري رضا عملائنا في القاهرة عن مستوى الخدمة، ونستخدم هذه الملاحظات لتحسين مساراتنا وجدولة زياراتنا باستمرار.</p>
      <p style="margin-top:16px">نهدف دائمًا لأن تكون تجربتك الأولى معنا في القاهرة بداية علاقة طويلة، لا صفقة واحدة، وهذا ما ينعكس في طريقة تعاملنا مع أصغر التفاصيل.</p>
      <p style="margin-top:16px">بالإضافة إلى الخدمات الست الأساسية، نساعد الشركات التي تفتتح فرعًا جديدًا في القاهرة أو تُجهّز مكتبًا من الصفر عبر تنسيق كل هذه الخدمات في مشروع واحد بترتيب تنفيذ صحيح، بدل التعامل مع ست جهات منفصلة قد تتعارض مواعيدها مع بعضها البعض.</p>
      <p style="margin-top:16px">وخلف هذا النموذج تقف خبرة 27 عامًا في السوق المصري. نعرف كيف تشتري الشركات، وما الذي يعطل مكتبًا عن العمل، وما الفرق بين مورد يبيع منتجًا ومورد يتحمل مسؤولية تشغيل كاملة. هذه الخبرة هي ما نضعه في كل عقد توريد وكل زيارة صيانة داخل القاهرة.</p>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>شركة نيو جولدن أوفيس بالقاهرة: ست فئات متكاملة لتجهيز شركتك</h2>
      <div class="divider"></div>
    </div>
    <div class="services-grid">
      <div class="service-card reveal">
        <div class="service-icon"><i class="fas fa-print"></i></div>
        <h3 class="service-title">الطباعة والدعاية للشركات</h3>
        <p class="service-desc">كروت شخصية، أوراق رسمية، فولدرات، بروشورات وفلايرات بجودة تليق بعلامتك التجارية. أوفست للكميات الكبيرة وديجيتال للكميات السريعة، مع بروفة قبل التنفيذ.</p>
        <a href="/cairo/printing" class="btn btn-outline btn-sm">خدمات الطباعة للشركات في القاهرة <i class="fas fa-arrow-left"></i></a>
      </div>

      <div class="service-card reveal delay-1">
        <div class="service-icon"><i class="fas fa-pen-ruler"></i></div>
        <h3 class="service-title">الأدوات والمستلزمات المكتبية</h3>
        <p class="service-desc">توريد دوري لكل مستلزمات المكتب: أوراق، أقلام، ملفات، دفاتر، أدوات أرشفة وأحبار، بعقود توريد دورية وفاتورة ضريبية.</p>
        <a href="/cairo/office-supplies" class="btn btn-outline btn-sm">توريد المستلزمات المكتبية بالقاهرة <i class="fas fa-arrow-left"></i></a>
      </div>

      <div class="service-card reveal delay-2">
        <div class="service-icon"><i class="fas fa-snowflake"></i></div>
        <h3 class="service-title">التكييفات: بيع وتركيب وصيانة</h3>
        <p class="service-desc">من السبليت إلى الحلول المركزية، مع ترشيح القدرة المناسبة وعقود صيانة سنوية تواجه أجواء القاهرة المغبرة.</p>
        <a href="/cairo/ac" class="btn btn-outline btn-sm">خدمات شركة التكييفات في القاهرة <i class="fas fa-arrow-left"></i></a>
      </div>

      <div class="service-card reveal delay-3">
        <div class="service-icon"><i class="fas fa-video"></i></div>
        <h3 class="service-title">كاميرات المراقبة وأنظمة الأمان</h3>
        <p class="service-desc">معاينة، توريد، تركيب، برمجة، وصيانة، مع حلول مشاهدة عن بُعد تناسب أصحاب الفروع المتعددة الذين يديرون أعمالهم من مكان واحد.</p>
        <a href="/cairo/cameras" class="btn btn-outline btn-sm">خدمات كاميرات المراقبة في القاهرة <i class="fas fa-arrow-left"></i></a>
      </div>

      <div class="service-card reveal">
        <div class="service-icon"><i class="fas fa-copy"></i></div>
        <h3 class="service-title">ماكينات تصوير المستندات</h3>
        <p class="service-desc">بيع وصيانة لماركات موثوقة مثل ريكو وكانون وكونيكا مينولتا وتوشيبا، مع عقود صيانة لأساطيل الماكينات في مقرات الشركات الكبرى.</p>
        <a href="/cairo/copiers" class="btn btn-outline btn-sm">خدمات ماكينات التصوير في القاهرة <i class="fas fa-arrow-left"></i></a>
      </div>

      <div class="service-card reveal delay-1">
        <div class="service-icon"><i class="fas fa-money-bill-wave"></i></div>
        <h3 class="service-title">ماكينات عد النقود وكشف التزييف</h3>
        <p class="service-desc">لماركات عالمية مثل جلوري وLG وكاسيدا، مرشحة حسب حجم التعامل النقدي اليومي، مع تدريب وصيانة وقطع غيار أصلية.</p>
        <a href="/cairo/cash-machines" class="btn btn-outline btn-sm">ماكينات عد النقود في القاهرة <i class="fas fa-arrow-left"></i></a>
