<script is:inline>
  (function () {
    var form = document.getElementById('quoteForm');
    if (!form) return;
    var WA_NUMBER = '201227392074';
    var SERVICE_LABELS = {
      'printing': 'خدمات الطباعة',
      'copiers': 'ماكينات التصوير والطباعة',
      'cameras': 'كاميرات المراقبة',
      'ac': 'أجهزة التكييف',
      'cash-machines': 'ماكينات فرز وعد النقود',
      'office-supplies': 'المستلزمات المكتبية',
      'office-setup': 'تجهيز مكتب متكامل',
      'other': 'استفسار عام / خدمة أخرى'
    };
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var successMsg = document.getElementById('quoteSuccessMessage');
      var name = document.getElementById('q-name').value.trim();
      var phone = document.getElementById('q-phone').value.trim();
      var companyEl = document.getElementById('q-company');
      var company = companyEl ? companyEl.value.trim() : '';
      var hiddenService = form.querySelector('input[name="service"]');
      var selectService = document.getElementById('q-service');
      var serviceCode = hiddenService ? hiddenService.value : (selectService ? selectService.value : '');
      var serviceLabel = SERVICE_LABELS[serviceCode] || serviceCode;
      var subserviceEl = document.getElementById('q-subservice');
      var subservice = subserviceEl ? subserviceEl.value.trim() : '';
      var messageEl = document.getElementById('q-message');
      var message = messageEl ? messageEl.value.trim() : '';
      var extraChecked = form.querySelectorAll('input[name="services[]"]:checked');
      var extraServices = [];
      for (var i = 0; i < extraChecked.length; i++) {
        extraServices.push(SERVICE_LABELS[extraChecked[i].value] || extraChecked[i].value);
      }
      var lines = [
        'مرحبًا، اسمي ' + name + ' (' + phone + ')',
        company ? 'اسم الشركة: ' + company : null,
        'الخدمة المطلوبة: ' + serviceLabel,
        subservice ? 'تفاصيل الطلب: ' + subservice : null,
        extraServices.length ? 'خدمات إضافية مطلوبة: ' + extraServices.join('، ') : null,
        message ? 'رسالتي: ' + message : null
      ].filter(Boolean);
      var text = encodeURIComponent(lines.join('\n'));
      window.open('https://wa.me/' + WA_NUMBER + '?text=' + text, '_blank');
      form.style.display = 'none';
      successMsg.style.display = 'block';
    });
  })();
</script>
