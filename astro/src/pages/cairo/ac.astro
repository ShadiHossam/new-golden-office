---
import Img from '../../components/Img.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://newgoldenoffice.com/cairo/ac#service",
      "name": "شراء وتركيب وصيانة تكييفات في القاهرة",
      "serviceType": "تركيب وصيانة وإصلاح تكييفات وشحن فريون للشركات",
      "url": "https://newgoldenoffice.com/cairo/ac",
      "areaServed": [
        {"@type":"Place","name":"التجمع الخامس، القاهرة"},
        {"@type":"Place","name":"مدينة نصر، القاهرة"},
        {"@type":"Place","name":"المعادي، القاهرة"},
        {"@type":"Place","name":"القاهرة الجديدة"},
        {"@type":"Place","name":"وسط البلد، القاهرة"}
      ],
      "provider": { "@id": "https://newgoldenoffice.com/#organization" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"كم تكلفة تركيب تكييف 1.5 حصان في القاهرة؟","acceptedAnswer":{"@type":"Answer","text":"التكلفة تعتمد على الماركة والموديل وطول المواسير والدور وصعوبة الوصول وأي أعمال كهرباء إضافية. نقدم عرض سعر رسميًا مفصل البنود بعد معرفة تفاصيل الموقع."}},
        {"@type":"Question","name":"ما التكييف المناسب لمساحة مكتبي؟","acceptedAnswer":{"@type":"Answer","text":"القدرة تُحسب من المساحة وارتفاع السقف وعدد الأفراد واتجاه الشمس والدور. نرشح القدرة بعد معاينة أو مراجعة دقيقة لتفاصيل المكان."}},
        {"@type":"Question","name":"كم مرة يجب صيانة التكييف في القاهرة؟","acceptedAnswer":{"@type":"Answer","text":"بوتيرة أعلى من المدن الساحلية بسبب الغبار والأتربة، خاصة في مواسم العواصف الترابية وللمكاتب القريبة من مناطق الإنشاءات."}},
        {"@type":"Question","name":"كم تكلفة شحن الفريون وكم مرة يحتاجها التكييف؟","acceptedAnswer":{"@type":"Answer","text":"الجهاز السليم لا يحتاج شحن فريون دوريًا، فنقص الفريون علامة تسريب يجب إصلاحه أولًا."}},
        {"@type":"Question","name":"هل تقدمون عقد صيانة سنويًا وكم سعره؟","acceptedAnswer":{"@type":"Answer","text":"نعم، عقود صيانة سنوية تشمل زيارات دورية مجدولة وتقارير حالة مكتوبة وأولوية استجابة للأعطال. السعر يحدد حسب عدد الوحدات ووتيرة الزيارات."}},
        {"@type":"Question","name":"كم يستغرق التركيب وهل تصلحون الأعطال بسرعة؟","acceptedAnswer":{"@type":"Answer","text":"تركيب الوحدة الواحدة ينجز عادة في زيارة واحدة. عملاء عقود الصيانة يحصلون على أولوية استجابة للأعطال."}},
        {"@type":"Question","name":"هل قطع الغيار أصلية وما مدة الضمان؟","acceptedAnswer":{"@type":"Answer","text":"نستخدم قطع غيار أصلية مطابقة لمواصفات الجهاز مع فاتورة رسمية، ونقدم ضمانًا مكتوبًا على التركيب والإصلاح."}},
        {"@type":"Question","name":"هل تغطون كل أحياء القاهرة؟","acceptedAnswer":{"@type":"Answer","text":"نغطي التجمع الخامس ومدينة نصر والمعادي والقاهرة الجديدة ووسط البلد المالي ومصر الجديدة والشيخ زايد بفرق ميدانية متنقلة ومسارات مجدولة."}},
        {"@type":"Question","name":"هل التكييف المركزي يستهلك كهرباء أكثر من السبليت؟","acceptedAnswer":{"@type":"Answer","text":"المقارنة ليست مطلقة؛ المركزي المصمم جيدًا لمساحة مفتوحة قد يكون أكفأ، والحكم الصحيح يأتي من دراسة المساحة قبل الشراء."}},
        {"@type":"Question","name":"ما الفرق بين تكييف الانفرتر والتكييف العادي وأيهما أنسب للمكاتب؟","acceptedAnswer":{"@type":"Answer","text":"العادي يعمل بسرعة ثابتة يفصلها ويوصلها بالتبادل، والانفرتر يعدّل سرعة الكمبروسر باستمرار حسب الحمل الفعلي، فيعطي استهلاك كهرباء أقل وتبريدًا أكثر ثباتًا وضجيجًا أقل. سعر الشراء أعلى لكن التوفير في فاتورة الكهرباء غالبًا يعوّضه خلال موسمين إلى ثلاثة مواسم تشغيل مكثف."}},
        {"@type":"Question","name":"كيف أحسب قدرة التكييف بالحصان تقريبيًا بنفسي؟","acceptedAnswer":{"@type":"Answer","text":"قاعدة تقريبية: كل حصان يبرد بارتياح 12 إلى 15 مترًا مربعًا في غرفة عادية الارتفاع بلا حمل حراري زائد، لكن الرقم يتغير مع ارتفاع السقف وعدد الأجهزة والأشخاص واتجاه الشمس والدور، والرقم النهائي نؤكده بعد مراجعة تفاصيل موقعك."}},
        {"@type":"Question","name":"متى يكون الأنسب استبدال التكييف القديم بدل إصلاحه؟","acceptedAnswer":{"@type":"Answer","text":"إذا تجاوز عمر الجهاز 8 إلى 10 سنوات وتكرر العطل أكثر من مرتين في نفس الموسم، أو صار الإصلاح المطلوب يقارب نصف سعر جهاز جديد، الاستبدال عادة أوفر على المدى المتوسط."}}
      ]
    }
  ]
});
---

<BaseLayout
  title="شركة تكييفات في القاهرة | تركيب وصيانة بضمان"
  description="شركة تكييفات في القاهرة بخبرة 27 عامًا: شراء وتركيب وصيانة وإصلاح وشحن فريون للشركات والمكاتب، عقود صيانة سنوية تغطي أحياء القاهرة. اطلب عرض سعر الآن."
  keywords="شركة تكييفات في القاهرة، صيانة تكييف بالقاهرة، تركيب تكييف القاهرة"
  ogTitle="شركة تكييفات في القاهرة | نيو جولدن أوفيس"
  ogDescription="شراء وتركيب وصيانة وإصلاح وشحن فريون للشركات والمكاتب، عقود صيانة سنوية تغطي أحياء القاهرة."
  ogImage="/images/webp-images/modern-air-conditioner-unit-on-wall-at-home-2026-03-25-06-57-47-utc.webp"
  schemaJson={schemaJson}
>
<style>
  .quote-section{padding:60px 0}
  .quote-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:stretch}
  .quote-form-card{background:#fff;border-radius:18px;padding:2.2rem;box-shadow:0 4px 24px rgba(27,58,107,0.1)}
  .quote-form-card h3,.quote-form-card .as-h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:700;color:var(--green-dark);margin-bottom:1.5rem}
  .form-group{margin-bottom:1.1rem}
  .form-group label{display:block;font-family:'Cairo',sans-serif;font-size:0.95rem;font-weight:600;color:var(--green-dark);margin-bottom:0.4rem}
  .form-group input,.form-group select,.form-group textarea{width:100%;padding:0.8rem 1rem;border:2px solid #e5eaf3;border-radius:10px;font-family:'Tajawal',sans-serif;font-size:1rem;color:#333;background:#fafbfd;transition:border-color .3s,box-shadow .3s;outline:none;box-sizing:border-box;direction:rtl}
  .form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--green-dark);box-shadow:0 0 0 3px rgba(27,58,107,.1);background:#fff}
  .form-group textarea{height:100px;resize:vertical}
  .form-submit-btn{width:100%;padding:1rem;background:linear-gradient(135deg,var(--green-dark),var(--green-mid));color:#fff;border:none;border-radius:12px;font-family:'Cairo',sans-serif;font-size:1.05rem;font-weight:700;cursor:pointer;transition:transform .3s,box-shadow .3s;display:flex;align-items:center;justify-content:center;gap:.5rem}
  .form-submit-btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(27,58,107,.25)}
  .success-message{display:none;background:linear-gradient(135deg,#e8f5e9,#f1f8e9);border:2px solid #4caf50;border-radius:12px;padding:1.5rem;text-align:center;margin-top:1rem}
  .success-message i{font-size:2.5rem;color:#4caf50;display:block;margin-bottom:.5rem}
  .success-message p{font-family:'Cairo',sans-serif;font-size:1.05rem;color:#2e7d32;font-weight:600}
  .quote-alt-card{background:linear-gradient(135deg,#25D366 0%,#128C7E 100%);border-radius:18px;padding:2.4rem;text-align:center;color:#fff;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:1rem}
  .quote-alt-card .wa-icon{font-size:3rem}
  .quote-alt-card h3,.quote-alt-card .as-h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:800}
  .quote-alt-card p{opacity:.92;line-height:1.8}
  @media(max-width:768px){.quote-grid{grid-template-columns:1fr}}
</style>

<section class="page-hero">
  <div class="container">
    <div class="page-hero-inner">
      <div class="page-hero-content">
        <nav class="breadcrumb">
          <a href="/">الرئيسية</a>
          <span>/</span>
          <a href="/cairo">خدماتنا في القاهرة</a>
          <span>/</span>
          <span class="current">شركة تكييفات في القاهرة</span>
        </nav>
        <h1 class="reveal">شركة تكييفات في القاهرة</h1>
        <p class="lead reveal delay-1">شراء وتركيب تكييف بمعايير احترافية، صيانة دورية بعقود سنوية، إصلاح أعطال وشحن فريون، بفرق ميدانية متنقلة تغطي أحياء القاهرة الرئيسية</p>
      </div>
      <div class="page-hero-image">
        <Img src="/images/webp-images/modern-air-conditioner-unit-on-wall-at-home-2026-03-25-06-57-47-utc.webp" alt="شركة تكييفات في القاهرة" preset="hero" priority />
      </div>
    </div>
  </div>
</section>

<section class="stats-section">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item reveal"><div class="stat-num" data-target="27" data-suffix="+">0+</div><div class="stat-label">سنة خبرة في السوق المصري</div></div>
      <div class="stat-item reveal delay-1"><div class="stat-num" data-target="5000" data-suffix="+">0+</div><div class="stat-label">عميل في جميع أنحاء مصر</div></div>
      <div class="stat-item reveal delay-2"><div class="stat-num stat-text">كل الماركات</div><div class="stat-label">المتاحة في السوق، بيعًا وصيانة</div></div>
      <div class="stat-item reveal delay-3"><div class="stat-num" data-target="4">0</div><div class="stat-label">أنواع تكييف: سبليت وشباك وكونسيلد ومركزي</div></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>تكييفات القاهرة: شراء وتركيب وصيانة كل الماركات</h2>
      <div class="divider"></div>
    </div>
    <div class="intro-text" style="max-width:900px;margin:0 auto;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>كشركة تكييفات في القاهرة نغطي دورة التكييف كاملة: شراء تكييفات جديدة من كل الماركات، تركيب سبليت وشباك وكونسيلد ومركزي بمعايير احترافية، صيانة دورية بعقود سنوية للمكاتب والشركات والمنازل، إصلاح الأعطال وشحن الفريون بعد إصلاح التسريب.</p>
      <p style="margin-top:16px">القدرة الصحيحة للمساحة وجودة التركيب يحددان عمر التكييف واستهلاكه للكهرباء أكثر من الماركة. وفي القاهرة تحديدًا، الغبار والأتربة هما العدو الأول للوحدات الخارجية، ولذلك يركز جدول الصيانة على غسيل المكثف والفلاتر.</p>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>صيانة تكييف بالقاهرة وخدماتنا: تركيب وإصلاح وشحن فريون</h2>
      <div class="divider"></div>
    </div>
    <div class="services-grid">
      <div class="service-card reveal"><div class="service-icon"><i class="fas fa-cart-shopping"></i></div><h3 class="service-title">شراء وتوريد بأسعار الشركات</h3><p class="service-desc">تحديد القدرة المناسبة ثم التوريد من ماركات موثوقة بعروض خاصة للكميات.</p><a href="/ac/buy" class="btn btn-outline-primary btn-sm">تكييفات للبيع <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal delay-1"><div class="service-icon"><i class="fas fa-toolbox"></i></div><h3 class="service-title">تركيب باحترافية تحمي استثمارك</h3><p class="service-desc">اختيار موقع الوحدتين، تفريغ الهواء من الدائرة، اختبار الضغوط، وتشغيل تجريبي كامل.</p><a href="/ac/installation" class="btn btn-outline-primary btn-sm">تركيب التكييفات <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal delay-2"><div class="service-icon"><i class="fas fa-broom"></i></div><h3 class="service-title">صيانة دورية تمنع العطل</h3><p class="service-desc">تنظيف الفلاتر، فحص غاز التبريد والضغوط، وتقرير حالة مكتوب بعد كل زيارة.</p><a href="/ac/maintenance" class="btn btn-outline-primary btn-sm">صيانة التكييفات <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal delay-3"><div class="service-icon"><i class="fas fa-screwdriver-wrench"></i></div><h3 class="service-title">إصلاح الأعطال بتشخيص دقيق</h3><p class="service-desc">كمبروسر، تسريب فريون، كارتة تحكم، أو مروحة متوقفة، بتشخيص من الجذر لا ترقيع.</p></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>الغبار والرمال: التحدي المناخي الأول لتكييفات القاهرة</h2>
      <div class="divider"></div>
    </div>
    <div class="intro-text" style="max-width:900px;margin:0 auto;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>في القاهرة، العدو الحقيقي للتكييف ليس الرطوبة بل الغبار والأتربة. موجات الرمال والعواصف الترابية الموسمية، وأتربة الطرق والمناطق العمرانية الجديدة وأعمال الإنشاءات المستمرة، كلها تتراكم على الفلاتر والمبادلات الحرارية والوحدات الخارجية. النتيجة عند الإهمال متوقعة: تبريد أضعف، استهلاك كهرباء أعلى، أعطال متكررة، وفي النهاية حمل زائد يتلف الكمبروسر.</p>
      <p style="margin-top:16px">لذلك ننصح شركات القاهرة بحجز <a href="/ac/maintenance">خدمة صيانة تكييفات وشحن فريون</a> بجدول عناية أعلى وتيرة من المدن الساحلية: تنظيف الفلاتر بوتيرة مكثفة خاصة في مواسم العواصف الترابية، عناية خاصة بالمكاتب القريبة من الطرق الرئيسية ومناطق الإنشاءات، وفحص دوري شامل للوحدات الخارجية وغسيل المبادلات الحرارية. فريقنا يحدد الوتيرة الدقيقة المناسبة لموقع مكتبك عند أول زيارة.</p>
    </div>
    <div class="reveal" style="max-width:900px;margin:32px auto 0;border-radius:var(--radius-lg);overflow:hidden">
      <Img src="/images/webp-images/controlling-room-temperature-with-remote-control-d-2026-03-24-03-30-27-utc.webp" alt="صيانة تكييفات في القاهرة" preset="content" style="width:100%;height:340px;object-fit:cover;display:block" />
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>أنواع التكييفات التي نخدمها ودليل اختيار القدرة</h2>
      <div class="divider"></div>
    </div>
    <div class="features-grid">
      <div class="feature-card reveal"><div class="feature-icon"><i class="fas fa-wind"></i></div><h3>تكييف سبليت</h3><p>الخيار الأكثر شيوعًا للمكاتب والغرف المنفصلة، كفاءة جيدة وصوت هادئ.</p></div>
      <div class="feature-card reveal delay-1"><div class="feature-icon"><i class="fas fa-square"></i></div><h3>تكييف شباك</h3><p>حل عملي واقتصادي للغرف الصغيرة والمواقع التي يصعب فيها تمديد مواسير.</p></div>
      <div class="feature-card reveal delay-2"><div class="feature-icon"><i class="fas fa-building"></i></div><h3>تكييف مركزي</h3><p>الأنسب للمساحات المفتوحة الكبيرة والمقرات متعددة الطوابق، ويحتاج تصميمًا هندسيًا دقيقًا.</p></div>
      <div class="feature-card reveal delay-3"><div class="feature-icon"><i class="fas fa-layer-group"></i></div><h3>تكييف كونسيلد (مخفي)</h3><p>يُخفى داخل السقف المعلق ويمنح المكاتب الحديثة مظهرًا راقيًا بلا وحدات ظاهرة.</p></div>
    </div>
    <p style="max-width:800px;margin:24px auto 0;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">القدرة الصحيحة تُحسب من المساحة وارتفاع السقف وعدد الأفراد والأجهزة واتجاه الشمس والدور، لهذا لا نبيع بالتليفون قدرة جاهزة، بل نعاين أو نراجع التفاصيل بدقة قبل الترشيح.</p>
  </div>
</section>

<MidPageCTA formId="acCairoMidCta" />

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>ما الذي يحدد أسعار تركيب وصيانة التكييف في القاهرة؟</h2>
      <div class="divider"></div>
    </div>
    <div class="intro-text" style="max-width:900px;margin:0 auto;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <ul style="max-width:700px;margin:0 auto;padding-inline-start:20px;line-height:2.1">
        <li><strong>قدرة الجهاز ونوعه:</strong> تركيب سبليت 1.5 حصان يختلف عن كونسيلد 5 حصان بدكتات.</li>
        <li><strong>الماركة والموديل:</strong> فرق السعر يعكس فرق الكفاءة والضمان وتوافر قطع الغيار.</li>
        <li><strong>تفاصيل موقع التركيب:</strong> طول المواسير، الدور، صعوبة الوصول، والحاجة لأعمال كهرباء إضافية.</li>
        <li><strong>عدد الوحدات وحجم التعاقد:</strong> تجهيز مقر كامل يفتح باب أسعار الكميات والعروض الخاصة.</li>
        <li><strong>نطاق الخدمة:</strong> توريد فقط، توريد مع تركيب، أم باقة متكاملة مع عقد صيانة سنوي.</li>
      </ul>
      <p style="margin-top:20px;text-align:center">تواصل معنا على 01227392074، أخبرنا بعدد الوحدات والمساحات، نرتب معاينة إن لزمت، ثم يصلك عرض سعر رسمي مفصل البنود.</p>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>عقود الصيانة السنوية: الباقة التي لا يقدمها غيرنا بهذا الوضوح</h2>
      <div class="divider"></div>
    </div>
    <div class="steps-grid">
