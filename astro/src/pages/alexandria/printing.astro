---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://newgoldenoffice.com/alexandria/printing#service",
      "name": "خدمات الطباعة في الإسكندرية",
      "serviceType": "طباعة أوفست وديجيتال ومطبوعات داخلية وخارجية",
      "areaServed": { "@type": "City", "name": "الإسكندرية" },
      "provider": { "@id": "https://newgoldenoffice.com/#organization" },
      "url": "https://newgoldenoffice.com/alexandria/printing"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"ما الفرق بين الطباعة الأوفست والديجيتال، وأيهما أوفر لكميتي؟","acceptedAnswer":{"@type":"Answer","text":"الأوفست يطبع بألواح ويصبح اقتصاديًا جدًا في الكميات الكبيرة لأن تكلفة النسخة تنخفض مع زيادة العدد. الديجيتال يطبع من الملف مباشرة، لذا هو الأسرع والأوفر للكميات الصغيرة والمتوسطة. أرسل لنا كميتك ومواصفاتك وسنحسب لك التكلفة بالطريقتين ونرشح الأوفر."}},
        {"@type":"Question","name":"كم سعر طباعة 1000 كارت شخصي في الإسكندرية؟","acceptedAnswer":{"@type":"Answer","text":"السعر يتحدد حسب الخامة (وزن الورق ونوعه)، التشطيب (مط، لامع، سلوفان، يوفي)، والطباعة وجهًا أو وجهين. أرسل مواصفاتك وستصلك التفاصيل في عرض سعر نهائي واضح قبل التنفيذ."}},
        {"@type":"Question","name":"ما أقل كمية يمكن طباعتها؟","acceptedAnswer":{"@type":"Answer","text":"بفضل الطباعة الديجيتال لا يوجد حد أدنى مرهق: نطبع النسخ القليلة والعينات والطلبات الفردية. ومع زيادة الكمية ننقلك إلى الأوفست ليكون سعر النسخة أوفر."}},
        {"@type":"Question","name":"كم مدة تنفيذ وتسليم الطلب؟","acceptedAnswer":{"@type":"Answer","text":"المدة تعتمد على نوع الطباعة والكمية والتشطيبات: الديجيتال أسرع، والأوفست يحتاج وقت تجهيز. عند تأكيد الطلب نتفق على موعد تسليم واضح ونلتزم به."}},
        {"@type":"Question","name":"هل توصّلون الطلب لكل أحياء الإسكندرية؟","acceptedAnswer":{"@type":"Answer","text":"نعم. فرق التسليم لدينا تغطي أحياء الإسكندرية: وسط البلد، المنشية، العطارين، سموحة، سيدي جابر، جليم، لوران، ميامي، والكورنيش، إضافة إلى منطقة الميناء."}},
        {"@type":"Question","name":"هل يمكن الطلب أونلاين ورفع التصميم واستلام عيّنة قبل الطباعة؟","acceptedAnswer":{"@type":"Answer","text":"نعم. ترسل ملف التصميم عبر واتساب، نراجعه فنيًا ونرد بعرض السعر، ثم تعتمد بروفة نهائية قبل بدء الطباعة."}},
        {"@type":"Question","name":"ما الخدمات التي تقدمها شركة الطباعة المحترفة؟","acceptedAnswer":{"@type":"Answer","text":"طباعة الأوفست والديجيتال، المطبوعات الداخلية والخارجية، المطبوعات التجارية، التشطيبات الفاخرة مثل اليوفي، الهدايا الدعائية، والتصميم والمراجعة الفنية قبل التنفيذ."}},
        {"@type":"Question","name":"كيف أختار أفضل شركة طباعة في الإسكندرية؟","acceptedAnswer":{"@type":"Answer","text":"قارن على أربعة أشياء: جودة نماذج أعمال حقيقية، وضوح عرض السعر قبل التنفيذ، الالتزام بمواعيد التسليم، ووجود مقر فعلي تستطيع زيارته داخل المدينة."}}
      ]
    }
  ]
});
---

<BaseLayout
  title="شركة طباعة في الإسكندرية، كروت وبنرات ورول أب | نيو جولدن أوفيس"
  description="شركة طباعة في الإسكندرية بخبرة 27 عامًا: أوفست وديجيتال، كروت وفلايرات وبنرات ورول اب، تصميم وتنفيذ وتسليم لكل أحياء الإسكندرية. اطلب عرض سعرك الآن."
  keywords="شركة طباعة في الإسكندرية، شركة طباعة اوفست في الاسكندرية، طباعة بنرات ولافتات في الاسكندرية، اسعار طباعة بزنس كارد الاسكندرية، طباعة يوفي الاسكندرية"
  ogTitle="شركة طباعة في الإسكندرية | نيو جولدن أوفيس"
  ogDescription="شركة طباعة في الإسكندرية بخبرة 27 عامًا: أوفست وديجيتال، كروت وفلايرات وبنرات ورول اب، تسليم لكل أحياء الإسكندرية."
  ogImage="/images/printing-hub.webp"
  schemaJson={schemaJson}
>
<style>
  .quote-section{padding:60px 0}
  .quote-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:stretch}
  .quote-form-card{background:#fff;border-radius:18px;padding:2.2rem;box-shadow:0 4px 24px rgba(27,58,107,0.1)}
  .quote-form-card h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:700;color:var(--green-dark);margin-bottom:1.5rem}
  .form-group{margin-bottom:1.1rem}
  .form-group label{display:block;font-family:'Cairo',sans-serif;font-size:0.95rem;font-weight:600;color:var(--green-dark);margin-bottom:0.4rem}
  .form-group input,.form-group select,.form-group textarea{width:100%;padding:0.8rem 1rem;border:2px solid #e5eaf3;border-radius:10px;font-family:'Tajawal',sans-serif;font-size:1rem;color:#333;background:#fafbfd;transition:border-color .3s,box-shadow .3s;outline:none;box-sizing:border-box;direction:rtl}
  .form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--green-dark);box-shadow:0 0 0 3px rgba(27,58,107,.1);background:#fff}
  .form-group textarea{height:100px;resize:vertical}
  .form-submit-btn{width:100%;padding:1rem;background:linear-gradient(135deg,var(--green-dark),var(--green-mid));color:#fff;border:none;border-radius:12px;font-family:'Cairo',sans-serif;font-size:1.05rem;font-weight:700;cursor:pointer;transition:transform .3s,box-shadow .3s;display:flex;align-items:center;justify-content:center;gap:.5rem}
  .form-submit-btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(27,58,107,.25)}
  .success-message{display:none;background:linear-gradient(135deg,#e8f5e9,#f1f8e9);border:2px solid #4caf50;border-radius:12px;padding:1.5rem;text-align:center;margin-top:1rem}
  .success-message i{font-size:2.5rem;color:#4caf50;display:block;margin-bottom:.5rem}
  .success-message p{font-family:'Cairo',sans-serif;font-size:1.05rem;color:#2e7d32;font-weight:600}
  .quote-alt-card{background:linear-gradient(135deg,#25D366 0%,#128C7E 100%);border-radius:18px;padding:2.4rem;text-align:center;color:#fff;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:1rem}
  .quote-alt-card .wa-icon{font-size:3rem}
  .quote-alt-card h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:800}
  .quote-alt-card p{opacity:.92;line-height:1.8}
  @media(max-width:768px){.quote-grid{grid-template-columns:1fr}}
</style>

<section class="page-hero">
  <div class="container">
    <div class="page-hero-inner">
      <div class="page-hero-content">
        <nav class="breadcrumb">
          <a href="/">الرئيسية</a>
          <span>/</span>
          <a href="/alexandria">خدماتنا في الإسكندرية</a>
          <span>/</span>
          <span class="current">شركة طباعة في الإسكندرية</span>
        </nav>
        <h1 class="reveal">شركة طباعة في الإسكندرية</h1>
        <p class="lead reveal delay-1">أوفست وديجيتال، مطبوعات داخلية وخارجية، تصميم وتنفيذ وتسليم لكل أحياء الإسكندرية، من مقرنا الفعلي في الإبراهيمية، بخبرة 27 عامًا</p>
      </div>
      <div class="page-hero-image">
        <img src="/images/webp-images/hi-tech-printing-equipment-in-print-workshop-2026-03-25-01-25-40-utc.webp" alt="شركة طباعة في الإسكندرية" loading="eager">
      </div>
    </div>
  </div>
</section>

<!-- STATS -->
<section class="stats-section">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item reveal">
        <div class="stat-num" data-target="27" data-suffix="+">0+</div>
        <div class="stat-label">سنة خبرة في الطباعة</div>
      </div>
      <div class="stat-item reveal delay-1">
        <div class="stat-num" data-target="4">0</div>
        <div class="stat-label">تقنيات طباعة متاحة</div>
      </div>
      <div class="stat-item reveal delay-2">
        <div class="stat-num" data-target="9">0</div>
        <div class="stat-label">أحياء نغطيها بالتسليم يوميًا</div>
      </div>
      <div class="stat-item reveal delay-3">
        <div class="stat-num" data-target="1">0</div>
        <div class="stat-label">قطعة واحدة كحد أدنى للطلب</div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="intro-text" style="max-width:900px;margin:0 auto 48px;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>تبحث عن شركة طباعة في الإسكندرية تنفذ شغلك بجودة ثابتة وموعد مضبوط وسعر واضح قبل التنفيذ؟ نيو جولدن أوفيس تخدم شركات ومكاتب ومحال الإسكندرية منذ 27 عامًا من مقرنا في 26 عبد المنعم سند، الإبراهيمية، باب شرق، الإسكندرية. قربنا منك يعني شيئًا عمليًا: تعتمد البروفة بسرعة، وتستلم مطبوعاتك بلا انتظار طويل، وتجد من تكلمه فورًا لو احتجت تعديلًا في اللحظة الأخيرة. من كارت شخصي واحد إلى حملة مطبوعات كاملة لشركتك، ننفذها كلها تحت سقف واحد: طباعة أوفست وديجيتال، مطبوعات داخلية وخارجية، تصميم وهوية بصرية، وتسليم يصل إليك في أي حي من أحياء الإسكندرية.</p>
      <p style="margin-top:16px">خبرتنا المتراكمة منذ 1999 في هذا المجال تحديدًا تعني أننا رأينا كل أنواع المشاكل المحتملة في الطباعة وتعلمنا كيف نتجنبها من البداية: ألوان لا تطابق الشاشة، تصميمات بدون هامش قص كافٍ، وتأخيرات بسبب موافقات متأخرة. نراجع كل هذه التفاصيل معك قبل الطباعة الفعلية، ونرسل دائمًا عينة أو معاينة رقمية قبل تنفيذ الكمية الكاملة.</p>
      <p style="margin-top:16px">نحتفظ أيضًا بملف كامل لتصميمات كل عميل سابق، فإذا احتجت طباعة إضافية لاحقًا لنفس التصميم، ننفذها بسرعة دون الحاجة لإعادة إرسال الملفات أو مراجعة التصميم من جديد.</p>
      <p style="margin-top:16px">للمشاريع الكبيرة التي تشمل عدة أنواع مطبوعات معًا، ننسق التنفيذ بحيث تصلك كل العناصر في نفس الموعد جاهزة للاستخدام دفعة واحدة بدل تسليمات متفرقة.</p>
      <p style="margin-top:16px">نساعدك أيضًا في التخطيط لمواسم الطلب المرتفع كالمعارض والمناسبات، لضمان جدولة تنفيذ مريحة بدل ضغط اللحظات الأخيرة قبل الموعد المهم.</p>
      <p style="margin-top:16px">نوضح دائمًا التكلفة الكاملة مقدمًا قبل بدء أي عمل، حتى تعرف بدقة ما ستدفعه دون أي مفاجآت في الفاتورة النهائية.</p>
      <p style="margin-top:16px">هذا الوضوح المنذ اليوم الأول هو ما يميز تعاملنا مع كل عميل جديد في الإسكندرية.</p>
      <p style="margin-top:16px;text-align:center">تعرف على <a href="/alexandria">خدماتنا الشاملة في الإسكندرية</a> بكل تخصصاتنا الستة.</p>
    </div>

    <div class="section-header">
      <h2>شركة طباعة اوفست في الاسكندرية — خدماتنا الكاملة</h2>
      <div class="divider"></div>
    </div>
    <div class="services-grid">
      <div class="service-card reveal">
        <div class="service-icon"><i class="fas fa-layer-group"></i></div>
        <h3 class="service-title">طباعة أوفست للكميات الكبيرة</h3>
        <p class="service-desc">كتالوجات، بروشورات، فلايرات، أوراق رسمية بمعايير لون دقيقة. كلما زادت الكمية انخفضت تكلفة النسخة الواحدة.</p>
        <a href="/printing/offset" class="btn btn-outline-primary btn-sm">طباعة أوفست <i class="fas fa-arrow-left"></i></a>
      </div>
      <div class="service-card reveal delay-1">
        <div class="service-icon"><i class="fas fa-bolt"></i></div>
        <h3 class="service-title">طباعة ديجيتال للكميات الصغيرة والمستعجلة</h3>
        <p class="service-desc">نسخ محدودة أو تسليم عاجل، بلا حد أدنى مرهق ولا انتظار لتجهيز ألواح طباعة.</p>
        <a href="/printing/digital" class="btn btn-outline-primary btn-sm">طباعة ديجيتال <i class="fas fa-arrow-left"></i></a>
      </div>
      <div class="service-card reveal delay-2">
        <div class="service-icon"><i class="fas fa-store"></i></div>
        <h3 class="service-title">طباعة إن دور للمساحات الداخلية</h3>
        <p class="service-desc">استاندات، لوحات استقبال، ملصقات حوائط وفتارين، بخامات داخلية بألوان غنية وتفاصيل حادة.</p>
      </div>
      <div class="service-card reveal delay-3">
        <div class="service-icon"><i class="fas fa-sun"></i></div>
        <h3 class="service-title">طباعة أوت دور تتحمل مناخ الإسكندرية</h3>
        <p class="service-desc">بنرات ولافتات وفينيل واجهات بخامات مقاومة للشمس والرطوبة ورذاذ البحر، مناسبة لمحال الكورنيش.</p>
      </div>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>المطبوعات التي ننفذها</h2>
      <div class="divider"></div>
    </div>
    <div class="services-grid">
      <div class="service-card reveal">
        <div class="service-icon"><i class="fas fa-id-card"></i></div>
        <h3 class="service-title">كروت شخصية وبزنس كارد</h3>
        <p class="service-desc">خامات وتشطيبات متعددة: مط، لامع، ورق سميك فاخر، سلوفان حراري، ويوفي انتقائي.</p>
        <a href="/printing/business-cards" class="btn btn-outline-primary btn-sm">طباعة بزنس كارد <i class="fas fa-arrow-left"></i></a>
      </div>
      <div class="service-card reveal delay-1">
        <div class="service-icon"><i class="fas fa-book-open"></i></div>
        <h3 class="service-title">فلايرات وبروشورات وكتالوجات</h3>
        <p class="service-desc">مقاسات وطيّات مختلفة، مع ترشيح الورق والتشطيب حسب طريقة الاستخدام.</p>
        <a href="/printing/brochures" class="btn btn-outline-primary btn-sm">بروشورات وفلايرات <i class="fas fa-arrow-left"></i></a>
      </div>
      <div class="service-card reveal delay-2">
        <div class="service-icon"><i class="fas fa-image"></i></div>
        <h3 class="service-title">رول اب وبانر وفينيل</h3>
        <p class="service-desc">لكل معرض أو افتتاح أو حملة موسمية، بخامات تناسب مكان الاستخدام الداخلي أو الخارجي.</p>
        <a href="/printing/banners" class="btn btn-outline-primary btn-sm">طباعة بنرات وفينيل <i class="fas fa-arrow-left"></i></a>
      </div>
      <div class="service-card reveal delay-3">
        <div class="service-icon"><i class="fas fa-wand-magic-sparkles"></i></div>
        <h3 class="service-title">طباعة يوفي وتشطيبات فاخرة</h3>
        <p class="service-desc">ألوان بارزة ولمعان انتقائي يبرز اللوجو، مناسبة للكروت الفاخرة والأغلفة.</p>
        <a href="/printing/uv" class="btn btn-outline-primary btn-sm">طباعة UV <i class="fas fa-arrow-left"></i></a>
      </div>
      <div class="service-card reveal">
        <div class="service-icon"><i class="fas fa-gift"></i></div>
        <h3 class="service-title">هدايا دعائية مطبوعة</h3>
        <p class="service-desc">أقلام، أجندات، أكواب، ونوت بوك مطبوعة بشعار شركتك، من التصميم إلى التسليم.</p>
        <a href="/printing/gifts" class="btn btn-outline-primary btn-sm">طباعة هدايا وأكواب <i class="fas fa-arrow-left"></i></a>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>أوفست أم ديجيتال؟ اختر حسب كميتك</h2>
      <div class="divider"></div>
    </div>
    <p style="max-width:800px;margin:0 auto 32px;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">أكثر سؤال يصلنا من عملاء جدد: أي نوع طباعة أختار؟ الجواب يعتمد أساسًا على الكمية والاستعجال.</p>
    <div style="overflow-x:auto;max-width:900px;margin:0 auto">
      <table style="width:100%;border-collapse:collapse;font-size:0.95rem">
        <thead>
          <tr style="background:var(--green-dark);color:var(--white)">
            <th style="padding:14px 16px;text-align:right">المعيار</th>
            <th style="padding:14px 16px;text-align:right">طباعة أوفست</th>
            <th style="padding:14px 16px;text-align:right">طباعة ديجيتال</th>
          </tr>
        </thead>
        <tbody>
          <tr style="background:var(--white);border-bottom:1px solid #eee"><td style="padding:12px 16px">الكمية المناسبة</td><td style="padding:12px 16px">الكميات الكبيرة (آلاف النسخ)</td><td style="padding:12px 16px">الكميات الصغيرة والمتوسطة</td></tr>
          <tr style="background:var(--section-bg,#f8f9fa);border-bottom:1px solid #eee"><td style="padding:12px 16px">تكلفة النسخة</td><td style="padding:12px 16px">تنخفض كثيرًا مع زيادة الكمية</td><td style="padding:12px 16px">ثابتة تقريبًا مهما كانت الكمية</td></tr>
          <tr style="background:var(--white);border-bottom:1px solid #eee"><td style="padding:12px 16px">سرعة البدء</td><td style="padding:12px 16px">تحتاج تجهيز ألواح قبل الطباعة</td><td style="padding:12px 16px">تبدأ فورًا من الملف مباشرة</td></tr>
          <tr style="background:var(--section-bg,#f8f9fa);border-bottom:1px solid #eee"><td style="padding:12px 16px">ثبات الألوان</td><td style="padding:12px 16px">دقة لون عالية للكميات الضخمة</td><td style="padding:12px 16px">جودة ممتازة للأعمال اليومية</td></tr>
          <tr style="background:var(--white)"><td style="padding:12px 16px">الأنسب لـ</td><td style="padding:12px 16px">كتالوجات، فلايرات حملات، أوراق رسمية</td><td style="padding:12px 16px">كروت عاجلة، منيوهات، عينات، دعوات</td></tr>
        </tbody>
      </table>
    </div>
