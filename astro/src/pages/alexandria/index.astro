<script is:inline>
  (function () {
    var form = document.getElementById('quoteForm');
    if (!form) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var successMsg = document.getElementById('quoteSuccessMessage');
      var errorMsg = document.getElementById('quoteErrorMessage');
      var submitBtn = document.getElementById('quoteSubmitBtn');
      errorMsg.style.display = 'none';
      submitBtn.disabled = true;
      submitBtn.style.opacity = '0.7';
      fetch('/contact-handler.php', { method: 'POST', body: new FormData(form) })
        .then(function (res) { return res.json().then(function (data) { return { ok: res.ok && data.ok, message: data.message }; }); })
        .then(function (result) {
          if (result.ok) { form.style.display = 'none'; successMsg.style.display = 'block'; }
          else { errorMsg.textContent = result.message || 'حدث خطأ، برجاء المحاولة مرة أخرى أو التواصل عبر واتساب.'; errorMsg.style.display = 'block'; }
        })
        .catch(function () { errorMsg.textContent = 'تعذر الإرسال، برجاء المحاولة عبر واتساب.'; errorMsg.style.display = 'block'; })
        .finally(function () { submitBtn.disabled = false; submitBtn.style.opacity = '1'; });
    });
  })();
</script>
