---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://newgoldenoffice.com/alexandria#service",
      "url": "https://newgoldenoffice.com/alexandria",
      "name": "خدماتنا في الإسكندرية",
      "inLanguage": "ar",
      "serviceType": [
        "خدمات الطباعة",
        "الأدوات والمستلزمات المكتبية",
        "بيع وتركيب وصيانة التكييفات",
        "أنظمة كاميرات المراقبة",
        "ماكينات التصوير والطابعات",
        "ماكينات عد النقود وكشف التزييف"
      ],
      "areaServed": { "@type": "City", "name": "الإسكندرية" },
      "provider": { "@id": "https://newgoldenoffice.com/#organization" },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "خدمات نيو جولدن أوفيس في الإسكندرية",
        "itemListElement": [
          {"@type":"Offer","itemOffered":{"@type":"Service","name":"خدمات الطباعة في الإسكندرية","url":"https://newgoldenoffice.com/alexandria/printing"}},
          {"@type":"Offer","itemOffered":{"@type":"Service","name":"الأدوات والمستلزمات المكتبية في الإسكندرية","url":"https://newgoldenoffice.com/alexandria/office-supplies"}},
          {"@type":"Offer","itemOffered":{"@type":"Service","name":"بيع وتركيب وصيانة التكييفات في الإسكندرية","url":"https://newgoldenoffice.com/alexandria/ac"}},
          {"@type":"Offer","itemOffered":{"@type":"Service","name":"أنظمة كاميرات المراقبة في الإسكندرية","url":"https://newgoldenoffice.com/alexandria/cameras"}},
          {"@type":"Offer","itemOffered":{"@type":"Service","name":"ماكينات التصوير والطابعات في الإسكندرية","url":"https://newgoldenoffice.com/alexandria/copiers"}},
          {"@type":"Offer","itemOffered":{"@type":"Service","name":"ماكينات عد النقود وكشف التزييف في الإسكندرية","url":"https://newgoldenoffice.com/alexandria/cash-machines"}}
        ]
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://newgoldenoffice.com/alexandria#faq",
      "inLanguage": "ar",
      "mainEntity": [
        {"@type":"Question","name":"ما المناطق التي تغطيها خدماتكم داخل الإسكندرية؟","acceptedAnswer":{"@type":"Answer","text":"نغطي مناطق الإسكندرية الرئيسية: وسط البلد، سموحة، سيدي جابر، ميامي، جليم، لوران، إضافة إلى أسواق المنشية والعطارين ومنطقة الميناء والكورنيش. تواصل معنا وسنؤكد لك التغطية والموعد المناسب."}},
        {"@type":"Question","name":"هل يمكن زيارة مقركم قبل التعاقد أو الشراء؟","acceptedAnswer":{"@type":"Answer","text":"نعم، وننصح بها. يمكنك زيارة مقرنا بالإسكندرية ومعاينة ماكينات التصوير وماكينات عد النقود ونماذج المطبوعات بنفسك قبل اتخاذ القرار."}},
        {"@type":"Question","name":"ما مواعيد التسليم والتركيب داخل الإسكندرية؟","acceptedAnswer":{"@type":"Answer","text":"لأن مقرنا وفريقنا الفني داخل المدينة، التسليم سريع والاستجابة قريبة. نتفق معك على موعد واضح قبل تأكيد الطلب ونلتزم به، سواء كان توريد مستلزمات أو تركيب تكييف أو نظام كاميرات."}},
        {"@type":"Question","name":"هل يمكن التعاقد على أكثر من خدمة معًا؟","acceptedAnswer":{"@type":"Answer","text":"نعم. لو بتجهّز مكتب أو نشاط جديد بالكامل، عندنا صفحة مخصصة توضح كيف ننسق الست خدمات في مشروع واحد بعقد وفاتورة ومندوب حساب واحد: newgoldenoffice.com/alexandria/office-setup"}},
        {"@type":"Question","name":"هل تقدمون عقود صيانة سنوية؟","acceptedAnswer":{"@type":"Answer","text":"نعم، نقدم عقود صيانة وقائية سنوية للتكييفات وماكينات التصوير وأنظمة كاميرات المراقبة، بزيارات دورية مجدولة وأولوية استجابة عند أي عطل طارئ."}},
        {"@type":"Question","name":"هل تصدرون فواتير ضريبية وهل يوجد دفع آجل للشركات؟","acceptedAnswer":{"@type":"Answer","text":"نصدر فواتير ضريبية للشركات والجهات التي تحتاجها، ونوفر ترتيبات دفع مؤسسية تشمل الدفع الآجل للحسابات المتعاقدة بحسب الاتفاق."}},
        {"@type":"Question","name":"كيف أحصل على عرض سعر ومم يتحدد السعر؟","acceptedAnswer":{"@type":"Answer","text":"تواصل معنا وحدد احتياجك. يتحدد السعر حسب المواصفات والكمية والماركة وحجم التعاقد ونوع التركيب أو الصيانة المطلوبة، وتستلم عرضًا مفصلًا واضح البنود قبل أي التزام."}},
        {"@type":"Question","name":"هل تخدمون مناطق خارج الإسكندرية؟","acceptedAnswer":{"@type":"Answer","text":"نعم، نقدم تغطية خدمة كاملة في القاهرة تشمل التجمع الخامس ومدينة نصر والمعادي والقاهرة الجديدة ووسط البلد، بمسارات تسليم مجدولة وفرق ميدانية متنقلة."}}
      ]
    }
  ]
});
---

<BaseLayout
  title="خدماتنا في الإسكندرية، طباعة ومستلزمات وتكييفات | نيو جولدن أوفيس"
  description="خدماتنا في الإسكندرية: طباعة، أدوات مكتبية، تكييفات، كاميرات مراقبة، ماكينات تصوير وعد نقود. خبرة 27 عامًا ومقر فعلي بالإسكندرية. اطلب عرض سعر الآن."
  keywords="خدماتنا في الإسكندرية، شركة نيو جولدن أوفيس بالإسكندرية، توريدات مكتبية الاسكندرية، خدمات متكاملة للشركات الاسكندرية"
  ogTitle="خدماتنا في الإسكندرية | نيو جولدن أوفيس"
  ogDescription="خدماتنا في الإسكندرية: طباعة، أدوات مكتبية، تكييفات، كاميرات مراقبة، ماكينات تصوير وعد نقود. خبرة 27 عامًا ومقر فعلي بالإسكندرية."
  ogImage="/images/about-team.webp"
  robots="noindex, nofollow"
  schemaJson={schemaJson}
>
<style>
  .quote-section{padding:60px 0}
  .quote-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:stretch}
  .quote-form-card{background:#fff;border-radius:18px;padding:2.2rem;box-shadow:0 4px 24px rgba(27,58,107,0.1)}
  .quote-form-card h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:700;color:var(--green-dark);margin-bottom:1.5rem}
  .form-group{margin-bottom:1.1rem}
  .form-group label{display:block;font-family:'Cairo',sans-serif;font-size:0.95rem;font-weight:600;color:var(--green-dark);margin-bottom:0.4rem}
  .form-group input,.form-group select,.form-group textarea{width:100%;padding:0.8rem 1rem;border:2px solid #e5eaf3;border-radius:10px;font-family:'Tajawal',sans-serif;font-size:1rem;color:#333;background:#fafbfd;transition:border-color .3s,box-shadow .3s;outline:none;box-sizing:border-box;direction:rtl}
  .form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--green-dark);box-shadow:0 0 0 3px rgba(27,58,107,.1);background:#fff}
  .form-group textarea{height:100px;resize:vertical}
  .form-submit-btn{width:100%;padding:1rem;background:linear-gradient(135deg,var(--green-dark),var(--green-mid));color:#fff;border:none;border-radius:12px;font-family:'Cairo',sans-serif;font-size:1.05rem;font-weight:700;cursor:pointer;transition:transform .3s,box-shadow .3s;display:flex;align-items:center;justify-content:center;gap:.5rem}
  .form-submit-btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(27,58,107,.25)}
  .success-message{display:none;background:linear-gradient(135deg,#e8f5e9,#f1f8e9);border:2px solid #4caf50;border-radius:12px;padding:1.5rem;text-align:center;margin-top:1rem}
  .success-message i{font-size:2.5rem;color:#4caf50;display:block;margin-bottom:.5rem}
  .success-message p{font-family:'Cairo',sans-serif;font-size:1.05rem;color:#2e7d32;font-weight:600}
  .quote-alt-card{background:linear-gradient(135deg,#25D366 0%,#128C7E 100%);border-radius:18px;padding:2.4rem;text-align:center;color:#fff;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:1rem}
  .quote-alt-card .wa-icon{font-size:3rem}
  .quote-alt-card h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:800}
  .quote-alt-card p{opacity:.92;line-height:1.8}
  @media(max-width:768px){.quote-grid{grid-template-columns:1fr}}
</style>

<section class="page-hero">
  <div class="container">
    <div class="page-hero-inner">
      <div class="page-hero-content">
        <nav class="breadcrumb">
          <a href="/">الرئيسية</a>
          <span>/</span>
          <span class="current">خدماتنا في الإسكندرية</span>
        </nav>
        <h1 class="reveal">خدماتنا في الإسكندرية</h1>
        <p class="lead reveal delay-1">من قلب الإسكندرية، ومنذ 27 عامًا، نقدم كل ما يحتاجه مكتبك أو شركتك: طباعة، أدوات مكتبية، تكييفات، كاميرات مراقبة، ماكينات تصوير، وماكينات عد نقود، بمقر فعلي تزوره وفريق واحد يتابعك بعد البيع</p>
      </div>
      <div class="page-hero-image">
        <img src="/images/webp-images/business-professionals-meeting-at-conference-room-2026-01-05-00-29-12-utc.webp" alt="خدماتنا في الإسكندرية" loading="eager">
      </div>
    </div>
  </div>
</section>

<section class="stats-section">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item reveal">
        <div class="stat-num" data-target="27" data-suffix="+">0+</div>
        <div class="stat-label">سنة خبرة في الإسكندرية</div>
      </div>
      <div class="stat-item reveal delay-1">
        <div class="stat-num" data-target="6">0</div>
        <div class="stat-label">تخصصات خدمة تحت سقف واحد</div>
      </div>
      <div class="stat-item reveal delay-2">
        <div class="stat-num" data-target="1999">0</div>
        <div class="stat-label">عام التأسيس بالإبراهيمية</div>
      </div>
      <div class="stat-item reveal delay-3">
        <div class="stat-num" data-target="6">0</div>
        <div class="stat-label">أحياء رئيسية نغطيها يوميًا</div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="intro-text" style="max-width:900px;margin:0 auto 48px;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>من قلب الإسكندرية، ومنذ 27 عامًا، تقدم شركة نيو جولدن أوفيس كل ما يحتاجه مكتبك أو شركتك في مكان واحد. خدماتنا في الإسكندرية تغطي 6 تخصصات كاملة: الطباعة، الأدوات المكتبية، التكييفات، كاميرات المراقبة، ماكينات التصوير، وماكينات عد النقود. مقرنا الفعلي في 26 عبد المنعم سند، الإبراهيمية، باب شرق، الإسكندرية، وهذا فارق حقيقي: تزورنا وترى المنتجات قبل الشراء، ونصلك بسرعة أينما كنت في المدينة، وتجد من يرد عليك بعد البيع لأننا هنا فعلًا، لا مجرد رقم على الإنترنت.</p>
      <p style="margin-top:16px">نحن لسنا وسيطًا يجمع لك موردين متفرقين. نحن شركة توريدات وخدمات مكتبية بالإسكندرية تملك خبرة تشغيل حقيقية: نورد، نركب، نصون، ونبقى معك بعد البيع. فريق واحد ومسؤولية واحدة وحساب واحد. هذا ما جعل شركات ومصانع وبنوكًا وعيادات ومدارس ومحال تجارية في الإسكندرية تتعامل معنا لسنوات طويلة وتجدد التعاقد عامًا بعد عام.</p>
      <p style="margin-top:16px">هذا التنوع في قاعدة عملائنا صقل خبرتنا في التعامل مع أي نوع نشاط تقريبًا، لأننا تعاملنا فعليًا مع تفاصيله من قبل ونعرف نقاط الحساسية الخاصة بكل قطاع — من متطلبات الأمان الصارمة للبنوك، إلى حساسية التوقيت لدى المصانع التي لا تحتمل توقف خط الإنتاج بسبب عطل بسيط في التكييف أو ماكينة التصوير.</p>
    </div>

    <div class="section-header">
      <h2>شركة نيو جولدن أوفيس بالإسكندرية: 6 تخصصات تحت سقف واحد</h2>
      <div class="divider"></div>
    </div>

    <div class="services-grid">
      <div class="service-card reveal">
        <div class="service-icon"><i class="fas fa-print"></i></div>
        <h3 class="service-title">خدمات الطباعة في الإسكندرية</h3>
        <p class="service-desc">طباعة أوفست وديجيتال، كروت شخصية، فلايرات، بروشورات، كتالوجات، رول أب، بنرات ولافتات فينيل. نراجع العينة معك في نفس المدينة قبل التنفيذ.</p>
        <a href="/alexandria/printing" class="btn btn-outline btn-sm">خدمات الطباعة في الإسكندرية <i class="fas fa-arrow-left"></i></a>
      </div>

      <div class="service-card reveal">
        <div class="service-icon"><i class="fas fa-pen-ruler"></i></div>
        <h3 class="service-title">الأدوات والمستلزمات المكتبية</h3>
        <p class="service-desc">ورق تصوير، أقلام، ملفات وأرشفة، قرطاسية، أحبار طابعات، سبورات. بيع بالجملة وعقود توريد دوري شهري بفواتير ضريبية للشركات.</p>
        <a href="/alexandria/office-supplies" class="btn btn-outline btn-sm">الأدوات والمستلزمات المكتبية <i class="fas fa-arrow-left"></i></a>
      </div>

      <div class="service-card reveal delay-1">
        <div class="service-icon"><i class="fas fa-snowflake"></i></div>
        <h3 class="service-title">بيع وتركيب وصيانة التكييفات</h3>
        <p class="service-desc">توريد وتركيب وصيانة تكييفات سبليت وشباك لأشهر الماركات، مع اختيار القدرة المناسبة ومتابعة دورية بشحن الفريون.</p>
        <a href="/alexandria/ac" class="btn btn-outline btn-sm">بيع وتركيب وصيانة التكييفات <i class="fas fa-arrow-left"></i></a>
      </div>

      <div class="service-card reveal delay-2">
        <div class="service-icon"><i class="fas fa-video"></i></div>
        <h3 class="service-title">أنظمة كاميرات المراقبة</h3>
        <p class="service-desc">كاميرات IP وWiFi، أجهزة تسجيل DVR وNVR، توريد وتركيب وبرمجة ومتابعة عن بعد من هاتفك أينما كنت.</p>
        <a href="/alexandria/cameras" class="btn btn-outline btn-sm">أنظمة كاميرات المراقبة <i class="fas fa-arrow-left"></i></a>
      </div>

      <div class="service-card reveal delay-3">
        <div class="service-icon"><i class="fas fa-copy"></i></div>
        <h3 class="service-title">ماكينات التصوير والطابعات</h3>
        <p class="service-desc">ماكينات تصوير وطابعات لماركات معروفة مثل ريكو وكانون وكونيكا مينولتا، مع أحبار وقطع غيار أصلية وعقود صيانة.</p>
        <a href="/alexandria/copiers" class="btn btn-outline btn-sm">ماكينات التصوير والطابعات <i class="fas fa-arrow-left"></i></a>
      </div>

      <div class="service-card reveal">
        <div class="service-icon"><i class="fas fa-money-bill-wave"></i></div>
        <h3 class="service-title">ماكينات عد النقود وكشف التزييف</h3>
        <p class="service-desc">ماكينات عد نقود وكشف تزييف للبنوك والصرافات والمحال التجارية، لماركات متداولة مثل جلوري وكاسيدا، وماكينات فرم مستندات.</p>
        <a href="/alexandria/cash-machines" class="btn btn-outline btn-sm">ماكينات عد النقود وكشف التزييف <i class="fas fa-arrow-left"></i></a>
      </div>
    </div>
    <p style="max-width:800px;margin:32px auto 0;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">بتفتح فرع جديد أو بتجهّز مكتب من الصفر وعايز الست خدمات دي منسقة في مشروع واحد؟ <a href="/alexandria/office-setup">صفحة تجهيز مكتب متكامل في الإسكندرية</a>.</p>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>لماذا نيو جولدن أوفيس؟ خبرة 27 عامًا ومقر فعلي بالإسكندرية</h2>
      <div class="divider"></div>
    </div>
    <div class="features-grid">
      <div class="feature-card reveal">
        <div class="feature-icon"><i class="fas fa-shield-halved"></i></div>
        <h4>ضمان حقيقي وخدمة ما بعد البيع</h4>
        <p>كل جهاز نبيعه أو نركبه يتبعه التزام واضح بالضمان والمتابعة، لأن سمعتنا في مدينتنا أهم من أي صفقة واحدة.</p>
      </div>
      <div class="feature-card reveal delay-1">
        <div class="feature-icon"><i class="fas fa-calendar-check"></i></div>
        <h4>عقود صيانة سنوية</h4>
        <p>للتكييفات وماكينات التصوير وكاميرات المراقبة، بزيارات وقائية دورية تمنع العطل قبل حدوثه.</p>
      </div>
      <div class="feature-card reveal delay-2">
        <div class="feature-icon"><i class="fas fa-bolt"></i></div>
        <h4>استجابة سريعة داخل الإسكندرية</h4>
        <p>الفريق الفني يتحرك من داخل المدينة لا من محافظة أخرى، فتكون زيارة الصيانة أقرب وأسرع.</p>
      </div>
      <div class="feature-card reveal delay-3">
        <div class="feature-icon"><i class="fas fa-file-invoice"></i></div>
        <h4>تعامل مؤسسي كامل</h4>
        <p>فواتير ضريبية، عروض أسعار رسمية، وترتيبات دفع تناسب الشركات بما فيها الدفع الآجل بحسب الاتفاق.</p>
      </div>
      <div class="feature-card reveal">
        <div class="feature-icon"><i class="fas fa-building"></i></div>
        <h4>مقر فعلي تزوره</h4>
        <p>26 عبد المنعم سند، الإبراهيمية، باب شرق، الإسكندرية. تعاين المنتجات بنفسك قبل أي قرار.</p>
      </div>
      <div class="feature-card reveal delay-1">
        <div class="feature-icon"><i class="fas fa-users"></i></div>
        <h4>فريق واحد لكل احتياجاتك</h4>
        <p>بدلًا من مورد للطباعة وآخر للتكييف وثالث للكاميرات، جهة واحدة تعرف شركتك وتتابع كل شيء.</p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>تغطية شاملة لأحياء الإسكندرية</h2>
      <div class="divider"></div>
    </div>
    <div class="intro-text" style="max-width:900px;margin:0 auto;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">
