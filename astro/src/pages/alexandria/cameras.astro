---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://newgoldenoffice.com/alexandria/cameras#service",
      "name": "تركيب وصيانة كاميرات مراقبة في الإسكندرية",
      "serviceType": "تركيب أنظمة كاميرات مراقبة",
      "url": "https://newgoldenoffice.com/alexandria/cameras",
      "provider": { "@id": "https://newgoldenoffice.com/#organization" },
      "areaServed": { "@type": "City", "name": "الإسكندرية" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"كم سعر تركيب كاميرات المراقبة في الإسكندرية شامل التركيب؟","acceptedAnswer":{"@type":"Answer","text":"لا يوجد سعر موحد، فالتكلفة تتحدد بعدد الكاميرات ونوعها ودقتها وسعة التخزين وطبيعة التمديدات. المعاينة مجانية، وبعدها يصلك عرض سعر مكتوب."}},
        {"@type":"Question","name":"كام كاميرا أحتاج لمحل أو فيلا أو شركة؟","acceptedAnswer":{"@type":"Answer","text":"العدد تحدده نقاط التغطية لا المساحة وحدها: المداخل والمخارج ونقاط الدفع والممرات والنقاط العمياء."}},
        {"@type":"Question","name":"هارد 1 تيرا يسجل كام يوم؟","acceptedAnswer":{"@type":"Answer","text":"المدة تعتمد على عدد الكاميرات ودقة التسجيل ونظام الضغط ونمط التسجيل. عند المعاينة نحسب السعة المطلوبة لعدد الأيام الذي تحتاجه."}},
        {"@type":"Question","name":"هل تسجل كاميرات المراقبة عند انقطاع الإنترنت؟","acceptedAnswer":{"@type":"Answer","text":"التسجيل محلي على جهاز DVR أو NVR، فانقطاع الإنترنت لا يوقفه، ويتوقف مؤقتًا المشاهدة عن بعد فقط."}},
        {"@type":"Question","name":"ما الفرق بين DVR وNVR وأيهما أنسب لي؟","acceptedAnswer":{"@type":"Answer","text":"DVR للكاميرات التناظرية وAHD، وNVR لكاميرات IP بجودة أعلى وتوسعة أسهل. الأنسب يحدده حجم منشأتك."}},
        {"@type":"Question","name":"أي ماركة أختار: هيكفيجن أم داهوا؟","acceptedAnswer":{"@type":"Answer","text":"كلتاهما ماركة عالمية موثوقة في مصر. أفضل نوع كاميرا هو المناسب للموقع، ونرشح التوليفة حسب الموقع والميزانية."}},
        {"@type":"Question","name":"هل يمكنني مشاهدة الكاميرات من خارج البلاد؟","acceptedAnswer":{"@type":"Answer","text":"نعم، مع أنظمة IP تتابع البث الحي والتسجيلات من هاتفك من أي دولة."}},
        {"@type":"Question","name":"كم مدة الضمان وكم سعر عقد الصيانة السنوي؟","acceptedAnswer":{"@type":"Answer","text":"كل الأجهزة أصلية بضمانها الرسمي، وعقد الصيانة السنوي يشمل زيارات دورية بتكلفة تُحدَّد حسب عدد الكاميرات."}},
        {"@type":"Question","name":"هل تغطون منطقتي في الإسكندرية؟","acceptedAnswer":{"@type":"Answer","text":"نغطي وسط البلد وسموحة وسيدي جابر وميامي وجليم ولوران والمنشية والعطارين والكورنيش باستجابة سريعة."}}
      ]
    }
  ]
});
---

<BaseLayout
  title="شركة كاميرات مراقبة في الإسكندرية | تركيب وصيانة"
  description="شركة كاميرات مراقبة في الإسكندرية بخبرة 27 عامًا. تركيب كاميرات IP وأنظمة DVR وNVR بضمان وعقود صيانة، وتغطية لكل أحياء الإسكندرية. اطلب عرض سعر."
  keywords="شركة كاميرات مراقبة في الإسكندرية، تركيب كاميرات مراقبة الاسكندرية، كاميرات مراقبة للمحلات بالاسكندرية"
  ogTitle="شركة كاميرات مراقبة في الإسكندرية | نيو جولدن أوفيس"
  ogDescription="تركيب كاميرات IP وأنظمة DVR وNVR بضمان وعقود صيانة، وتغطية لكل أحياء الإسكندرية."
  ogImage="/images/webp-images/modern-cctv-camera-on-a-wall-with-a-blurred-multi-2026-01-08-06-13-58-utc.webp"
  schemaJson={schemaJson}
>
<style>
  .quote-section{padding:60px 0}
  .quote-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:stretch}
  .quote-form-card{background:#fff;border-radius:18px;padding:2.2rem;box-shadow:0 4px 24px rgba(27,58,107,0.1)}
  .quote-form-card h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:700;color:var(--green-dark);margin-bottom:1.5rem}
  .form-group{margin-bottom:1.1rem}
  .form-group label{display:block;font-family:'Cairo',sans-serif;font-size:0.95rem;font-weight:600;color:var(--green-dark);margin-bottom:0.4rem}
  .form-group input,.form-group select,.form-group textarea{width:100%;padding:0.8rem 1rem;border:2px solid #e5eaf3;border-radius:10px;font-family:'Tajawal',sans-serif;font-size:1rem;color:#333;background:#fafbfd;transition:border-color .3s,box-shadow .3s;outline:none;box-sizing:border-box;direction:rtl}
  .form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--green-dark);box-shadow:0 0 0 3px rgba(27,58,107,.1);background:#fff}
  .form-group textarea{height:100px;resize:vertical}
  .form-submit-btn{width:100%;padding:1rem;background:linear-gradient(135deg,var(--green-dark),var(--green-mid));color:#fff;border:none;border-radius:12px;font-family:'Cairo',sans-serif;font-size:1.05rem;font-weight:700;cursor:pointer;transition:transform .3s,box-shadow .3s;display:flex;align-items:center;justify-content:center;gap:.5rem}
  .form-submit-btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(27,58,107,.25)}
  .success-message{display:none;background:linear-gradient(135deg,#e8f5e9,#f1f8e9);border:2px solid #4caf50;border-radius:12px;padding:1.5rem;text-align:center;margin-top:1rem}
  .success-message i{font-size:2.5rem;color:#4caf50;display:block;margin-bottom:.5rem}
  .success-message p{font-family:'Cairo',sans-serif;font-size:1.05rem;color:#2e7d32;font-weight:600}
  .quote-alt-card{background:linear-gradient(135deg,#25D366 0%,#128C7E 100%);border-radius:18px;padding:2.4rem;text-align:center;color:#fff;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:1rem}
  .quote-alt-card .wa-icon{font-size:3rem}
  .quote-alt-card h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:800}
  .quote-alt-card p{opacity:.92;line-height:1.8}
  @media(max-width:768px){.quote-grid{grid-template-columns:1fr}}
</style>

<section class="page-hero">
  <div class="container">
    <div class="page-hero-inner">
      <div class="page-hero-content">
        <nav class="breadcrumb">
          <a href="/">الرئيسية</a>
          <span>/</span>
          <a href="/alexandria">خدماتنا في الإسكندرية</a>
          <span>/</span>
          <span class="current">شركة كاميرات مراقبة في الإسكندرية</span>
        </nav>
        <h1 class="reveal">شركة كاميرات مراقبة في الإسكندرية</h1>
        <p class="lead reveal delay-1">معاينة مجانية، تركيب كاميرات IP وأنظمة DVR وNVR، مشاهدة عن بعد من هاتفك، وعقود صيانة سنوية تراعي رطوبة الساحل، بخبرة 27 عامًا</p>
      </div>
      <div class="page-hero-image">
        <img src="/images/webp-images/modern-cctv-camera-on-a-wall-with-a-blurred-multi-2026-01-08-06-13-58-utc.webp" alt="شركة كاميرات مراقبة في الإسكندرية" loading="eager">
      </div>
    </div>
  </div>
</section>

<section class="stats-section">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item reveal"><div class="stat-num" data-target="27" data-suffix="+">0+</div><div class="stat-label">سنة خبرة في تجهيز المنشآت</div></div>
      <div class="stat-item reveal delay-1"><div class="stat-num" data-target="4">0</div><div class="stat-label">أنواع كاميرات نوردها ونركبها</div></div>
      <div class="stat-item reveal delay-2"><div class="stat-num" data-target="2">0</div><div class="stat-label">ماركتان عالميتان بضمان رسمي</div></div>
      <div class="stat-item reveal delay-3"><div class="stat-num" data-target="1">0</div><div class="stat-label">معاينة مجانية قبل أي عرض سعر</div></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="intro-text" style="max-width:900px;margin:0 auto 48px;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>تبحث عن شركة كاميرات مراقبة في الإسكندرية تصمم لك نظامًا يحمي محلك أو شركتك فعلًا، لا مجرد كاميرات معلقة على الحائط؟ نيو جولدن أوفيس تعمل في تجهيز وخدمة منشآت الإسكندرية منذ 27 عامًا، من مقرنا الفعلي: 26 عبد المنعم سند، الإبراهيمية، باب شرق. نغطي المنظومة كاملة: معاينة الموقع مجانًا، اختيار أنواع الكاميرات المناسبة، التمديدات والتركيب، أجهزة التسجيل DVR وNVR، ضبط المتابعة من هاتفك، ثم الضمان وعقود الصيانة السنوية.</p>
      <p style="margin-top:16px">الرطوبة العالية والهواء المالح القريب من البحر في الإسكندرية يؤثران على معدات المراقبة الخارجية بشكل مختلف عن باقي المحافظات؛ الأسلاك والكابلات الرخيصة تتآكل أسرع، وأغطية الكاميرات غير المصممة للبيئة الساحلية تفقد وضوحها بسرعة أكبر. من خبرتنا المتراكمة في المدينة، نختار دائمًا خامات ومعدات تراعي هذا العامل المناخي الخاص بالإسكندرية تحديدًا، وهو تفصيل قد لا ينتبه له مورد من محافظة أخرى.</p>
      <p style="margin-top:16px;text-align:center">تعرف على <a href="/alexandria">خدماتنا الشاملة في الإسكندرية</a> بكل تخصصاتنا الستة.</p>
    </div>

    <div class="section-header">
      <h2>تركيب كاميرات مراقبة الاسكندرية — لماذا نيو جولدن أوفيس هي الأفضل؟</h2>
      <div class="divider"></div>
    </div>
    <div class="features-grid">
      <div class="feature-card reveal"><div class="feature-icon"><i class="fas fa-award"></i></div><h4>خبرة 27 عامًا</h4><p>في تجهيز وخدمة الشركات والمحلات، لا في بيع الأجهزة فقط.</p></div>
      <div class="feature-card reveal delay-1"><div class="feature-icon"><i class="fas fa-magnifying-glass-location"></i></div><h4>معاينة مجانية للموقع</h4><p>قبل أي عرض سعر، لأن التسعير الجاد يبدأ من فهم المكان.</p></div>
      <div class="feature-card reveal delay-2"><div class="feature-icon"><i class="fas fa-layer-group"></i></div><h4>منظومة أمنية متكاملة</h4><p>توريد وتركيب وبرمجة وتدريب وصيانة من جهة واحدة.</p></div>
      <div class="feature-card reveal delay-3"><div class="feature-icon"><i class="fas fa-water"></i></div><h4>أنظمة مقاسة على الساحل</h4><p>خامات تتحمل رطوبة البحر والإضاءة الخلفية القوية على واجهات الكورنيش.</p></div>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>أنواع كاميرات المراقبة التي نوردها ونركبها</h2>
      <div class="divider"></div>
    </div>
    <div class="services-grid">
      <div class="service-card reveal"><div class="service-icon"><i class="fas fa-video"></i></div><h3 class="service-title">كاميرات IP الشبكية</h3><p class="service-desc">تنقل الصورة رقميًا بجودة عالية، مع تحليل حركة وميزات ذكية. الخيار الأول للمنشآت التي تريد توسعًا مستقبليًا.</p><a href="/cameras/ip-wifi" class="btn btn-outline btn-sm">كاميرات IP وواي فاي <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal delay-1"><div class="service-icon"><i class="fas fa-cable-car"></i></div><h3 class="service-title">كاميرات AHD وTurbo HD</h3><p class="service-desc">أنظمة على الكابلات المحورية التقليدية بجودة HD وتكلفة اقتصادية.</p></div>
      <div class="service-card reveal delay-2"><div class="service-icon"><i class="fas fa-arrows-spin"></i></div><h3 class="service-title">كاميرات PTZ المتحركة</h3><p class="service-desc">تتحرك أفقيًا ورأسيًا وتقرب الصورة، مثالية للمخازن والجراجات والساحات الواسعة.</p></div>
      <div class="service-card reveal delay-3"><div class="service-icon"><i class="fas fa-moon"></i></div><h3 class="service-title">الرؤية الليلية الملونة ColorVu</h3><p class="service-desc">تحتفظ بالألوان في الإضاءة المنخفضة، فارق جوهري لتمييز لون سيارة أو ملابس ليلًا.</p></div>
    </div>
    <p style="max-width:800px;margin:24px auto 0;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)"><strong>معالجة الإضاءة الخلفية WDR</strong> أهم مواصفة للمنشآت السكندرية المطلة على البحر: بدونها يظهر الداخل من الباب مجرد ظل أسود أمام الضوء، ومعها يتوازن الداخل والخارج معًا.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>كاميرات مراقبة للمحلات والواجهات التجارية على الكورنيش</h2>
      <div class="divider"></div>
    </div>
    <div class="intro-text" style="max-width:900px;margin:0 auto;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>المحلات على الكورنيش وفي المناطق التجارية والسياحية لها طبيعة خاصة: حركة زبائن كثيفة، واجهات مفتوحة، وموسم صيفي يتضاعف فيه الازدحام. نظام كاميرات مراقبة للمحلات بالإسكندرية يجب أن يتعامل مع هذا كله: كاميرات تلتقط الوجوه بوضوح عند المداخل رغم الإضاءة الخلفية القوية القادمة من البحر، وتغطية للممرات ونقاط الدفع، وتسجيل يحتفظ بأيام الذروة كاملة.</p>
      <p style="margin-top:16px">في موسم الصيف تحديدًا، عندما تتضاعف حركة الزوار على الكورنيش والمناطق السياحية، نوصي بمراجعة سعة التخزين مسبقًا لضمان الاحتفاظ بفترة كافية من التسجيلات رغم زيادة الحركة اليومية أمام الكاميرات مقارنة بباقي شهور السنة.</p>
      <p style="margin-top:16px">نساعد أصحاب المحلات الموسمية على الكورنيش في ضبط النظام قبل بداية كل موسم صيفي، للتأكد من جاهزيته الكاملة قبل ذروة الإقبال على المدينة.</p>
      <p style="margin-top:16px">نقدم أيضًا فحصًا مجانيًا سريعًا لأنظمة عملائنا القائمة قبل بداية كل موسم صيفي، للتأكد من سلامة الكابلات ووضوح العدسات قبل ازدحام الطلبات في ذروة الموسم.</p>
      <p style="margin-top:16px">نتابع أيضًا عن قرب أي تحديثات تقنية جديدة في عالم كاميرات المراقبة، لنقترحها على عملائنا الحاليين إذا كانت تستحق الترقية فعليًا.</p>
      <p style="margin-top:16px">في مواسم الصيف تحديدًا، الازدحام يرفع مخاطر السرقات الخاطفة والخلافات أمام المحل، فيصبح التسجيل الواضح دليلك الأول. نصمم التغطية بحيث تخدمك في اليوم العادي وفي ذروة أغسطس بنفس الكفاءة.</p>
    </div>
    <div class="reveal" style="max-width:900px;margin:32px auto 0;border-radius:var(--radius-lg);overflow:hidden">
      <img src="/images/webp-images/modern-white-security-camera-technology-for-survei-2026-01-07-00-31-34-utc.webp" alt="كاميرات مراقبة للمحلات في الإسكندرية" loading="lazy" style="width:100%;height:340px;object-fit:cover;display:block">
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>كيف تحدد عدد ونوع الكاميرات المناسبة لموقعك؟</h2>
      <div class="divider"></div>
    </div>
    <div class="intro-text" style="max-width:900px;margin:0 auto;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>الخطأ الشائع هو حساب عدد الكاميرات بناءً على مساحة المكان فقط، بينما الطريقة الصحيحة هي تحديد نقاط التغطية الحرجة أولًا: المدخل الرئيسي، نقاط الدفع أو الخزينة، المخارج الجانبية، الممرات الطويلة، والزوايا العمياء التي لا تراها كاميرا أخرى. محل تجاري صغير قد يحتاج 4 كاميرات فقط إذا وُزعت بذكاء، بينما فيلا كبيرة بحديقة قد تحتاج 8 كاميرات أو أكثر لتغطية المحيط الخارجي والمداخل كلها.</p>
      <p style="margin-top:16px">نوع الكاميرا يحدده الموقع أيضًا: كاميرات Dome الداخلية أنسب للمحلات والمكاتب لأنها أقل استفزازًا بصريًا، وكاميرات Bullet الخارجية أكثر مقاومة للعوامل الجوية وتناسب الواجهات والمداخل. للمساحات المفتوحة الكبيرة كالمصانع والمخازن، كاميرات PTZ القابلة للتحكم في الاتجاه والتكبير توفر مرونة أكبر بعدد كاميرات أقل. فريقنا يعاين موقعك فعليًا قبل اقتراح أي توليفة نهائية.</p>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>علامات إن نظام المراقبة عندك محتاج صيانة أو ترقية</h2>
      <div class="divider"></div>
    </div>
    <div class="intro-text" style="max-width:900px;margin:0 auto;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>صورة ضبابية أو باهتة، توقف التسجيل بشكل متقطع، عدم القدرة على المشاهدة عن بُعد رغم اتصال الإنترنت، أو امتلاء الهاردسك بشكل متكرر أسرع من المعتاد — كل هذه علامات تستحق زيارة فحص. تجاهلها لفترة طويلة قد يعني أنك تكتشف عطلًا كاملًا في اللحظة التي تحتاج فيها فعليًا لمراجعة تسجيل حادثة معينة، وهي أسوأ لحظة ممكنة لاكتشاف أن النظام لا يعمل.</p>
      <p style="margin-top:16px">أنظمة المراقبة القديمة (أكثر من 5-6 سنوات) التي تعمل بتقنية تناظرية قديمة تستحق أيضًا مراجعة جدوى الترقية لنظام IP حديث، خاصة إذا كنت تحتاج دقة أعلى أو مشاهدة عن بُعد أكثر استقرارًا. نساعدك في تقييم النظام القائم مجانًا واقتراح الحل الأنسب اقتصاديًا.</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
