---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://newgoldenoffice.com/alexandria/office-setup#service",
      "url": "https://newgoldenoffice.com/alexandria/office-setup",
      "name": "تجهيز مكتب أو نشاط متكامل في الإسكندرية",
      "description": "تنسيق ست خدمات (طباعة، مستلزمات مكتبية، تكييفات، كاميرات مراقبة، ماكينات تصوير، ماكينات عد نقود) في مشروع تجهيز واحد للمكاتب والمحال الجديدة في الإسكندرية، بعقد وفاتورة ومندوب حساب واحد، ومقر فعلي تعاين فيه المعدات بنفسك.",
      "serviceType": "تجهيز مكاتب ومحال متكامل",
      "areaServed": { "@type": "City", "name": "الإسكندرية" },
      "provider": { "@id": "https://newgoldenoffice.com/#organization" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"هل لازم أطلب كل الخدمات مع بعض؟","acceptedAnswer":{"@type":"Answer","text":"لأ، ابدأ بأي خدمة أو خدمتين تحتاجهم فعلًا، وضيف الباقي على نفس الحساب وقت ما تحتاجه — المشروع مصمم يكبر معاك مش يبدأ كامل من أول يوم."}},
        {"@type":"Question","name":"إزاي بيتحدد ترتيب تنفيذ الخدمات؟","acceptedAnswer":{"@type":"Answer","text":"التكييف والتمديدات الكهربائية أولًا قبل ما تتقفل الحوائط، بعدها كابلات الشبكة وتركيب الكاميرات، بعدها الأثاث والمستلزمات وماكينات التصوير والعد، وآخر حاجة الطباعة والهوية البصرية عشان تتظبط على شكل المكان النهائي."}},
        {"@type":"Question","name":"ينفع أزور مقركم وأشوف الأجهزة قبل ما نبدأ المشروع؟","acceptedAnswer":{"@type":"Answer","text":"أكيد، وده فرق حقيقي عندنا في الإسكندرية. مقرنا في الإبراهيمية تقدر تزوره وتعاين ماكينات التصوير وماكينات عد النقود وعينات المطبوعات بنفسك قبل ما تلتزم بأي حاجة."}},
        {"@type":"Question","name":"هل السعر بيبقى أوفر لو حجزت أكثر من خدمة مع بعض؟","acceptedAnswer":{"@type":"Answer","text":"في الغالب أيوه، لأن حجم التعاقد الأكبر بيدّينا مساحة نرشحلك فيها شروط أفضل. السعر النهائي بيتحدد حسب مواصفات كل خدمة، فابعتلنا التفاصيل ويوصلك عرض واحد شامل."}},
        {"@type":"Question","name":"مين المسؤول عن تنسيق الفرق المختلفة؟","acceptedAnswer":{"@type":"Answer","text":"مندوب حساب واحد بيتابع مشروعك من المعاينة للتسليم، وبما إن فريقنا كله داخل المدينة، التنسيق والاستجابة بيكونوا أسرع من مشروع بيتابعه فريق من محافظة تانية."}},
        {"@type":"Question","name":"كام مدة تنفيذ مشروع تجهيز متكامل عادةً؟","acceptedAnswer":{"@type":"Answer","text":"بيعتمد على حجم المكان وعدد الخدمات، بس كمتوسط: مكتب أو محل متوسط الحجم بياخد من أسبوعين لأربع أسابيع من المعاينة للتسليم النهائي."}},
        {"@type":"Question","name":"هل ينفع أبدأ بالتكييف والكاميرات بس وأأجل الطباعة لبعدين؟","acceptedAnswer":{"@type":"Answer","text":"أكيد، وده الترتيب المنطقي أصلًا. نجهزلك خطة مرحلية توضح إيه اللي لازم يتنفذ الأول وإيه اللي ينفع يتأجل لميزانية تانية، من غير ما يتأثر باقي المشروع."}},
        {"@type":"Question","name":"هل تقدروا تشتغلوا بره ساعات العمل عشان منوقفش النشاط؟","acceptedAnswer":{"@type":"Answer","text":"نعم، خصوصًا في مشروعات توسعة مكان قائم أو محل شغال. نتفق مع مندوب حسابك على جدول تنفيذ بره ساعات الذروة أو في أيام محددة يقل فيها التأثير على نشاطك."}},
        {"@type":"Question","name":"هل فيه ضمان موحد على كل الخدمات المنسقة؟","acceptedAnswer":{"@type":"Answer","text":"نعم، عقد وفاتورة واحدة يعني ضمان موثق وواضح لكل بند بدل ما تلاحق ست ضمانات من ست جهات مختلفة لو حصلت مشكلة في أي جزء من المشروع."}}
      ]
    }
  ]
});
---

<BaseLayout
  title="تجهيز مكتب أو نشاط متكامل في الإسكندرية — طباعة وتكييف وكاميرات ومستلزمات | نيو جولدن أوفيس"
  description="بتجهّز مكتب أو محل جديد في الإسكندرية؟ ننسق التكييف والكاميرات والمستلزمات المكتبية وماكينات التصوير والعد والطباعة في مشروع واحد، ومقرنا الفعلي تقدر تزوره وتعاين المعدات بنفسك."
  keywords="تجهيز مكتب متكامل الإسكندرية، تجهيز محل جديد الإسكندرية، تأسيس نشاط الإسكندرية"
  ogTitle="تجهيز مكتب أو نشاط متكامل في الإسكندرية | نيو جولدن أوفيس"
  ogDescription="ننسق ست خدمات تجهيز المكاتب والمحال في مشروع واحد بعقد وفاتورة ومندوب حساب واحد — الإسكندرية."
  ogImage="/images/about-team.webp"
  schemaJson={schemaJson}
>
<style>
  .quote-section{padding:60px 0}
  .quote-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:stretch}
  .quote-form-card{background:#fff;border-radius:18px;padding:2.2rem;box-shadow:0 4px 24px rgba(27,58,107,0.1)}
  .quote-form-card h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:700;color:var(--green-dark);margin-bottom:1.5rem}
  .form-group{margin-bottom:1.1rem}
  .form-group label{display:block;font-family:'Cairo',sans-serif;font-size:0.95rem;font-weight:600;color:var(--green-dark);margin-bottom:0.4rem}
  .form-group input,.form-group select,.form-group textarea{width:100%;padding:0.8rem 1rem;border:2px solid #e5eaf3;border-radius:10px;font-family:'Tajawal',sans-serif;font-size:1rem;color:#333;background:#fafbfd;transition:border-color .3s,box-shadow .3s;outline:none;box-sizing:border-box;direction:rtl}
  .form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--green-dark);box-shadow:0 0 0 3px rgba(27,58,107,.1);background:#fff}
  .form-group textarea{height:100px;resize:vertical}
  .checkbox-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .checkbox-item{display:flex;align-items:center;gap:8px;font-family:'Tajawal',sans-serif;font-size:0.92rem;color:#333}
  .checkbox-item input{width:auto}
  .form-submit-btn{width:100%;padding:1rem;background:linear-gradient(135deg,var(--green-dark),var(--green-mid));color:#fff;border:none;border-radius:12px;font-family:'Cairo',sans-serif;font-size:1.05rem;font-weight:700;cursor:pointer;transition:transform .3s,box-shadow .3s;display:flex;align-items:center;justify-content:center;gap:.5rem}
  .form-submit-btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(27,58,107,.25)}
  .success-message{display:none;background:linear-gradient(135deg,#e8f5e9,#f1f8e9);border:2px solid #4caf50;border-radius:12px;padding:1.5rem;text-align:center;margin-top:1rem}
  .success-message i{font-size:2.5rem;color:#4caf50;display:block;margin-bottom:.5rem}
  .success-message p{font-family:'Cairo',sans-serif;font-size:1.05rem;color:#2e7d32;font-weight:600}
  .quote-alt-card{background:linear-gradient(135deg,#25D366 0%,#128C7E 100%);border-radius:18px;padding:2.4rem;text-align:center;color:#fff;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:1rem}
  .quote-alt-card .wa-icon{font-size:3rem}
  .quote-alt-card h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:800}
  .quote-alt-card p{opacity:.92;line-height:1.8}
  @media(max-width:768px){.quote-grid{grid-template-columns:1fr}.checkbox-grid{grid-template-columns:1fr}}
</style>

<section class="page-hero">
  <div class="container">
    <div class="page-hero-inner">
      <div class="page-hero-content">
        <nav class="breadcrumb">
          <a href="/">الرئيسية</a>
          <span>/</span>
          <a href="/alexandria">خدماتنا في الإسكندرية</a>
          <span>/</span>
          <span class="current">تجهيز مكتب متكامل</span>
        </nav>
        <h1 class="reveal">تجهيز مكتب أو نشاط متكامل في الإسكندرية</h1>
        <p class="lead reveal delay-1">بتجهّز مكتب أو محل جديد؟ ننسق التكييف والكاميرات والمستلزمات المكتبية وماكينات التصوير والعد والطباعة في مشروع واحد، ومقرنا الفعلي بالإبراهيمية تقدر تزوره وتعاين المعدات بنفسك قبل ما تلتزم</p>
      </div>
      <div class="page-hero-image">
        <img src="/images/webp-images/business-professionals-meeting-at-conference-room-2026-01-05-00-29-12-utc.webp" alt="تجهيز مكتب متكامل في الإسكندرية" loading="eager">
      </div>
    </div>
  </div>
</section>

<section class="stats-section">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item reveal">
        <div class="stat-num" data-target="6">0</div>
        <div class="stat-label">خدمات تحت مشروع واحد</div>
      </div>
      <div class="stat-item reveal delay-1">
        <div class="stat-num" data-target="1">0</div>
        <div class="stat-label">مندوب حساب يتابع المشروع كامل</div>
      </div>
      <div class="stat-item reveal delay-2">
        <div class="stat-num" data-target="4">0</div>
        <div class="stat-label">مراحل تنفيذ مرتبة</div>
      </div>
      <div class="stat-item reveal delay-3">
        <div class="stat-num" data-target="1">0</div>
        <div class="stat-label">مقر فعلي تعاين فيه المعدات</div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="intro-text" style="max-width:900px;margin:0 auto 48px;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>لما تجهّز مكتب أو محل جديد، المشكلة الحقيقية مش في اختيار الأجهزة، المشكلة في التنسيق: فريق التكييف بييجي قبل الكهربائي، فريق الكاميرات بيلاقي الحوائط اتقفلت، والمطبوعات بتتأخر لحد ما يتحدد شكل المكان النهائي. نيو جولدن أوفيس بتاخد المشكلة دي منك: مندوب حساب واحد بيبني خطة تنفيذ مرحلية للست خدمات بترتيب صح من أول يوم، وبما إن مقرنا وفريقنا داخل الإسكندرية، تقدر تزورنا وتعاين المعدات بنفسك قبل ما تلتزم بأي حاجة.</p>
      <p style="margin-top:16px">الخدمة دي مش موجهة بس لمشروعات كبيرة. صاحب صيدلية بيفتتح فرع تاني، أو عيادة بتنقل لعيادة أوسع، أو شركة صغيرة بتوسع مكتبها من غرفتين لثلاث غرف، كلهم بيستفيدوا من نفس فكرة التنسيق المركزي: خطة واحدة، مندوب واحد، وفاتورة واحدة، بدل ما يبقى كل جزء من التجهيز مشروعًا منفصلًا بحد ذاته يحتاج متابعة مستقلة.</p>
    </div>

    <div class="section-header">
      <h2>الست خدمات اللي بتتنسق في مشروعك</h2>
      <div class="divider"></div>
    </div>
    <div class="services-grid">
      <div class="service-card reveal"><div class="service-icon"><i class="fas fa-snowflake"></i></div><h3 class="service-title">التكييفات</h3><p class="service-desc">أول مرحلة تنفيذ — قبل ما تتقفل الحوائط أو يتركّب أي جهاز حساس.</p><a href="/alexandria/ac" class="btn btn-outline btn-sm">التفاصيل <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal delay-1"><div class="service-icon"><i class="fas fa-video"></i></div><h3 class="service-title">كاميرات المراقبة</h3><p class="service-desc">تمديد كابلات الشبكة وتركيب الكاميرات بعد التكييف مباشرة.</p><a href="/alexandria/cameras" class="btn btn-outline btn-sm">التفاصيل <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal delay-2"><div class="service-icon"><i class="fas fa-copy"></i></div><h3 class="service-title">ماكينات تصوير المستندات</h3><p class="service-desc">عايناها بنفسك في مقرنا قبل ما تتركّب في مكتبك.</p><a href="/alexandria/copiers" class="btn btn-outline btn-sm">التفاصيل <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal delay-3"><div class="service-icon"><i class="fas fa-pen-ruler"></i></div><h3 class="service-title">الأدوات والمستلزمات المكتبية</h3><p class="service-desc">توريد أول دفعة تجهيز مع بدء عقد التوريد الدوري.</p><a href="/alexandria/office-supplies" class="btn btn-outline btn-sm">التفاصيل <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal"><div class="service-icon"><i class="fas fa-money-bill-wave"></i></div><h3 class="service-title">ماكينات عد النقود</h3><p class="service-desc">للمحال والفروع اللي بتتعامل نقدي، بتتركب مع باقي المعدات.</p><a href="/alexandria/cash-machines" class="btn btn-outline btn-sm">التفاصيل <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal delay-1"><div class="service-icon"><i class="fas fa-print"></i></div><h3 class="service-title">الطباعة والهوية البصرية</h3><p class="service-desc">آخر مرحلة عمدًا — بعد ما تتأكد من شكل المكان النهائي.</p><a href="/alexandria/printing" class="btn btn-outline btn-sm">التفاصيل <i class="fas fa-arrow-left"></i></a></div>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>إزاي بيتم تنفيذ مشروع تجهيز متكامل؟</h2>
      <div class="divider"></div>
    </div>
    <div class="steps-grid">
      <div class="step-card reveal">
        <div class="step-num">1</div>
        <h4>معاينة شاملة</h4>
        <p>مندوب حسابك ييجي يعاين المكان، يشوف القدرة الكهربائية، توزيع المساحة، ونقاط التركيب المطلوبة لكل خدمة.</p>
      </div>
      <div class="step-card reveal delay-1">
        <div class="step-num">2</div>
        <h4>خطة تنفيذ مرحلية</h4>
        <p>يوصلك جدول زمني واضح: التكييف والكهرباء، بعدين الشبكة والكاميرات، بعدين الأثاث والمستلزمات، وأخيرًا الطباعة والهوية.</p>
      </div>
      <div class="step-card reveal delay-2">
        <div class="step-num">3</div>
        <h4>تنفيذ منسّق</h4>
        <p>كل فريق بييجي في موعده المحدد من غير تعارض، وبما إننا داخل المدينة الاستجابة والمتابعة أسرع.</p>
      </div>
      <div class="step-card reveal delay-3">
        <div class="step-num">4</div>
        <h4>تسليم واحد وضمان موحد</h4>
        <p>تستلم المكان جاهز بالكامل، بعقد وفاتورة وضمان موحد، مش أوراق متفرقة من ست جهات.</p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>ما الذي يحدد تكلفة مشروع التجهيز الكامل؟</h2>
      <div class="divider"></div>
    </div>
    <div class="intro-text" style="max-width:900px;margin:0 auto;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p style="text-align:center">لا يوجد رقم إجمالي ثابت لمشروع تجهيز، لأن كل مشروع مختلف في احتياجه. لكن أهم العوامل التي تحدد التكلفة الإجمالية:</p>
      <ul style="max-width:750px;margin:24px auto 0;padding-inline-start:20px;line-height:2.1">
        <li><strong>مساحة المكان وعدد الغرف:</strong> تحدد عدد وحدات التكييف والكاميرات المطلوبة وكمية المستلزمات.</li>
        <li><strong>عدد الخدمات المطلوبة معًا:</strong> مشروع يشمل الست خدمات مختلف عن مشروع يبدأ بخدمتين فقط.</li>
        <li><strong>حالة البنية التحتية الحالية:</strong> مكان جاهز للتشطيب يختلف تكلفة عن مكان يحتاج تعديلات كهربائية أولًا.</li>
        <li><strong>فئة المعدات المختارة:</strong> اقتصادية أم احترافية، في كل خدمة من الست خدمات.</li>
        <li><strong>هل هناك عقد صيانة سنوي مصاحب:</strong> يضاف كبند منفصل واضح في نفس العرض.</li>
      </ul>
      <p style="margin-top:20px;text-align:center">لهذا نبني عرض السعر بعد المعاينة أو بعد مراجعة تفاصيلك الدقيقة، ونقدمه لك مقسّمًا على كل خدمة حتى ترى بوضوح إلى أين يذهب كل جنيه، بدل رقم إجمالي غامض.</p>
    </div>
  </div>
</section>

<MidPageCTA formId="alexSetupMidCta" />

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>لمين الخدمة دي؟</h2>
      <div class="divider"></div>
    </div>
    <div class="features-grid">
      <div class="feature-card reveal"><div class="feature-icon"><i class="fas fa-building"></i></div><h4>مكتب أو محل جديد بالكامل</h4><p>نشاط بيفتتح لأول مرة في الإسكندرية ومحتاج تجهيز من الصفر بميعاد افتتاح محدد.</p></div>
      <div class="feature-card reveal delay-1"><div class="feature-icon"><i class="fas fa-arrows-up-down-left-right"></i></div><h4>توسعة مكان قائم</h4><p>مكتب أو محل موجود بيكبّر مساحته ومحتاج يضيف تكييف وكاميرات ومعدات إضافية.</p></div>
      <div class="feature-card reveal delay-2"><div class="feature-icon"><i class="fas fa-truck-moving"></i></div><h4>نقل مقر بالكامل</h4><p>نشاط بينقل مكانه ومحتاج كل حاجة تتظبط قبل يوم الانتقال، من التكييف للهوية البصرية.</p></div>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>الميزانية والتخطيط: من أين نبدأ؟</h2>
      <div class="divider"></div>
    </div>
    <div class="intro-text" style="max-width:900px;margin:0 auto;line-height:2;font-size:1.05rem;color:var(--text-muted)">
