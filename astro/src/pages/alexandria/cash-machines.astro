---
import Img from '../../components/Img.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';
import CashMachineComparison from '../../components/CashMachineComparison.astro';
import CashMachineFaults from '../../components/CashMachineFaults.astro';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://newgoldenoffice.com/alexandria/cash-machines#service",
      "name": "شراء ماكينات عد نقود وكشف تزييف في الإسكندرية",
      "serviceType": "توريد وصيانة ماكينات عد النقود وأجهزة كشف تزييف العملة",
      "url": "https://newgoldenoffice.com/alexandria/cash-machines",
      "provider": { "@id": "https://newgoldenoffice.com/#organization" },
      "areaServed": { "@type": "City", "name": "الإسكندرية" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"ما أسعار ماكينات عد النقود في الإسكندرية؟","acceptedAnswer":{"@type":"Answer","text":"تختلف حسب النوع (عد فقط، عد مع كشف، عد وفرز) والسرعة والماركة. تواصل معنا وستصلك قائمة أسعار محدثة في نفس اليوم."}},
        {"@type":"Question","name":"هل يمكن لماكينة عد النقود كشف التزوير؟","acceptedAnswer":{"@type":"Answer","text":"نعم، أغلب الموديلات تجمع بين العد وكشف التزييف بتقنيات UV وMG وIR."}},
        {"@type":"Question","name":"ما الفرق بين ماكينة العد فقط والعد مع الفرز وكشف التزوير؟","acceptedAnswer":{"@type":"Answer","text":"العد فقط يعطي عدد الأوراق، والعد مع الكشف يفحص التزييف، والعد والفرز يضيف فصل الفئات وقراءة القيمة."}},
        {"@type":"Question","name":"هل تدعم الماكينة الجنيه المصري والدولار واليورو؟","acceptedAnswer":{"@type":"Answer","text":"كل الموديلات تدعم الجنيه، وتتوفر موديلات تدعم الدولار واليورو أيضًا."}},
        {"@type":"Question","name":"هل يوجد ضمان وصيانة وقطع غيار في الإسكندرية؟","acceptedAnswer":{"@type":"Answer","text":"نعم، ضمان مكتوب وصيانة وقطع غيار من داخل الإسكندرية بلا شحن لمحافظة أخرى."}},
        {"@type":"Question","name":"هل يمكن تجربة الماكينة قبل الشراء؟","acceptedAnswer":{"@type":"Answer","text":"لا تتوفر تجربة الماكينة قبل الشراء، لكن كل ماكينة مشمولة بالضمان: إذا ظهرت بها أي مشكلة نسترجعها أو نستبدلها لك."}},
        {"@type":"Question","name":"كيف أختار ماكينة عد النقود المناسبة لنشاطي؟","acceptedAnswer":{"@type":"Answer","text":"حدد حجم تعاملاتك اليومية وهل تحتاج كشف تزييف وفرز فئات، ونرشح لك الأنسب."}},
        {"@type":"Question","name":"ما الذي يحدد سعر ماكينة عد النقود؟","acceptedAnswer":{"@type":"Answer","text":"الوظيفة (عد فقط أم كشف أم فرز)، سرعة العد، عدد تقنيات الكشف، دعم العملات الأجنبية، متانة الاستخدام، وحجم التعاقد إن كنت تجهز أكثر من فرع."}},
        {"@type":"Question","name":"لماذا تنحشر الأوراق داخل ماكينة العد أو تُقرأ أكثر من ورقة معًا؟","acceptedAnswer":{"@type":"Answer","text":"غالبًا بسبب اتساخ رولات السحب المطاطية أو رطوبة زائدة في الأوراق، والحل تنظيف الرولات ومساري السحب بانتظام."}},
        {"@type":"Question","name":"هل تحدّثون الجهاز عند صدور فئات جديدة من الجنيه المصري؟","acceptedAnswer":{"@type":"Answer","text":"نعم، نجري تحديثًا برمجيًا أو معايرة عند صدور فئات أو تصميمات جديدة للعملة حتى يستمر الجهاز في التعرف عليها بدقة."}},
        {"@type":"Question","name":"هل رطوبة الجو في الإسكندرية تؤثر على أداء ماكينة العد؟","acceptedAnswer":{"@type":"Answer","text":"الرطوبة والغبار الساحلي يؤثران على الحساسات ورولات السحب مع الوقت، لذا ننصح بتنظيف دوري وحفظ الجهاز بعيدًا عن الرطوبة المباشرة عند الإغلاق."}}
      ]
    }
  ]
});
---

<BaseLayout
  title="شركة ماكينات عد نقود في الإسكندرية | ضمان وصيانة محلية"
  description="شركة ماكينات عد نقود في الإسكندرية بخبرة 27 عامًا. أنواع وماركات ماكينات عد الفلوس وكشف تزييف العملة، ضمان وصيانة محلية وعرض سعر سريع. تواصل الآن."
  keywords="شركة ماكينات عد نقود في الإسكندرية، ماكينة عد فلوس الاسكندرية، جهاز كشف تزييف العملة الاسكندرية"
  ogTitle="شركة ماكينات عد نقود في الإسكندرية | نيو جولدن أوفيس"
  ogDescription="أنواع وماركات ماكينات عد الفلوس وكشف تزييف العملة، ضمان وصيانة محلية في الإسكندرية."
  ogImage="/images/alexandria-cash-machines-hero.webp"
  schemaJson={schemaJson}
>
<style>
  .quote-section{padding:60px 0}
  .quote-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:stretch}
  .quote-form-card{background:#fff;border-radius:18px;padding:2.2rem;box-shadow:0 4px 24px rgba(27,58,107,0.1)}
  .quote-form-card h3,.quote-form-card .as-h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:700;color:var(--green-dark);margin-bottom:1.5rem}
  .form-group{margin-bottom:1.1rem}
  .form-group label{display:block;font-family:'Cairo',sans-serif;font-size:0.95rem;font-weight:600;color:var(--green-dark);margin-bottom:0.4rem}
  .form-group input,.form-group select,.form-group textarea{width:100%;padding:0.8rem 1rem;border:2px solid #e5eaf3;border-radius:10px;font-family:'Tajawal',sans-serif;font-size:1rem;color:#333;background:#fafbfd;transition:border-color .3s,box-shadow .3s;outline:none;box-sizing:border-box;direction:rtl}
  .form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--green-dark);box-shadow:0 0 0 3px rgba(27,58,107,.1);background:#fff}
  .form-group textarea{height:100px;resize:vertical}
  .form-submit-btn{width:100%;padding:1rem;background:linear-gradient(135deg,var(--green-dark),var(--green-mid));color:#fff;border:none;border-radius:12px;font-family:'Cairo',sans-serif;font-size:1.05rem;font-weight:700;cursor:pointer;transition:transform .3s,box-shadow .3s;display:flex;align-items:center;justify-content:center;gap:.5rem}
  .form-submit-btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(27,58,107,.25)}
  .success-message{display:none;background:linear-gradient(135deg,#e8f5e9,#f1f8e9);border:2px solid #4caf50;border-radius:12px;padding:1.5rem;text-align:center;margin-top:1rem}
  .success-message i{font-size:2.5rem;color:#4caf50;display:block;margin-bottom:.5rem}
  .success-message p{font-family:'Cairo',sans-serif;font-size:1.05rem;color:#2e7d32;font-weight:600}
  .quote-alt-card{background:linear-gradient(135deg,#25D366 0%,#128C7E 100%);border-radius:18px;padding:2.4rem;text-align:center;color:#fff;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:1rem}
  .quote-alt-card .wa-icon{font-size:3rem}
  .quote-alt-card h3,.quote-alt-card .as-h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:800}
  .quote-alt-card p{opacity:.92;line-height:1.8}
  @media(max-width:768px){.quote-grid{grid-template-columns:1fr}}
</style>

<section class="page-hero">
  <div class="container">
    <div class="page-hero-inner">
      <div class="page-hero-content">
        <nav class="breadcrumb">
          <a href="/">الرئيسية</a>
          <span>/</span>
          <a href="/alexandria">خدماتنا في الإسكندرية</a>
          <span>/</span>
          <span class="current">شركة ماكينات عد نقود في الإسكندرية</span>
        </nav>
        <h1 class="reveal">شركة ماكينات عد نقود في الإسكندرية</h1>
        <p class="lead reveal delay-1">ماكينات عد الفلوس وكشف تزييف العملة، تجربة حقيقية في مقرنا قبل الشراء، ضمان وصيانة محلية بخبرة 27 عامًا</p>
      </div>
      <div class="page-hero-image">
        <Img src="/images/webp-images/counting-cash-with-a-money-counter-machine-2026-03-25-00-56-49-utc.webp" alt="شركة ماكينات عد نقود في الإسكندرية" preset="hero" priority />
      </div>
    </div>
  </div>
</section>

<section class="stats-section">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item reveal"><div class="stat-num" data-target="27" data-suffix="+">0+</div><div class="stat-label">سنة خبرة في السوق المصري</div></div>
      <div class="stat-item reveal delay-1"><div class="stat-num" data-target="5000" data-suffix="+">0+</div><div class="stat-label">عميل في جميع أنحاء مصر</div></div>
      <div class="stat-item reveal delay-2"><div class="stat-num stat-text">كل الماركات</div><div class="stat-label">المتاحة في السوق، بيعًا وصيانة</div></div>
      <div class="stat-item reveal delay-3"><div class="stat-num" data-target="4">0</div><div class="stat-label">أنواع ماكينات: عد، كشف، فرز، وكثيف الاستخدام</div></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>ماكينات عد النقود وكشف التزييف في الإسكندرية</h2>
      <div class="divider"></div>
    </div>
    <div class="intro-text" style="max-width:900px;margin:0 auto;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>ماكينة عد النقود تعد رزمة 100 ورقة في ثوانٍ وتفحص كل ورقة أثناء مرورها، فتختصر وقت تقفيل الخزينة وتمنع أخطاء العد اليدوي وتلتقط الورقة المزيفة قبل أن تدخل درجك. كشركة ماكينات عد نقود في الإسكندرية نوفر كل فئاتها: ماكينات العد فقط، وماكينات العد مع كشف التزييف بتقنيات UV وMG وIR، وماكينات العد والفرز التي تقرأ قيمة كل ورقة وتعطيك إجمالي الرزمة المختلطة بالجنيه، وأجهزة كشف التزييف المستقلة لنقطة البيع.</p>
      <p style="margin-top:16px">نتعامل مع كل الماركات المتاحة في السوق، من Glory وKisan وMagner في الفئة الاحترافية حتى الموديلات الاقتصادية للمحلات الصغيرة، ونوفر معها الصيانة وقطع الغيار. الموديل المناسب يتحدد بحجم تعاملك اليومي، وهل تستقبل رزمًا مختلطة الفئات، وهل تتعامل بالدولار واليورو بجانب الجنيه.</p>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>ماكينة عد فلوس الاسكندرية: أنواع ماكينات عد النقود وأيها يناسبك؟</h2>
      <div class="divider"></div>
    </div>
    <div class="services-grid">
      <div class="service-card reveal"><div class="service-icon"><i class="fas fa-coins"></i></div><h3 class="service-title">ماكينة عد فقط</h3><p class="service-desc">تعد الأوراق بسرعة وتعطيك العدد الإجمالي. الخيار الاقتصادي للمحل ذي المخاطر المنخفضة.</p><a href="/cash-machines/counting" class="btn btn-outline-primary btn-sm">ماكينات عد النقود <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal delay-1"><div class="service-icon"><i class="fas fa-magnifying-glass"></i></div><h3 class="service-title">ماكينة عد مع كشف تزييف</h3><p class="service-desc">الفئة الأكثر طلبًا: تعد وتفحص كل ورقة بتقنيات UV وMG وIR أثناء المرور.</p><a href="/cash-machines/detector" class="btn btn-outline-primary btn-sm">أجهزة كشف العملة المزيفة <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal delay-2"><div class="service-icon"><i class="fas fa-layer-group"></i></div><h3 class="service-title">ماكينة عد وفرز العملات</h3><p class="service-desc">تفصل الفئات المختلطة وتقرأ قيمة كل ورقة، مناسبة للصرافة والبنوك.</p><a href="/cash-machines/counting" class="btn btn-outline-primary btn-sm">ماكينات عد وفرز النقود <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal delay-3"><div class="service-icon"><i class="fas fa-industry"></i></div><h3 class="service-title">ماكينات كثيفة الاستخدام</h3><p class="service-desc">للتشغيل المتواصل ساعات طويلة: خزانات أكبر وأجزاء أمتن، خيار البنوك وشركات التحصيل.</p><a href="/cash-machines/counting" class="btn btn-outline-primary btn-sm">عد نقود كثيف الاستخدام <i class="fas fa-arrow-left"></i></a></div>
    </div>
  </div>
</section>

<CashMachineComparison />

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>كشف تزييف العملة: كيف يعمل ومتى تحتاجه؟</h2>
      <div class="divider"></div>
    </div>
    <div class="intro-text" style="max-width:900px;margin:0 auto;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>لتاجر التجزئة، ورقة نقدية مزيفة واحدة تُقبل بالخطأ تعني خسارة كاملة لقيمتها. أجهزة كشف التزييف تحسم الفحص في ثوانٍ بثلاث تقنيات: الأشعة فوق البنفسجية UV تكشف العلامات الفلورية، الحبر المغناطيسي MG يتحقق من خصائص حبر الطباعة الرسمي، والأشعة تحت الحمراء IR تقرأ الأنماط غير المرئية. كثير من محلات الإسكندرية تستخدم جهاز كشف مستقل عند نقطة البيع مع كشف مدمج في ماكينة العد عند إغلاق الخزينة.</p>
      <p style="margin-top:16px">الجمع بين الطريقتين (جهاز كشف مستقل عند البيع، وماكينة عد بكشف مدمج عند التسوية) يوفر طبقتين من الحماية بدل الاعتماد على فحص واحد فقط. هذا مهم بشكل خاص للمحلات التي تستقبل عملاء غير معروفين طوال اليوم، حيث لا يمكن الاعتماد على الفحص البصري وحده مهما كانت خبرة الموظف في التعامل مع النقود.</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>تجار المنشية والعطارين: تجهيز الأسواق التقليدية</h2>
      <div class="divider"></div>
    </div>
    <div class="intro-text" style="max-width:900px;margin:0 auto;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>الأسواق التجارية التقليدية في المنشية والعطارين تعمل بإيقاع خاص: تعاملات نقدية كثيفة طوال اليوم، رزم فئات مختلطة، وتصفية يومية للخزينة. ماكينة عد بكشف مدمج ليست رفاهية هنا بل أداة تشغيل يومية، ولأن مقرنا داخل الإسكندرية فالمعاينة والتسليم والدعم كلها قريبة من محلك في السوق.</p>
      <p style="margin-top:16px">أصحاب المحلات في هذه الأسواق غالبًا يفضلون أجهزة بسيطة الاستخدام لا تحتاج تدريبًا معقدًا للموظفين، مع متانة تتحمل الاستخدام المكثف اليومي لساعات طويلة دون تسخين أو تعطل. نراعي هذا التوازن بين البساطة والمتانة عند ترشيح الجهاز المناسب لهذا النوع من الأنشطة التجارية اليومية المزدحمة.</p>
    </div>
    <div class="reveal" style="max-width:900px;margin:32px auto 0;border-radius:var(--radius-lg);overflow:hidden">
      <Img src="/images/webp-images/hands-putting-cash-counter-close-up-worker-calcul-2026-03-11-01-02-02-utc.webp" alt="ماكينات عد نقود للأسواق التقليدية بالإسكندرية" preset="content" style="width:100%;height:340px;object-fit:cover;display:block" />
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>كيف تختار ماكينة العد المناسبة لطبيعة نشاطك؟</h2>
      <div class="divider"></div>
    </div>
    <div class="intro-text" style="max-width:900px;margin:0 auto;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>محلات الصرافة والبنوك في وسط البلد تحتاج ماكينة عد مختلطة الفئات بسرعة عالية وتقنيات كشف تزييف متعددة (UV+MG+IR) لأن الحجم اليومي كبير ولا مجال لخطأ في التسوية. أما محلات السوبر ماركت والصيدليات في سموحة وسيدي جابر فتحتاج أولوية لسرعة إغلاق الكاشير آخر الوردية، فماكينة اقتصادية بكشف UV+MG الأساسي تكون كافية تمامًا.</p>
      <p style="margin-top:16px">شركات الاستيراد والتصدير قرب الميناء غالبًا تحتاج جهازًا محمولًا يمكن نقله بين المكاتب أو المخازن، بينما محلات الصاغة والمجوهرات في المنطقة التجارية تحتاج دقة عالية جدًا في الكشف عن أوراق النقد الأجنبي المستخدمة في التعاملات الكبيرة. فريقنا يرشح الماكينة المناسبة بعد فهم حجم وطبيعة تعاملاتك النقدية اليومية.</p>
    </div>
  </div>
</section>

<MidPageCTA formId="cashAlexandriaMidCta" />

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>دليل الاختيار حسب نشاطك</h2>
      <div class="divider"></div>
    </div>
    <div class="features-grid">
      <div class="feature-card reveal"><div class="feature-icon"><i class="fas fa-prescription-bottle-medical"></i></div><h3>صيدلية أو محل صغير</h3><p>ماكينة عد بكشف تزييف مدمج من الفئة الاقتصادية، سهلة الاستخدام وموثوقة.</p></div>
      <div class="feature-card reveal delay-1"><div class="feature-icon"><i class="fas fa-cart-shopping"></i></div><h3>سوبرماركت أو سلسلة محلات</h3><p>ماكينة عد وكشف بسرعة أعلى وخزان أكبر يناسب ذروة العمل اليومية.</p></div>
      <div class="feature-card reveal delay-2"><div class="feature-icon"><i class="fas fa-money-bill-transfer"></i></div><h3>صرافة</h3><p>ماكينة عد وفرز تقرأ قيمة الورقة وتدعم عملات متعددة بدقة عالية.</p></div>
      <div class="feature-card reveal delay-3"><div class="feature-icon"><i class="fas fa-building-columns"></i></div><h3>بنك أو شركة تحصيل</h3><p>فئة كثيفة الاستخدام بعقد صيانة سنوي وزمن استجابة متفق عليه كتابيًا.</p></div>
    </div>
  </div>
</section>

<CashMachineFaults city="الإسكندرية" />

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>الضمان والصيانة وقطع الغيار داخل الإسكندرية</h2>
      <div class="divider"></div>
    </div>
    <div class="steps-grid">
      <div class="step-card reveal"><div class="step-num">1</div><h3>ضمان حقيقي</h3><p>على الأجهزة الجديدة، بشروط واضحة تستلمها مكتوبة مع الفاتورة دون أي غموض.</p></div>
