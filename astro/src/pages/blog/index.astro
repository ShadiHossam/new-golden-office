---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import BlogGrid from '../../components/BlogGrid.astro';
import { getSortedPosts, countPages, POSTS_PER_PAGE } from '../../lib/blog-list';

const posts = await getSortedPosts();
const totalPages = countPages(posts.length);
const pagePosts = posts.slice(0, POSTS_PER_PAGE);

// hasPart lists every post in the series, not just this page's slice, so the
// collection stays a complete description of the blog.
const collectionSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'مدونة نيو جولدن أوفيس',
  url: 'https://newgoldenoffice.com/blog',
  ...(posts.length
    ? {
        hasPart: posts.map((p) => ({
          '@type': 'Article',
          headline: p.title,
          url: `https://newgoldenoffice.com/blog/${p.slug}`,
        })),
      }
    : {}),
});
---

<BaseLayout
  title="مدونة نيو جولدن أوفيس | نصائح المستلزمات المكتبية والطباعة"
  description="مقالات ونصائح من نيو جولدن أوفيس حول مستلزمات مكتبية، خدمات الطباعة، ماكينات التصوير، كاميرات المراقبة، والتكييفات في مصر."
  ogTitle="مدونة نيو جولدن أوفيس"
  ogDescription="مقالات ونصائح حول مستلزمات مكتبية وخدمات الطباعة وأنظمة الأمان في مصر."
  schemaJson={collectionSchema}
>
<PageHero
  title="المدونة"
  subtitle="مقالات ونصائح حول مستلزمات مكتبية، طباعة، أنظمة أمان، وتكييفات في مصر"
  heroImage="/images/hero-office.webp"
  heroAlt="مدونة نيو جولدن أوفيس — نصائح المستلزمات المكتبية والطباعة"
  heroIcon="fa-newspaper"
  showCta={false}
  breadcrumbs={[
    { label: 'الرئيسية', href: '/' },
    { label: 'المدونة' }
  ]}
/>

<BlogGrid posts={pagePosts} page={1} totalPages={totalPages} />
</BaseLayout>
