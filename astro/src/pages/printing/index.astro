---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';
import PageHero from '../../components/PageHero.astro';
import IconCardGrid from '../../components/IconCardGrid.astro';
import { getSeoFor } from '../../lib/siteSeo';
---

<BaseLayout
  {...getSeoFor('/printing')}
  preloadImage="/images/printing-hub.webp"
>
<PageHero
  title="خدمات الطباعة الاحترافية في مصر"
  subtitle="نيو جولدن أوفيس — طباعة احترافية بأعلى جودة وأفضل أسعار، نجيب بأفضل نتيجة لكل مشروع في الإسكندرية ومصر كلها"
  heroImage="/images/printing-hub.webp"
  heroIcon="fa-print"
  showCta={true}
  breadcrumbs={[
    { label: 'الرئيسية', href: '/' },
    { label: 'خدمات الطباعة' }
  ]}
/>

  <!-- INTRO + SERVICES GRID -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>طباعة احترافية — كل ما تحتاجه تحت سقف واحد</h2>
        <div class="divider"></div>
      </div>

      <div class="intro-text" style="max-width:900px;margin:0 auto 48px;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-secondary)">
        <p>منذ تأسيسها عام 1999، تُقدّم شركة نيو جولدن أوفيس في الإسكندرية باقةً متكاملة من خدمات الطباعة الاحترافية التي تلبي احتياجات الأفراد والشركات والمؤسسات الحكومية على حدٍّ سواء. نحن نؤمن بأن المطبوعات الجيدة تُعبّر عن هوية العلامة التجارية وتُعزز انطباع العميل الأول، لذلك نحرص على الجمع بين أحدث تقنيات الطباعة والخامات الفاخرة والتسليم في الوقت المحدد.</p>
        <p>نتعامل مع كل مشروع طباعة، مهما كان حجمه، بنفس مستوى الاهتمام بالتفاصيل، من كرت شخصي واحد إلى حملة مطبوعات كاملة لشركة كبرى، ونحرص دائمًا على مراجعة العينة معك قبل تنفيذ الكمية الكاملة.</p>
        <p>نساعدك أيضًا في التخطيط المسبق لمواسم الطلب المرتفع، كالمعارض والمؤتمرات ونهاية العام، لضمان جدولة تنفيذ مريحة بدل ضغط اللحظات الأخيرة.</p>
        <p>نتابع أيضًا مواعيد التجديد الدورية لعملائنا المتكررين، ونذكّرهم مسبقًا بأي مطبوعات موسمية تحتاج تحديثًا قبل موعد الحاجة الفعلية.</p>
        <p>نوضح دائمًا التكلفة الكاملة والمدة الزمنية بدقة قبل بدء أي طباعة، حتى لا تفاجأ بأي تغيير في السعر أو الموعد لاحقًا.</p>
        <p>نرحب دائمًا بزيارتك لمقرنا لمعاينة نماذج أعمال سابقة ومناقشة تفاصيل مشروعك مباشرة مع فريقنا.</p>
        <p style="margin-top:16px">سواء كنت تبحث عن طباعة كميات كبيرة بسعر تنافسي عبر الأوفست، أو تحتاج نسخاً قليلة عالية الجودة من خلال الطباعة الرقمية، أو تريد بنرات ضخمة لافتة تُعلن عن حدثك أو محلك التجاري، أو بزنس كارد أنيقة تُمثّل شركتك في أفضل صورة — فريقنا المتخصص هنا لخدمتك. نوفر أيضاً طباعة UV بتقنية الحبر فوق البنفسجية التي تُعطي لمسة ثلاثية الأبعاد مميزة، وطباعة هدايا مخصصة على الأكواب والبلوزات والأدوات المكتبية لتُبقي علامتك التجارية حاضرة في يد عملائك يومياً.</p>
        <p style="margin-top:16px">نعتمد في عملنا على ماكينات طباعة ألمانية ويابانية حديثة، وأحبار عالمية مُعتمدة، وورق مُستورد عالي الجودة. كما يضم فريقنا مصممين جرافيك محترفين يساعدونك في تحويل فكرتك إلى مطبوع احترافي جاهز للتوزيع. نستقبل الطلبات من جميع أنحاء مصر ونُوصّل إلى باب المنشأة أو الفرع، بتغطية خاصة لعملاء <a href="/cairo/printing">القاهرة</a> و<a href="/alexandria/printing">الإسكندرية</a>.</p>
      </div>

      <!-- 6 SERVICE CARDS -->
      <div class="services-grid">

        <div class="service-card">
          <div class="service-icon">
            <i class="fas fa-print"></i>
          </div>
          <h3 class="service-title">طباعة أوفست</h3>
          <p class="service-desc">الحل الأمثل للكميات الكبيرة — كتالوجات، مجلات، بروشورات، وعبوات تجارية بألوان CMYK دقيقة وجودة لا تُضاهى.</p>
          <a href="/printing/offset" class="btn btn-outline-primary btn-sm">طباعة الأوفست للكميات الكبيرة <i class="fas fa-arrow-left"></i></a>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <i class="fas fa-digital-tachograph"></i>
          </div>
          <h3 class="service-title">طباعة رقمية</h3>
          <p class="service-desc">مثالية للكميات الصغيرة والنماذج الأولية — تسليم سريع دون ألواح طباعة، بألوان زاهية وتفاصيل دقيقة.</p>
          <a href="/printing/digital" class="btn btn-outline-primary btn-sm">الطباعة الرقمية السريعة <i class="fas fa-arrow-left"></i></a>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <i class="fas fa-image"></i>
          </div>
          <h3 class="service-title">طباعة بنرات وفينيل</h3>
          <p class="service-desc">بنرات ضخمة للمعارض والمحلات والفعاليات — طباعة واسعة الفورمات بألوان ثابتة مقاومة للأشعة فوق البنفسجية والرطوبة.</p>
          <a href="/printing/banners" class="btn btn-outline-primary btn-sm">بنرات ولافتات دعائية <i class="fas fa-arrow-left"></i></a>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <i class="fas fa-id-card"></i>
          </div>
          <h3 class="service-title">بزنس كارد</h3>
          <p class="service-desc">بطاقات أعمال فاخرة بأوراق مميزة وتشطيبات متنوعة تعكس مكانة علامتك التجارية.</p>
          <a href="/printing/business-cards" class="btn btn-outline-primary btn-sm">كروت شخصية وبروشورات الشركة <i class="fas fa-arrow-left"></i></a>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <i class="fas fa-book-open"></i>
          </div>
          <h3 class="service-title">بروشورات وفلايرات</h3>
          <p class="service-desc">بروشورات تسويقية وفلايرات توزيع وكتالوجات منتجات — كل أنواع الطي والمقاسات والورق المناسب لكل استخدام.</p>
          <a href="/printing/brochures" class="btn btn-outline-primary btn-sm">بروشورات وفلايرات الشركة <i class="fas fa-arrow-left"></i></a>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <i class="fas fa-sun"></i>
          </div>
          <h3 class="service-title">طباعة UV</h3>
          <p class="service-desc">تقنية الطباعة فوق البنفسجية توفر ألواناً عميقة ولمسة بارزة ثلاثية الأبعاد على كارتات الأعمال والتغليف الفاخر.</p>
          <a href="/printing/uv" class="btn btn-outline-primary btn-sm">طباعة UV على الأسطح الخاصة <i class="fas fa-arrow-left"></i></a>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <i class="fas fa-gift"></i>
          </div>
          <h3 class="service-title">طباعة هدايا وأكواب</h3>
          <p class="service-desc">اطبع شعارك على الأكواب والبلوزات والأقلام والأكريليك وعشرات المنتجات الترويجية لتبقى في يد عملائك كل يوم.</p>
          <a href="/printing/gifts" class="btn btn-outline-primary btn-sm">هدايا دعاية مطبوعة <i class="fas fa-arrow-left"></i></a>
        </div>

      </div>

      <!-- BUYING GUIDE -->
      <div style="max-width:900px;margin:60px auto 0">
        <h2 style="margin-bottom:20px">أي تقنية طباعة تناسب مشروعك؟ دليل مقارنة سريع</h2>
        <p>أكثر سؤال يطرحه علينا عملاؤنا الجدد هو: "أي نوع طباعة أختار؟". الإجابة تعتمد على ثلاثة عوامل رئيسية: الكمية المطلوبة، سرعة التسليم، ونوع الخامة. إليك دليلاً مبسطاً يوفر عليك وقت البحث:</p>
        <IconCardGrid columns={3} items={[
          { icon: 'fa-boxes', title: 'كمية كبيرة (500 نسخة فأكثر) على ورق', text: '<a href="/printing/offset">طباعة الأوفست</a> هي الأوفر، خاصة إذا احتجت مطابقة لون بانتون دقيقة أو ثبات لون عبر آلاف النسخ — كتالوجات، كتب، عبوات تغليف.' },
          { icon: 'fa-bolt', title: 'كمية صغيرة أو طلب عاجل على ورق', text: '<a href="/printing/digital">الطباعة الرقمية</a> لا تشترط حداً أدنى وتُسلَّم خلال ساعات، مثالية للنماذج الأولية والدعوات الشخصية والطباعة المتغيرة.' },
          { icon: 'fa-image', title: 'لافتات ضخمة أو فينيل للمعارض والمحلات', text: '<a href="/printing/banners">طباعة البنرات والفينيل</a> واسعة الفورمات، مقاومة للشمس والرطوبة، تناسب الإعلانات الخارجية.' },
          { icon: 'fa-gem', title: 'الطباعة على خامات صلبة غير ورقية (أكريليك، معدن، زجاج، خشب)', text: '<a href="/printing/uv">طباعة UV</a> هي التقنية الوحيدة القادرة على الالتصاق بهذه الأسطح بألوان نابضة ومقاومة للخدش، مثالية للافتات الفاخرة ودروع التكريم.' },
          { icon: 'fa-mug-hot', title: 'الطباعة على منتجات قماشية أو سيراميك (أكواب، تيشيرتات، وسائد)', text: '<a href="/printing/gifts">طباعة السبليميشن على الهدايا</a> تجعل التصميم جزءاً من نسيج المنتج نفسه لا طبقة فوقه.' },
          { icon: 'fa-id-card', title: 'كروت شخصية وبروشورات تسويقية', text: 'صفحتا <a href="/printing/business-cards">الكروت الشخصية</a> و<a href="/printing/brochures">البروشورات والفلايرات</a> تفصّلان أوزان الورق والتشطيبات المناسبة لكل استخدام.' },
        ]} />
        <p>إذا كان مشروعك يجمع أكثر من عنصر — مثلاً معرض تجاري يحتاج بنر واجهة، وكروت شخصية، وهدايا ترويجية معاً — يمكن لفريقنا تنسيق الطلب بالكامل تحت مظلة واحدة بدل التنقل بين موردين مختلفين.</p>

        <h2 style="margin-top:40px;margin-bottom:20px">الطباعة حسب نوع عميلك — سيناريوهات واقعية</h2>
        <IconCardGrid columns={3} items={[
          { icon: 'fa-rocket', title: 'الشركات الناشئة والمشاريع الصغيرة', text: 'تبدأ عادة بكروت شخصية وبروشور تعريفي بسيط عبر الطباعة الرقمية لتجربة السوق قبل الاستثمار في كميات كبيرة.' },
          { icon: 'fa-calendar-alt', title: 'منظمو الفعاليات والمؤتمرات', text: 'يحتاجون بنرات واجهة ورول أب، وهدايا ترويجية بالجملة توزَّع على الزوار، وكروت أسماء مؤقتة — غالباً بمواعيد تسليم ضيقة قبل موعد الفعالية.' },
          { icon: 'fa-gift', title: 'الهدايا المؤسسية للشركات الكبرى', text: 'طلبات موسمية متكررة (رمضان، رأس السنة) من أكواب وأجندات مطبوعة بشعار الشركة، تحتاج تخطيطاً مسبقاً وجدولة إنتاج بالجملة.' },
          { icon: 'fa-store', title: 'المحلات التجارية وسلاسل البيع بالتجزئة', text: 'لافتات واجهة UV أو أكريليك تدوم لسنوات، مع كتالوجات موسمية أوفست لتوزيعها على الفروع.' },
          { icon: 'fa-university', title: 'الجهات الحكومية والمؤسسات التعليمية', text: 'مطبوعات رسمية وكتب ومناهج بكميات ضخمة موحدة المواصفات عبر طباعة الأوفست.' },
        ]} />
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section class="section section-bg">
    <div class="container">
      <div class="section-header">
        <h2>مميزات تجعلنا الخيار الأول في الطباعة بمصر</h2>
        <div class="divider"></div>
      </div>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon"><i class="fas fa-medal"></i></div>
          <h4>جودة مضمونة</h4>
          <p>نستخدم أحبار عالمية وخامات مستوردة لنضمن لك مطبوعات ثابتة الألوان تصمد أمام الزمن.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon"><i class="fas fa-clock"></i></div>
          <h4>تسليم في الموعد</h4>
          <p>نحترم وقتك ونلتزم بمواعيد التسليم المتفق عليها — وقت التسليم السريع متاح للطلبات العاجلة.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon"><i class="fas fa-tags"></i></div>
          <h4>أسعار تنافسية</h4>
          <p>نقدم أفضل جودة بأسعار عادلة تناسب الشركات الصغيرة والكبيرة على حدٍّ سواء.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon"><i class="fas fa-headset"></i></div>
          <h4>دعم متخصص</h4>
          <p>فريق متخصص من المصممين والفنيين جاهز لمساعدتك من لحظة تقديم الملف حتى استلام المطبوع.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon"><i class="fas fa-cog"></i></div>
          <h4>تقنيات حديثة</h4>
          <p>ماكينات طباعة من أحدث الجيل تدعم طباعة الأوفست والرقمية وطباعة واسعة الفورمات وطباعة UV.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon"><i class="fas fa-history"></i></div>
          <h4>شريكك الموثوق منذ 1999</h4>
          <p>منذ 1999 ونحن نخدم آلاف العملاء في الإسكندرية ومصر ونبني علاقات طويلة الأمد مبنية على الثقة.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon"><i class="fas fa-layer-group"></i></div>
          <h4>كل التقنيات تحت سقف واحد</h4>
          <p>لا داعي للتنقل بين موردين مختلفين — أوفست ورقمية وUV وسبليميشن وبنرات كلها متاحة في منشأة واحدة، مما يوفر وقتك ويضمن اتساق الجودة بين كل قطع طلبك.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon"><i class="fas fa-file-import"></i></div>
          <h4>مراجعة ملفات مجانية</h4>
          <p>يراجع فريقنا الفني ملفك مجاناً قبل الطباعة للتأكد من الدقة ومنطقة القطع ونظام الألوان، لتفادي أي مفاجآت أو إعادة طباعة بسبب خطأ في التجهيز.</p>
        </div>
      </div>
    </div>
  </section>

  <MidPageCTA formId="prnIndexMidCta" />

  <!-- HOW IT WORKS -->
  <section class="section section-bg">
    <div class="container">
      <div class="section-header">
        <h2>خطوات بسيطة للحصول على خدمتك</h2>
        <div class="divider"></div>
      </div>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">1</div>
          <h4>تواصل معنا</h4>
          <p>تواصل مع فريقنا عبر واتساب أو اتصل بنا مباشرة أو قم بزيارتنا في مقرنا بالإبراهيمية، وأخبرنا بما تحتاجه من مطبوعات.</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <h4>نحضر عرض السعر</h4>
          <p>يقوم فريقنا بدراسة طلبك وتقديم عرض سعر مفصّل يشمل نوع الطباعة والخامات والكمية وموعد التسليم خلال وقت قصير.</p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <h4>ننفذ المطلوب</h4>
          <p>بعد الموافقة على العرض، يبدأ فريقنا الفني فوراً في التنفيذ باستخدام أحدث المعدات لضمان مطبوع احترافي في موعده.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- BRANDS -->
  <section class="brands-section">
    <div class="container">
      <div class="section-header" style="margin-bottom:32px">
        <h2>نتعامل مع أفضل ماركات الطباعة العالمية</h2>
        <div class="divider"></div>
      </div>
      <div class="brands-grid">
        <span class="brand-badge">Canon</span>
        <span class="brand-badge">Ricoh</span>
        <span class="brand-badge">HP</span>
        <span class="brand-badge">Epson</span>
        <span class="brand-badge">Roland</span>
        <span class="brand-badge">Mimaki</span>
        <span class="brand-badge">Xerox</span>
        <span class="brand-badge">Brother</span>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>أسئلة عن خدمات الطباعة</h2>
        <div class="divider"></div>
      </div>
      <div class="faq-list">

        <div class="faq-item">
          <div class="faq-question">
            كيف يمكنني تقديم طلب طباعة مع نيو جولدن أوفيس؟
            <i class="fas fa-plus"></i>
          </div>
          <div class="faq-answer">
            <div class="faq-answer-inner">يمكنك تقديم طلبك بأكثر من طريقة: عبر واتساب على الرقم 01227392074 مع إرسال تفاصيل الطلب والملفات مباشرة، أو الاتصال الهاتفي لمناقشة احتياجاتك مع أحد خبرائنا، أو زيارتنا شخصياً في مقرنا بشارع عبد المنعم سند، الإبراهيمية، باب شرق، الإسكندرية. الأفضل أن ترسل لنا ملفات التصميم بصيغة PDF أو AI أو CDR مع تحديد الكمية المطلوبة وموعد التسليم المناسب لك.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">
            ما هو الحد الأدنى للكميات في الطباعة؟
            <i class="fas fa-plus"></i>
          </div>
          <div class="faq-answer">
            <div class="faq-answer-inner">يختلف الحد الأدنى للكمية حسب نوع الخدمة: الطباعة الرقمية لا تشترط حداً أدنى — حتى نسخة واحدة ممكنة. طباعة الأوفست تبدأ عادةً من 500 نسخة وتكون أكثر اقتصادية كلما زادت الكمية. البنرات والفينيل تُطبع بدءاً من قطعة واحدة. البزنس كارد نبدأ من 100 قطعة. لمزيد من التفاصيل حسب كل منتج، تواصل معنا وسيساعدك فريقنا.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">
            ما هي صيغ الملفات التي تقبلونها للطباعة؟
            <i class="fas fa-plus"></i>
          </div>
          <div class="faq-answer">
            <div class="faq-answer-inner">نقبل جميع الصيغ الشائعة: PDF (الأفضل والأكثر ضماناً)، وملفات Adobe Illustrator (AI)، وCorelDRAW (CDR)، وPhotoshop (PSD)، وInDesign (INDD)، بالإضافة إلى JPG وPNG بدقة لا تقل عن 300 DPI على الحجم الفعلي للطباعة. يُفضّل دائماً أن تكون الألوان في نمط CMYK لضمان دقة الألوان. إن لم تكن متأكداً من إعدادات ملفك، أرسله لنا وسيراجعه فريقنا الفني مجاناً.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">
            ما هو وقت التسليم المعتاد للطلبات؟
            <i class="fas fa-plus"></i>
          </div>
          <div class="faq-answer">
            <div class="faq-answer-inner">تتفاوت مدة التسليم حسب نوع الطباعة والكمية: الطباعة الرقمية تُسلّم في يوم إلى يومين عمل. الأوفست يحتاج من 3 إلى 7 أيام حسب الكمية والتشطيبات. البنرات والفينيل تستغرق يوماً إلى ثلاثة أيام. للطلبات العاجلة، نوفر خدمة التسليم السريع بتسعيرة إضافية بسيطة — أخبرنا بموعد حاجتك وسنبذل قصارى جهدنا لتلبية طلبك في الوقت المحدد.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">
            ما هي طرق الدفع المتاحة وهل تتوصلون خارج الإسكندرية؟
            <i class="fas fa-plus"></i>
          </div>
          <div class="faq-answer">
            <div class="faq-answer-inner">نقبل الدفع نقداً، بالتحويل البنكي، أو عبر تطبيقات الدفع الإلكتروني المتاحة في مصر. بالنسبة للتوصيل، نُوصّل لجميع مناطق الإسكندرية مجاناً أو بتكلفة رمزية، كما نشحن لجميع محافظات مصر عبر شركات الشحن المعتمدة. يمكنك أيضاً استلام طلبك مباشرة من مقرنا في الإبراهيمية.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">
            هل يمكن طلب أكثر من نوع طباعة في نفس الفاتورة؟
            <i class="fas fa-plus"></i>
          </div>
          <div class="faq-answer">
            <div class="faq-answer-inner">نعم، يمكنك الجمع بين عدة أنواع طباعة (مثلاً كروت شخصية مع بروشورات ولافتة) في طلب واحد وفاتورة واحدة، وهذا شائع جدًا لأصحاب الأعمال الذين يجهزون هويتهم البصرية الكاملة دفعة واحدة.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">
            كم يستغرق تسليم مطبوعات عاجلة؟
            <i class="fas fa-plus"></i>
          </div>
          <div class="faq-answer">
            <div class="faq-answer-inner">الطلبات الرقمية الصغيرة كالكروت والبروشورات يمكن تسليمها خلال يوم إلى يومي عمل، بينما الكميات الكبيرة بطباعة الأوفست تحتاج جدولة أطول حسب حجم الطلب وتعقيد التصميم.</div>
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">
            هل تقدمون خصومات على الطلبات الكبيرة أو المتكررة؟
            <i class="fas fa-plus"></i>
          </div>
          <div class="faq-answer">
            <div class="faq-answer-inner">نعم، الشركات التي تطلب مطبوعات بشكل دوري أو بكميات كبيرة تحصل على أسعار تفضيلية، ونقترح دائمًا الأنسب اقتصاديًا حسب حجم استهلاكك السنوي المتوقع لهذا النوع من المطبوعات.</div>
          </div>
        </div>

      </div>
    </div>
  </section>

