---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';
import PageHero from '../../components/PageHero.astro';
import { getSeoFor } from '../../lib/siteSeo';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "طباعة كروت شخصية وبروشورات",
  "description": "طباعة كروت شخصية وبروشورات ومطبوعات دعائية في مصر — تشطيبات متنوعة وأوزان ورق مختلفة.",
  "serviceType": "طباعة كروت",
  "provider": {
    "@type": "LocalBusiness",
    "name": "نيو جولدن أوفيس",
    "url": "https://newgoldenoffice.com",
    "telephone": "+201227392074",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "26 عبد المنعم سند",
      "addressLocality": "الإبراهيمية، باب شرق",
      "addressRegion": "الإسكندرية",
      "addressCountry": "EG"
    }
  },
  "areaServed": { "@type": "Country", "name": "Egypt" }
});
---

<BaseLayout
  {...getSeoFor('/printing/business-cards')}
  schemaJson={schemaJson}
  preloadImage="/images/printing-hub.webp"
>
<PageHero
  title="طباعة كروت شخصية وبروشورات في مصر — انطباعك الأول"
  subtitle="كرت شخصي أنيق وبروشور احترافي يتركان انطباعاً لا يُنسى — نيو جولدن أوفيس تصنع مطبوعاتك التسويقية بأفضل الخامات وأرقى التشطيبات في مصر"
  heroImage="/images/printing-hub.webp"
  heroIcon="fa-id-card"
  breadcrumbs={[
    { label: 'الرئيسية', href: '/' },
    { label: 'خدمات الطباعة', href: '/printing' },
    { label: 'كروت وبروشورات' }
  ]}
/>

<!-- MAIN CONTENT -->
<section class="service-detail">
  <div class="container">
    <div class="service-detail-grid">
      <div class="service-content">
        <h2>أهمية الكرت الشخصي الاحترافي في عالم الأعمال</h2>
        <p>كرتك الشخصي هو أول ما يراه الشريك أو العميل المحتمل، وهو الانطباع الذي يبقى في ذاكرته بعد انتهاء اللقاء. كرت شخصي مطبوع على ورق فاخر بتشطيب احترافي يقول الكثير عن مستوى اهتمامك بالتفاصيل وعن هوية علامتك التجارية. في نيو جولدن أوفيس، نصنع كروتاً شخصية تليق بمكانتك المهنية.</p>

        <h2>أنواع الكروت الشخصية التي نطبعها</h2>

        <h3>الكروت الشخصية القياسية</h3>
        <p>المقاس المعتاد 9 سم × 5 سم على ورق 350 جرام أو 400 جرام كوشيه. تأتي بتشطيب مطفي أو لامع حسب تفضيلك. الخيار الكلاسيكي الأنيق الذي يناسب جميع المجالات المهنية.</p>

        <h3>الكروت المطوية (Folded Business Cards)</h3>
        <p>كروت تُطوى إلى النصف لتوفير مساحة أكبر للمعلومات، مثالية للأطباء والمحامين وأصحاب المشاريع الذين يحتاجون إلى عرض معلومات تفصيلية أكثر أو قائمة خدمات موجزة.</p>

        <MidPageCTA formId="prnBusinessCardsMidCta" />

        <h3>الكروت مع تشطيب UV بقعي (Spot UV)</h3>
        <p>تشطيب راقٍ يضيف لمسة لامعة على أجزاء محددة من الكرت (كالشعار أو الاسم) بينما تبقى بقية الكرت مطفية. يمنح الكرت طابعاً فاخراً ومميزاً يلفت الانتباه.</p>

        <h3>الكروت ذات التحسس النافر (Embossed / Debossed)</h3>
        <p>تقنية تضيف نتوءاً أو غائراً على الكرت تشعر به باللمس، تُستخدم عادةً على الشعار أو الاسم لإضفاء طابع فخامة استثنائي. مناسبة للشركات والعلامات التجارية الراقية.</p>

        <h2>أوزان الورق المتاحة للكروت الشخصية</h2>
        <ul>
          <li><strong>300 جرام:</strong> الحد الأدنى المقبول احترافياً — جيد للكروت العادية وذات التوزيع الواسع</li>
          <li><strong>350 جرام:</strong> الوزن الأكثر شيوعاً وتوصياً — يمنح صلابة جيدة ومظهراً احترافياً</li>
          <li><strong>400 جرام:</strong> وزن فاخر يمنح إحساساً بالثقل والفخامة عند اللمس</li>
          <li><strong>ورق مقوى مع طبقة فاخرة:</strong> لأعلى مستويات الفخامة والتميز</li>
        </ul>

        <h2>التشطيبات المتاحة للكروت والمطبوعات</h2>
        <ul>
          <li><strong>مطفي (Matt Lamination):</strong> تشطيب ناعم وأنيق يمنع الانعكاسات — الأكثر شيوعاً وأناقة</li>
          <li><strong>لامع (Gloss Lamination):</strong> يبرز الألوان ويمنح مظهراً براقاً ونضاراً</li>
          <li><strong>ناعم كالمخمل (Soft Touch / Velvet):</strong> إحساس مخملي فاخر عند اللمس — تشطيب استثنائي</li>
          <li><strong>UV بقعي (Spot UV):</strong> لمسة لامعة على أجزاء محددة لإبراز العناصر المهمة</li>
        </ul>

        <h2>البروشورات والمطبوعات الدعائية</h2>
        <p>البروشور هو أداة تسويقية أساسية تقدم علامتك التجارية وخدماتك بشكل منظم وجذاب. في نيو جولدن أوفيس، نطبع جميع أنواع البروشورات:</p>
        <ul>
          <li><strong>بروشور مطوي ثنائي (Bi-fold):</strong> صفحة واحدة مطوية إلى نصفين — 4 صفحات</li>
          <li><strong>بروشور مطوي ثلاثي (Tri-fold / Z-fold):</strong> مطوي إلى ثلاثة أقسام — الأكثر استخداماً</li>
          <li><strong>الفلايرز والنشرات:</strong> نشرات مسطحة ليست مطوية للتوزيع السريع والإعلانات</li>
          <li><strong>الليفلتس:</strong> نشرات صغيرة الحجم لعروض محددة ومناسبات خاصة</li>
          <li><strong>الكتالوجات:</strong> كتيبات مخيطة أو ملزومة لعرض كامل لمنتجاتك وخدماتك</li>
        </ul>

        <h2>لماذا تختار نيو جولدن أوفيس لطباعة كروتك وبروشوراتك؟</h2>
        <p>مع خبرة أكثر من 27 عاماً في طباعة المطبوعات التسويقية في الإسكندرية ومصر، نعرف ما الذي يجعل المطبوعة ناجحة ومؤثرة. نوفر استشارة مجانية لاختيار أنسب الخامات والتشطيبات لميزانيتك وهدفك التسويقي. ملفاتك في أيدٍ أمينة مع فريقنا المتخصص في ما قبل الطباعة.</p>
      </div>
      <aside class="service-sidebar">
        <div class="sidebar-card">
          <h4><i class="fas fa-phone-alt" style="color:var(--secondary)"></i> تواصل معنا</h4>
          <div class="contact-info">
            <div class="contact-info-item"><i class="fab fa-whatsapp"></i><a href="https://wa.me/201227392074">واتساب مباشر</a></div>
