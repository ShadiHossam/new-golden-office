---
import BaseLayout from '../../layouts/BaseLayout.astro';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://newgoldenoffice.com/ac/alexandria#service",
      "name": "بيع وتركيب وصيانة تكييفات في الإسكندرية",
      "serviceType": "توريد وتركيب وصيانة تكييفات",
      "url": "https://newgoldenoffice.com/ac/alexandria",
      "provider": { "@id": "https://newgoldenoffice.com/#organization" },
      "areaServed": { "@type": "City", "name": "الإسكندرية" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"كم سعر تركيب أو صيانة التكييف في الإسكندرية؟","acceptedAnswer":{"@type":"Answer","text":"التكلفة تتحدد بقدرة الجهاز ونوعه ومسافة المواسير وموقع الوحدة الخارجية وحالة الجهاز. نقدم عرض سعر مكتوبًا فور معرفة الحالة، والمعاينة داخل الإسكندرية مجانية."}},
        {"@type":"Question","name":"كم حصان يناسب مساحة غرفتي؟","acceptedAnswer":{"@type":"Answer","text":"استرشاديًا: 1.5 حصان للغرف حتى حوالي 15 م²، و2.25 حصان حتى حوالي 25 م²، و3 حصان للمساحات الأكبر. القدرة النهائية تتحدد بعد معاينة سريعة."}},
        {"@type":"Question","name":"ما الفرق بين تكييف الانفرتر والعادي؟","acceptedAnswer":{"@type":"Answer","text":"الانفرتر يغيّر سرعة الكباس حسب الحاجة فيستهلك كهرباء أقل مع التشغيل الطويل، والعادي أرخص شراءً وأبسط صيانة."}},
        {"@type":"Question","name":"كم تستغرق الاستجابة لطلب الصيانة؟","acceptedAnswer":{"@type":"Answer","text":"فرقنا داخل الإسكندرية نفسها فنصل بسرعة دون انتظار فني من خارج المدينة، ولعملاء عقود الصيانة السنوية أولوية استجابة أعلى."}},
        {"@type":"Question","name":"ما مدة الضمان على الصيانة والتركيب؟","acceptedAnswer":{"@type":"Answer","text":"كل تركيب وإصلاح بضمان مكتوب في الفاتورة وعرض السعر، وأي مشكلة تتكرر داخل فترة الضمان نعالجها على حسابنا."}},
        {"@type":"Question","name":"هل تتوفر قطع غيار أصلية لكل الماركات؟","acceptedAnswer":{"@type":"Answer","text":"نعم، نوفر قطع غيار أصلية لكاريير وشارب وميديا ويونيون اير وجري وتورنيدو وغيرها."}},
        {"@type":"Question","name":"هل يمكن استبدال تكييفي القديم بجهاز جديد؟","acceptedAnswer":{"@type":"Answer","text":"نعم. نقيّم الجهاز القديم بصراحة: إن كان الإصلاح مجديًا أخبرناك، وإن كان الاستبدال أوفر توليّنا فك القديم وتوريد وتركيب الجديد."}},
        {"@type":"Question","name":"ماذا يشمل التجديد الشامل للتكييف القديم؟","acceptedAnswer":{"@type":"Answer","text":"عمرة كاملة تشمل فحص دائرة التبريد ومعالجة التسريبات، تنظيفًا عميقًا للوحدتين، واستبدال الأجزاء المتهالكة بقطع أصلية."}},
        {"@type":"Question","name":"متى يمكنني التعاقد السنوي للصيانة الوقائية؟","acceptedAnswer":{"@type":"Answer","text":"في أي وقت من السنة، والأفضل قبل دخول الصيف حتى تستقبل الحر بوحدات مفحوصة ونظيفة."}},
        {"@type":"Question","name":"ما المناطق التي تغطونها داخل الإسكندرية؟","acceptedAnswer":{"@type":"Answer","text":"نخدم وسط البلد وسموحة وسيدي جابر وميامي وجليم ولوران والمنشية والعطارين والكورنيش ومحيط الميناء."}}
      ]
    }
  ]
});
---

<BaseLayout
  title="شركة تكييفات في الإسكندرية | بيع وتركيب وصيانة كل الماركات"
  description="شركة تكييفات في الإسكندرية بخبرة 27 عامًا: توريد وتركيب سبليت ومركزي، صيانة وشحن فريون لكل الماركات، وعقود صيانة سنوية. اطلب عرض سعر اليوم."
  keywords="شركة تكييفات في الإسكندرية، صيانة تكييف بالاسكندرية، تركيب تكييف الاسكندرية، شحن فريون الاسكندرية"
  ogTitle="شركة تكييفات في الإسكندرية | نيو جولدن أوفيس"
  ogDescription="توريد وتركيب سبليت ومركزي، صيانة وشحن فريون لكل الماركات، وعقود صيانة سنوية في الإسكندرية."
  ogImage="/images/webp-images/outdoor-air-conditioner-unit-on-the-wall-of-a-buil-2026-03-19-04-22-48-utc.webp"
  robots="noindex, nofollow"
  schemaJson={schemaJson}
>
<style>
  .quote-section{padding:60px 0}
  .quote-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:stretch}
  .quote-form-card{background:#fff;border-radius:18px;padding:2.2rem;box-shadow:0 4px 24px rgba(27,58,107,0.1)}
  .quote-form-card h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:700;color:var(--green-dark);margin-bottom:1.5rem}
  .form-group{margin-bottom:1.1rem}
  .form-group label{display:block;font-family:'Cairo',sans-serif;font-size:0.95rem;font-weight:600;color:var(--green-dark);margin-bottom:0.4rem}
  .form-group input,.form-group select,.form-group textarea{width:100%;padding:0.8rem 1rem;border:2px solid #e5eaf3;border-radius:10px;font-family:'Tajawal',sans-serif;font-size:1rem;color:#333;background:#fafbfd;transition:border-color .3s,box-shadow .3s;outline:none;box-sizing:border-box;direction:rtl}
  .form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--green-dark);box-shadow:0 0 0 3px rgba(27,58,107,.1);background:#fff}
  .form-group textarea{height:100px;resize:vertical}
  .form-submit-btn{width:100%;padding:1rem;background:linear-gradient(135deg,var(--green-dark),var(--green-mid));color:#fff;border:none;border-radius:12px;font-family:'Cairo',sans-serif;font-size:1.05rem;font-weight:700;cursor:pointer;transition:transform .3s,box-shadow .3s;display:flex;align-items:center;justify-content:center;gap:.5rem}
  .form-submit-btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(27,58,107,.25)}
  .success-message{display:none;background:linear-gradient(135deg,#e8f5e9,#f1f8e9);border:2px solid #4caf50;border-radius:12px;padding:1.5rem;text-align:center;margin-top:1rem}
  .success-message i{font-size:2.5rem;color:#4caf50;display:block;margin-bottom:.5rem}
  .success-message p{font-family:'Cairo',sans-serif;font-size:1.05rem;color:#2e7d32;font-weight:600}
  .quote-alt-card{background:linear-gradient(135deg,#25D366 0%,#128C7E 100%);border-radius:18px;padding:2.4rem;text-align:center;color:#fff;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:1rem}
  .quote-alt-card .wa-icon{font-size:3rem}
  .quote-alt-card h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:800}
  .quote-alt-card p{opacity:.92;line-height:1.8}
  @media(max-width:768px){.quote-grid{grid-template-columns:1fr}}
</style>

<section class="page-hero">
  <div class="container">
    <div class="page-hero-inner">
      <div class="page-hero-content">
        <nav class="breadcrumb">
          <a href="/">الرئيسية</a>
          <span>/</span>
          <a href="/alexandria">خدماتنا في الإسكندرية</a>
          <span>/</span>
          <span class="current">شركة تكييفات في الإسكندرية</span>
        </nav>
        <h1 class="reveal">شركة تكييفات في الإسكندرية</h1>
        <p class="lead reveal delay-1">توريد وتركيب سبليت وشباك ومركزي، صيانة وشحن فريون لكل الماركات، وعقود صيانة سنوية تراعي رطوبة الساحل، بخبرة 27 عامًا في مدينة الإسكندرية</p>
      </div>
      <div class="page-hero-image">
        <img src="/images/webp-images/outdoor-air-conditioner-unit-on-the-wall-of-a-buil-2026-03-19-04-22-48-utc.webp" alt="شركة تكييفات في الإسكندرية" loading="eager">
      </div>
    </div>
  </div>
</section>

<section class="stats-section">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item reveal"><div class="stat-num" data-target="27" data-suffix="+">0+</div><div class="stat-label">سنة خبرة في تكييف الإسكندرية</div></div>
      <div class="stat-item reveal delay-1"><div class="stat-num" data-target="6">0</div><div class="stat-label">ماركات نتعامل مع كل قطع غيارها</div></div>
      <div class="stat-item reveal delay-2"><div class="stat-num" data-target="8">0</div><div class="stat-label">أحياء نغطيها بمواعيد سريعة</div></div>
      <div class="stat-item reveal delay-3"><div class="stat-num" data-target="3">0</div><div class="stat-label">أنواع تكييف نركبها: سبليت وشباك ومركزي</div></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="intro-text" style="max-width:900px;margin:0 auto 48px;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>تبحث عن شركة تكييفات في الإسكندرية تفهم مناخ المدينة قبل أن تفهم الأجهزة؟ نيو جولدن أوفيس تخدم مكاتب وشركات ومنازل الإسكندرية منذ 27 عامًا من مقرنا الفعلي: 26 عبد المنعم سند، الإبراهيمية، باب شرق. فرقنا الفنية تعمل يوميًا في هواء الإسكندرية الرطب المالح، وتعرف بالخبرة ما الذي يصيب الوحدات هنا تحديدًا وكيف تطيل عمرها. نغطي احتياجك كاملًا: توريد أجهزة جديدة من كل الماركات، تركيب احترافي، صيانة دورية وإصلاح، شحن فريون، وفك ونقل التكييفات.</p>
    </div>

    <div class="section-header">
      <h2>لماذا نيو جولدن أوفيس شركة تكييفات موثوقة في الإسكندرية؟</h2>
      <div class="divider"></div>
    </div>
    <div class="features-grid">
      <div class="feature-card reveal"><div class="feature-icon"><i class="fas fa-building"></i></div><h4>مقر فعلي في الإسكندرية</h4><p>لسنا رقم هاتف يظهر ويختفي. عنوان ثابت تزوره، وفريق دائم تعرفه بالاسم.</p></div>
      <div class="feature-card reveal delay-1"><div class="feature-icon"><i class="fas fa-tags"></i></div><h4>شركة واحدة لكل الماركات</h4><p>كاريير وشارب وميديا ويونيون اير وجري وتورنيدو وغيرها.</p></div>
      <div class="feature-card reveal delay-2"><div class="feature-icon"><i class="fas fa-user-check"></i></div><h4>فريق فني موظف لدينا</h4><p>لا نرسل مقاول باطن. الفني الذي يدخل مكتبك يتبعنا ونحاسَب على شغله.</p></div>
      <div class="feature-card reveal delay-3"><div class="feature-icon"><i class="fas fa-certificate"></i></div><h4>قطع غيار أصلية وضمان موثق</h4><p>بالتفاصيل مكتوبة في عرض السعر لا بالكلام.</p></div>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>توريد وتركيب التكييفات: سبليت وشباك ومركزي</h2>
      <div class="divider"></div>
    </div>
    <div class="services-grid">
      <div class="service-card reveal"><div class="service-icon"><i class="fas fa-wind"></i></div><h3 class="service-title">تكييف سبليت</h3><p class="service-desc">الخيار الأشهر للمكاتب والشقق والمحال، مع اختيار مدروس لمكان الوحدة الخارجية يقلل تعرضها لرذاذ البحر.</p><a href="/ac/installation" class="btn btn-outline btn-sm">تركيب التكييفات <i class="fas fa-arrow-left"></i></a></div>
      <div class="service-card reveal delay-1"><div class="service-icon"><i class="fas fa-square"></i></div><h3 class="service-title">تكييف الشباك</h3><p class="service-desc">خيار عملي للغرف الصغيرة والمواقع التي لا تسمح بوحدة خارجية منفصلة.</p></div>
      <div class="service-card reveal delay-2"><div class="service-icon"><i class="fas fa-building-user"></i></div><h3 class="service-title">التكييف المركزي والكونسيلد</h3><p class="service-desc">للمقرات الكبيرة والعيادات والمطاعم: حساب أحمال التبريد، توزيع مخارج الهواء، وتأسيس كامل أثناء التشطيب.</p></div>
      <div class="service-card reveal delay-3"><div class="service-icon"><i class="fas fa-cart-shopping"></i></div><h3 class="service-title">شراء تكييف جديد</h3><p class="service-desc">توريد أجهزة من كل الماركات بترشيح محايد حسب مساحتك وميزانيتك.</p><a href="/ac/buy" class="btn btn-outline btn-sm">تكييفات للبيع <i class="fas fa-arrow-left"></i></a></div>
    </div>
    <p style="max-width:800px;margin:24px auto 0;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)"><strong>علامات التركيب الخاطئ:</strong> تنقيط ماء من الوحدة الداخلية، ضعف تبريد رغم أن الجهاز جديد، اهتزاز أو صوت مرتفع من الوحدة الخارجية، أو ارتفاع ملحوظ في فاتورة الكهرباء. معاينة واحدة تكشف السبب وتوفر عليك أعطالًا أكبر.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>الرطوبة والهواء المالح: عدو الوحدات الخارجية في الإسكندرية</h2>
      <div class="divider"></div>
    </div>
    <div class="intro-text" style="max-width:900px;margin:0 auto;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>الوحدة الخارجية في الإسكندرية تعيش ظروفًا أقسى من مثيلتها في المدن الداخلية. الرطوبة المرتفعة والهواء المحمل بالأملاح يسرّعان تآكل زعانف المكثف والهيكل المعدني والتوصيلات، خصوصًا في المباني القريبة من البحر والمحال المطلة على الكورنيش. النتيجة المعتادة: كفاءة تبريد تنخفض تدريجيًا، واستهلاك كهرباء يرتفع، ثم أعطال مبكرة كان يمكن تفاديها.</p>
      <p style="margin-top:16px">لهذا ننصح عملاءنا في الإسكندرية بجدول صيانة أقرب زمنيًا مما يُنصح به في المدن الداخلية، يركز على غسيل الوحدة الخارجية من الترسبات الملحية وفحص التآكل مبكرًا. وفي التركيبات الجديدة نراعي هذا من البداية: مكان وحدة خارجية محمي قدر الإمكان من الرذاذ المباشر، تثبيت مقاوم للرياح، وتوصيلات معزولة جيدًا.</p>
    </div>
    <div class="reveal" style="max-width:900px;margin:32px auto 0;border-radius:var(--radius-lg);overflow:hidden">
      <img src="/images/webp-images/adjusting-air-conditioner-with-remote-control-in-h-2026-03-17-22-42-22-utc.webp" alt="صيانة تكييفات في الإسكندرية" loading="lazy" style="width:100%;height:340px;object-fit:cover;display:block">
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>صيانة تكييف بالاسكندرية: إصلاح وتنظيف وشحن فريون</h2>
      <div class="divider"></div>
    </div>
    <div class="features-grid">
      <div class="feature-card reveal"><div class="feature-icon"><i class="fas fa-broom"></i></div><h4>صيانة دورية وتنظيف عميق</h4><p>غسيل الفلاتر والوحدة الخارجية من الترسبات الملحية، وفحص ضغوط الفريون والأمبير.</p></div>
      <div class="feature-card reveal delay-1"><div class="feature-icon"><i class="fas fa-droplet"></i></div><h4>شحن فريون بعد فحص التسريب</h4><p>نفحص الدائرة كاملة أولًا، فإن وُجد تسريب عولج قبل الشحن.</p><a href="/ac/maintenance" class="btn btn-outline btn-sm">صيانة التكييفات <i class="fas fa-arrow-left"></i></a></div>
      <div class="feature-card reveal delay-2"><div class="feature-icon"><i class="fas fa-screwdriver-wrench"></i></div><h4>الإصلاح والتجديد الشامل</h4><p>إصلاح الكباسات والمراوح والكروت الإلكترونية، وتجديد شامل للوحدات القديمة التي تستحق.</p></div>
      <div class="feature-card reveal delay-3"><div class="feature-icon"><i class="fas fa-truck-ramp-box"></i></div><h4>فك ونقل وتأسيس مواسير</h4><p>فك ونقل التكييف عند الانتقال، وتأسيس مواسير النحاس أثناء التشطيب.</p></div>
    </div>
    <p style="max-width:800px;margin:24px auto 0;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)"><strong>علامات تحتاج صيانة الآن:</strong> تبريد أضعف من المعتاد، رائحة كريهة عند التشغيل، تنقيط ماء داخل الغرفة، صوت جديد لم تعتده، أو قفزة واضحة في فاتورة الكهرباء.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>دليل اختيار قدرة التكييف: كم حصان تحتاج مساحتك؟</h2>
      <div class="divider"></div>
    </div>
    <div style="overflow-x:auto;max-width:800px;margin:0 auto">
      <table style="width:100%;border-collapse:collapse;font-size:0.95rem">
        <thead><tr style="background:var(--green-dark);color:var(--white)"><th style="padding:14px 16px;text-align:right">القدرة</th><th style="padding:14px 16px;text-align:right">المساحة الاسترشادية</th></tr></thead>
        <tbody>
          <tr style="background:var(--white);border-bottom:1px solid #eee"><td style="padding:12px 16px">1.5 حصان</td><td style="padding:12px 16px">الغرف الصغيرة حتى حوالي 15 م²</td></tr>
          <tr style="background:#f8f9fa;border-bottom:1px solid #eee"><td style="padding:12px 16px">2.25 حصان</td><td style="padding:12px 16px">الغرف والمكاتب المتوسطة من 16 إلى 25 م²</td></tr>
          <tr style="background:var(--white);border-bottom:1px solid #eee"><td style="padding:12px 16px">3 حصان</td><td style="padding:12px 16px">المساحات الأكبر من 25 إلى 35 م²</td></tr>
          <tr style="background:#f8f9fa"><td style="padding:12px 16px">4 حصان فأكثر</td><td style="padding:12px 16px">القاعات والمساحات المفتوحة والمحال الكبيرة</td></tr>
        </tbody>
      </table>
    </div>
    <p style="max-width:800px;margin:24px auto 0;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">المساحة وحدها لا تكفي: الواجهة البحرية، ارتفاع السقف، وعدد الأشخاص والأجهزة تغيّر الحساب، لهذا نفضل معاينة سريعة قبل الترشيح النهائي. <strong>انفرتر أم عادي؟</strong> الانفرتر أوفر في الكهرباء مع ساعات التشغيل الطويلة، والعادي أقل سعرًا ومنطقي للاستخدام المتقطع.</p>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>نتعامل مع كل الماركات</h2>
      <div class="divider"></div>
    </div>
