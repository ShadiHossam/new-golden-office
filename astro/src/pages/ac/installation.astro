  schemaJson={schemaJson}
  preloadImage="/images/ac-hub.webp"
  keywords="تركيب تكييفات مصر, تركيب تكييف سبليت مصر, فني تركيب تكييفات الإسكندرية, تركيب تكييفات القاهرة, تركيب كاسيت مصر, فني تكييف معتمد"
  ogTitle="تركيب تكييفات في مصر، فنيون محترفون | نيو جولدن أوفيس"
  ogDescription="تركيب تكييفات احترافي بضمان في الإسكندرية والقاهرة وجميع محافظات مصر. سبليت وكاسيت وسبليت مخفي. اتصل بنا الآن."
