---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';
import PageHero from '../../components/PageHero.astro';
import ContentIntro from '../../components/ContentIntro.astro';
import IconCardGrid from '../../components/IconCardGrid.astro';
import ComparisonGrid from '../../components/ComparisonGrid.astro';
import { getSeoFor } from '../../lib/siteSeo';

const schemaJson = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "تركيب تكييفات",
    "description": "تركيب تكييفات احترافي في مصر بواسطة فنيين معتمدين — سبليت وكاسيت ومركزي مع ضمان سنة على التركيب.",
    "serviceType": "تركيب تكييفات",
    "provider": {
      "@type": "LocalBusiness",
      "name": "نيو جولدن أوفيس",
      "url": "https://newgoldenoffice.com",
      "telephone": "+201227392074",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "26 عبد المنعم سند",
        "addressLocality": "الإبراهيمية، باب شرق",
        "addressRegion": "الإسكندرية",
        "addressCountry": "EG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Egypt" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "هل يمكنكم تركيب تكييف اشتريته من مكان آخر؟",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "نعم، نُقدّم خدمة تركيب مستقلة لأي جهاز بغض النظر عن مصدره. نفحص الجهاز أولاً للتأكد من سلامته وأن السعة والمواصفات مناسبة للمكان، ثم نُنفّذ التركيب بنفس معايير الجودة التي نطبقها على أجهزتنا."
        }
      },
      {
        "@type": "Question",
        "name": "ما أكثر خطأ تركيب يسبب أعطالاً لاحقة؟",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "أشهر خطأ هو عدم تفريغ الأنابيب من الهواء والرطوبة قبل فتح الفريون (باستخدام Vacuum Pump)، مما يُدخل رطوبة تتحول لاحقاً لحمض يُتلف الكمبريسور تدريجياً. الخطأ الثاني هو ميل خاطئ لخرطوم الصرف يسبب تسرب المياه داخل الحائط أو السقف."
        }
      },
      {
        "@type": "Question",
        "name": "هل يمكن تركيب التكييف في نفس يوم التوريد؟",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "في أغلب الحالات نعم، خصوصاً للسبليت المنزلي، بشرط أن يكون الموقع جاهزاً (وجود تغذية كهربائية مناسبة ومكان واضح للوحدة الخارجية). للمشاريع الأكبر أو التركيبات المعقدة مثل الكاسيت والمركزي، نحدد موعداً بعد المعاينة الأولية."
        }
      },
      {
        "@type": "Question",
        "name": "هل التركيب يختلف بين الشقق القديمة والمباني الجديدة؟",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "نعم، المباني القديمة غالباً تحتاج فحصاً إضافياً للتمديدات الكهربائية للتأكد من تحملها الحمل الجديد، وقد تحتاج مسارات أنابيب مختلفة بسبب اختلاف سماكة الجدران. المباني الحديثة عادة أسهل في التخطيط المسبق لأن التصميم الإنشائي يراعي مسارات التكييف من البداية."
        }
      },
      {
        "@type": "Question",
        "name": "كم تكلفة تركيب تكييف منفصلاً عن سعر الجهاز؟",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "تكلفة التركيب تعتمد على طول مسار الأنابيب المطلوب، نوع التركيب (سبليت عادي أم كاسيت أم مركزي)، وموقع الوحدة الخارجية. نُقدّم دائماً معاينة مجانية وعرض سعر واضح قبل بدء أي عمل حتى تعرف التكلفة الكاملة مسبقاً."
        }
      },
      {
        "@type": "Question",
        "name": "هل تركبون التكييف في نفس اليوم لعدة وحدات دفعة واحدة؟",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "نعم، للمشاريع التي تشمل عدة وحدات في نفس الموقع مثل تجهيز مكتب أو مبنى كامل، ننسق فريقاً أكبر أو نوزع العمل على أيام متتالية حسب حجم المشروع، مع خطة واضحة تحدد لك مسبقاً مدة إنجاز كل مرحلة."
        }
      }
    ]
  }
]);
---

<BaseLayout
  {...getSeoFor('/ac/installation')}
  schemaJson={schemaJson}
  preloadImage="/images/ac-hub.webp"
>
<PageHero
  title="تركيب تكييفات في مصر — فنيون محترفون معتمدون"
  subtitle="نيو جولدن أوفيس تقدم خدمة تركيب تكييفات احترافية في مصر منذ عام 1999. فنيونا المعتمدون يضمنون تركيباً دقيقاً وفق معايير الشركات المصنّعة لأعلى أداء وأطول عمر لتكييفك. نخدم الإسكندرية والقاهرة وجميع المحافظات."
  heroImage="/images/ac-hub.webp"
  heroIcon="fa-tools"
  breadcrumbs={[
    { label: 'الرئيسية', href: '/' },
    { label: 'تكييفات', href: '/ac' },
    { label: 'تركيب تكييفات' }
  ]}
/>

<section class="service-detail">
  <div class="container"><div class="service-detail-grid">
    <div class="service-content">
      <ContentIntro
        heading="تركيب تكييف سبليت مصر — لماذا التركيب الاحترافي يُطيل عمر تكييفك؟"
        text="كثير من العملاء يتفاجؤون بأن سبب أعطال التكييف المتكررة ليس جودة الجهاز بل أخطاء في التركيب الأول. تركيب التكييف ليس مجرد تثبيت وحدتين وتوصيل الأنابيب — إنه عملية دقيقة تتطلب خبرة وأدوات متخصصة."
      />
      <p>الفرق بين تركيب يدوم 15 عاماً بلا مشاكل وآخر يبدأ في التسريب أو فقدان الكفاءة خلال أشهر لا يظهر في اللحظة الأولى بعد التركيب — كلا التركيبين قد يبدوان متطابقين ظاهرياً ويبردان الغرفة في أول أسبوع. الفرق الحقيقي يظهر مع الوقت: في مدى إحكام وصلات الفريون، في دقة تفريغ الأنابيب من الرطوبة، وفي جودة التثبيت الذي يتحمل اهتزاز الكمبريسور يومياً لسنوات. هذا بالضبط ما نركّز عليه في كل زيارة تركيب ننفذها.</p>

      <h3><i class="fas fa-exclamation-circle" style="color:var(--secondary);margin-left:8px;"></i> لماذا يهم التركيب الاحترافي؟</h3>
      <IconCardGrid columns={2} items={[
        { icon: 'fa-percentage', title: 'الكفاءة الكاملة', text: 'التركيب الصحيح يضمن حصولك على كامل طاقة التبريد المكتوبة على الجهاز — التركيب الخاطئ قد يُقلّل الكفاءة 20-30%' },
        { icon: 'fa-hourglass-half', title: 'عمر أطول', text: 'أنابيب النحاس المتصلة بشكل صحيح مع العزل الجيد تحمي الكمبريسور من الزيادة في الضغط' },
        { icon: 'fa-bolt', title: 'توفير الكهرباء', text: 'الجهاز المركَّب صح يعمل في نطاق التصميم — لا يُجهد الكمبريسور بلا داعٍ' },
        { icon: 'fa-shield-alt', title: 'الضمان ساري', text: 'كثير من الشركات ترفض الضمان إذا تبيّن أن التركيب لم يكن احترافياً — فريقنا مُعتمد من الشركات المصنّعة' },
      ]} />

      <h3><i class="fas fa-clipboard-check" style="color:var(--secondary);margin-left:8px;"></i> متطلبات التركيب — نتحقق منها مسبقاً</h3>
      <IconCardGrid columns={3} items={[
        { icon: 'fa-ruler-combined', title: 'مقاس الفتحة في الجدار', text: 'نحسب المكان الصح لمرور الأنابيب بعيداً عن الأسلاك الكهربائية والإنشاءات' },
        { icon: 'fa-bolt', title: 'التمديد الكهربائي', text: 'نتأكد من أن الدائرة الكهربائية تتحمل الحمل المطلوب ونوفر breaker منفصل إذا لزم' },
        { icon: 'fa-ruler-horizontal', title: 'مسافة أنبوب الفريون', text: 'المسافة المثالية بين الوحدة الداخلية والخارجية من 3 إلى 7 أمتار — كلما قلّت المسافة كلما قلّت فقدانات الفريون وارتفعت الكفاءة، والمسافات الأطول تحتاج فريوناً إضافياً' },
        { icon: 'fa-map-marker-alt', title: 'مكان الوحدة الخارجية', text: 'نختار الموضع الأمثل بعيداً عن مصادر الحرارة مع تهوية كافية' },
        { icon: 'fa-water', title: 'مسار الصرف', text: 'نصمم خط الصرف بميل صحيح لضمان سيلان الماء بعيداً عن الجدار تلقائياً' },
      ]} />

      <h3><i class="fas fa-snowflake" style="color:var(--secondary);margin-left:8px;"></i> أنواع التركيب التي نتخصص فيها</h3>
      <ComparisonGrid items={[
        { title: 'تكييف سبليت حائطي (Wall Split)', text: 'الأشيع في مصر — وحدة داخلية على الحائط ووحدة خارجية. يتضمن حفر القاعدة، تمرير الأنابيب، وسد الفتحة بإتقان. مناسب لجميع السعات من 1 إلى 3 طن، والتركيب يستغرق عادة 2 إلى 4 ساعات حسب الموقع' },
        { title: 'تكييف كانسيل (Concealed Duct)', text: 'يُركَّب داخل الأسقف المعلقة — التبريد يصدر من الفتحات في السقف. يحتاج تخطيطاً دقيقاً للقنوات وتنسيقاً مع أعمال التشطيبات' },
        { title: 'تكييف كاسيت (Cassette)', text: 'يُثبَّت في منتصف السقف ويوزع الهواء 4 اتجاهات — مثالي للمحلات والصالات الكبيرة، ويتطلب سقفاً معلقاً بارتفاع متر مربع على الأقل' },
      ]} />

      <MidPageCTA formId="acInstallMidCta" />

      <h3><i class="fas fa-list-ol" style="color:var(--secondary);margin-left:8px;"></i> خطوات تركيب تكييف السبليت بالتفصيل</h3>
      <IconCardGrid columns={3} items={[
        { icon: 'fa-map-marker-alt', title: 'الخطوة 1 — تحديد المواضع', text: 'نحدد موضع الوحدة الداخلية (مرتفعة بما يكفي، بعيدة عن المصادر الحرارية) وموضع الوحدة الخارجية على الشرفة أو الحائط الخارجي' },
        { icon: 'fa-thumbtack', title: 'الخطوة 2 — تركيب اللوحة الخلفية', text: 'تثبيت لوحة الدعم (Back Plate) بمستوى دقيق وبراغٍ قوية في الجدار' },
        { icon: 'fa-circle-notch', title: 'الخطوة 3 — حفر ثقب المرور', text: 'حفر ثقب قطر 7 سم في الجدار بزاوية ميل طفيفة نحو الخارج لتصريف الكثافة' },
        { icon: 'fa-project-diagram', title: 'الخطوة 4 — تمديد الأنابيب والأسلاك', text: 'تمديد أنابيب النحاس المعزولة وأسلاك التوصيل وخرطوم الصرف في sleeve واحدة منظمة' },
        { icon: 'fa-link', title: 'الخطوة 5 — تثبيت الوحدتين وتوصيلهما', text: 'تثبيت الوحدة الداخلية على اللوحة والوحدة الخارجية على القاعدة المعدنية، ثم توصيل الأنابيب بمفاتيح خاصة' },
        { icon: 'fa-vial', title: 'الخطوة 6 — تفريغ الهواء والاختبار', text: 'تفريغ الأنابيب من الهواء والرطوبة بمضخة Vacuum Pump ثم فتح الفريون واختبار التبريد والتدفئة' },
      ]} />

      <h3><i class="fas fa-shield-alt" style="color:var(--secondary);margin-left:8px;"></i> ضمان التركيب وما يشمله</h3>
      <p>نقدم ضماناً شاملاً على جميع أعمال التركيب التي ينفذها فنيونا:</p>
      <IconCardGrid columns={3} items={[
        { icon: 'fa-tools', title: 'ضمان التركيب', text: 'سنة كاملة على جميع أعمال التركيب، أي مشكلة ناتجة عن خطأ في التركيب نُصلحها مجاناً.' },
        { icon: 'fa-wind', title: 'ضمان إحكام الفريون', text: 'نتأكد من عدم وجود أي تسريب في وصلات أنابيب الفريون ونضمن ذلك لمدة سنة.' },
        { icon: 'fa-exclamation-circle', title: 'ما لا يشمله الضمان', text: 'الأضرار الناتجة عن حوادث خارجية أو التلاعب بالجهاز أو سوء الاستخدام أو أعطال قطع الغيار الأصلية.' },
      ]} />

      <h3><i class="fas fa-lightbulb" style="color:var(--secondary);margin-left:8px;"></i> نصائح لاختيار أنسب موقع للتكييف</h3>
      <IconCardGrid columns={3} items={[
        { icon: 'fa-arrows-alt-v', title: 'الارتفاع المثالي', text: 'ركّب الوحدة الداخلية على ارتفاع 2.2 إلى 2.5 متر من الأرض لأفضل توزيع هواء بارد دون أن يلفح الهواء الجالسين مباشرة.' },
        { icon: 'fa-sun', title: 'بعيداً عن الحرارة المباشرة', text: 'تجنّب تركيب الوحدة الداخلية أمام نوافذ تتعرض للشمس المباشرة لأن ذلك يُضلل حساسات الحرارة ويقلل الكفاءة.' },
        { icon: 'fa-balance-scale', title: 'مستوى الوحدة الداخلية', text: 'يجب أن تكون الوحدة الداخلية مستوية تماماً أفقياً لضمان تصريف الكوندنسيت بشكل طبيعي دون تجمع.' },
        { icon: 'fa-umbrella', title: 'الوحدة الخارجية في الظل', text: 'إن أمكن، ركّب الوحدة الخارجية في مكان به ظل جزئي أو قم بتغطيتها بشكل يسمح بالتهوية، يزيد ذلك كفاءتها في الصيف المصري الشديد.' },
        { icon: 'fa-wind', title: 'مسافة التهوية', text: 'اترك مسافة لا تقل عن 30 سم أمام الوحدة الخارجية وعلى الجانبين لتسمح بتدفق الهواء وتسهيل الصيانة.' },
      ]} />

      <h3><i class="fas fa-map-marker-alt" style="color:var(--secondary);margin-left:8px;"></i> نغطي جميع أنحاء مصر</h3>
      <p>نقدم خدمة تركيب التكييفات في الإسكندرية والقاهرة والجيزة وطنطا والمنصورة والمحافظات المجاورة. فريقنا المتنقل يصل إلى موقعك في الموعد المحدد. للمشاريع الكبرى خارج الإسكندرية، تواصل معنا لترتيب الزيارة وتقديم عرض سعر مخصص.</p>

      <div style="background:#f0f4ff;border-right:4px solid var(--secondary);padding:20px;border-radius:8px;margin:24px 0;">
        <h4 style="margin-bottom:12px;"><i class="fas fa-info-circle" style="color:var(--secondary);margin-left:8px;"></i> تركيب احترافي مقابل تركيب عشوائي</h4>
        <p style="font-size:0.95rem;color:#444;margin:0;line-height:1.7">التركيب الاحترافي يستخدم أنابيب نحاس أصلية بسُمك مناسب، مفاتيح توصيل معتمدة، وأدوات Vacuum Pump وManifold Gauge للتحقق من الضغط. التركيب العشوائي باستخدام أنابيب رديئة أو بدون تفريغ يُقلّل كفاءة الجهاز ويُعرّض الكمبريسور للتلف المبكر.</p>
      </div>

      <h3><i class="fas fa-building" style="color:var(--secondary);margin-left:8px;"></i> تحديات التركيب حسب نوع المبنى</h3>
      <p>كل نوع مبنى له تحديات تركيب مختلفة، ونتعامل معها بأسلوب مُصمَّم خصيصاً لكل حالة:</p>
      <IconCardGrid columns={3} items={[
        { icon: 'fa-home', title: 'الشقق القديمة', text: 'غالباً تحتاج فحصاً إضافياً للتمديدات الكهربائية القديمة قبل التركيب للتأكد من تحملها الحمل الجديد، وقد نحتاج مسارات أنابيب غير مباشرة بسبب سماكة الجدران القديمة أو وجود حديد تسليح في مواضع معينة' },
        { icon: 'fa-city', title: 'المباني الحديثة والفلل', text: 'عادة أسهل في التخطيط لأن التصميم الإنشائي يراعي مسارات التكييف من البداية، ونحرص هنا على إخفاء الأنابيب داخل قنوات جمالية بدل تركها ظاهرة على الواجهة' },
        { icon: 'fa-store', title: 'المحلات التجارية', text: 'نُنسّق موعد التركيب خارج ساعات الذروة قدر الإمكان لتقليل تعطيل العمل، ونولي عناية خاصة لتثبيت وحدات الكاسيت بشكل متماثل مع تصميم السقف المعلق' },
        { icon: 'fa-industry', title: 'المصانع والمستودعات', text: 'تتطلب تخطيطاً هندسياً لمسارات الأنابيب الطويلة ونقاط تثبيت إضافية لدعم الوزن، مع مراعاة سلامة التمديدات الكهربائية الصناعية القائمة' },
        { icon: 'fa-hotel', title: 'الفنادق والمباني متعددة الطوابق', text: 'نحتاج تنسيقاً دقيقاً بين عدة وحدات ومسارات صرف مشتركة، وغالباً نُنفّذ التركيب على مراحل بالتنسيق مع إدارة المبنى لتفادي إزعاج النزلاء' },
      ]} />

      <h3><i class="fas fa-bug" style="color:var(--secondary);margin-left:8px;"></i> أخطاء تركيب شائعة نتجنّبها دائماً</h3>
      <p>رأينا خلال سنوات عملنا الكثير من أعطال التكييف التي سببها الحقيقي خطأ في التركيب الأول وليس عيباً في الجهاز نفسه:</p>
      <IconCardGrid columns={3} items={[
        { icon: 'fa-vial', title: 'عدم تفريغ الأنابيب بالكامل', text: 'إذا لم يُستخدم Vacuum Pump لسحب الهواء والرطوبة من الأنابيب قبل فتح الفريون، تتحول الرطوبة المتبقية إلى حمض يُتلف الكمبريسور تدريجياً خلال أشهر' },
        { icon: 'fa-water', title: 'ميل خاطئ لخرطوم الصرف', text: 'إذا كان الميل غير كافٍ أو معكوساً، يتجمع الماء ويتسرب داخل الحائط أو السقف، مما يسبب أضراراً إنشائية قبل أن يُلاحَظ التسريب من التكييف نفسه' },
        { icon: 'fa-ruler-horizontal', title: 'أنابيب طويلة جداً بلا تعويض فريون إضافي', text: 'كل متر إضافي في مسافة الأنابيب عن الحد الموصى به يحتاج كمية فريون إضافية محسوبة بدقة، وإهمال ذلك يُنقص كفاءة التبريد بشكل ملحوظ' },
