---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';
import PageHero from '../../components/PageHero.astro';
import ContentIntro from '../../components/ContentIntro.astro';
import IconCardGrid from '../../components/IconCardGrid.astro';
import ComparisonGrid from '../../components/ComparisonGrid.astro';
import { getSeoFor } from '../../lib/siteSeo';

const schemaJson = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "بيع تكييفات",
    "description": "تكييفات للبيع في مصر — Carrier وKoldair وSamsung وSharp وMidea وLG بأفضل الأسعار مع ضمان المصنع.",
    "serviceType": "بيع تكييفات",
    "provider": {
      "@type": "LocalBusiness",
      "name": "نيو جولدن أوفيس",
      "url": "https://newgoldenoffice.com",
      "telephone": "+201227392074",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "26 عبد المنعم سند",
        "addressLocality": "الإبراهيمية، باب شرق",
        "addressRegion": "الإسكندرية",
        "addressCountry": "EG"
      }
    },
    "areaServed": { "@type": "Country", "name": "Egypt" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "هل تختلف توصية الشراء بين المنزل والمكتب والمحل؟",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "نعم بشكل كبير. المنزل يحتاج أولوية للهدوء وتوفير الكهرباء فننصح بإنفرتر سبليت، المكتب يحتاج مراعاة حرارة الأجهزة الإلكترونية الإضافية، المحل التجاري يحتاج سعة أعلى بسبب فتح الباب المستمر، والمصنع يحتاج تكييفاً مركزياً أو كاسيت متعدد حسب حجم المساحة وارتفاع السقف."
        }
      },
      {
        "@type": "Question",
        "name": "ما معنى تصنيف EER أو كفاءة الطاقة على التكييف؟",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "EER هو معدل كفاءة الطاقة، ويقيس كمية التبريد الناتجة مقابل كل وحدة كهرباء مستهلكة. كلما ارتفع الرقم، كان الجهاز أكثر كفاءة واقتصاداً في التشغيل. تكييفات الإنفرتر عادة تحمل تصنيف كفاءة أعلى من التكييفات العادية ذات السرعة الثابتة."
        }
      },
      {
        "@type": "Question",
        "name": "ما أكثر خطأ شائع عند شراء تكييف في مصر؟",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "أشهر خطأ هو شراء سعة أقل من المطلوب توفيراً في السعر، مما يجعل الجهاز يعمل بأقصى طاقته باستمرار ويتلف كمبريسوره أسرع مع فاتورة كهرباء أعلى من المتوقع. الخطأ الثاني الشائع هو تجاهل نوع الفريون والتوافق مع الأجهزة الأخرى الموجودة عند التوسع لاحقاً."
        }
      },
      {
        "@type": "Question",
        "name": "هل يمكن شراء عدة تكييفات دفعة واحدة بسعر أفضل؟",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "نعم، عند شراء عدة وحدات لمبنى أو مشروع واحد نقدم عرض سعر إجمالي أفضل من شراء كل وحدة بشكل منفصل، ونُنظّم التوريد والتركيب كخطة واحدة موحدة لتقليل وقت التعطيل."
        }
      },
      {
        "@type": "Question",
        "name": "هل التكييف المستعمل خيار جيد لتوفير التكلفة؟",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "نحن لا نتعامل بالتكييفات المستعملة لأن أعمارها التشغيلية غير مضمونة وغالباً تستهلك كهرباء أعلى بكثير من جهاز جديد اقتصادي. الأفضل غالباً هو اختيار جهاز جديد بسعة أصغر أو ماركة اقتصادية بدل المخاطرة بجهاز مستعمل مجهول التاريخ."
        }
      },
      {
        "@type": "Question",
        "name": "كم يستغرق توريد التكييف بعد الطلب؟",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "معظم الماركات والسعات الشائعة متوفرة لدينا كمخزون جاهز، لذا يمكن التوصيل والتركيب خلال أيام قليلة من تأكيد الطلب. الموديلات النادرة أو الطلبات الكبيرة جداً قد تحتاج وقتاً إضافياً للتوريد، وسنُخبرك بالمدة المتوقعة بوضوح عند الطلب."
        }
      }
    ]
  }
]);
---

<BaseLayout
  {...getSeoFor('/ac/buy')}
  schemaJson={schemaJson}
  preloadImage="/images/ac-hub.webp"
>
<PageHero
  title="تكييفات للبيع في مصر — أفضل الأسعار"
  subtitle="أوسع تشكيلة من التكييفات في مصر — سبليت وكاسيت ومركزي، إنفرتر وعادي، من 1 طن حتى 5 طن بأفضل الأسعار مع ضمان شامل وتركيب متاح في جميع أنحاء مصر"
  heroImage="/images/ac-hub.webp"
  heroIcon="fa-snowflake"
  breadcrumbs={[
    { label: 'الرئيسية', href: '/' },
    { label: 'تكييفات', href: '/ac' },
    { label: 'بيع تكييفات' }
  ]}
/>

<section class="service-detail">
  <div class="container"><div class="service-detail-grid">
    <div class="service-content">
      <ContentIntro
        heading="تكييفات أسعار مصر — اختر تكييفك المثالي من تشكيلتنا الواسعة"
        text="نيو جولدن أوفيس توفر لك أكبر مخزون من التكييفات في الإسكندرية والقاهرة — من الماركات العالمية الأولى بأسعار مضمونة ومنافسة. سواء كنت تبحث عن تكييف اقتصادي لغرفة واحدة أو نظام تكييف مركزي لمبنى كامل، ستجد لدينا ما يناسبك."
      />

      <h3><i class="fas fa-th-list" style="color:var(--secondary);margin-left:8px;"></i> سبليت مقابل كاسيت مقابل مركزي</h3>
      <ComparisonGrid items={[
        { title: 'تكييف السبليت (Split Unit)', text: 'الأكثر شيوعاً في مصر. وحدة داخلية تُثبَّت على الجدار ووحدة خارجية في الشرفة. مثالي للغرف والمكاتب الفردية. يتوفر بسعات 1 – 2.25 – 3 طن.' },
        { title: 'تكييف الكاسيت (Cassette Unit)', text: 'يُركَّب في السقف بشكل متماثل جميل، يوزع الهواء في 4 اتجاهات. مثالي للمحلات والصالات والمطاعم والشركات. سعات 2 – 4 طن.' },
        { title: 'التكييف المركزي (Central AC)', text: 'نظام مركزي يبرد مبنى كاملاً عبر قنوات هواء. الأعلى كفاءة للمساحات الكبيرة جداً كالفنادق والمستشفيات والمجمعات.' },
      ]} />

      <h3><i class="fas fa-tachometer-alt" style="color:var(--secondary);margin-left:8px;"></i> دليل اختيار السعة (BTU) حسب المساحة</h3>
      <p>اختيار السعة الصحيحة أمر حاسم، تكييف أصغر من المطلوب لن يبرد بكفاءة وأكبر من المطلوب سيزيد الاستهلاك دون فائدة:</p>
      <IconCardGrid columns={3} items={[
        { icon: 'fa-door-closed', title: 'حتى 15م² (غرفة صغيرة)', text: '1 طن = 12,000 BTU — مناسب لغرفة النوم الصغيرة' },
        { icon: 'fa-bed', title: '15 — 22م² (غرفة متوسطة)', text: '1.5 طن = 18,000 BTU — الأنسب لغرف النوم الرئيسية' },
        { icon: 'fa-couch', title: '22 — 30م² (غرفة كبيرة)', text: '2 طن = 24,000 BTU — للصالات الصغيرة والغرف الكبيرة' },
        { icon: 'fa-chair', title: '30 — 40م² (صالة متوسطة)', text: '2.25 طن = 27,000 BTU — شائع جداً للصالات المصرية' },
        { icon: 'fa-building', title: '40 — 55م² (صالة كبيرة)', text: '3 طن = 36,000 BTU — للصالات الكبيرة والمكاتب' },
        { icon: 'fa-warehouse', title: 'فوق 55م² (محلات/صالات ضخمة)', text: '4-5 طن أو عدة تكييفات — حسب التصميم' },
      ]} />

      <h3><i class="fas fa-ruler-combined" style="color:var(--secondary);margin-left:8px;"></i> عوامل إضافية تُعدّل السعة المطلوبة</h3>
      <p>جدول المساحة أعلاه نقطة بداية جيدة، لكن عوامل أخرى قد تزيد أو تُنقص الحصان المطلوب بمقدار نصف طن كامل:</p>
      <IconCardGrid columns={3} items={[
        { icon: 'fa-arrows-alt-v', title: 'ارتفاع السقف', text: 'غرفة بسقف أعلى من 3 أمتار تحتاج حجم تبريد أكبر من نفس المساحة بسقف عادي 2.8 متر، لأن حجم الهواء المُراد تبريده أكبر' },
        { icon: 'fa-sun', title: 'اتجاه الشمس وعدد النوافذ', text: 'غرفة تتعرض لشمس مباشرة بعد الظهر أو بها نوافذ كبيرة تحتاج سعة أعلى من غرفة مظللة بنفس المساحة' },
        { icon: 'fa-layer-group', title: 'عزل الجدران والسقف', text: 'المباني الحديثة جيدة العزل تحتفظ بالبرودة أفضل، بينما المباني القديمة قد تحتاج سعة أعلى لتعويض فقد التبريد عبر الجدران' },
        { icon: 'fa-users', title: 'عدد الأشخاص ومصادر الحرارة', text: 'كل شخص إضافي وكل جهاز كهربائي (فرن، أجهزة كمبيوتر، إضاءة قوية) يضيف حِمل حرارة فعلياً يستحق مراعاته عند الحساب' },
        { icon: 'fa-building', title: 'الطابق', text: 'الشقق في الأدوار العلوية المعرضة لأشعة الشمس على السطح مباشرة تحتاج غالباً سعة أعلى من الأدوار الوسطى المحمية' },
      ]} />
      <p>لهذا السبب بالتحديد لا نعتمد فقط على المساحة بالمتر المربع عند تقديم عرض السعر — نسأل عن هذه التفاصيل مسبقاً أو نزور الموقع في المشاريع الكبيرة لضمان اختيار السعة الصحيحة من أول مرة.</p>

      <MidPageCTA formId="acBuyMidCta" />

      <h3><i class="fas fa-bolt" style="color:var(--secondary);margin-left:8px;"></i> إنفرتر أم عادي؟</h3>
      <p>المقارنة الأهم عند شراء تكييف في مصر:</p>
      <ComparisonGrid items={[
        { title: 'التكييف العادي (Fixed Speed)', text: 'سعر شراء أرخص، لكن يستهلك طاقة ثابتة عالية. الأنسب إذا كان الاستخدام ساعات قليلة يومياً.' },
        { title: 'تكييف الإنفرتر', text: 'سعر أعلى بـ 20-40%، لكنه يوفر 30-50% من فاتورة الكهرباء. يُسترجع فرق السعر خلال موسم واحد أو اثنين. الأنسب للاستخدام اليومي الطويل في مصر.' },
      ]} />
      <p><strong>توصيتنا:</strong> في ظل ارتفاع أسعار الكهرباء في مصر، تكييف الإنفرتر يُعدّ الاستثمار الأذكى على المدى البعيد لمن يستخدم التكييف يومياً.</p>

      <h3><i class="fas fa-star" style="color:var(--secondary);margin-left:8px;"></i> مقارنة الماركات المتاحة</h3>
      <div style="overflow-x:auto;margin-bottom:24px;">
        <table style="width:100%;font-size:0.9rem;border-collapse:collapse;">
          <thead><tr style="background:var(--primary);color:var(--white);"><th style="padding:10px 12px;text-align:right;">الماركة</th><th style="padding:10px 12px;text-align:right;">المنشأ</th><th style="padding:10px 12px;text-align:right;">السعر</th><th style="padding:10px 12px;text-align:right;">الكفاءة</th><th style="padding:10px 12px;text-align:right;">الأنسب لـ</th></tr></thead>
          <tbody>
            <tr style="border-bottom:1px solid var(--border);"><td style="padding:10px 12px;font-weight:700;">Carrier</td><td style="padding:10px 12px;">أمريكي</td><td style="padding:10px 12px;">مرتفع</td><td style="padding:10px 12px;">★★★★★</td><td style="padding:10px 12px;">الفنادق والمشاريع الكبرى</td></tr>
            <tr style="border-bottom:1px solid var(--border);background:var(--bg);"><td style="padding:10px 12px;font-weight:700;">Koldair</td><td style="padding:10px 12px;">مصري</td><td style="padding:10px 12px;">متوسط</td><td style="padding:10px 12px;">★★★★</td><td style="padding:10px 12px;">المنازل والمحلات</td></tr>
            <tr style="border-bottom:1px solid var(--border);"><td style="padding:10px 12px;font-weight:700;">Samsung</td><td style="padding:10px 12px;">كوري</td><td style="padding:10px 12px;">مرتفع</td><td style="padding:10px 12px;">★★★★★</td><td style="padding:10px 12px;">المنازل الراقية</td></tr>
            <tr style="border-bottom:1px solid var(--border);background:var(--bg);"><td style="padding:10px 12px;font-weight:700;">Sharp</td><td style="padding:10px 12px;">ياباني</td><td style="padding:10px 12px;">متوسط-مرتفع</td><td style="padding:10px 12px;">★★★★★</td><td style="padding:10px 12px;">المنازل (تنقية الهواء)</td></tr>
            <tr style="border-bottom:1px solid var(--border);"><td style="padding:10px 12px;font-weight:700;">Midea</td><td style="padding:10px 12px;">صيني</td><td style="padding:10px 12px;">اقتصادي</td><td style="padding:10px 12px;">★★★★</td><td style="padding:10px 12px;">الميزانية المحدودة</td></tr>
            <tr style="background:var(--bg);"><td style="padding:10px 12px;font-weight:700;">LG</td><td style="padding:10px 12px;">كوري</td><td style="padding:10px 12px;">مرتفع</td><td style="padding:10px 12px;">★★★★★</td><td style="padding:10px 12px;">الاستخدام الثقيل اليومي</td></tr>
          </tbody>
        </table>
      </div>

      <h3><i class="fas fa-award" style="color:var(--secondary);margin-left:8px;"></i> الضمان والخدمة بعد البيع</h3>
      <IconCardGrid columns={2} items={[
        { icon: 'fa-certificate', title: 'ضمان المصنع', text: 'من 2 إلى 5 سنوات حسب الماركة والموديل — ضمان موثّق من الوكيل الرسمي' },
        { icon: 'fa-heart', title: 'ضمان الكمبرسور', text: 'كثير من الماركات تقدم ضمان 5 سنوات على الكمبرسور (القلب النابض للتكييف)' },
        { icon: 'fa-cogs', title: 'قطع الغيار', text: 'قطع غيار أصلية متوفرة دائماً لدينا لجميع الماركات التي نبيعها' },
        { icon: 'fa-headset', title: 'صيانة ما بعد الضمان', text: 'نستمر في خدمتك بعد انتهاء فترة الضمان بأسعار مناسبة وقطع أصلية' },
      ]} />

      <h3><i class="fas fa-users" style="color:var(--secondary);margin-left:8px;"></i> ماذا تشتري حسب طبيعة استخدامك؟</h3>
      <p>سؤال "ما أفضل تكييف؟" ليس له إجابة واحدة — الإجابة الصحيحة تعتمد على أين ستُستخدم الوحدة وكم ساعة يومياً:</p>
      <IconCardGrid columns={3} items={[
        { icon: 'fa-bed', title: 'لغرفة نوم أو شقة سكنية', text: 'إنفرتر سبليت بسعة 1 إلى 1.5 طن غالباً كافٍ، مع أولوية للماركات الهادئة صوتياً مثل Samsung أو LG لأن الاستخدام يكون أثناء النوم' },
        { icon: 'fa-briefcase', title: 'لمكتب أو شركة صغيرة', text: 'سبليت أو كاسيت حسب تصميم المساحة، مع مراعاة أن أجهزة الكمبيوتر والطابعات تضيف حرارة فعلية تستحق زيادة نصف درجة في حساب السعة' },
        { icon: 'fa-store', title: 'لمحل تجاري بباب مفتوح', text: 'كاسيت بسعة أعلى من الحساب النظري بمقدار درجة، لأن التبريد يتسرب باستمرار من الباب المفتوح طوال ساعات العمل' },
        { icon: 'fa-industry', title: 'لمصنع أو مستودع', text: 'تكييف مركزي أو عدة وحدات كاسيت موزعة، مع الأخذ في الاعتبار الحرارة الصادرة عن الآلات نفسها وليس فقط مساحة الأرضية' },
        { icon: 'fa-hotel', title: 'لفندق أو مستشفى أو مدرسة', text: 'نظام مركزي أو كاسيت بنظام تحكم مستقل لكل غرفة، مع أولوية لماركات ذات ضمان طويل بسبب التشغيل شبه المستمر على مدار الساعة' },
      ]} />

      <h3><i class="fas fa-plug" style="color:var(--secondary);margin-left:8px;"></i> فهم كفاءة الطاقة (EER) قبل الشراء</h3>
      <p>يظهر على علبة كثير من التكييفات رقم كفاءة الطاقة EER — وهو مقياس يوضح كمية التبريد الناتجة (بوحدة BTU) مقابل كل وحدة كهرباء مستهلكة. ببساطة: كلما ارتفع رقم EER، كلما احتاج الجهاز كهرباء أقل لينتج نفس مقدار التبريد. تكييفات الإنفرتر عادة تحمل تصنيف كفاءة أعلى بشكل واضح من التكييفات العادية ثابتة السرعة، لأن ضاغط الإنفرتر يعمل بالسرعة التي تحتاجها الغرفة فعلياً بدل التشغيل بأقصى طاقة أو الإيقاف الكامل. عند المقارنة بين جهازين بنفس السعة والسعر التقريبي، ننصح دائماً باختيار الرقم الأعلى في كفاءة الطاقة، لأن فرق السعر الأولي يُسترد عادة خلال موسم أو موسمين من انخفاض فاتورة الكهرباء، خصوصاً مع الاستخدام اليومي الطويل في الصيف المصري.</p>

      <h3><i class="fas fa-exclamation-triangle" style="color:var(--secondary);margin-left:8px;"></i> أخطاء شائعة عند شراء تكييف — تجنّبها</h3>
      <IconCardGrid columns={3} items={[
        { icon: 'fa-money-bill-wave', title: 'اختيار سعة أقل توفيراً في السعر', text: 'يبدو توفيراً في البداية لكنه يُجبر الجهاز على العمل بأقصى طاقته باستمرار، فيتلف الكمبريسور أسرع وترتفع فاتورة الكهرباء بدل أن تنخفض' },
        { icon: 'fa-wind', title: 'تجاهل نوع الفريون عند التوسع', text: 'إذا كان لديك أجهزة قديمة تعمل بفريون R22 وتخطط لإضافة أجهزة جديدة R410A أو R32، تأكد أن هذا لا يؤثر على قطع الغيار أو الصيانة المستقبلية' },
        { icon: 'fa-file-contract', title: 'الشراء من مصدر بلا ضمان موثّق', text: 'بعض العروض المغرية في السوق تأتي بلا ضمان حقيقي من الوكيل الرسمي — تأكد دائماً من بطاقة الضمان الأصلية عند الاستلام' },
        { icon: 'fa-tools', title: 'تجاهل تكلفة التركيب عند المقارنة', text: 'قارن السعر شاملاً التركيب وليس سعر الجهاز فقط، فبعض العروض الرخيصة تخفي تكلفة تركيب مرتفعة لاحقاً' },
