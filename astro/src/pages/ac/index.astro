---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';
import PageHero from '../../components/PageHero.astro';
import ContentIntro from '../../components/ContentIntro.astro';
import ComparisonGrid from '../../components/ComparisonGrid.astro';
import { getSeoFor } from '../../lib/siteSeo';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما الفرق بين تكييف الإنفرتر والعادي؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تكييف الإنفرتر يتحكم في سرعة الضاغط ويضبطها حسب الحاجة، فيستهلك طاقة أقل بنسبة 30-50% من التكييف العادي الذي يشغل الضاغط بكامل طاقته أو يوقفه تماماً. الإنفرتر أغلى بالشراء لكنه يوفر فاتورة كهرباء أقل بكثير على المدى البعيد، وهو الأنسب في مصر حيث يعمل التكييف لساعات طويلة."
      }
    },
    {
      "@type": "Question",
      "name": "كم طن تكييف أحتاج لغرفتي؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "كقاعدة عامة: غرفة حتى 15م² تحتاج 1 طن. غرفة 15-25م² تحتاج 1.5 طن. غرفة 25-35م² تحتاج 2 طن. صالة كبيرة 35-50م² تحتاج 2.5 إلى 3 طن. تعتمد هذه الأرقام على ارتفاع السقف وعدد النوافذ وعازلية الجدران وعدد الأشخاص. فريقنا يحسب السعة الصحيحة لك مجاناً."
      }
    },
    {
      "@type": "Question",
      "name": "كم يستغرق تركيب تكييف سبليت؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تركيب تكييف سبليت واحد يستغرق من 2 إلى 4 ساعات حسب موقع التركيب وطول الأنابيب المطلوبة. إذا كانت هناك عدة تكييفات في نفس اليوم، نُنظّم الفريق لإنجاز الجميع في وقت معقول بدون إرباك أو إزعاج."
      }
    },
    {
      "@type": "Question",
      "name": "متى يجب تنظيف فلتر التكييف؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ينبغي تنظيف فلتر الهواء كل شهر إلى شهرين خلال موسم الاستخدام الكثيف. الفلتر المتسخ يُقلل كفاءة التبريد ويزيد استهلاك الكهرباء ويُجهد الموتور. في الإسكندرية والقاهرة حيث يكون التلوث والغبار عالياً، ننصح بالتنظيف الشهري."
      }
    },
    {
      "@type": "Question",
      "name": "كم تكلفة التكييف بالتركيب في مصر؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تكلفة التكييف بالتركيب في مصر تشمل سعر الجهاز + تكلفة التركيب، وتتفاوت حسب الحصان والمواصفات. تواصل معنا للحصول على عرض سعر مجاني."
      }
    },
    {
      "@type": "Question",
      "name": "هل يمكنني شراء التكييف من مكان وطلب تركيبه من نيو جولدن أوفيس؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم، نوفر خدمة تركيب منفصلة حتى لو لم تشترِ الجهاز منا، لكننا ننصح دائماً بفحص الجهاز أولاً للتأكد من مطابقته للمواصفات وسلامته قبل التركيب. الأسعار والضمان على التركيب نفسه يبقيان كما هما بغض النظر عن مصدر الجهاز."
      }
    },
    {
      "@type": "Question",
      "name": "ما الفرق بين تكييف السبليت وتكييف الكاسيت؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تكييف السبليت يُركَّب على الحائط ويناسب الغرف والمكاتب الفردية، بينما تكييف الكاسيت يُركَّب في منتصف السقف ويوزّع الهواء البارد في 4 اتجاهات متساوية، وهو الأنسب للمحلات والصالات الكبيرة والمساحات المفتوحة التي تحتاج توزيعاً متجانساً للتبريد."
      }
    },
    {
      "@type": "Question",
      "name": "هل تقدمون خدمة خارج الإسكندرية والقاهرة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم، فريقنا الفني المتنقل يخدم جميع محافظات مصر تقريباً بما فيها الجيزة وطنطا والمنصورة والمحافظات المجاورة. للمشاريع الكبرى أو المواقع البعيدة، تواصل معنا مسبقاً لترتيب زيارة الفريق وتحديد موعد مناسب."
      }
    },
    {
      "@type": "Question",
      "name": "كم مرة يجب صيانة التكييف في السنة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ننصح بصيانتين أساسيتين سنوياً على الأقل: واحدة قبل بداية الصيف لضمان جاهزية الجهاز لموسم التشغيل الطويل، وأخرى بعد انتهاء الصيف لتنظيف الجهاز من تراكم الأتربة وفحص أي أعطال قبل موسم التوقف. الأماكن ذات الاستخدام المكثف كالمحلات والمكاتب قد تحتاج فحصاً كل 3 أشهر."
      }
    }
  ]
});
---

<BaseLayout
  {...getSeoFor('/ac')}
  preloadImage="/images/ac-hub.webp"
  schemaJson={schemaJson}
>
<PageHero
  title="تكييفات في مصر — بيع وتركيب وصيانة"
  subtitle="حلول التكييف المتكاملة لمنزلك وشركتك — أفضل الماركات العالمية بأسعار تنافسية، تركيب احترافي بواسطة فنيين معتمدين، وصيانة دورية لضمان الأداء المثالي في جميع أنحاء مصر"
  heroImage="/images/ac-hub.webp"
  heroIcon="fa-snowflake"
  breadcrumbs={[
    { label: 'الرئيسية', href: '/' },
    { label: 'تكييفات' }
  ]}
  showCta={false}
/>

<section class="stats-section">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item reveal"><div class="stat-num">+2000</div><div class="stat-label">تكييف مُركَّب في مصر</div></div>
      <div class="stat-item reveal delay-1"><div class="stat-num">+50</div><div class="stat-label">ماركة وموديل متاح</div></div>
      <div class="stat-item reveal delay-2"><div class="stat-num">27 عاماً</div><div class="stat-label">خبرة في السوق المصري</div></div>
      <div class="stat-item reveal delay-3"><div class="stat-num">24 ساعة</div><div class="stat-label">استجابة لطلبات الصيانة</div></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>حلول تكييف متكاملة من البيع حتى الصيانة</h2>
      <p>كل ما تحتاجه من تكييفات في مكان واحد — بيع وتركيب وصيانة بواسطة فريق متخصص وموثوق منذ عام 1999</p>
      <div class="divider"></div>
    </div>
    <div class="services-grid" style="margin-bottom:70px;">
      <a href="/ac/buy" class="service-card reveal">
        <div class="service-icon"><i class="fas fa-shopping-cart"></i></div>
        <h3>بيع تكييفات</h3>
        <p>أكبر تشكيلة من تكييفات السبليت والكاسيت والمركزي من Carrier وKoldair وSamsung وSharp وMidea وLG — إنفرتر وغير إنفرتر بجميع السعات من 1 طن حتى 5 طن</p>
        <span class="service-link">اعرف أكثر <i class="fas fa-arrow-left"></i></span>
      </a>
      <a href="/ac/installation" class="service-card reveal delay-1">
        <div class="service-icon"><i class="fas fa-tools"></i></div>
        <h3>تركيب تكييفات</h3>
        <p>تركيب احترافي بواسطة فنيين معتمدين — أنابيب نحاس عالية الجودة، صرف صحيح، اختبار شامل، وضمان على التركيب سنة كاملة</p>
        <span class="service-link">اعرف أكثر <i class="fas fa-arrow-left"></i></span>
      </a>
      <a href="/ac/maintenance" class="service-card reveal delay-2">
        <div class="service-icon"><i class="fas fa-wrench"></i></div>
        <h3>صيانة وشحن فريون</h3>
        <p>صيانة دورية وطارئة لجميع أنواع التكييفات — تنظيف الفلاتر والكويل، شحن الفريون R22 وR410A وR32، استبدال قطع الغيار بأصلية</p>
        <span class="service-link">اعرف أكثر <i class="fas fa-arrow-left"></i></span>
      </a>
    </div>

    <div style="max-width:860px;margin:0 auto;">
      <ContentIntro
        heading="شريكك الموثوق للتكييف في مصر منذ 1999"
        text="تأسست شركة نيو جولدن أوفيس عام 1999 في الإسكندرية، وخلال مسيرة 27 عاماً من العمل المتواصل، نمت لتكون واحدة من الشركات الرائدة في مجال خدمات التكييف في مصر. نتعامل مع أكثر من 50 ماركة وموديل من أفضل تكييفات العالم لنضمن لك دائماً توفر الخيار المناسب لميزانيتك واحتياجاتك."
      />
      <p>في مصر حيث تكون درجات الحرارة الصيفية من أقسى درجات الحرارة في العالم، يصبح التكييف ضرورة حياتية لا رفاهية. سواء كنت تبحث عن تكييف لغرفة نوم صغيرة أو منزل كامل أو شركة أو مصنع، فريقنا المتخصص يوفر لك الحل الأمثل بأفضل الأسعار في السوق المصري.</p>
      <p>من يونيو حتى نهاية سبتمبر يعمل معظم التكييفات في مصر لساعات طويلة يومياً بلا توقف تقريباً، وهذا الاستخدام المكثف يكشف بسرعة أي خطأ في اختيار السعة أو في جودة التركيب — جهاز أصغر من المطلوب يعمل بأقصى طاقته طوال الوقت فيتآكل كمبريسوره أسرع، وجهاز أكبر من اللازم يستهلك كهرباء زائدة دون فائدة تُذكر في التبريد. لهذا نتعامل مع كل عميل باعتباره حالة مختلفة: نسأل عن المساحة، عدد الأشخاص، اتجاه الشمس، وحتى نوع النشاط (منزل هادئ أم محل بابه مفتوح طوال اليوم) قبل أن نرشّح جهازاً بعينه.</p>
      <p>ولأن التكييف استثمار يمتد لسنوات طويلة، صمّمنا خدماتنا الثلاث — البيع والتركيب والصيانة — لتعمل كمنظومة متكاملة وليست خدمات منفصلة: نفس الفريق الذي يبيعك الجهاز هو من يتابع تركيبه وصيانته لاحقاً، فلا تضيع المسؤولية بين أطراف متعددة عند حدوث أي مشكلة.</p>

      <h3 style="margin-top:32px;margin-bottom:16px;"><i class="fas fa-wind" style="color:var(--secondary);margin-left:8px;"></i> الماركات المتوفرة لدينا</h3>
      <ComparisonGrid items={[
        { title: 'Carrier', text: 'الماركة الأمريكية الأولى عالمياً في صناعة التكييف، موثوقية لا مثيل لها وعمر تشغيلي طويل' },
        { title: 'Koldair', text: 'الماركة المصرية الأولى، جودة ممتازة وأسعار تنافسية مع شبكة صيانة واسعة في مصر' },
        { title: 'Samsung', text: 'تقنية الإنفرتر المتطورة بتصميم أنيق وكفاءة طاقة عالية' },
        { title: 'Sharp', text: 'الماركة اليابانية الموثوقة بتقنية تنقية الهواء Plasmacluster الفريدة' },
        { title: 'Midea', text: 'خيار ممتاز من حيث الجودة والسعر، من أكبر شركات التكييف عالمياً' },
        { title: 'LG', text: 'تكييفات ذكية بتقنيات متطورة ومحرك الإنفرتر المزدوج الشهير' },
      ]} />
      <p>لا نحصر أنفسنا في ماركة واحدة لأن كل عميل له أولوية مختلفة: بعض العملاء يريدون أرخص سعر ممكن مع جودة مقبولة (Koldair أو Midea)، وبعضهم يبحث عن أعلى موثوقية طويلة المدى بغض النظر عن السعر (Carrier)، وآخرون يريدون تصميماً أنيقاً وتقنيات ذكية للتحكم عن بعد (Samsung وLG). فريقنا يشرح لك الفروق الحقيقية بدل الترويج لماركة بعينها.</p>

      <MidPageCTA formId="acIndexMidCta" />

      <h3 style="margin-top:32px;margin-bottom:16px;"><i class="fas fa-th" style="color:var(--secondary);margin-left:8px;"></i> أنواع التكييفات المتاحة</h3>
      <ComparisonGrid items={[
        { title: 'تكييف السبليت (Split)', text: 'الأكثر شيوعاً في المنازل والمكاتب، وحدة داخلية على الجدار ووحدة خارجية، ويتوفر بسعات من 1 إلى 3 طن تقريباً لتغطية غرفة النوم حتى الصالة الكبيرة' },
        { title: 'تكييف الكاسيت (Cassette)', text: 'يُركَّب في السقف ويوزّع الهواء البارد في 4 اتجاهات متساوية، مثالي للمحلات التجارية والشركات والمساحات الكبيرة ذات الأسقف المعلقة' },
        { title: 'التكييف المركزي (Central AC)', text: 'للمباني الكبيرة والفنادق والمستشفيات والمجمعات التجارية، حيث يتم تبريد المبنى بالكامل من محطة واحدة عبر شبكة قنوات هواء' },
        { title: 'تكييف قناة الهواء (Ducted)', text: 'نظام مخفي بالكامل داخل السقف مع توزيع الهواء عبر القنوات، يناسب المنازل الراقية والفلل التي تحتاج تبريداً موحداً دون ظهور وحدات على الحوائط' },
      ]} />

      <h3 style="margin-top:32px;margin-bottom:16px;"><i class="fas fa-question-circle" style="color:var(--secondary);margin-left:8px;"></i> متى تحتاج كل خدمة من خدماتنا؟</h3>
      <p>كثير من العملاء لا يعرفون من أين يبدأون — إليك دليل سريع لتحديد ما تحتاجه بالضبط:</p>
      <div class="steps-grid" style="margin-bottom:16px;">
        <div class="step-card reveal"><div class="step-num"><i class="fas fa-shopping-cart"></i></div><h4>تحتاج <a href="/ac/buy">شراء تكييف</a> إذا</h4><p>لا يوجد لديك تكييف أصلاً، أو تكييفك القديم يستهلك فريوناً وكهرباء بشكل مبالغ فيه وأصبح إصلاحه غير مجدٍ اقتصادياً مقارنة بشراء جهاز جديد أوفر في التشغيل</p></div>
        <div class="step-card reveal delay-1"><div class="step-num"><i class="fas fa-tools"></i></div><h4>تحتاج <a href="/ac/installation">تركيب تكييف</a> إذا</h4><p>اشتريت جهازاً جديداً أو نقلته من مكان لآخر، أو تشك أن تركيبك الحالي تم بشكل عشوائي وتريد فحصه وإعادة تركيبه بشكل صحيح</p></div>
        <div class="step-card reveal delay-2"><div class="step-num"><i class="fas fa-wrench"></i></div><h4>تحتاج <a href="/ac/maintenance">صيانة تكييف</a> إذا</h4><p>جهازك يعمل لكن تبريده ضعف، أو يصدر صوتاً أو رائحة غريبة، أو مضى عليه أكثر من 6 أشهر دون فحص دوري — الصيانة الوقائية أرخص بكثير من إصلاح عطل كبير لاحقاً</p></div>
      </div>

      <h3 style="margin-top:32px;margin-bottom:16px;"><i class="fas fa-map-marker-alt" style="color:var(--secondary);margin-left:8px;"></i> نخدم جميع محافظات مصر</h3>
      <p>من الإسكندرية إلى القاهرة الكبرى والجيزة وطنطا والمنصورة وجميع المحافظات، فريقنا الفني المتنقل يصل إليك في أسرع وقت ممكن لبيع وتركيب وصيانة تكييفك. للمشاريع الكبرى، نوفر فرق عمل متعددة لإنجاز العمل في الوقت المحدد. صفحاتنا المخصصة لـ<a href="/cairo/ac">تكييفات القاهرة</a> و<a href="/alexandria/ac">تكييفات الإسكندرية</a> تحتوي على تفاصيل إضافية عن أوقات الاستجابة في كل مدينة.</p>
      <p>للمشاريع التي تحتاج عدداً كبيراً من الوحدات دفعة واحدة — مبنى إداري جديد، فرع تجاري بعدة طوابق، أو مصنع بمساحات متعددة — نتعامل مع هذه الطلبات كمشروع متكامل: معاينة واحدة تغطي كل المبنى، جدول تركيب منظم يقلل التعطيل، وعرض سعر إجمالي واضح بدل تسعير كل وحدة بشكل منفصل. تواصل معنا مبكراً في مرحلة التخطيط إن أمكن حتى نساعدك في تصميم توزيع الوحدات قبل التنفيذ النهائي للكهرباء والتكييف.</p>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>التكييف المناسب حسب طبيعة المكان</h2>
      <p>احتياج التبريد يختلف جذرياً بين منزل هادئ ومحل بابه مفتوح طوال اليوم — إليك كيف نتعامل مع كل حالة</p>
      <div class="divider"></div>
    </div>
    <div class="features-grid">
      <div class="feature-card reveal"><div class="feature-icon"><i class="fas fa-home"></i></div><h4>المنازل والشقق</h4><p>الأولوية للهدوء وكفاءة الطاقة — ننصح غالباً بتكييف إنفرتر سبليت لكل غرفة رئيسية، مع مراعاة توزيع الأجهزة بحيث لا تُثقل عداد الكهرباء عند التشغيل المتزامن</p></div>
      <div class="feature-card reveal delay-1"><div class="feature-icon"><i class="fas fa-building"></i></div><h4>المكاتب والشركات</h4><p>نحتاج لحساب عدد الموظفين وأجهزة الكمبيوتر التي تصدر حرارة إضافية، وغالباً نرشّح تكييف كاسيت في الصالات المشتركة وسبليت في المكاتب الفردية المغلقة</p></div>
      <div class="feature-card reveal delay-2"><div class="feature-icon"><i class="fas fa-store"></i></div><h4>المحلات التجارية</h4><p>الباب المفتوح المستمر يعني فقد تبريد دائم، لذا نرشّح سعة أعلى من الحساب النظري للمساحة بمقدار درجة أو درجتين، مع كاسيت للتوزيع المتساوي في الصالة</p></div>
      <div class="feature-card reveal delay-3"><div class="feature-icon"><i class="fas fa-industry"></i></div><h4>المصانع والمستودعات</h4><p>مساحات كبيرة وأسقف عالية تحتاج تكييفاً مركزياً أو عدة وحدات كاسيت موزعة بعناية، مع مراعاة الحرارة الصادرة عن المعدات والآلات نفسها عند حساب السعة</p></div>
