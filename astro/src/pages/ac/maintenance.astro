    <div class="btn-group" style="justify-content:center;">
      <a href="/contact" class="btn btn-outline btn-lg"><i class="fas fa-phone-alt"></i> اتصل بنا</a>
      <a href="https://wa.me/201227392074?text=أريد%20صيانة%20دورية%20للتكييف" target="_blank" class="btn btn-lg" style="background:var(--white);color:var(--secondary-dark);font-weight:700;"><i class="fab fa-whatsapp" style="color:#25D366;"></i> واتساب مباشر</a>
    </div>
  </div>
</section>
</BaseLayout>
