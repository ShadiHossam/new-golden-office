---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';
import PageHero from '../../components/PageHero.astro';
import { getSeoFor } from '../../lib/siteSeo';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "صيانة تكييفات وشحن فريون",
  "description": "صيانة تكييفات وشحن فريون في مصر — تنظيف فلاتر وكويل، شحن R22 وR410A، استبدال قطع غيار، عقود صيانة سنوية.",
  "serviceType": "صيانة تكييفات",
  "provider": {
    "@type": "LocalBusiness",
    "name": "نيو جولدن أوفيس",
    "url": "https://newgoldenoffice.com",
    "telephone": "+201227392074",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "26 عبد المنعم سند",
      "addressLocality": "الإبراهيمية، باب شرق",
      "addressRegion": "الإسكندرية",
      "addressCountry": "EG"
    }
  },
  "areaServed": { "@type": "Country", "name": "Egypt" }
});
---

<BaseLayout
  {...getSeoFor('/ac/maintenance')}
  schemaJson={schemaJson}
  preloadImage="/images/ac-hub.webp"
>
<PageHero
  title="صيانة تكييفات وشحن فريون في مصر — خدمة سريعة"
  subtitle="تكييفك يعمل لكنه لا يبرد بالكفاءة المعتادة؟ قد يحتاج إلى صيانة دورية أو شحن فريون. نيو جولدن أوفيس تقدم خدمة صيانة تكييفات شاملة في مصر منذ 1999 — استجابة سريعة وأسعار مناسبة"
  heroImage="/images/ac-hub.webp"
  heroIcon="fa-wrench"
  breadcrumbs={[
    { label: 'الرئيسية', href: '/' },
    { label: 'تكييفات', href: '/ac' },
    { label: 'صيانة وشحن فريون' }
  ]}
/>

<section class="service-detail">
  <div class="container"><div class="service-detail-grid">
    <div class="service-content">
      <h2>شحن فريون مصر وصيانة التكييف — الاستثمار الأذكى لحماية جهازك</h2>
      <p>الصيانة الدورية تُطيل عمر التكييف بشكل كبير وتوفر فاتورة الكهرباء وتمنع الأعطال المكلفة. معظم مشاكل التكييف في مصر يمكن تفاديها بصيانة وقائية بسيطة كل 6 أشهر قبل بداية الصيف وبعد انتهائه.</p>

      <h3><i class="fas fa-heartbeat" style="color:var(--secondary);margin-left:8px;"></i> لماذا تحتاج لصيانة تكييفك؟</h3>
      <ul>
        <li><i class="fas fa-check-circle"></i><span><strong>توفير الكهرباء:</strong> تكييف نظيف يعمل بكفاءة 20-30% أعلى من تكييف متسخ الفلاتر — الفلتر المتسخ يُجبر الكمبريسور على العمل أكثر لينتج نفس البرودة</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>تبريد أقوى وأسرع:</strong> الكويل النظيف والفريون الكافي يضمنان الوصول لدرجة الحرارة المطلوبة أسرع وبأقل ضوضاء</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>هواء نظيف وصحي:</strong> الفلاتر المتسخة تُعيد تدوير الغبار والجراثيم في الغرفة — التنظيف الدوري يُحسّن جودة الهواء</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>منع الأعطال المفاجئة:</strong> اكتشاف مشاكل الفريون أو الكمبريسور مبكراً يوفر عليك تكلفة إصلاح كبيرة لاحقاً</span></li>
      </ul>

      <h3><i class="fas fa-exclamation-triangle" style="color:var(--secondary);margin-left:8px;"></i> علامات تكييفك يحتاج صيانة فوراً</h3>
      <ul>
        <li><i class="fas fa-check-circle"></i><span><strong>لا يبرد كما كان سابقاً</strong> رغم أنه يعمل — علامة على نقص فريون أو فلتر مسدود</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>صوت غير طبيعي</strong> كطرق أو صفير — علامة على مشكلة في الكمبريسور أو الفان</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>تقطير مياه من الوحدة الداخلية</strong> — خرطوم الصرف مسدود أو ممتلئ</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>ارتفاع فاتورة الكهرباء</strong> دون تغيير في الاستخدام — التكييف يُجهد نفسه أكثر</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>رائحة كريهة</strong> عند تشغيله — تكاثر بكتيريا في الفلتر أو الكويل</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>تجمد الوحدة الداخلية</strong> — نقص فريون واضح</span></li>
      </ul>

      <MidPageCTA formId="acMaintenanceMidCta" />

      <h3><i class="fas fa-tools" style="color:var(--secondary);margin-left:8px;"></i> ماذا تشمل خدمة الصيانة؟</h3>
      <ul>
        <li><i class="fas fa-check-circle"></i><span><strong>تنظيف الفلتر:</strong> غسيل الفلاتر وتعقيمها لضمان تدفق هواء نظيف وتوفير الكهرباء</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>تنظيف كويل التبخير والمكثف:</strong> إزالة الأتربة والعوالق من الكويل بمحاليل متخصصة</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>فحص مستوى الفريون:</strong> قياس ضغط الفريون بـ Manifold Gauge وإضافة الكمية المطلوبة إن لزم</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>تنظيف وفحص خرطوم الصرف:</strong> تنظيف خرطوم الصرف والتحقق من ميله وعدم انسداده</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>فحص الكمبريسور والكهرباء:</strong> قياس استهلاك الكمبريسور والتأكد من سلامة التوصيلات والكابلات</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>فحص المكثفات (Capacitors):</strong> فحص المكثفات واستبدال المعطوب منها، سبب شائع لأعطال الكمبرسور</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>فحص الموتورات والريش:</strong> فحص الموتورات الداخلية والخارجية والتأكد من سلامة الريش</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>اختبار وحدة التحكم والريموت:</strong> التأكد من استجابة الوحدة لجميع أوامر الريموت</span></li>
      </ul>

      <h3><i class="fas fa-wind" style="color:var(--secondary);margin-left:8px;"></i> شحن الفريون — R22 وR410A وR32</h3>
      <ul>
        <li><i class="fas fa-check-circle"></i><span><strong>فريون R22:</strong> مادة التبريد التقليدية المستخدمة في التكييفات المصنوعة قبل 2015 تقريباً، ويُمنع تدريجياً في كثير من الدول بسبب ضرره على طبقة الأوزون. لا يزال متوفراً لدينا مع قياس الضغط الدقيق لتحديد الكمية المناسبة، لكن أسعاره في ارتفاع مستمر بسبب تقليص الإنتاج العالمي</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>فريون R410A:</strong> النوع الأشيع في التكييفات الحديثة — صديق للبيئة وأكفأ في نقل الحرارة، يعمل بضغط أعلى ويتطلب معدات شحن مختلفة وزيوت خاصة</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>فريون R32:</strong> الجيل الجديد الأكثر كفاءة وصداقة للبيئة — يُستخدم في التكييفات الحديثة من Samsung وMidea وLG</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>كشف تسريبات الفريون:</strong> إذا نقص الفريون مراراً فهذا يعني وجود تسريب — نُشخّصه ونُصلحه قبل إعادة الشحن</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>تنبيه مهم:</strong> لا يمكن تحويل تكييف R22 ليعمل بـ R410A دون تغيير مكونات جوهرية، والتحويل غير المتخصص يُتلف الكمبرسور. إذا كان تكييفك القديم يستهلك الفريون بسرعة، استشرنا لتقييم جدوى الصيانة مقابل الاستبدال</span></li>
      </ul>

      <h3><i class="fas fa-file-contract" style="color:var(--secondary);margin-left:8px;"></i> عقود الصيانة السنوية</h3>
      <p>للشركات والمحلات وأصحاب أنظمة التكييف المتعددة نوفر عقود صيانة سنوية تشمل:</p>
      <ul>
        <li><i class="fas fa-check-circle"></i><span>زيارتان إلى أربع زيارات للصيانة الشاملة سنوياً حسب الاتفاق (قبل الصيف وبعده أساساً)</span></li>
        <li><i class="fas fa-check-circle"></i><span>أولوية الاستجابة لطلبات الصيانة الطارئة خلال 24 ساعة</span></li>
        <li><i class="fas fa-check-circle"></i><span><strong>خصومات على قطع الغيار:</strong> أسعار مخفضة على قطع الغيار والمواد المستهلكة لعملاء العقود</span></li>
        <li><i class="fas fa-check-circle"></i><span>تقرير صيانة مكتوب ومفصل بعد كل زيارة</span></li>
      </ul>
      <p>نخدم الإسكندرية والقاهرة والمدن المجاورة. تواصل معنا للحصول على عرض سعر لعقد صيانة مخصص لعدد وحداتك ومتطلباتك.</p>

      <div style="overflow-x:auto;margin-top:24px;">
        <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
          <caption style="caption-side:top;text-align:right;margin-bottom:12px;font-weight:700;color:var(--primary);">جدول الصيانة الموصى به</caption>
          <thead>
            <tr>
              <th style="padding:12px 14px;text-align:right;background:#e8f4ff;color:#1a6cbf;border-bottom:2px solid #bee0ff;">الصيانة الشهرية</th>
              <th style="padding:12px 14px;text-align:right;background:#e8fff0;color:#1a8f5b;border-bottom:2px solid #b3f0d0;">الصيانة كل 3 أشهر</th>
              <th style="padding:12px 14px;text-align:right;background:#fff8e8;color:#9c7a1a;border-bottom:2px solid #ffd980;">الصيانة السنوية</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="padding:10px 14px;background:#e8f4ff;color:#333;vertical-align:top;">تنظيف الفلاتر يدوياً</td>
              <td style="padding:10px 14px;background:#e8fff0;color:#333;vertical-align:top;">تنظيف كويل التبخير</td>
              <td style="padding:10px 14px;background:#fff8e8;color:#333;vertical-align:top;">فحص وقياس الفريون</td>
            </tr>
            <tr>
              <td style="padding:10px 14px;background:#e8f4ff;color:#333;vertical-align:top;">التأكد من عمل الريموت</td>
              <td style="padding:10px 14px;background:#e8fff0;color:#333;vertical-align:top;">تنظيف خرطوم الصرف</td>
              <td style="padding:10px 14px;background:#fff8e8;color:#333;vertical-align:top;">فحص الكمبريسور والكهرباء</td>
            </tr>
            <tr>
              <td style="padding:10px 14px;background:#e8f4ff;color:#333;vertical-align:top;">التحقق من عدم وجود روائح غريبة</td>
              <td style="padding:10px 14px;background:#e8fff0;color:#333;vertical-align:top;">فحص ضوضاء غير طبيعية</td>
              <td style="padding:10px 14px;background:#fff8e8;color:#333;vertical-align:top;">تنظيف كويل المكثف</td>
            </tr>
            <tr>
              <td style="padding:10px 14px;background:#e8f4ff;color:#333;vertical-align:top;border-bottom:none;">—</td>
              <td style="padding:10px 14px;background:#e8fff0;color:#333;vertical-align:top;border-bottom:none;">فحص الكابلات الكهربائية</td>
              <td style="padding:10px 14px;background:#fff8e8;color:#333;vertical-align:top;border-bottom:none;">التأكد من سلامة التمديدات</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <aside class="service-sidebar">
      <div class="sidebar-card">
        <h4><i class="fas fa-list" style="color:var(--secondary);margin-left:8px;"></i> خدمات التكييف</h4>
        <div class="sidebar-services">
          <a href="/ac/buy" class="sidebar-service-link"><span>بيع تكييفات</span><i class="fas fa-angle-left"></i></a>
          <a href="/ac/installation" class="sidebar-service-link"><span>تركيب تكييفات</span><i class="fas fa-angle-left"></i></a>
          <a href="/ac/maintenance" class="sidebar-service-link active"><span>صيانة وشحن فريون</span><i class="fas fa-angle-left"></i></a>
        </div>
      </div>
      <div class="sidebar-card">
        <h4><i class="fas fa-phone-alt" style="color:var(--secondary);margin-left:8px;"></i> تواصل معنا</h4>
        <div class="contact-info">
          <div class="contact-info-item"><i class="fas fa-phone-alt"></i><a href="tel:+201227392074">01227392074</a></div>
