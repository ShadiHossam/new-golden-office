---
// Generic renderer for custom pages created via the admin's Pages module
// (astro/src/content/pages/*.json). Mirrors the old renderPageHtml() shell:
// page-hero + breadcrumb + body + optional CTA banner.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MidPageCTA from '../components/MidPageCTA.astro';
import * as cheerio from 'cheerio';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => data.status === 'published');
  return pages.map((page) => ({
    params: { slug: page.data.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const d = page.data;

// Split body_html roughly in half (at a top-level block boundary) so the
// mid-page CTA can be inserted between the two halves.
function splitAtMidpoint(html: string): { firstHtml: string; secondHtml: string } {
  const $ = cheerio.load(html, null, false);
  const nodes = $.root().contents().toArray();
  const blockNodes = nodes
    .map((n, i) => ({ n, i }))
    .filter(({ n }) => n.type === 'tag');
  if (blockNodes.length < 4) {
    return { firstHtml: html, secondHtml: '' };
  }
  const midIdx = blockNodes[Math.floor(blockNodes.length / 2)].i;
  const firstHtml = nodes.slice(0, midIdx).map((n) => $.html(n)).join('');
  const secondHtml = nodes.slice(midIdx).map((n) => $.html(n)).join('');
  return { firstHtml, secondHtml };
}

const { firstHtml, secondHtml } = splitAtMidpoint(d.body_html || '');
---

<BaseLayout
  title={d.seo_title || d.title}
  description={d.meta_description}
  keywords={d.meta_keywords}
  ogTitle={d.og_title || d.seo_title || d.title}
  ogDescription={d.og_description || d.meta_description}
  ogImage={d.og_image}
  robots={d.robots || undefined}
>
<section class="page-hero">
  <div class="container">
    <div class="page-hero-content">
      <nav class="breadcrumb" aria-label="breadcrumb">
        <a href="/">الرئيسية</a>
        <i class="fa-solid fa-chevron-left"></i>
        <span>{d.title}</span>
      </nav>
      <h1 class="reveal">{d.title}</h1>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div set:html={firstHtml} />
  </div>
</section>

{secondHtml && <MidPageCTA formId="pageMidCta" />}

{secondHtml && (
  <section class="section" style="padding-top:0">
    <div class="container">
      <div set:html={secondHtml} />
    </div>
  </section>
)}
</BaseLayout>
