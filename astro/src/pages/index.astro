---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSeoFor } from '../lib/siteSeo';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما هي الخدمات التي تقدمها نيو جولدن أوفيس؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نقدم ست فئات خدمات متكاملة تحت سقف واحد: المستلزمات المكتبية (ورق A4، أقلام، دفاتر، ملفات)، خدمات الطباعة (أوفست ورقمية وبنرات وبزنس كارد وUV)، ماكينات التصوير والطابعات (بيع وصيانة وكارتريدج)، كاميرات المراقبة (بيع وتركيب وصيانة)، التكييفات (بيع وتركيب وصيانة)، وماكينات عد النقود وكشف التزييف والفارم وتدمير المستندات."
      }
    },
    {
      "@type": "Question",
      "name": "هل تخدمون خارج الإسكندرية؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم، رغم أن مقرنا الرئيسي في الإسكندرية، فإننا نخدم عملاءنا في جميع محافظات مصر بما في ذلك القاهرة الكبرى والجيزة والدلتا والصعيد. لدينا فرق ميدانية متنقلة للتركيب والصيانة وشبكة توصيل تغطي جميع المحافظات."
      }
    },
    {
      "@type": "Question",
      "name": "كيف أحصل على عرض سعر؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "يمكنك التواصل معنا عبر الهاتف أو واتساب على 01227392074 أو من خلال نموذج التواصل في صفحة اتصل بنا. أخبرنا باحتياجك وسنرسل لك عرض سعر مفصل خلال وقت قصير، مع إمكانية المعاينة الميدانية للخدمات التي تتطلب ذلك مثل التكييفات وكاميرات المراقبة."
      }
    },
    {
      "@type": "Question",
      "name": "هل تقدمون خصومات للشركات والطلبات بالجملة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم، نوفر أسعار جملة تنافسية للشركات والمؤسسات والمدارس والجهات الحكومية على جميع فئاتنا، مع إمكانية التوريد المنتظم الشهري وفواتير ضريبية رسمية واتفاقيات صيانة سنوية للتكييفات وماكينات التصوير وكاميرات المراقبة."
      }
    },
    {
      "@type": "Question",
      "name": "هل المنتجات أصلية ومضمونة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم، جميع منتجاتنا أصلية 100% من موزعين معتمدين، ونقدم ضمانًا شاملاً على كل منتج وخدمة نبيعها، بالإضافة إلى ضمان إضافي على التركيب في خدمات التكييفات وكاميرات المراقبة."
      }
    },
    {
      "@type": "Question",
      "name": "هل لديكم فرع أو معرض يمكن زيارته؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم، مقرنا ومعرضنا الرئيسي في الإبراهيمية، باب شرق بالإسكندرية، ويمكنكم زيارته لمعاينة المنتجات مباشرة. لعملاء المحافظات الأخرى، نوفر معاينة عن بُعد وصورًا وفيديوهات تفصيلية للمنتجات قبل الشراء."
      }
    },
    {
      "@type": "Question",
      "name": "ما هي طرق الدفع المتاحة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نقبل الدفع النقدي والتحويل البنكي، ونوفر للشركات والعملاء الدائمين إمكانية الدفع الآجل بعد الاتفاق على شروط التعامل، بالإضافة إلى فواتير ضريبية رسمية لجميع المعاملات."
      }
    },
    {
      "@type": "Question",
      "name": "كم يستغرق التوصيل أو التركيب؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "توصيل المستلزمات المكتبية والطباعة يتم عادة خلال نفس اليوم في الإسكندرية ويوم إلى يومي عمل في باقي المحافظات. أما خدمات التركيب مثل التكييفات وكاميرات المراقبة فتُجدول حسب حجم العمل، مع التزام تام بالمواعيد المتفق عليها."
      }
    }
  ]
});
---

<BaseLayout
  {...getSeoFor('/')}
  preloadImage="/images/hero-office.webp"
  schemaJson={schemaJson}
>

<!-- ═══════════════ HERO ═══════════════ -->
<section class="hero">
  <div class="container">
    <div class="hero-grid">

      <div class="hero-text">
        <div class="hero-badge animate">
          <i class="fas fa-award"></i>
          شريكك الموثوق في مصر منذ عام 1999
        </div>
        <h1 class="animate delay-1">
          <span>شركة طباعة ومستلزمات مكتبية</span><br>
          كل ما يحتاجه مكتبك في مكان واحد
        </h1>
        <p class="lead animate delay-2">
          مستلزمات مكتبية، طباعة احترافية، ماكينات تصوير وطابعات، كاميرات مراقبة، تكييفات — كل ما يحتاجه عملك في مكان واحد، بجودة مضمونة وأسعار تنافسية وتوصيل سريع لجميع أنحاء مصر.
        </p>
        <div class="hero-btns animate delay-3">
          <a href="/contact" class="btn btn-primary btn-lg">
            <i class="fas fa-phone-alt"></i> اتصل بنا الآن
          </a>
          <a href="https://wa.me/201227392074" target="_blank" class="btn btn-whatsapp btn-lg">
            <i class="fab fa-whatsapp"></i> واتساب مباشر
          </a>
        </div>
        <div class="hero-stats-boxes animate delay-4">
          <div class="hero-stat-box">
            <div class="num">27+</div>
            <div class="lbl">سنة خبرة</div>
          </div>
          <div class="hero-stat-box">
            <div class="num">5000+</div>
            <div class="lbl">عميل راضي</div>
          </div>
          <div class="hero-stat-box">
            <div class="num">50+</div>
            <div class="lbl">ماركة عالمية</div>
          </div>
          <div class="hero-stat-box">
            <div class="num">6</div>
            <div class="lbl">خدمات متكاملة</div>
          </div>
        </div>
      </div>

      <div class="hero-panel hero-panel-photo animate delay-2" style="background-image:url('/images/hero-office.webp')">
        <img src="/images/logo.png" alt="نيو جولدن أوفيس" class="hero-panel-logo" fetchpriority="high" width="88" height="88">
        <div class="hero-panel-since">شريكك الموثوق منذ عام</div>
        <div class="hero-panel-year">١٩٩٩</div>
        <div class="hero-panel-divider"></div>
        <div class="service-chips">
          <span class="service-chip"><i class="fas fa-print"></i> طباعة</span>
          <span class="service-chip"><i class="fas fa-copy"></i> ماكينات تصوير</span>
          <span class="service-chip"><i class="fas fa-video"></i> كاميرات مراقبة</span>
          <span class="service-chip"><i class="fas fa-wind"></i> تكييفات</span>
          <span class="service-chip"><i class="fas fa-money-bill-wave"></i> ماكينات نقود</span>
          <span class="service-chip"><i class="fas fa-briefcase"></i> مستلزمات مكتبية</span>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ═══════════════ SERVICES ═══════════════ -->
<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>كل ما تحتاجه لمكتبك في مكان واحد</h2>
      <p>نقدم لك مجموعة متكاملة من الخدمات والمنتجات المكتبية بجودة مضمونة وأسعار تنافسية في جميع أنحاء مصر</p>
      <div class="divider"></div>
    </div>
    <div class="services-grid">
      <a href="/office-supplies" class="service-card reveal">
        <div class="service-card-img"><img src="/images/office-supplies-hub.webp" alt="مستلزمات مكتبية" loading="lazy"></div>
        <div class="service-icon"><i class="fas fa-briefcase"></i></div>
        <h3>ورق ومستلزمات مكتبية</h3>
        <p>ورق A4، ورق حراري، أقلام، دفاتر، ملفات، أختام، وجميع المستلزمات المكتبية — توصيل سريع لجميع أنحاء مصر</p>
        <span class="service-link">تعرف أكثر <i class="fas fa-arrow-left"></i></span>
      </a>
      <a href="/printing" class="service-card reveal delay-1">
        <div class="service-card-img"><img src="/images/printing-hub.webp" alt="خدمات الطباعة" loading="lazy"></div>
        <div class="service-icon"><i class="fas fa-print"></i></div>
        <h3>خدمات الطباعة</h3>
        <p>طباعة أوفست، رقمية، بنرات، بزنس كارد، UV، وطباعة على الهدايا — نجيب بأفضل نتيجة لكل مشروع</p>
        <span class="service-link">تعرف أكثر <i class="fas fa-arrow-left"></i></span>
      </a>
      <a href="/copiers" class="service-card reveal delay-2">
        <div class="service-card-img"><img src="/images/copiers-hub.webp" alt="ماكينات التصوير" loading="lazy"></div>
        <div class="service-icon"><i class="fas fa-copy"></i></div>
        <h3>ماكينات التصوير والطابعات</h3>
        <p>بيع وصيانة ماكينات التصوير والطابعات وتعبئة الكارتريدج لجميع الماركات العالمية</p>
        <span class="service-link">تعرف أكثر <i class="fas fa-arrow-left"></i></span>
      </a>
      <a href="/cameras" class="service-card reveal">
        <div class="service-card-img"><img src="/images/cameras-hub.webp" alt="كاميرات المراقبة" loading="lazy"></div>
        <div class="service-icon"><i class="fas fa-video"></i></div>
        <h3>كاميرات المراقبة</h3>
        <p>بيع وتركيب وصيانة كاميرات المراقبة وأنظمة DVR وNVR وكاميرات IP وواي فاي</p>
        <span class="service-link">تعرف أكثر <i class="fas fa-arrow-left"></i></span>
      </a>
      <a href="/ac" class="service-card reveal delay-1">
        <div class="service-card-img"><img src="/images/ac-hub.webp" alt="التكييفات" loading="lazy"></div>
        <div class="service-icon"><i class="fas fa-wind"></i></div>
        <h3>التكييفات</h3>
        <p>بيع وتركيب وصيانة جميع أنواع التكييفات السبليت والكاسيت وشحن الفريون</p>
        <span class="service-link">تعرف أكثر <i class="fas fa-arrow-left"></i></span>
      </a>
      <a href="/cash-machines" class="service-card reveal delay-2">
        <div class="service-card-img"><img src="/images/cash-machines-hub.webp" alt="ماكينات عد النقود" loading="lazy"></div>
        <div class="service-icon"><i class="fas fa-money-bill-wave"></i></div>
        <h3>ماكينات الفارم والعد النقدي</h3>
        <p>ماكينات عد النقود، كشف العملات المزيفة، ماكينات الفارم والختم، وتدمير المستندات</p>
        <span class="service-link">تعرف أكثر <i class="fas fa-arrow-left"></i></span>
      </a>
    </div>
  </div>
</section>

<!-- ═══════════════ SERVICES IN DETAIL ═══════════════ -->
<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>خدماتنا الست بالتفصيل — تعرف على كل قسم</h2>
      <p>كل قسم من أقسامنا يُدار بفريق متخصص وخبرة مستقلة، لكنها جميعًا تجتمع تحت سقف واحد لتوفر عليك عناء التعامل مع أكثر من مورد</p>
      <div class="divider"></div>
    </div>
    <div style="max-width:900px;margin:0 auto;display:flex;flex-direction:column;gap:28px">
      <div class="reveal">
        <h3 style="margin-bottom:10px"><i class="fas fa-briefcase" style="color:var(--secondary);margin-left:8px"></i> مستلزمات مكتبية بالجملة</h3>
        <p style="line-height:1.9;color:var(--text-muted)">ورق A4 وورق حراري للكاشير، أقلام BIC وPilot وStabilo، دفاتر ومفكرات، ملفات وأدوات أرشفة، أختام، أظرف، وايت بورد وفلين بورد، أدوات ربط ودباسة، بوست إت، وبطاريات وUSB. نخدم المكاتب والمدارس والمستشفيات والجهات الحكومية بتوريد منتظم شهري وفواتير ضريبية رسمية.</p>
      </div>
      <div class="reveal delay-1">
        <h3 style="margin-bottom:10px"><i class="fas fa-print" style="color:var(--secondary);margin-left:8px"></i> خدمات الطباعة الاحترافية</h3>
        <p style="line-height:1.9;color:var(--text-muted)">من طباعة الأوفست للكميات الكبيرة إلى الطباعة الرقمية السريعة، مرورًا بالبنرات الإعلانية الكبيرة، بزنس كارد فاخرة، طباعة UV على أسطح غير تقليدية، وطباعة الهدايا الترويجية بشعار شركتك. فريقنا يرشدك لاختيار طريقة الطباعة الأنسب لميزانيتك وتوقيتك.</p>
      </div>
      <div class="reveal delay-2">
        <h3 style="margin-bottom:10px"><i class="fas fa-copy" style="color:var(--secondary);margin-left:8px"></i> ماكينات التصوير والطابعات</h3>
        <p style="line-height:1.9;color:var(--text-muted)">بيع وصيانة ماكينات تصوير وطابعات Canon وRicoh وKyocera وXerox، مع تعبئة كارتريدج أصلية أو متوافقة عالية الجودة لماركات HP وEpson وغيرها. نوفر عقود صيانة سنوية للشركات لضمان استمرارية العمل دون انقطاع.</p>
      </div>
      <div class="reveal delay-3">
        <h3 style="margin-bottom:10px"><i class="fas fa-video" style="color:var(--secondary);margin-left:8px"></i> كاميرات المراقبة الأمنية</h3>
        <p style="line-height:1.9;color:var(--text-muted)">كاميرات Hikvision وDahua بتقنيات IP وواي فاي وأنظمة تسجيل DVR وNVR، بيع وتركيب وصيانة لمحلات تجارية ومصانع ومنازل ومقرات شركات. تصميم نظام المراقبة يبدأ بمعاينة الموقع لتحديد عدد الكاميرات والزوايا المثلى.</p>
      </div>
      <div class="reveal">
        <h3 style="margin-bottom:10px"><i class="fas fa-wind" style="color:var(--secondary);margin-left:8px"></i> التكييفات بجميع أنواعها</h3>
        <p style="line-height:1.9;color:var(--text-muted)">تكييفات سبليت وكاسيت ومركزي من Carrier وKoldair وSamsung وSharp وMidea وLG، بيع وتركيب احترافي وشحن فريون R22 وR410A وR32. نحسب السعة المناسبة لمساحتك مجانًا قبل أي عملية شراء.</p>
      </div>
      <div class="reveal delay-1">
        <h3 style="margin-bottom:10px"><i class="fas fa-money-bill-wave" style="color:var(--secondary);margin-left:8px"></i> ماكينات عد النقود والفارم</h3>
        <p style="line-height:1.9;color:var(--text-muted)">ماكينات عد وفرز النقود، أجهزة كشف العملات المزيفة بالأشعة فوق البنفسجية، ماكينات الفارم والختم البريدي، وماكينات تدمير المستندات (Shredder) بمستويات أمان مختلفة للبنوك والصرافات والمحلات والشركات.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════ IMAGE BANNER ═══════════════ -->
<div class="image-banner">
  <img src="/images/about-team.webp" alt="فريق نيو جولدن أوفيس" loading="lazy">
  <div class="image-banner-overlay">
    <h3>نوفر لك الوقت ونجيب بأفضل حل لكل احتياج</h3>
    <p>شريكك الموثوق في مصر منذ 1999 — جودة مضمونة وأسعار تنافسية</p>
  </div>
</div>

<!-- ═══════════════ WHY US ═══════════════ -->
<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>نقدم لك أكثر من مجرد منتج</h2>
      <p>نلتزم بتقديم خدمة متكاملة تبدأ من الاستشارة وتنتهي بالصيانة الدورية</p>
      <div class="divider"></div>
    </div>
    <div class="features-grid">
      <div class="feature-card reveal">
        <div class="feature-icon"><i class="fas fa-history"></i></div>
        <h4>نفهم احتياجك ونجيب بأفضل حل</h4>
        <p>خبرة متراكمة منذ 1999 تجعلنا نختصر عليك الوقت والبحث ونقدم لك الحل الأمثل مباشرة</p>
      </div>
      <div class="feature-card reveal delay-1">
        <div class="feature-icon"><i class="fas fa-shield-alt"></i></div>
        <h4>ضمان شامل على جميع المنتجات</h4>
        <p>نضمن لك جميع المنتجات والخدمات مع دعم فني متواصل وقطع غيار أصلية</p>
      </div>
      <div class="feature-card reveal delay-2">
        <div class="feature-icon"><i class="fas fa-tags"></i></div>
        <h4>أسعار تنافسية ومرنة</h4>
        <p>نقدم أفضل الأسعار في السوق مع إمكانية التقسيط والتفاوض على الكميات الكبيرة</p>
      </div>
      <div class="feature-card reveal delay-3">
        <div class="feature-icon"><i class="fas fa-headset"></i></div>
        <h4>خدمة ما بعد البيع</h4>
        <p>فريق دعم فني متخصص لصيانة منتجاتك وضمان استمرارية عملك دون انقطاع</p>
      </div>
      <div class="feature-card reveal">
        <div class="feature-icon"><i class="fas fa-layer-group"></i></div>
        <h4>مورد واحد بدل خمسة</h4>
        <p>بدل التنقل بين مورد مستلزمات ومطبعة وفني تكييف وفني كاميرات، كل احتياجاتك تُدار من جهة واحدة تعرف تاريخ تعاملك وتفهم احتياجك</p>
      </div>
      <div class="feature-card reveal delay-1">
        <div class="feature-icon"><i class="fas fa-file-invoice"></i></div>
        <h4>تعامل مؤسسي واضح</h4>
        <p>عروض أسعار رسمية وفواتير ضريبية وعقود صيانة مكتوبة للشركات والمؤسسات، بلا غموض في الشروط أو المستحقات</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════ ABOUT / STORY ═══════════════ -->
<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>قصتنا: من محل صغير في الإسكندرية إلى شريك تجهيز لآلاف المكاتب</h2>
      <div class="divider"></div>
    </div>
    <div class="intro-text" style="max-width:900px;margin:0 auto;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>تأسست نيو جولدن أوفيس عام 1999 في الإبراهيمية بباب شرق، الإسكندرية، كمحل متخصص في المستلزمات المكتبية وصيانة ماكينات التصوير. مع مرور السنوات وثقة العملاء المتزايدة، توسعنا تدريجيًا لنضم خدمات الطباعة الاحترافية، ثم كاميرات المراقبة الأمنية، ثم التكييفات، وأخيرًا ماكينات عد النقود وكشف التزييف وتدمير المستندات — كل توسع جاء استجابة لاحتياج حقيقي طلبه عملاؤنا أنفسهم.</p>
      <p style="margin-top:16px">اليوم، وبعد أكثر من 27 عامًا من العمل المتواصل، خدمنا أكثر من 5000 عميل راضٍ يمتدون من الإسكندرية والقاهرة الكبرى إلى الدلتا والصعيد وكل محافظات مصر. نتعامل مع أكثر من 50 ماركة عالمية معتمدة في مجالاتنا الستة، ونحرص أن يكون كل عميل — سواء كان صاحب مكتب صغير أو مدير مشتريات في شركة كبرى — قد وجد لدينا الحل الأمثل بأفضل سعر ودون أي مجهود إضافي في البحث عن مورد موثوق.</p>
      <p style="margin-top:16px">فلسفتنا بسيطة: نؤمن أن الوقت أثمن من أن يُهدر في التنقل بين موردين متعددين لتجهيز مكتب أو شركة واحدة. لهذا بنينا نيو جولدن أوفيس لتكون نقطة الاتصال الواحدة التي تغطي كل احتياجات التجهيز والتشغيل المكتبي، من قلم رصاص إلى تكييف مركزي، بنفس مستوى الجودة والالتزام في كل قسم.</p>
      <p style="margin-top:16px">كل فني وموظف مبيعات في فريقنا مدرّب على قسمه بشكل متخصص، فمن يتولى تركيب التكييفات مختلف عن من يتابع عقود صيانة ماكينات التصوير أو من يرشح كاميرات المراقبة، وهذا التخصص الداخلي هو ما يحافظ على جودة الخدمة رغم اتساع نطاق أعمالنا. ونحرص دائمًا على استيراد وتوريد منتجات أصلية 100% من وكلاء ومصنّعين معتمدين، مع ضمان مكتوب على كل عملية بيع أو تركيب، لأن سمعتنا بُنيت على مدار 27 عامًا ولا نساوم عليها من أجل صفقة واحدة.</p>
    </div>
  </div>
</section>

