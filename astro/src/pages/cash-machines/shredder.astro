          <tr style="background:#fff;border-bottom:1px solid #eee"><td style="padding:12px 16px;font-weight:700">P-5 / P-6</td><td style="padding:12px 16px">قطع دقيقة جداً</td><td style="padding:12px 16px">البنوك والمؤسسات الحكومية</td></tr>
