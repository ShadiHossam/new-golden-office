---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MidPageCTA from '../../components/MidPageCTA.astro';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://newgoldenoffice.com/cash-machines/alexandria#service",
      "name": "بيع ماكينات عد نقود وكشف تزييف في الإسكندرية",
      "serviceType": "توريد وصيانة ماكينات عد النقود وأجهزة كشف تزييف العملة",
      "url": "https://newgoldenoffice.com/cash-machines/alexandria",
      "provider": { "@id": "https://newgoldenoffice.com/#organization" },
      "areaServed": { "@type": "City", "name": "الإسكندرية" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"ما أسعار ماكينات عد النقود في الإسكندرية؟","acceptedAnswer":{"@type":"Answer","text":"تختلف حسب النوع (عد فقط، عد مع كشف، عد وفرز) والسرعة والماركة. تواصل معنا وستصلك قائمة أسعار محدثة في نفس اليوم."}},
        {"@type":"Question","name":"هل يمكن لماكينة عد النقود كشف التزوير؟","acceptedAnswer":{"@type":"Answer","text":"نعم، أغلب الموديلات تجمع بين العد وكشف التزييف بتقنيات UV وMG وIR."}},
        {"@type":"Question","name":"ما الفرق بين ماكينة العد فقط والعد مع الفرز وكشف التزوير؟","acceptedAnswer":{"@type":"Answer","text":"العد فقط يعطي عدد الأوراق، والعد مع الكشف يفحص التزييف، والعد والفرز يضيف فصل الفئات وقراءة القيمة."}},
        {"@type":"Question","name":"هل تدعم الماكينة الجنيه المصري والدولار واليورو؟","acceptedAnswer":{"@type":"Answer","text":"كل الموديلات تدعم الجنيه، وتتوفر موديلات تدعم الدولار واليورو أيضًا."}},
        {"@type":"Question","name":"هل يوجد ضمان وصيانة وقطع غيار في الإسكندرية؟","acceptedAnswer":{"@type":"Answer","text":"نعم، ضمان مكتوب وصيانة وقطع غيار من داخل الإسكندرية بلا شحن لمحافظة أخرى."}},
        {"@type":"Question","name":"هل يمكن زيارة معرض لتجربة الماكينة قبل الشراء؟","acceptedAnswer":{"@type":"Answer","text":"نعم، يمكن زيارة مقرنا وتجربة الأجهزة بنقود فعلية قبل الشراء."}},
        {"@type":"Question","name":"كيف أختار ماكينة عد النقود المناسبة لنشاطي؟","acceptedAnswer":{"@type":"Answer","text":"حدد حجم تعاملاتك اليومية وهل تحتاج كشف تزييف وفرز فئات، ونرشح لك الأنسب."}}
      ]
    }
  ]
});
---

<BaseLayout
  title="شركة ماكينات عد نقود في الإسكندرية | ضمان وصيانة محلية"
  description="شركة ماكينات عد نقود في الإسكندرية بخبرة 27 عامًا. أنواع وماركات ماكينات عد الفلوس وكشف تزييف العملة، ضمان وصيانة محلية وعرض سعر سريع. تواصل الآن."
  keywords="شركة ماكينات عد نقود في الإسكندرية، ماكينة عد فلوس الاسكندرية، جهاز كشف تزييف العملة الاسكندرية"
  ogTitle="شركة ماكينات عد نقود في الإسكندرية | نيو جولدن أوفيس"
  ogDescription="أنواع وماركات ماكينات عد الفلوس وكشف تزييف العملة، ضمان وصيانة محلية في الإسكندرية."
  ogImage="/images/money-counting-machine-1-1784574483119-990294.webp"
  robots="noindex, nofollow"
  schemaJson={schemaJson}
>
<style>
  .quote-section{padding:60px 0}
  .quote-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:stretch}
  .quote-form-card{background:#fff;border-radius:18px;padding:2.2rem;box-shadow:0 4px 24px rgba(27,58,107,0.1)}
  .quote-form-card h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:700;color:var(--green-dark);margin-bottom:1.5rem}
  .form-group{margin-bottom:1.1rem}
  .form-group label{display:block;font-family:'Cairo',sans-serif;font-size:0.95rem;font-weight:600;color:var(--green-dark);margin-bottom:0.4rem}
  .form-group input,.form-group select,.form-group textarea{width:100%;padding:0.8rem 1rem;border:2px solid #e5eaf3;border-radius:10px;font-family:'Tajawal',sans-serif;font-size:1rem;color:#333;background:#fafbfd;transition:border-color .3s,box-shadow .3s;outline:none;box-sizing:border-box;direction:rtl}
  .form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--green-dark);box-shadow:0 0 0 3px rgba(27,58,107,.1);background:#fff}
  .form-group textarea{height:100px;resize:vertical}
  .form-submit-btn{width:100%;padding:1rem;background:linear-gradient(135deg,var(--green-dark),var(--green-mid));color:#fff;border:none;border-radius:12px;font-family:'Cairo',sans-serif;font-size:1.05rem;font-weight:700;cursor:pointer;transition:transform .3s,box-shadow .3s;display:flex;align-items:center;justify-content:center;gap:.5rem}
  .form-submit-btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(27,58,107,.25)}
  .success-message{display:none;background:linear-gradient(135deg,#e8f5e9,#f1f8e9);border:2px solid #4caf50;border-radius:12px;padding:1.5rem;text-align:center;margin-top:1rem}
  .success-message i{font-size:2.5rem;color:#4caf50;display:block;margin-bottom:.5rem}
  .success-message p{font-family:'Cairo',sans-serif;font-size:1.05rem;color:#2e7d32;font-weight:600}
  .quote-alt-card{background:linear-gradient(135deg,#25D366 0%,#128C7E 100%);border-radius:18px;padding:2.4rem;text-align:center;color:#fff;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:1rem}
  .quote-alt-card .wa-icon{font-size:3rem}
  .quote-alt-card h3{font-family:'Cairo',sans-serif;font-size:1.3rem;font-weight:800}
  .quote-alt-card p{opacity:.92;line-height:1.8}
  @media(max-width:768px){.quote-grid{grid-template-columns:1fr}}
</style>

<section class="page-hero">
  <div class="container">
    <div class="page-hero-inner">
      <div class="page-hero-content">
        <nav class="breadcrumb">
          <a href="/">الرئيسية</a>
          <span>/</span>
          <a href="/alexandria">خدماتنا في الإسكندرية</a>
          <span>/</span>
          <span class="current">شركة ماكينات عد نقود في الإسكندرية</span>
        </nav>
        <h1 class="reveal">شركة ماكينات عد نقود في الإسكندرية</h1>
        <p class="lead reveal delay-1">ماكينات عد الفلوس وكشف تزييف العملة، تجربة حقيقية في مقرنا قبل الشراء، ضمان وصيانة محلية بخبرة 27 عامًا</p>
      </div>
      <div class="page-hero-image">
        <img src="/images/webp-images/counting-cash-with-a-money-counter-machine-2026-03-25-00-56-49-utc.webp" alt="شركة ماكينات عد نقود في الإسكندرية" loading="eager">
      </div>
    </div>
  </div>
</section>

<section class="stats-section">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item reveal"><div class="stat-num" data-target="27" data-suffix="+">0+</div><div class="stat-label">سنة خبرة في تجهيز محلات الإسكندرية</div></div>
      <div class="stat-item reveal delay-1"><div class="stat-num" data-target="4">0</div><div class="stat-label">أنواع ماكينات عد نقود نوفرها</div></div>
      <div class="stat-item reveal delay-2"><div class="stat-num" data-target="4">0</div><div class="stat-label">ماركات عالمية نتعامل معها</div></div>
      <div class="stat-item reveal delay-3"><div class="stat-num" data-target="1">0</div><div class="stat-label">تجربة حقيقية بنقودك قبل الشراء</div></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="intro-text" style="max-width:900px;margin:0 auto 48px;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>تبحث عن شركة ماكينات عد نقود في الإسكندرية توفر لك جهازًا دقيقًا، وضمانًا حقيقيًا، وصيانة قريبة من محلك؟ نيو جولدن أوفيس تجهز محلات وشركات الإسكندرية بماكينات عد الفلوس وأجهزة كشف تزييف العملة منذ 27 عامًا، من مقرنا الفعلي: 26 عبد المنعم سند، الإبراهيمية، باب شرق. كل دقيقة يقضيها موظفك في عد النقود يدويًا هي دقيقة مهدرة واحتمال خطأ، وكل ورقة مزيفة تمر دون فحص هي خسارة مباشرة من صافي الربح.</p>
    </div>

    <div class="section-header">
      <h2>لماذا نيو جولدن أوفيس؟</h2>
      <div class="divider"></div>
    </div>
    <div class="features-grid">
      <div class="feature-card reveal"><div class="feature-icon"><i class="fas fa-building"></i></div><h4>مقر فعلي في الإسكندرية</h4><p>تزوره وتجرب فيه الماكينة بنقودك الفعلية قبل الشراء.</p></div>
      <div class="feature-card reveal delay-1"><div class="feature-icon"><i class="fas fa-award"></i></div><h4>خبرة 27 عامًا</h4><p>في تجهيز وخدمة المكاتب والشركات، لسنا متجرًا ظهر أمس.</p></div>
      <div class="feature-card reveal delay-2"><div class="feature-icon"><i class="fas fa-location-dot"></i></div><h4>خدمة ما بعد البيع محلية</h4><p>ضمان وصيانة وقطع غيار من داخل المدينة، بلا شحن الجهاز.</p></div>
      <div class="feature-card reveal delay-3"><div class="feature-icon"><i class="fas fa-scale-balanced"></i></div><h4>ترشيح محايد حسب نشاطك</h4><p>نوفر أكثر من ماركة وفئة، فمصلحتنا أن تشتري الجهاز المناسب.</p></div>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>ماكينة عد فلوس الاسكندرية — أنواع ماكينات عد النقود وأيها يناسبك؟</h2>
      <div class="divider"></div>
    </div>
    <div class="services-grid">
      <div class="service-card reveal"><div class="service-icon"><i class="fas fa-coins"></i></div><h3 class="service-title">ماكينة عد فقط</h3><p class="service-desc">تعد الأوراق بسرعة وتعطيك العدد الإجمالي. الخيار الاقتصادي للمحل ذي المخاطر المنخفضة.</p></div>
      <div class="service-card reveal delay-1"><div class="service-icon"><i class="fas fa-magnifying-glass"></i></div><h3 class="service-title">ماكينة عد مع كشف تزييف</h3><p class="service-desc">الفئة الأكثر طلبًا: تعد وتفحص كل ورقة بتقنيات UV وMG وIR أثناء المرور.</p></div>
      <div class="service-card reveal delay-2"><div class="service-icon"><i class="fas fa-layer-group"></i></div><h3 class="service-title">ماكينة عد وفرز العملات</h3><p class="service-desc">تفصل الفئات المختلطة وتقرأ قيمة كل ورقة، مناسبة للصرافة والبنوك.</p></div>
      <div class="service-card reveal delay-3"><div class="service-icon"><i class="fas fa-industry"></i></div><h3 class="service-title">ماكينات كثيفة الاستخدام</h3><p class="service-desc">للتشغيل المتواصل ساعات طويلة: خزانات أكبر وأجزاء أمتن، خيار البنوك وشركات التحصيل.</p></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>مقارنة ماركات ماكينات عد النقود</h2>
      <div class="divider"></div>
    </div>
    <div style="overflow-x:auto;max-width:900px;margin:0 auto">
      <table style="width:100%;border-collapse:collapse;font-size:0.95rem">
        <thead><tr style="background:var(--green-dark);color:var(--white)"><th style="padding:14px 16px;text-align:right">الماركة</th><th style="padding:14px 16px;text-align:right">التموضع العام</th><th style="padding:14px 16px;text-align:right">الأنسب لمن؟</th></tr></thead>
        <tbody>
          <tr style="background:var(--white);border-bottom:1px solid #eee"><td style="padding:12px 16px">Glory</td><td style="padding:12px 16px">فئة عالمية عليا بموثوقية بنكية</td><td style="padding:12px 16px">البنوك والصرافات وخطوط النقد الكثيفة</td></tr>
          <tr style="background:#f8f9fa;border-bottom:1px solid #eee"><td style="padding:12px 16px">Kisan</td><td style="padding:12px 16px">فئة احترافية قوية في العد والفرز</td><td style="padding:12px 16px">الصرافات والشركات ذات الرزم المختلطة</td></tr>
          <tr style="background:var(--white);border-bottom:1px solid #eee"><td style="padding:12px 16px">Magner</td><td style="padding:12px 16px">ماركة عملية واسعة الانتشار</td><td style="padding:12px 16px">الشركات والمحلات الكبيرة</td></tr>
          <tr style="background:#f8f9fa"><td style="padding:12px 16px">Banker</td><td style="padding:12px 16px">فئة اقتصادية عملية</td><td style="padding:12px 16px">المحلات والمكاتب الصغيرة والمتوسطة</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>تجار المنشية والعطارين: تجهيز الأسواق التقليدية</h2>
      <div class="divider"></div>
    </div>
    <div class="intro-text" style="max-width:900px;margin:0 auto;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>الأسواق التجارية التقليدية في المنشية والعطارين تعمل بإيقاع خاص: تعاملات نقدية كثيفة طوال اليوم، رزم فئات مختلطة، وتصفية يومية للخزينة. ماكينة عد بكشف مدمج ليست رفاهية هنا بل أداة تشغيل يومية، ولأن مقرنا داخل الإسكندرية فالمعاينة والتسليم والدعم كلها قريبة من محلك في السوق.</p>
    </div>
    <div class="reveal" style="max-width:900px;margin:32px auto 0;border-radius:var(--radius-lg);overflow:hidden">
      <img src="/images/webp-images/hands-putting-cash-counter-close-up-worker-calcul-2026-03-11-01-02-02-utc.webp" alt="ماكينات عد نقود للأسواق التقليدية بالإسكندرية" loading="lazy" style="width:100%;height:340px;object-fit:cover;display:block">
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>كشف تزييف العملة: كيف يعمل ومتى تحتاجه؟</h2>
      <div class="divider"></div>
    </div>
    <div class="intro-text" style="max-width:900px;margin:0 auto;line-height:2;font-size:1.05rem;color:var(--text-muted)">
      <p>لتاجر التجزئة، ورقة نقدية مزيفة واحدة تُقبل بالخطأ تعني خسارة كاملة لقيمتها. أجهزة كشف التزييف تحسم الفحص في ثوانٍ بثلاث تقنيات: الأشعة فوق البنفسجية UV تكشف العلامات الفلورية، الحبر المغناطيسي MG يتحقق من خصائص حبر الطباعة الرسمي، والأشعة تحت الحمراء IR تقرأ الأنماط غير المرئية. كثير من محلات الإسكندرية تستخدم جهاز كشف مستقل عند نقطة البيع مع كشف مدمج في ماكينة العد عند إغلاق الخزينة.</p>
    </div>
  </div>
</section>

<MidPageCTA formId="cashAlexandriaMidCta" />

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>دليل الاختيار حسب نشاطك</h2>
      <div class="divider"></div>
    </div>
    <div class="features-grid">
      <div class="feature-card reveal"><div class="feature-icon"><i class="fas fa-prescription-bottle-medical"></i></div><h4>صيدلية أو محل صغير</h4><p>ماكينة عد بكشف تزييف مدمج من الفئة الاقتصادية.</p></div>
      <div class="feature-card reveal delay-1"><div class="feature-icon"><i class="fas fa-cart-shopping"></i></div><h4>سوبرماركت أو سلسلة محلات</h4><p>ماكينة عد وكشف بسرعة أعلى وخزان أكبر.</p></div>
      <div class="feature-card reveal delay-2"><div class="feature-icon"><i class="fas fa-money-bill-transfer"></i></div><h4>صرافة</h4><p>ماكينة عد وفرز تقرأ قيمة الورقة وتدعم عملات متعددة.</p></div>
      <div class="feature-card reveal delay-3"><div class="feature-icon"><i class="fas fa-building-columns"></i></div><h4>بنك أو شركة تحصيل</h4><p>فئة كثيفة الاستخدام بعقد صيانة سنوي وزمن استجابة متفق عليه.</p></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>الضمان والصيانة وقطع الغيار داخل الإسكندرية</h2>
      <div class="divider"></div>
    </div>
    <div class="steps-grid">
      <div class="step-card reveal"><div class="step-num">1</div><h4>ضمان حقيقي</h4><p>على الأجهزة الجديدة، بشروط واضحة تستلمها مكتوبة مع الفاتورة.</p></div>
      <div class="step-card reveal delay-1"><div class="step-num">2</div><h4>صيانة محلية</h4><p>فني يصل إليك أو تسلمنا الجهاز في مقرنا، بلا شحن إلى محافظة أخرى.</p></div>
      <div class="step-card reveal delay-2"><div class="step-num">3</div><h4>عقود صيانة سنوية</h4><p>للشركات والفروع، تشمل زيارات وقائية دورية وأولوية استجابة.</p></div>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header">
      <h2>مناطق نخدمها في الإسكندرية</h2>
      <div class="divider"></div>
    </div>
    <p style="max-width:800px;margin:0 auto;text-align:center;line-height:2;font-size:1.05rem;color:var(--text-muted)">نغطي الإسكندرية بالكامل من مقرنا داخل المدينة: استجابة سريعة في وسط البلد وسموحة وسيدي جابر وميامي وجليم ولوران، وخدمة يومية لتجار المنشية والعطارين وأسواق المدينة التقليدية، ومحال الكورنيش، وشركات الاستيراد والتصدير القريبة من الميناء التي تحتاج أجهزة تدعم العملات الأجنبية.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>أسئلة شائعة عن ماكينات عد النقود في الإسكندرية</h2>
      <div class="divider"></div>
    </div>
    <div class="faq-list">
      <div class="faq-item"><div class="faq-question">ما أسعار ماكينات عد النقود في الإسكندرية؟<i class="fas fa-plus"></i></div><div class="faq-answer"><div class="faq-answer-inner">تختلف حسب النوع والسرعة والماركة. تواصل معنا وستصلك قائمة أسعار محدثة في نفس اليوم.</div></div></div>
      <div class="faq-item"><div class="faq-question">هل يمكن لماكينة عد النقود كشف التزوير؟<i class="fas fa-plus"></i></div><div class="faq-answer"><div class="faq-answer-inner">نعم، أغلب الموديلات تجمع بين العد وكشف التزييف بتقنيات UV وMG وIR.</div></div></div>
      <div class="faq-item"><div class="faq-question">ما الفرق بين ماكينة العد فقط والعد مع الفرز؟<i class="fas fa-plus"></i></div><div class="faq-answer"><div class="faq-answer-inner">العد فقط يعطي عدد الأوراق، والعد والفرز يضيف فصل الفئات وقراءة القيمة بالجنيه.</div></div></div>
      <div class="faq-item"><div class="faq-question">هل تدعم الماكينة الجنيه المصري والدولار واليورو؟<i class="fas fa-plus"></i></div><div class="faq-answer"><div class="faq-answer-inner">كل الموديلات تدعم الجنيه، وتتوفر موديلات تدعم الدولار واليورو أيضًا.</div></div></div>
      <div class="faq-item"><div class="faq-question">هل يوجد ضمان وصيانة وقطع غيار في الإسكندرية؟<i class="fas fa-plus"></i></div><div class="faq-answer"><div class="faq-answer-inner">نعم، ضمان مكتوب وصيانة وقطع غيار من داخل الإسكندرية.</div></div></div>
