---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSeoFor } from '../lib/siteSeo';
---

<BaseLayout
  {...getSeoFor('/portfolio')}
>
<style is:global>
  .portfolio-stats { display:grid; grid-template-columns:repeat(4,1fr); gap:1.5rem; }
  .portfolio-stat { text-align:center; padding:2rem 1rem; }
  .portfolio-stat .ps-number { font-family:'Cairo',sans-serif; font-size:2.8rem; font-weight:900; color:var(--secondary,#E8A020); display:block; line-height:1; margin-bottom:0.4rem; }
  .portfolio-stat .ps-label { font-family:'Tajawal',sans-serif; font-size:1rem; color:var(--primary,#1B3A6B); font-weight:600; }
  .portfolio-filters { display:flex; gap:0.6rem; flex-wrap:wrap; justify-content:center; margin-bottom:2.5rem; }
  .filter-tab { padding:0.55rem 1.3rem; border-radius:50px; font-family:'Cairo',sans-serif; font-size:0.9rem; font-weight:600; cursor:pointer; border:2px solid var(--primary,#1B3A6B); color:var(--primary,#1B3A6B); background:transparent; transition:all 0.3s; }
  .filter-tab:hover,.filter-tab.active { background:var(--primary,#1B3A6B); color:#fff; }
  .portfolio-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; }
  .portfolio-card { border-radius:18px; overflow:hidden; box-shadow:0 4px 20px rgba(27,58,107,0.1); background:#fff; transition:transform 0.35s,box-shadow 0.35s; }
  .portfolio-card:hover { transform:translateY(-8px); box-shadow:0 12px 36px rgba(27,58,107,0.18); }
  .portfolio-card-image { height:190px; display:flex; flex-direction:column; align-items:center; justify-content:center; position:relative; }
  .portfolio-card-image i { font-size:3.5rem; color:rgba(255,255,255,0.9); margin-bottom:0.5rem; filter:drop-shadow(0 2px 8px rgba(0,0,0,0.2)); }
  .portfolio-card-image .card-number { font-family:'Cairo',sans-serif; font-size:0.85rem; color:rgba(255,255,255,0.75); font-weight:600; }
  .portfolio-card-body { padding:1.4rem 1.3rem; }
  .portfolio-card-body .pc-badge { display:inline-block; padding:0.25rem 0.8rem; border-radius:50px; font-size:0.78rem; font-family:'Cairo',sans-serif; font-weight:700; margin-bottom:0.7rem; }
  .badge-print{background:#fff3e0;color:#e65100}.badge-copier{background:#e8eaf6;color:#3949ab}.badge-camera{background:#e0f2f1;color:#00695c}.badge-ac{background:#e3f2fd;color:#1565c0}.badge-supplies{background:#f3e5f5;color:#6a1b9a}.badge-gift{background:#fce4ec;color:#c62828}
  .portfolio-card-body h3 { font-family:'Cairo',sans-serif; font-size:1rem; font-weight:700; color:var(--primary,#1B3A6B); margin-bottom:0.4rem; line-height:1.4; }
  .portfolio-card-body p { font-size:0.88rem; color:#666; line-height:1.6; }
  .bg-navy-dark{background:linear-gradient(135deg,#1B3A6B 0%,#0d2244 100%)}.bg-navy-mid{background:linear-gradient(135deg,#2a5298 0%,#1B3A6B 100%)}.bg-gold{background:linear-gradient(135deg,#E8A020 0%,#c47c0a 100%)}.bg-teal{background:linear-gradient(135deg,#00796b 0%,#004d40 100%)}.bg-indigo{background:linear-gradient(135deg,#3949ab 0%,#1a237e 100%)}.bg-blue-steel{background:linear-gradient(135deg,#1565c0 0%,#0d47a1 100%)}.bg-purple{background:linear-gradient(135deg,#6a1b9a 0%,#4a148c 100%)}.bg-olive{background:linear-gradient(135deg,#558b2f 0%,#33691e 100%)}.bg-crimson{background:linear-gradient(135deg,#c62828 0%,#b71c1c 100%)}
  .port-testimonials-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.8rem; }
  .port-testimonial-card { background:#fff; border-radius:18px; padding:2rem; box-shadow:0 4px 20px rgba(27,58,107,0.09); border-top:4px solid var(--secondary,#E8A020); transition:transform 0.3s; }
  .port-testimonial-card:hover { transform:translateY(-5px); }
  .port-testimonial-card .quote-icon { font-size:3rem; color:var(--secondary,#E8A020); opacity:0.3; font-family:Georgia,serif; line-height:0.8; margin-bottom:0.5rem; }
  .port-testimonial-card .tc-text { font-size:0.97rem; color:#444; line-height:1.85; margin-bottom:1.5rem; font-style:italic; }
  .port-testimonial-card .tc-author { display:flex; align-items:center; gap:1rem; }
  .port-testimonial-card .tc-avatar { width:50px; height:50px; border-radius:50%; background:linear-gradient(135deg,var(--primary,#1B3A6B),#2a5298); display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .port-testimonial-card .tc-avatar i { font-size:1.4rem; color:var(--secondary,#E8A020); }
  .port-testimonial-card .tc-info h4 { font-family:'Cairo',sans-serif; font-size:0.95rem; font-weight:700; color:var(--primary,#1B3A6B); margin-bottom:0.15rem; }
  .port-testimonial-card .tc-info p { font-size:0.85rem; color:#888; }
  .tc-stars { color:var(--secondary,#E8A020); font-size:0.85rem; margin-bottom:0.8rem; }
  @media(max-width:1000px){.portfolio-grid{grid-template-columns:repeat(2,1fr)}.port-testimonials-grid{grid-template-columns:1fr}.portfolio-stats{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:640px){.portfolio-grid{grid-template-columns:1fr}.portfolio-stats{grid-template-columns:repeat(2,1fr)}}
</style>

<section class="page-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href="/">الرئيسية</a>
      <i class="fa-solid fa-chevron-left"></i>
      <span>معرض أعمالنا</span>
    </nav>
    <h1 class="reveal">معرض أعمالنا — مشاريع نفخر بها</h1>
    <p class="lead reveal delay-1">أكثر من خمسة وثلاثين عامًا من الخبرة تتجلى في مئات المشاريع الناجحة للشركات والفنادق والمستشفيات والجامعات في مصر. كل مشروع يحكي قصة ثقة وجودة.</p>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="portfolio-stats">
      <div class="portfolio-stat reveal"><span class="ps-number">+500</span><span class="ps-label">مشروع منجز بنجاح</span></div>
      <div class="portfolio-stat reveal delay-1"><span class="ps-number">+27</span><span class="ps-label">سنة في السوق المصري</span></div>
      <div class="portfolio-stat reveal delay-2"><span class="ps-number">+100</span><span class="ps-label">شركة ومؤسسة عميلة</span></div>
      <div class="portfolio-stat reveal"><span class="ps-number">6</span><span class="ps-label">محافظات تغطية شاملة</span></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header reveal">
      <h2>نخدمك في هذه المجالات</h2>
      <div class="divider"></div>
      <p>صور مشاريعنا الحقيقية قادمة قريباً، تواصل معنا وسنسعد بإرسال نماذج ومراجع من أعمالنا مباشرة</p>
    </div>
    <div class="portfolio-grid">
      <div class="portfolio-card reveal">
        <div class="portfolio-card-image bg-navy-dark"><i class="fa-solid fa-print"></i></div>
        <div class="portfolio-card-body">
          <span class="pc-badge badge-print">طباعة</span>
          <h3>خدمات الطباعة</h3>
          <p>أوفست، رقمية، بنرات، بزنس كارد، UV، وطباعة على الهدايا لعملاء من مختلف القطاعات.</p>
        </div>
      </div>
      <div class="portfolio-card reveal delay-1">
        <div class="portfolio-card-image bg-indigo"><i class="fa-solid fa-copy"></i></div>
        <div class="portfolio-card-body">
          <span class="pc-badge badge-copier">تصوير وطباعة</span>
          <h3>ماكينات التصوير والطابعات</h3>
          <p>بيع وصيانة ماكينات التصوير والطابعات وتوريد كارتريدج لمكاتب وشركات ومؤسسات.</p>
        </div>
      </div>
      <div class="portfolio-card reveal delay-2">
        <div class="portfolio-card-image bg-teal"><i class="fa-solid fa-camera"></i></div>
        <div class="portfolio-card-body">
          <span class="pc-badge badge-camera">كاميرات مراقبة</span>
          <h3>أنظمة المراقبة</h3>
          <p>تركيب وصيانة كاميرات مراقبة وأنظمة DVR/NVR لمحلات ومصانع ومنشآت بمختلف الأحجام.</p>
        </div>
      </div>
      <div class="portfolio-card reveal">
        <div class="portfolio-card-image bg-blue-steel"><i class="fa-solid fa-snowflake"></i></div>
        <div class="portfolio-card-body">
          <span class="pc-badge badge-ac">تكييفات</span>
          <h3>التكييفات</h3>
          <p>بيع وتركيب وصيانة تكييفات لمكاتب وفنادق ومنشآت تجارية وسكنية.</p>
        </div>
      </div>
      <div class="portfolio-card reveal delay-1">
        <div class="portfolio-card-image bg-purple"><i class="fa-solid fa-briefcase"></i></div>
        <div class="portfolio-card-body">
          <span class="pc-badge badge-supplies">مستلزمات مكتبية</span>
          <h3>المستلزمات المكتبية</h3>
          <p>توريد ورق وأدوات كتابة ومستلزمات مكتبية بالجملة لمكاتب وشركات ومؤسسات تعليمية وطبية.</p>
        </div>
      </div>
      <div class="portfolio-card reveal delay-2">
        <div class="portfolio-card-image bg-gold"><i class="fa-solid fa-money-bill-wave"></i></div>
        <div class="portfolio-card-body">
          <span class="pc-badge badge-print">ماكينات فارم وعد</span>
          <h3>ماكينات عد النقود والفارم</h3>
          <p>ماكينات عد النقود، كشف العملات المزيفة، الفارم والختم، وتدمير المستندات.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section style="padding:60px 0;background:#f8f9fa">
  <div class="container">
    <h2 style="font-size:1.8rem;font-weight:700;color:#1a1a2e;margin-bottom:24px">قطاعات نخدمها في مصر</h2>
    <p style="font-size:1.05rem;line-height:1.9;color:#555;margin-bottom:24px">نيو جولدن أوفيس تخدم شركات وجهات من مختلف القطاعات في القاهرة والإسكندرية وجميع محافظات مصر:</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px">
      <div style="background:#fff;border-radius:10px;padding:16px;text-align:center;border:1px solid #e0e0e0">🏢<p style="margin:6px 0 0;font-size:0.9rem;font-weight:600">شركات ومكاتب</p></div>
      <div style="background:#fff;border-radius:10px;padding:16px;text-align:center;border:1px solid #e0e0e0">🏥<p style="margin:6px 0 0;font-size:0.9rem;font-weight:600">مستشفيات وعيادات</p></div>
      <div style="background:#fff;border-radius:10px;padding:16px;text-align:center;border:1px solid #e0e0e0">🏨<p style="margin:6px 0 0;font-size:0.9rem;font-weight:600">فنادق ومنتجعات</p></div>
      <div style="background:#fff;border-radius:10px;padding:16px;text-align:center;border:1px solid #e0e0e0">🏫<p style="margin:6px 0 0;font-size:0.9rem;font-weight:600">مدارس وجامعات</p></div>
      <div style="background:#fff;border-radius:10px;padding:16px;text-align:center;border:1px solid #e0e0e0">🏭<p style="margin:6px 0 0;font-size:0.9rem;font-weight:600">مصانع ومستودعات</p></div>
      <div style="background:#fff;border-radius:10px;padding:16px;text-align:center;border:1px solid #e0e0e0">🏦<p style="margin:6px 0 0;font-size:0.9rem;font-weight:600">بنوك ومؤسسات</p></div>
    </div>
  </div>
</section>

<section class="section section-bg">
  <div class="container">
    <div class="section-header reveal">
      <h2>كيف ننفذ مشروعك من البداية للنهاية</h2>
      <div class="divider"></div>
      <p>سواء كان مشروعك تجهيز مكتب جديد بالكامل أو توريد صنف واحد، نتبع نفس المنهجية المدروسة لكل عميل</p>
    </div>
    <div class="portfolio-stats" style="text-align:right">
      <div class="portfolio-stat reveal" style="text-align:right;padding:1.5rem">
        <h3 style="font-family:'Cairo',sans-serif;font-size:1.1rem;color:var(--primary,#1B3A6B);margin-bottom:8px">1. معاينة واستشارة</h3>
        <p style="font-size:0.92rem;color:#666;line-height:1.7">نستمع لاحتياجك الفعلي أولاً، سواء عبر مكالمة أو زيارة ميدانية، لنفهم حجم العمل والميزانية والمواعيد قبل اقتراح أي حل.</p>
      </div>
      <div class="portfolio-stat reveal delay-1" style="text-align:right;padding:1.5rem">
        <h3 style="font-family:'Cairo',sans-serif;font-size:1.1rem;color:var(--primary,#1B3A6B);margin-bottom:8px">2. عرض سعر مخصص</h3>
        <p style="font-size:0.92rem;color:#666;line-height:1.7">نرسل عرض سعر تفصيلي خلال 24 ساعة يحدد الماركات والمواصفات والمدة الزمنية، دون التزامات مخفية.</p>
      </div>
      <div class="portfolio-stat reveal delay-2" style="text-align:right;padding:1.5rem">
        <h3 style="font-family:'Cairo',sans-serif;font-size:1.1rem;color:var(--primary,#1B3A6B);margin-bottom:8px">3. تنفيذ وتركيب</h3>
        <p style="font-size:0.92rem;color:#666;line-height:1.7">فريقنا الفني ينفذ التوريد أو التركيب في الموعد المتفق عليه، مع أقل تعطيل ممكن لسير عملك اليومي.</p>
      </div>
      <div class="portfolio-stat reveal" style="text-align:right;padding:1.5rem">
        <h3 style="font-family:'Cairo',sans-serif;font-size:1.1rem;color:var(--primary,#1B3A6B);margin-bottom:8px">4. متابعة ما بعد البيع</h3>
        <p style="font-size:0.92rem;color:#666;line-height:1.7">علاقتنا لا تنتهي بالتسليم، نبقى متاحين للصيانة وقطع الغيار وأي استفسار طوال فترة الضمان وبعدها.</p>
      </div>
    </div>
  </div>
</section>

<section class="cta-banner">
  <div class="container">
    <div class="reveal">
      <h2>ابدأ مشروعك معنا اليوم</h2>
      <p>انضم إلى أكثر من 5000 عميل يثقون بنيو جولدن أوفيس — تواصل معنا الآن وسنقدم لك عرض سعر مجاني خلال 24 ساعة</p>
      <div class="btn-group">
        <a href="/contact" class="btn btn-primary btn-lg"><i class="fa-solid fa-envelope"></i> طلب عرض سعر</a>
        <a href="https://wa.me/201227392074?text=مرحبًا، أريد الاستفسار عن بدء مشروع جديد" class="btn btn-outline btn-lg" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp"></i> واتساب</a>
      </div>
    </div>
  </div>
</section>

</BaseLayout>
